        // Set a callback to run when the Google Visualization API is loaded.
        google.charts.setOnLoadCallback(drawCharts);

        $(document).on('click', '#pcSwitch1', function () {
            if ($(this).prop('checked', true)) {
                $('#chart4').removeClass('hide');
                $('#chart5').addClass('hide');
                $('#pcTitle').html('Price Competitiveness Report (All Products)');
            }
            $(this).closest('.btn-group').removeClass('open');
            $('.tooltip').hide();
        })

        $(document).on('click', '#pcSwitch2', function () {
            if ($(this).prop('checked', true)) {
                $('#chart4').addClass('hide');
                $('#chart5').removeClass('hide');
                $('#pcTitle').html('Price Competitiveness Report (Key Lines)');
            }
            $(this).closest('.btn-group').removeClass('open');
            $('.tooltip').hide();
        })               

