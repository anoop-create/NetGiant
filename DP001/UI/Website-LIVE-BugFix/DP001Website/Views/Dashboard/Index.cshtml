        function pricingAnalysis(htmlId) {

            var data = google.visualization.arrayToDataTable([

                [{ label: 'Inventory', type: 'string' }, { label: 'Percentage', type: 'number' }, { label: 'Count', type: 'number' }],

    @{
        var last2 = Model.PricingAnalysisList.Last();
        foreach (Tuple<string, int, int> tup in Model.PricingAnalysisList)
        {
                <text>
    ['@(tup.Item1)', @(tup.Item2), @(tup.Item3)]
    </text>
            if (tup.Item1 != last2.Item1)
