@using DP001BusinessLogic.ViewModels;
@using DP001Website.Models;
@model DashboardViewModel

@{
    ViewBag.Title = "Dashboard";
    ViewBag.BodyClass = "g-bg-lightgrey";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1>
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Dashboard
            </h1>
        </div>
    </div>
</section>

<section class="container-fluid">
    <div class="row">
        <div class="col-lg-12 col-md-12">
            <div class="container-fluid">
                <div class="row">
                    @{
                        Html.RenderPartial("InventoryTotals", Model.Counters);

                        Html.RenderPartial("PriceRulesSummary", Model.Counters);

                        Html.RenderPartial("ProductMappingSummary", Model.Counters);

                        Html.RenderPartial("Schedule", Model);
                    }
                </div>
                <div class="row">
                    @{
                        Html.RenderPartial("MarginDistribution", Model.Counters);

                        Html.RenderPartial("PriceCompetitive", Model.Counters);

                        //Html.RenderPartial("InventoryTotals", Model.Counters);

                        //Html.RenderPartial("CategoryRanking", Model);

                        //Html.RenderPartial("BrandRanking", Model);

                        //Html.RenderPartial("PricingAnalysis", Model.Counters);
                    }

                </div>
            </div>
        </div>
    </div>
</section>

