        function priceCompetitive(htmlId, selection) {
            var data;
            if (selection == 'all') {
                data = google.visualization.arrayToDataTable([

                    //[{ label: 'Inventory', type: 'string' }, { label: 'Percentage', type: 'number' }, { label: 'Count', type: 'number' }],
                    [{ label: 'Inventory', type: 'string' }, { label: 'Count', type: 'number' }, { role: 'tooltip', type: 'string' }],

            @{
                if (Model.PricingAnalysisList.Count > 0)
                {
                    var lastAll = Model.PricingAnalysisList.Last();
                    foreach (Tuple<string, string, int> tup in Model.PricingAnalysisList)
                    {
                        <text>['@(tup.Item1)', @(tup.Item3), '@(tup.Item2)']</text>
                        if (tup.Item1 != lastAll.Item1)
                        {
                            <text>,</text>
                        }
                    }
                }
                else
                {
                    <text>['No data', 1, 1]</text>
                }
            }
            ]);
            } else {
                data = google.visualization.arrayToDataTable([

                    [{ label: 'Inventory', type: 'string' }, { label: 'Percentage', type: 'number' }, { role: 'tooltip', type: 'string' }],

            @{
                if (Model.PricingAnalysisList.Count > 0)
                {
                    var lastKey = Model.PricingAnalysisListKey.Last();
                    foreach (Tuple<string, string, int> tup in Model.PricingAnalysisListKey)
                    {
                        <text>['@(tup.Item1)', @(tup.Item3), '@(tup.Item2)']</text>
                        if (tup.Item1 != lastKey.Item1)
                        {
                            <text>,</text>
                        }
                    }
                }
                else
                {
                    <text>['No data', 1, 1]</text>
                }
            }
            ]);
            }

            var options = {
                theme: "maximized",
                backgroundColor: "#ffffff",
                height: 350,
                pieHole: 0.4,
                pieSliceText: "value",
                pieSliceTextStyle: {
                    bold: "true"
                },
                animation: {
                    startup: true,
                    duration: 1000,
                    easing: "out"
                },
                slices: [
                    { color: "#418bca" },
                    { color: "#ef6f6c" },
                    { color: "#01bc8c" },
                    { color: "#006699" },
                    { color: "#f89a14" },
                    { color: "#006699" }
                ],
                tooltip: {
                    isHtml: "true",
                    textStyle: {
                        color: "#666666"
                    },
                    trigger: "focus"
                },
                legend: {
                    position: "labeled",
                    textStyle: {
                        color: "#666666",
                    }
                }
            };

                function selectHandler() {
                    var selectedItem = chart.getSelection()[0];
                    if (selectedItem) {
                        var segment = data.getValue(selectedItem.row, 0);
                        switch (segment) {
                            case "Sales Opportunity":
                                location.href = "/Reports/Comparison?grid-filter=Lookup.LookupName__1__Minimum"
                                break;
                            case "Margin Opportunity":
                                location.href = "/Reports/Comparison?grid-filter=Lookup.LookupName__1__Maximum"
                                break;
                            case "At desired margin":
                                location.href = "/Reports/Comparison?grid-filter=Lookup.LookupName__1__Desired"
                                break;
                            case "Above desired margin":
                                location.href = "/Reports/Comparison?grid-filter=Lookup.LookupName__1__Nudge Up"
                                break;
                            case "Below desired margin":
                                location.href = "/Reports/Comparison?grid-filter=Lookup.LookupName__1__Nudge Down"
                                break;
                        }
                    }
                }
                function setCursorPointer() {
                    $('#' + htmlId).css('cursor', 'pointer')
                }
                function setCursorNormal() {
                    $('#' + htmlId).css('cursor', 'default')
                }

                var chart = new google.visualization.PieChart(document.getElementById(htmlId));
                google.visualization.events.addListener(chart, 'select', selectHandler);
                google.visualization.events.addListener(chart, 'onmouseover', setCursorPointer);
                google.visualization.events.addListener(chart, 'onmouseout', setCursorNormal);
                chart.draw(data, options);
            }

            function marginDistribution(htmlId, selection) {
                var data;
                data = google.visualization.arrayToDataTable([

                    [{ label: 'Range', type: 'string' }, { label: 'Count', type: 'number' }, { role: 'tooltip', type: 'string' }, { role: 'annotation', type: 'string' }],

            @{
                if (Model.MarginDistributionList.Count > 0)
                {
                    var last1All = Model.MarginDistributionList.Last();
                    foreach (Tuple<string, int, string> tup in Model.MarginDistributionList)
                    {
                        <text>['@(tup.Item1)', @(tup.Item2), '@(tup.Item3)', '@(tup.Item2.ToString("N0"))']</text>
                        if (tup.Item1 != last1All.Item1)
                        {
                        <text>,</text>
                        }
                    }
                }
                else
                    {
                        <text>['No data', 0, 'No data', 'No data']</text>
                    }
                }
                ]);

                var options = {
                    animation: {
                        startup: true,
                        duration: 1000,
                        easing: "none"
                    },
                    bar: { groupWidth: "98%" },
                    bars: 'vertical',
                    chartArea: {
                        width: "90%",
                        height: "80%",
                        top: "10",
                        left: "80"
                    },
                    colors: ["#01bc8c"],
                    hAxis: {
                        title: 'Gross Margin (%)',
                        position: "out",
                        gridlines: {
                            count: 10,
                            color: "#ffffff"
                        }
                    },
                    height: 424,
                    legend: "none",
                    tooltip: {
                        isHtml: "true",
                        textStyle: {
                            color: "#666666"
                        }
                    },
                    vAxis: {
                        title: 'No. of Products'
                    }
                };

                function selectHandler() {
                    var selectedItem = chart.getSelection()[0];
                    if (selectedItem) {
                        var segment = data.getValue(selectedItem.row, 0).split(' - ');
                        location.href = "/Reports/Comparison?grid-filter=GrossMarginPercent__7__" + segment[0] + "&grid-filter=GrossMarginPercent__6__" + segment[1];
                    }
                }

                function setCursorPointer() {
                    $('#' + htmlId).css('cursor', 'pointer');
                }
                function setCursorNormal() {
                    $('#' + htmlId).css('cursor', 'pointer');
                }

                var chart = new google.visualization.ColumnChart(document.getElementById(htmlId));
                google.visualization.events.addListener(chart, 'select', selectHandler);
                google.visualization.events.addListener(chart, 'onmouseover', setCursorPointer);
                google.visualization.events.addListener(chart, 'onmouseout', setCursorNormal);
                chart.draw(data, options);
            }

    </script>
}




