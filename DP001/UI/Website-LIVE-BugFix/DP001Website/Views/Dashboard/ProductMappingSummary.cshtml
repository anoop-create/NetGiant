@using DP001BusinessLogic.ViewModels;
@model DashboardViewModel.Dash1

<div class="col-xs-12 col-md-6 col-lg-3 dashlet">
    <div class="g-bg-orange row">
        <div class="col-xs-8">
            <h4><i class="fa fa-question-circle-o fa-lg help-popup g-m-r-10" data-toggle="tooltip" title="A summary of supplier and competitor products where inventory matches cannot be found." data-helpsid="2" data-helpeid="2"></i>Product Mapping Summary</h4>
            <div class="pull-left col-xs-12">
                <div data-toggle="tooltip" title="There are @Model.SupplierExceptionsCount.ToString("N0") supplier products where matches cannot be found in your inventory, Click here to view supplier exceptions." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("SupplierExceptions", "SkuMappings")">Supplier Exceptions</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("SupplierExceptions", "SkuMappings")">@Model.SupplierExceptionsCount.ToString("N0")</a></div>
                </div>
                <div data-toggle="tooltip" title="There are @Model.CompetitorExceptionsCount.ToString("N0") competitor products where matches cannot be found in your inventory, Click here to view competitor exceptions." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("CompetitorExceptions", "SkuMappings")">Competitor Exceptions</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("CompetitorExceptions", "SkuMappings")">@Model.CompetitorExceptionsCount.ToString("N0")</a></div>
                </div>
                <div data-toggle="tooltip" title="There are @Model.ManualMappingsCount.ToString("N0") products that have been mapped to your inventory manually, Click here to see manual mappings." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("Index", "SkuMappings")">Manual Mappings</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("Index", "SkuMappings")">@Model.ManualMappingsCount.ToString("N0")</a></div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 dash-img">
            <i class="fa fa-chain fa-4x"></i>
        </div>
    </div>
</div>