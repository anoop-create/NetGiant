@using DP001BusinessLogic.ViewModels;
@model DashboardViewModel

<div class="col-xs-4 dashlet">
    <div class="dash-title">
        <div class="pull-left g-p-l-10">
            <i class="fa fa-question-circle fa-inverse help-popup" style="color: #ffffff" data-toggle="tooltip" title="" data-helpsid="2" data-helpeid="2"></i>
        </div>
        <div class="pull-left text-center" style="width: 90%">Category Ranking</div>
    </div>
    @if (Model.CategoryRankList.Count > 0)
    {
        <div class="clearfix dash-header">
            <div class="pull-left">Category</div>
            <div class="pull-left">Share of Total Inventory</div>
            <div class="pull-left">Count</div>
        </div>
        <div class="clearfix">
            <div class="pull-left dash-left tiny-font">
                @foreach (Tuple<string, int, int> tup in Model.CategoryRankList)
                {
                    <div class="">@tup.Item1</div>
                }
            </div>
            <div id="chart1" class="pull-left bar-chart"></div>
            <div class="pull-left dash-right tiny-font">
                @foreach (Tuple<string, int, int> tup in Model.CategoryRankList)
                {
                    <div class="">@tup.Item3.ToString()</div>
                }
            </div>
        </div>
    }
</div>
