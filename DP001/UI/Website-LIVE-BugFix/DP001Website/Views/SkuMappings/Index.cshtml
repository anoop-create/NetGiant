@using DP001BusinessLogic.ViewModels;
@using DP001Website.Models;
@using DP001DataAccess.Entities;
@using GridMvc.Html;
@model SkuMappingViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.SupEx = Model.ProductInventoryCount - Model.SupplierExceptionCount;
    ViewBag.ComEx = Model.ProductInventoryCount - Model.CompetitorExceptionCount;
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-7 col-lg-5 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Product Mappings
            </h1>
        </div>

        <div class="col-lg-5 sub-menu-info-container g-bg-orange visible-lg">
            <div class="container-fluid">
                <div class="row vertical-center">
                    <div class="col-lg-7">
                        <div class="row">
                            <div class="col-lg-6 sub-menu-highlight g-fc-white">
                                <div class="text-center">Product Inventory (@String.Format("{0:n0}", Model.ProductInventoryCount))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("Index", "Products")" role="button">View Inventory</a>
                                </div>
                            </div>
                            <div class="col-lg-6 sub-menu-highlight g-fc-white">
                                <div class="text-center">Supplier Matches (@ViewBag.SupEx.ToString("N0"))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("SupplierExceptions")" role="button">View Exceptions (@Model.SupplierExceptionCount.ToString("N0"))</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="row">
                            <div class="col-lg-9 sub-menu-highlight g-fc-white" style="border: none;">
                                <div class="text-center">Competitor Matches (@ViewBag.ComEx.ToString("N0"))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("CompetitorExceptions")" role="button">View Exceptions (@Model.CompetitorExceptionCount.ToString("N0"))</a>
                                </div>
                            </div>
                            <div class="col-lg-3 sub-menu-highlight g-fc-white dash-img vertical-center">
                                <i class="fa fa-chain fa-3x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-5 col-lg-2 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Report Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "SkuMappings", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-exclamation\"></i> View Supplier Exceptions", "SupplierExceptions", "SkuMappings", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-exclamation\"></i> View Competitor Exceptions", "CompetitorExceptions", "SkuMappings", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.SkuMappingList).Columns(columns =>
{
    columns.Add(o => o.Type)
        .Titled("Mapping Type")
        .Filterable(true)
        .SetFilterWidgetType("CustomMapTypeFilterWidget");

    columns.Add(o => o.SupplierCompetitorName)
        .Titled("Supplier/Competitor")
        .Filterable(true)
        .SetFilterWidgetType("CustomSupplierFilterWidget");

    columns.Add(o => o.Prod.Description)
        .Titled("Product Name")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Prod.Brand.BrandName)
        .Titled("Brand")
        .Filterable(true)
        .SetFilterWidgetType("CustomBrandFilterWidget");

    columns.Add(o => o.Prod.ManufacturerPartNo)
        .Titled("Part Number")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .SetWidth(30)
            .Css("no-border")
            .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.SkuMappingId));

}).WithPaging(200).Sortable().Named("prodMappingGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters().WithGridItemsCount()

@section scripts {
    <script type="text/javascript">
        $(function () {
            pageGrids.prodMappingGrid.addFilterWidget(
                new DropDownListWidget("CustomBrandFilterWidget", "brandList", "/Shared/GetBrandNames")
            );

            pageGrids.prodMappingGrid.addFilterWidget(
                new DropDownListWidget("CustomSupplierFilterWidget", "supplierCompetitorList", "/SkuMappings/GetSupplierCompetitors")
            );

            pageGrids.prodMappingGrid.addFilterWidget(
                new DropDownListWidget("CustomCompetitorFilterWidget", "supplierList", "/Shared/GetCompetitorNames")
            );

            pageGrids.prodMappingGrid.addFilterWidget(
                new DropDownListWidget("CustomMapTypeFilterWidget", "mapTypeList", "/SkuMappings/GetMappingTypes")
            );

            pageGrids.prodMappingGrid.addFilterWidget(
                    new TextWidget("CustomTextFilterWidget")
            );

            $(document).on('click', '.grid-wrap tbody > tr', function () {
                if ($(this).find('#x_SkuMappingId').length > 0) {
                    window.location.href = '@Url.Action("EditSkuMapping")/' + $(this).find('#x_SkuMappingId').val();
                }
            })
            @*$(document).on('click', '.page-form tbody > tr', function () {
                window.location.href = '@Url.Action("EditSkuMapping")/' + $(this).attr('data-id');
            })*@

        });
    </script>
}