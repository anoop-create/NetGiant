@using DP001Website.Models;
@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@using System.Web.Mvc;
@using System.Web.Mvc.Html;
@using DP001Website.Controllers;
@using System.Configuration;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="~/Content/images/favicon.ico" rel="icon" type="image/x-icon"/>
    @Styles.Render("~/Content/css")
    @{
        //Determine Tenant
        CommonModel cm = new CommonModel();
        TenantSetting tenant = cm.GetTenant();
        List<SelectListItem> channels = tenant.Channels.Select(x => new SelectListItem
        {
            //Text = HttpUtility.HtmlDecode("<span style=\"font-weight: " + (x.IsActive ? "bold" : "normal") + "\">" + x.ChannelName + "</span>"),
            Text = x.ChannelName,
            Value = x.ChannelID.ToString()
        }).ToList();

        //Set up additional header HTML tags
            switch (tenant.Lookup.LookupName.ToLower())
        {
            case "ekm powershop":
                <title>Price Optimiser</title>
                <link href="@Url.Content("~/Content/Ekm.css")" rel="stylesheet" type="text/css" />
                break;
            case "sap anywhere":
                <title>Priceology - Optimised Pricing Software</title>
                <link href="@Url.Content("~/Content/sapa.css")" rel="stylesheet" type="text/css" />
                break;
            default:
                <title>Priceology - Optimised Pricing Software</title>
                <link href="@Url.Content("~/Content/Saas.css")" rel="stylesheet" type="text/css" />
                break;
        }


        //Determine Current Channel
        if (HttpContext.Current.Session["CurrentChannel"] == null)
        {
            HttpContext.Current.Session["CurrentChannel"] = tenant.LastUsedChannelId.ToString();
        }
        string currentChannel = HttpContext.Current.Session["CurrentChannel"].ToString();
        channels.Where(x => x.Value == currentChannel).FirstOrDefault().Selected = true;
        Channel channel = tenant.Channels.Where(x => x.ChannelID == Int32.Parse(currentChannel)).FirstOrDefault();

        //Notification Count
        cm.RefreshLogSummaryCount(channel.ChannelID);

        //Determine menu selection
        string currentItem = HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString().ToLower();
        string currentAction = HttpContext.Current.Request.RequestContext.RouteData.Values["action"].ToString().ToLower();
        if ("products".Contains(currentItem))
        {
            currentItem = "inventories";
        }
        if ("inventory".Contains(currentAction))
        {
            currentItem = "inventories";
        }
        if ("tenantaudit".Contains(currentItem))
        {
            currentItem = "reports";
        }
        if ("tenantsettings skumappings schedule ftpsettings".Contains(currentItem))
        {
            currentItem = "settings";
        }
        if ("competitors".Contains(currentItem) && "index".Contains(currentAction))
        {
            currentItem = "settings";
        }
        if (currentAction.Contains("brandalias") || currentAction.Contains("mfpnalias"))
        {
            currentItem = "settings";
        }
    }
</head>
<body class="@ViewBag.BodyClass">
    <header>
        <nav class="navbar navbar-fixed-top" role="navigation">
            <div class="container-fluid">
                <div class="navbar-header">
                    <div>
                        <button type="button" class="navbar-toggle collapsed" data-toggle="offcanvas" data-target="#navbar-links" aria-expanded="false">
                            <span class="sr-only">Toggle navigation</span>
                            <span class="fa fa-bars"></span>
                        </button>

                        <div class="g-m-r-20 brand-text">
                            &nbsp;
                            <a href="/"></a>
                        </div>
                    </div>

                    <div class="channel-bar">
                        <li class="list-unstyled select-channel">
                            @Html.ChannelDropDown(tenant.Channels.ToList(), currentChannel, "pull-right", "00")
                        </li>
                    </div>
                </div>
                <div class="navbar-collapse collapse" id="navbar-links">
                    <div>
                        <ul class="nav navbar-left text-nowrap nav-justified">
                            @{ Html.RenderPartial("~/Views/Shared/Menu.cshtml",
   new { MenuType = "Authorised", MenuPosition = "Left", CurrentItem = currentItem }); }
                        </ul>
                    </div>

                    <div>
                        <ul class="nav navbar-nav navbar-right">
                            @if (User.Identity.IsAuthenticated)
                            {
                                if (User.IsInRole("SuperAdmin"))
                                {
                                    <li class="">
                                        @HttpContext.Current.Session["CurrentChannel"]
                                    </li>
                                    <li class="">
                                        @tenant.TenantID.ToString()
                                    </li>
                                }
                            }

                            <li class="select-channel">
                                @Html.ChannelDropDown(tenant.Channels.ToList(), currentChannel, "", "01")
                            </li>

                            <li class="">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-header dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fa fa-user fa-lg g-m-r-10"></i>
                                        <i class="fa fa-caret-down"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        @{ Html.RenderPartial("~/Views/Shared/Menu.cshtml",
   new { MenuType = "Authorised", MenuPosition = "Right", CurrentItem = "" }); }
                                    </ul>
                                </div>
                            </li>

                            <li class="">
                                <div class="btn-group">
                                    <button id="notification-summary" type="button" class="btn btn-header dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        @*<i class="fa fa-bell-o fa-lg"></i>*@
                                        <span class="fa-stack">
                                            <i class="fa fa-bell-o fa-lg"></i>
                                            <i class="fa fa-circle fa-badge-bg-t g-fc-green"></i>
                                            <span class="badge-text-t">@Session["SummaryLogCount"]</span>
                                        </span>
                                    </button>
                                    <ul id="notification-dropdown" class="dropdown-menu"></ul>
                                </div>
                            </li>

                            @*<li class="full-center help">
                                    <a class="btn btn-header" href="@Url.Action("Index", "Help")" role="button">
                                        <i class="fa fa-question"></i>
                                    </a>
                                </li>*@

                        </ul>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid body-authorised">
        <div class="row row-offcanvas row-offcanvas-left">
            <div class="col-xs-12">
                @RenderBody()
            </div>
            <div id="sidebar" class="col-xs-6 col-sm-3 sidebar-offcanvas">
                <ul class="list-group list-unstyled">
                    @{ Html.RenderPartial("~/Views/Shared/Menu.cshtml",
       new { MenuType = "Authorised", MenuPosition = "Left", CurrentItem = currentItem }); }
                    <li role="separator"><hr /></li>
                    <li>
                        @Html.ActionLink("Notifications", "Index", "Log")
                    </li>
                    <li role="separator"><hr /></li>
                    @{ Html.RenderPartial("~/Views/Shared/Menu.cshtml",
   new { MenuType = "Authorised", MenuPosition = "Right", CurrentItem = "" }); }
                </ul>
            </div>
        </div>
    </div>



    @*@RenderBody()*@

    <footer class="container-fluid">
        <p class="text-center">Copyright &copy; @DateTime.Now.Year <span class="brand-text"></span></p>
        <script type="text/javascript">
            //*************************//
            // Comodo  Trust           //
            //*************************//
            //<![CDATA[ 
            var tlJsHost = ((window.location.protocol == "https:") ? "https://secure.comodo.com/" : "http://www.trustlogo.com/");
            document.write(unescape("%3Cscript src='" + tlJsHost + "trustlogo/javascript/trustlogo.js' type='text/javascript'%3E%3C/script%3E"));
            //]]>
        </script>
        <script type="text/javascript">
            TrustLogo("https://app.priceology.io/Content/images/comodo_secure_seal_76x26_transp.png", "CL1", "none");
        </script>
    </footer>

    @Scripts.Render("~/bundles/alljs")
    @RenderSection("scripts", required: false)

    @Scripts.Render("~/bundles/idletimer")
    <script type="text/javascript">
        $.idleTimer(@ConfigurationManager.AppSettings["AutoLogoutMilliseconds"]);

        $(function () {
            try {
                $(document).bind("idle.idleTimer", function () {
                    window.location.href = '@Url.Action("Login", "Account",
                new { ReturnUrl = "/" + ViewContext.RouteData.Values["controller"] + "/" + ViewContext.RouteData.Values["action"]
                                    + "/" + ViewContext.RouteData.Values["id"] })';
                });
            }
            catch (exception) { }
        });
        </script>
</body>
</html>
