@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using GridMvc.Html;
@using DP001Website.Models;
@model LogViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Error Log
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Log Options</li>
                    <li role="presentation" class="divider"></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.ErrorList).Columns(columns =>
{
    columns.Add(o => o.LogID)
        .Titled("Log ID")
        .Filterable(true)
        .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.JobID)
        .Titled("Job ID")
        .Filterable(true)
        .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.TenantFK)
        .Titled("Tenant")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ChannelFK)
        .Titled("Channel")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Lookup.LookupName)
        .Titled("Log Type")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.DateTime)
        .Format("{0:dd/MM/yyyy (HH:mm)}")
        .Titled("Date/Time")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Entry)
        .Titled("Description")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.LogID));

}).WithPaging(200).Sortable().Named("logsGrid").Selectable(false).WithMultipleFilters().WithGridItemsCount()

@section scripts {
    <script type="text/javascript">
        $(function () {

            pageGrids.logsGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.logsGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

        });

    </script>
}
