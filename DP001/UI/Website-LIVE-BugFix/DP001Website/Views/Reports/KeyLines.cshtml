@using GridMvc.Html;
@using DP001BusinessLogic.ViewModels;
@using DP001Website.Models;
@model ReportsViewModel

@{
    ViewBag.Title = "Grid";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Key Lines
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Report Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "KeyLines", "Reports", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-upload\"></i> Export Report", "ExportToExcel", "Reports", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.Products).Columns(columns =>
{
    columns.Add(o => o.ManufacturerPartNo)
            .Sanitized(true)
            .Titled("Mfpn")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ClientProductID)
        .Titled("Client Product ID")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Description)
            .RenderValueAs(x => Html.HtmlActionLink(x.Description, "ProductDetail", "Products", new { id = x.ProductInventoryID }, null))
            .Titled("Description")
            .Encoded(false)
            .Sanitized(false)
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ProductCategory.CategoryName)
            .Titled("Category")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Brand.BrandName)
            .Titled("Brand")
            .Filterable(true)
            .SetFilterWidgetType("CustomBrandFilterWidget");

    columns.Add(o => o.StockQuantity)
            .Titled("Stock")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.SupplierInventories.Count)
            .Titled("No. Suppliers")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.CompetitorInventories.Count)
            .RenderValueAs(o => Html.TooltipLink(o.CompetitorInventories.Count.ToString(),
                new
                {
                    data_id = o.ProductInventoryID,
                    data_toggle = "tooltip",
                    data_placement = "bottom",
                    data_unique_id = Guid.NewGuid()
                },
                o.CompetitorInventories.Count > 0))
            .Encoded(false)
            .Sanitized(false)
            .Titled("No. Competitors")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.CheapestCostPrice)
            .RenderValueAs(o => string.Format("{0:N2}", o.CheapestCostPrice))
            .Titled("Cost Price")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.CheapestCompetitorPrice)
            .RenderValueAs(o => string.Format("{0:N2}", o.CheapestCompetitorPrice))
            .Titled("Cheapest Competitor")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.Price)
            .RenderValueAs(o => Html.TooltipLink(string.Format("{0:N2}", o.Price),
                new
                {
                    data_id = o.ProductInventoryID,
                    data_toggle = "tooltipZestPrice",
                    data_placement = "top",
                    data_unique_id = Guid.NewGuid()
                },
                o.Price > 0, "ZestPrice"))
            .Titled("Price")
            .Sanitized(false)
            .Encoded(false)
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.GrossMarginPercent)
            .RenderValueAs(o => string.Format("{0:N2}", (o.GrossMarginPercent ?? 0)) + "% (" +
                string.Format("{0:N2}", o.GrossMarginValue) + ")")
            .Titled("Gross Margin")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.CompetitorDifference)
            .RenderValueAs(o => string.Format("{0:N2}", o.CompetitorDifference))
            .Titled("Difference")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.Lookup.LookupName)
            .Titled("Outcome")
            .Filterable(true)
            .SetFilterWidgetType("CustomOutcomeFilterWidget");

    if (HttpContext.Current.Request.Url.AbsoluteUri.Contains("PriceRule.RuleName__1__Null"))
    {
        columns.Add(o => o.ProductInventoryID, "PriceRule.RuleName")
                .Titled("Rule Name")
                .Filterable(true)
                .SetFilterWidgetType("CustomRuleNameFilterWidget")
                .RenderValueAs(o => "None");
    }
    else
    {
        columns.Add(o => o.PriceRule.RuleName)
                .Titled("Rule Name")
                .Filterable(true)
                .SetFilterWidgetType("CustomRuleNameFilterWidget")
                .RenderValueAs(x => x.PriceRule == null ? "None" : x.PriceRule.RuleName);
    }

}).WithPaging(200).Sortable().Named("comparisonGrid").Selectable(false).WithMultipleFilters().WithGridItemsCount()

@Html.Hidden("TooltipDataUrl", Url.Action("CompetitorsTooltipData", "Competitors"))
@Html.Hidden("TooltipDataZestPriceUrl", Url.Action("PriceHistoryTooltipData", "Products"))

@section scripts {
    <script type="text/javascript">
        $(function () {
            pageGrids.comparisonGrid.addFilterWidget(
                new DropDownListWidget("CustomBrandFilterWidget", "brandList", "/Shared/GetBrandNames", "brand")
            );
            pageGrids.comparisonGrid.addFilterWidget(
                new DropDownListWidget("CustomOutcomeFilterWidget", "outcomeList", "/Shared/GetCalculationOutcomes", "outcome")
            );
            pageGrids.comparisonGrid.addFilterWidget(
                new DropDownListWidget("CustomRuleNameFilterWidget", "priceRuleNameList", "/Shared/GetPriceRuleNames", "rule name")
            );

            pageGrids.comparisonGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.comparisonGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            $('[data-toggle="tooltip"]').click(function () { return false; });
            $('[data-toggle="tooltipZestPrice"]').click(function () { return false; });
            $('[data-toggle="tooltip"]').tooltip({ title: function () { return GetTooltipData($(this), $('#TooltipDataUrl').val()) }, html: true });
            $('[data-toggle="tooltipZestPrice"]').tooltip({ title: function () { return GetTooltipData($(this), $('#TooltipDataZestPriceUrl').val()) }, html: true });

        });


    </script>
}