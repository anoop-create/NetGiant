@using DP001Website.Models;
@using Microsoft.AspNet.Identity.EntityFramework;

@model UserRoleViewModel

<div id="userRoles">
    @Html.CheckBoxListFor(
        model => model.PostedRoles,
        model => Model.AllRoles.OrderBy(x => x.Name),
        entity => entity.Name,
        entity => entity.Name,
        model => Model.AllUserRoles,
        new MvcCheckBoxList.Model.HtmlListInfo(
            MvcCheckBoxList.Model.HtmlTag.vertical_columns,
            2,
            new { @class = "text-nowrap" }))
</div>
