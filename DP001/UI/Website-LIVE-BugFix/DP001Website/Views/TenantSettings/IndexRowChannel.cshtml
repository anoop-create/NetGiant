@using DP001BusinessLogic.ViewModels;
@model TenantSettingsViewModel

<td style="padding: 5px;">
    <i class="fa @(Model.ChannelEntry.ChannelID == Model.CurrentChannelID ? "fa-check-circle" : "")"></i>
</td>
<td style="padding: 5px;">
    @Html.DisplayFor(m => Model.ChannelEntry.ChannelName)
</td>
<td style="padding: 5px;">
    @( Model.ChannelEntry.IsActive == true ? "Yes" : "No")
</td>
<td width="40px">
    <i class="fa fa-chevron-down" />
</td>
