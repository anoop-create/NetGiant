@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using DP001Website.Models;
@using GridMvc.Html;
@model TenantAuditViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Audit Trail
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Audit Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "TenantAudit", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.TenantAuditList).Columns(columns =>
{
    columns.Add(x => x.Timestamp)
        .Titled("Date")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(x => x.Channel.ChannelName)
        .Titled("Channel Name")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(x => x.UserName)
        .Titled("User Name")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(x => x.Type)
        .RenderValueAs(x => x.TypeName)
        .Titled("Action")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(x => x.ObjectName)
        .Titled("Object")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .SetWidth(30)
            .Css("no-border")
            .RenderValueAs(d => @<span class="fa fa-eye invisible"></span>);


    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.TenantAuditID));

}).WithPaging(200).Sortable().Named("tenantAuditGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters().WithGridItemsCount()

@section scripts
{
    <script type="text/javascript">
        $(function () {

            pageGrids.tenantAuditGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            $(document).on('click', '.grid-wrap tbody > tr', function () {
                if ($(this).find('#x_TenantAuditID').length > 0) {
                    window.location.href = '@Url.Action("DisplayEntry")/' + $(this).find('#x_TenantAuditID').val();
                }
            })
        })
    </script>
}

