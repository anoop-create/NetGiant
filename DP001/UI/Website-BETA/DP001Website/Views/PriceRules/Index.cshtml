@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@using PagedList.Mvc;
@using DP001Website.Models;
@using GridMvc.Html;
@model PriceRuleViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                @if (Model.ReportConfiguration != null)
                {
                    <a href="/Suppliers/Inventory/" class="grey">Price Rules</a>
                    <i class="fa fa-chevron-right"></i>
                    <span id="reportName">@Model.ReportConfiguration.Name</span>
                }
                else
                {
                    @:<span id="reportName">Price Rules</span>
                }
            </h1>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
                <div class="btn-group g-m-r-10">
                    <label><b>Load Report</b></label>
                </div>
                <div class="btn-group bootstrap-select-container g-m-r-10">
                    @Html.DropDownListExtended("ReportConfiguration_ConfigurationValue",
                    Model.ReportConfigList,
                    new { @class = "reportSelectPicker selectpicker" },
                    Model.ReportConfiguration != null ? Model.ReportConfiguration.ConfigurationValue : "",
                    "Default (All)")
                </div>
                <div class="btn-group">
                    <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-sliders fa-lg"></i>
                        <i class="fa fa-caret-down"></i>
                    </button>
                    <ul class="dropdown-menu g-p-10">
                        <li class="g-fw-b">Price Rule Options</li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-plus\"></i> Add Rule", "New", "PriceRules", null, null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "PriceRules", null, new { onclick = "clearGridFilters();" })
                        </li>
                        <li role="presentation">
                            @Ajax.HtmlActionLink("<i class=\"fa fa-question\"></i> Test Price Rules <i id=\"repriceSpinner\" style=\"display: none\" class=\"fa fa-spinner fa-pulse\"></i>",
                                "TriggerBatchProcess",
                                "Shared",
                                new
                                {
                                    process = "calculateprices",
                                    channelId = ViewBag.channelId,
                                    attributes = "t$calculateprices,tt$" + ViewBag.tenantId.ToString() + ",ch$" + ViewBag.channelId.ToString() + ",dbg$1",
                                    runImmediately = true
                                },
                                new AjaxOptions
                                {
                                    HttpMethod = "POST",
                                    OnComplete = "repriceComplete"
                                },
                                null)
                        </li>
                        <li role="presentation">
                            @Ajax.HtmlActionLink("<i class=\"fa fa-calculator\"></i> Calculate Prices <i id=\"repriceSpinner2\" style=\"display: none\" class=\"fa fa-spinner fa-pulse\"></i>",
                         "TriggerBatchProcess",
                         "Shared",
                         new
                         {
                             process = "calculateprices",
                             channelId = ViewBag.channelId,
                             attributes = "t$calculateprices,tt$" + ViewBag.tenantId.ToString() + ",ch$" + ViewBag.channelId.ToString(),
                             runImmediately = true
                         },
                         new AjaxOptions
                         {
                             HttpMethod = "POST",
                             OnComplete = "repriceCompleteCalculatePrices"
                         },
                         null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-line-chart\"></i> Preview Test Results", "ComparisonStaging", "Reports", null, null)
                        </li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation" id="saveChangesContainer" class="@(!Model.UserCanModify ? "hide" : "")">
                            <a href="#" id="saveChanges"><i class="fa fa-floppy-o"></i> Save Changes</a>
                        </li>

                        <li role="presentation">
                            <a id="saveReportPopup" href="#"><i class="fa fa-floppy-o"></i> Save New Custom Report</a>
                        </li>
                        <li role="presentation">
                            <a href="@Url.Action("Manage", "Reports")"><i class="fa fa-cogs"></i> Manage Custom Reports</a>
                        </li>
                        <li role="presentation">
                            <a href="@Url.Action("Export", "PriceRules", new { filter = "~", sort = "~", columns = "~" })" id="exportToExcel"><i class="fa fa-upload"></i> Export Rules</a>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>
</section>

@if (Model.ReportConfiguration == null)
{
    @(Html.Kendo().Grid<PriceRuleViewModel.Telerik>()
            .Name("priceRulesGrid")
            .HtmlAttributes(new { @class = "pointer-rows" })
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(read => read.Action("Index_Read", "PriceRules"))
                .PageSize(200)
                )
            .Columns(columns =>
            {
                columns.Bound(rule => rule.RuleName).Width(200).Title("Rule Name");
                columns.Bound(rule => rule.RuleType).Width(120).Title("Rule Type").Filterable(filterable => filterable.UI("ruleTypeFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/PriceRules/GetRuleTypes/" });
                columns.Bound(rule => rule.Banding).Width(100).Title("Banding");
                columns.Bound(rule => rule.Method).Width(180).Title("Method").Filterable(filterable => filterable.UI("methodFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/PriceRules/GetMethods/" });
                columns.Bound(rule => rule.CategoryName).Width(250).Title("Category").Filterable(filterable => filterable.UI("categoryFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/PriceRules/GetCategories/" });
                columns.Bound(rule => rule.BrandName).Width(150).Title("Brand").Filterable(filterable => filterable.UI("brandFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/PriceRules/GetBrands/" });
                columns.Bound(rule => rule.ProductName).Width(200).Title("Product");
                columns.Bound(rule => rule.ProductCount).Width(150).Title("Product Count");
                //columns.Bound(rule => rule.IsTest).Width(100).Title("Test");
                columns.Bound(rule => rule.Active).Width(100).Title("Active");
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable
                .AllowUnsort(true))
            .Groupable()
            .Scrollable()
            .Filterable(ftb => ftb
                .Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .Excel(excel => excel
                .AllPages(true)
                .FileName("Grid Export")
                .Filterable(true)
                .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
            .Events(events => events.Change("Grid_OnRowSelect"))
            .Selectable()
            .NoRecords("There are no items to display")

    //.Mobile()
    )
}
else
{
    <div id="loading" class="text-center g-m-t-40">
        <i class="fa fa-spinner fa-pulse fa-3x fa-fw"></i>
    </div>
    <div id="grid"></div>
}

<!-- Modal -->
@{ Html.RenderPartial("~/Views/Reports/SaveNewReportModal.cshtml", Model.ReportSecurityList); }

@Html.Hidden("ReportConfigId", Model.ReportConfiguration?.ReportConfigurationId)

@section scripts
{
    <script type="text/javascript">

        $(function () {
            $('#loading').remove();
            @if (Model.ReportConfiguration != null)
            {
                <text>
                    $("#priceRulesGrid").kendoGrid();
                    var grid = $("#priceRulesGrid").data("kendoGrid");
                    grid.bind("dataBound", grid_dataBound);

                    var config = @Html.Raw(Model.ReportConfiguration.ConfigurationValue);
                    setupGridFilters(config);
                    grid.setOptions(config);
                    setGridHeaderTitleTags();
                    resizeGrid();
                </text>
            }
            else
            {
                <text>
                    var grid = $("#priceRulesGrid").data("kendoGrid");
                    grid.bind("dataBound", grid_dataBound);
                </text>
            }

            $("#ReportConfiguration_ConfigurationValue").change(function (e) {
                e.preventDefault();
                changeCurrentReport('/PriceRules/Index/', this, grid);
            });

            $("#saveReportPopup").click(function () {
                $('#saveReportModal').modal('show');
            });

            $("#saveReport").click(function (e) {
                e.preventDefault();
                var reportDescription = $("#reportDescription").val();
                var reportSecurity = $("#Security").val();
                saveNewReport(reportDescription, reportSecurity, JSON.stringify(grid.getOptions()), 'Price Rules', '/PriceRules/Index/');
            });

            $("#saveChanges").click(function (e) {
                e.preventDefault();
                saveReportChanges($('#ReportConfigId').val(), JSON.stringify(grid.getOptions()));
            });

            function grid_dataBound(e) {
                saveGridFilters();
                updateFilterDropDowns();
            }
        });

        $(function() {
            checkJobInProgress('');
        });

        var Grid_OnRowSelect = function (e) {
            var data = this.dataItem(this.select());
            window.location.href = '@Url.Action("Edit")/' + data.PriceRuleId;
        }

    </script>
}

