@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@model FtpSettingViewModel

@{
    string fieldnumber = "";
    foreach (CustomField cf in Model.CustomFieldList)
    {
        fieldnumber = cf.DBFieldName.Substring(cf.DBFieldName.Length - 1);
        <div class="col-md-2 form-name">
            <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="(Mandatory) Please enter the column heading that identifies the @cf.UserFieldName custom field." data-helpsid="2" data-helpeid="2"></i>
            @cf.UserFieldName
        </div>
        <div class="col-md-4 form-value">
            @switch (fieldnumber)
            {
                case "1":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField1)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField1, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "2":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField2)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField2, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "3":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField3)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField3, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "4":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField4)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField4, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "5":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField5)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField5, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "6":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField6)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField6, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "7":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField7)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField7, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "8":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField8)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField8, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "9":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField9)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField9, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
                case "0":
                    @Html.ValidationMessageFor(x => x.FTPSettingEntry.FieldMapping.CustomField10)
                    @Html.TextBoxFor(x => x.FTPSettingEntry.FieldMapping.CustomField10, new { aria_required = "true", data_val = "true", data_val_required = "The " + cf.UserFieldName + " field is required." })
                    break;
            }
        </div>


    }
}
