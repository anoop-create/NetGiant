@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using GridMvc.Html;
@using DP001Website.Models;
@model TenantSettingsViewModel

@{
    ViewBag.Title = "Client Counts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Client Counts
            </h1>
        </div>

    </div>
</section>

@(Html.Kendo().Grid<TenantSettingsViewModel.ClientCounters>()
        .Name("clientCountsGrid")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Read(read => read.Action("ClientCounts_Read", "Account"))
            .PageSize(200)
            )
        .Columns(columns =>
        {
            columns.Bound(supplier => supplier.ClientName).Width(100).Title("Client Name");
            columns.Bound(supplier => supplier.Email).Width(300).Title("Email");
            columns.Bound(supplier => supplier.ContractName).Width(150).Title("Contract Name");
            columns.Bound(supplier => supplier.InventoryCount).Width(180).Title("Inventory Count").ClientTemplate("#= InventoryCount # / #= InventoryLimit #");
            columns.Bound(supplier => supplier.PriceRuleCount).Width(200).Title("Price Rule Count").ClientTemplate("#= PriceRuleCount # / #= PriceRuleLimit #");
            columns.Bound(supplier => supplier.ChannelCount).Width(180).Title("Channel Count").ClientTemplate("#= ChannelCount # / #= ChannelLimit #");
            columns.Bound(supplier => supplier.ScheduleCount).Width(100).Title("Schedule Count").ClientTemplate("#= ScheduleCount # / #= ScheduleLimit #");
            columns.Bound(supplier => supplier.UserCount).Width(100).Title("User Count").ClientTemplate("#= UserCount # / #= UserLimit #");
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable
            .AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(ftb => ftb
            .Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .Excel(excel => excel
            .AllPages(true)
            .FileName("Grid Export")
            .Filterable(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
        .NoRecords("There are no items to display")
        .Events(e => e.DataBound("saveGridFilters"))
)

