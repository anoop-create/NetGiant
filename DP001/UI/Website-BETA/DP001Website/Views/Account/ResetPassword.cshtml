@using DP001Website.Models;
@using Microsoft.AspNet.Identity.EntityFramework;

@model DP001Website.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Reset User Password
            </h1>
        </div>
    </div>
</section>

<section class="container-fluid">
    <div class="row">
        <div class="col-sm-12 col-md-8 col-md-push-2">
            <div class="row page-form" style="margin-top: 50px;">
                @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    <div class="form-horizontal page-form">
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        @Html.HiddenFor(model => model.Code)
                        <div class="container-fluid g-m-b-20">
                            <div class="row">
                                <div class="col-md-2 form-name">
                                    <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Your registered email address" data-helpsid="2" data-helpeid="2"></i>
                                    Email Address
                                </div>
                                <div class="col-md-4 form-value">
                                    @Html.ValidationMessageFor(x => x.Email)
                                    @Html.EditorFor(x => x.Email)
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-2 form-name">
                                    <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter your new password" data-helpsid="2" data-helpeid="2"></i>
                                    Password
                                </div>
                                <div class="col-md-4 form-value">
                                    @Html.ValidationMessageFor(x => x.Password)
                                    @Html.EditorFor(x => x.Password)
                                </div>
                                <div class="col-md-2 form-name">
                                    <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Confirm your new password" data-helpsid="2" data-helpeid="2"></i>
                                    Confirm Password
                                </div>
                                <div class="col-md-4 form-value">
                                    @Html.ValidationMessageFor(x => x.ConfirmPassword)
                                    @Html.EditorFor(x => x.ConfirmPassword)
                                </div>
                            </div>
                        </div>

                        <div class="container-fluid g-m-b-20">
                            <div class="row">
                                <div class="form-actions">
                                    <div class="pull-left form-message">
                                        <i class="fa fa-spinner fa-pulse" style="display: none"></i>
                                        <span></span>
                                    </div>

                                    @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Cancel",
                                    "ListUsers",
                                    "Account",
                                    new { },
                                    new
                                    {
                                        @class = "pull-right g-m-r-10 form-delete btn btn-default btn-sm"
                                    })
                                    <button type="submit" class="pull-right g-m-r-10 btn btn-default btn-sm" value="Save" name="action:Save">
                                        <i class="fa fa-floppy-o"></i> Save
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

