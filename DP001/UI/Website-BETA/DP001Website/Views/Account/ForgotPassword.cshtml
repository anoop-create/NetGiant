@model DP001Website.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot your password?";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1>
                <a href="@Url.Action("Index", "Home")">
                    <i class="fa fa-home"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Forgot Password
            </h1>
        </div>
    </div>
</section>

<section class="container-fluid" style="padding-top: 130px;">
    <div class="row">
        <div class="col-sm-12 col-md-8 col-md-push-2">
            <div class="row page-form">
                <div class="container-fluid">
                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-m-t-20">
                            <div class="col-md-2 form-name">
                                <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter the email address you use to sign into Priceology. We will then send you a link to reset your password" data-helpsid="2" data-helpeid="2"></i>
                                Enter your email.
                            </div>
                            <div class="col-md-4 form-value">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control g-m-r-10" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-actions">
                                <button type="submit" class="pull-right g-m-r-10 btn btn-default btn-sm" value="Submit">
                                    <i class="fa fa-floppy-o"></i> Send
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script type="text/javascript">
        $(function () {
            $('.selectpicker').selectpicker();
        });
    </script>
}
