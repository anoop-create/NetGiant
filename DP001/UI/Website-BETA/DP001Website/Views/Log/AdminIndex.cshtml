@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using GridMvc.Html;
@using DP001Website.Models;
@model LogViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Error Log
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Log Options</li>
                    <li role="presentation" class="divider"></li>
                </ul>
            </div>
        </div>
    </div>
</section>

@(Html.Kendo().Grid<LogViewModel.Telerik>()
        .Name("adminGrid")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Read(read => read.Action("AdminIndex_Read", "Log"))
            .PageSize(200)
            )
        .Columns(columns =>
        {
            columns.Bound(log => log.LogId).Width(100).Title("Log ID");
            columns.Bound(log => log.JobId).Width(100).Title("Job ID");
            columns.Bound(log => log.TenantId).Width(100).Title("Tenant");
            columns.Bound(log => log.ChannelId).Width(100).Title("Channel");
            columns.Bound(log => log.LogType).Width(120).Title("Log Type");
            columns.Bound(log => log.LogDateTime).Width(150).Title("Date/Time");
            columns.Bound(log => log.Description).Width(1000).Title("Description");
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable
            .AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(ftb => ftb
            .Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .Excel(excel => excel
            .AllPages(true)
            .FileName("Grid Export")
            .Filterable(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
        .NoRecords("There are no items to display")
        .Events(e => e.DataBound("saveGridFilters"))
)

