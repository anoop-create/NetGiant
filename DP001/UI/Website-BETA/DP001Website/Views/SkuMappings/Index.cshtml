@using DP001BusinessLogic.ViewModels;
@using DP001Website.Models;
@using DP001DataAccess.Entities;
@using GridMvc.Html;
@model SkuMappingViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.SupEx = Model.ProductInventoryCount - Model.SupplierExceptionCount;
    ViewBag.ComEx = Model.ProductInventoryCount - Model.CompetitorExceptionCount;
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-7 col-lg-5 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Product Mappings
            </h1>
        </div>

        <div class="col-lg-5 sub-menu-info-container g-bg-orange visible-lg">
            <div class="container-fluid">
                <div class="row vertical-center">
                    <div class="col-lg-7">
                        <div class="row">
                            <div class="col-lg-6 sub-menu-highlight g-fc-white">
                                <div class="text-center">Product Inventory (@String.Format("{0:n0}", Model.ProductInventoryCount))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("Index", "Products")" role="button">View Inventory</a>
                                </div>
                            </div>
                            <div class="col-lg-6 sub-menu-highlight g-fc-white">
                                <div class="text-center">Supplier Matches (@ViewBag.SupEx.ToString("N0"))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("SupplierExceptions")" role="button">View Exceptions (@Model.SupplierExceptionCount.ToString("N0"))</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="row">
                            <div class="col-lg-9 sub-menu-highlight g-fc-white" style="border: none;">
                                <div class="text-center">Competitor Matches (@ViewBag.ComEx.ToString("N0"))</div>
                                <div class="vertical-center">
                                    <a class="btn btn-default" href="@Url.Action("CompetitorExceptions")" role="button">View Exceptions (@Model.CompetitorExceptionCount.ToString("N0"))</a>
                                </div>
                            </div>
                            <div class="col-lg-3 sub-menu-highlight g-fc-white dash-img vertical-center">
                                <i class="fa fa-chain fa-3x"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xs-5 col-lg-2 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Report Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "SkuMappings", null, new { onclick = "clearGridFilters();" })
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-exclamation\"></i> View Supplier Exceptions", "SupplierExceptions", "SkuMappings", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-exclamation\"></i> View Competitor Exceptions", "CompetitorExceptions", "SkuMappings", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>


@(Html.Kendo().Grid<SkuMappingViewModel.TelerikSkuMappings>()
        .Name("skuMappingsGrid")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Read(read => read.Action("Index_Read", "SkuMappings"))
            .PageSize(200)
            )
        .Columns(columns =>
        {
            columns.Bound(skuMapping => skuMapping.MappingType).Title("Mapping Type").Filterable(filterable => filterable.UI("mappingTypeFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/SkuMappings/GetMappingTypes/" });
            columns.Bound(skuMapping => skuMapping.SupplierCompetitorName).Title("Supplier/Competitor").Filterable(filterable => filterable.UI("supplierCompetitorFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/SkuMappings/GetSupplierCompetitors/" });
            columns.Bound(skuMapping => skuMapping.ProductName).Title("Product Name");
            columns.Bound(skuMapping => skuMapping.BrandName).Title("Brand").Filterable(filterable => filterable.UI("brandFilter").Extra(false)).HeaderHtmlAttributes(new { data_url = "/SkuMappings/GetBrands/" });
            columns.Bound(skuMapping => skuMapping.Mfpn).Title("Part Number");
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable
            .AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(ftb => ftb
            .Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .Excel(excel => excel
            .AllPages(true)
            .FileName("Grid Export")
            .Filterable(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
        .Events(events => events.Change("Grid_OnRowSelect").DataBound("saveGridFilters"))
        .Selectable()
)


@section scripts
{
    <script type="text/javascript">

        var Grid_OnRowSelect = function (e) {
            var data = this.dataItem(this.select());
            window.location.href = '@Url.Action("EditSkuMapping")/' + data.SkuMappingId;
        }

    </script>
}
