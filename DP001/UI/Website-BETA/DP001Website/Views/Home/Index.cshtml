@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1>
                <a href="@Url.Action("Index", "Home")">
                    <i class="fa fa-home"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Optimised Pricing Software
            </h1>
        </div>
    </div>
</section>

<section class="container-fluid">
    <div class="row col-md-6 col-md-push-3 text-center" style="padding-bottom: 100px;">
        <h2>The Challenge</h2>
        Ecommerce has enjoyed incredible growth in recent years and as a result most market sectors are becoming commoditised.

        As a result every retailer has the challenge to optimise their online pricing, ensuring they remain competitive but also maximising their gross margin %.

        <h2>Our Solution</h2>
        Combine all data that contributes to the costing of a product and create a rules based solution to dynamically optimise selling price many times per day.
    </div>
</section>
