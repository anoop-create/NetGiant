@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@using PagedList.Mvc;
@using DP001Website.Models;
@using GridMvc.Html;
@model LookupViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Lookups
            </h1>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
                <div class="btn-group">
                    <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-sliders fa-lg"></i>
                        <i class="fa fa-caret-down"></i>
                    </button>
                    <ul class="dropdown-menu g-p-10">
                        <li class="g-fw-b">Price Rule Options</li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-plus\"></i> Add Lookup", "New", "Lookup", null, null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-plus\"></i> Add Lookup Type", "NewType", "Lookup", null, null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "Lookup", null, null)
                        </li>

                        @*<li role="presentation">
                                @Html.HtmlActionLink("<i class=\"fa fa-download\"></i> Import Rules", "ImportRules", "PriceRules", null, null)
                            </li>*@
                    </ul>
                </div>
            </div>
        }
    </div>
</section>

<div class="row">
    <div id="lookup-type" class="col-md-4">
        <h3>
            Lookup Types
            <a href="/Lookup/NewType/"><button class="g-cur-p btn btn-default btn-sm"><i class="fa fa-plus"></i> Add Lookup Type</button></a>
        </h3>
        @Html.Grid(Model.LookupTypeList).Columns(columns =>
   {

   columns.Add(x => x.LookupTypeName)
       .Titled("Type")
       .Filterable(true)
       .SetFilterWidgetType("CustomTextFilterWidget");

   columns.Add()
       .Encoded(false)
       .Sanitized(false)
       .SetWidth(30)
       .Css("no-border")
       .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

   columns.Add()
      .Encoded(false)
      .Sanitized(false)
      .SetWidth(30)
      .Css("no-border")
      .RenderValueAs(d => @<span class="fa fa-filter invisible"></span>);

    columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("hidden")
        .RenderValueAs(x => Html.HiddenFor(y => x.LookupTypeID));

   }).WithPaging(200).Sortable().Named("LookupTypeGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters()
    </div>

    <div id="lookup" class="col-md-2"></div>

    <div id="lookup" class="col-md-6">
        <h3>
            Lookups
            <a href="/Lookup/New/"><button class="g-cur-p btn btn-default btn-sm"><i class="fa fa-plus"></i> Add Lookup</button></a>
        </h3>
        @Html.Grid(Model.LookupList).Columns(columns =>
       {

       columns.Add(x => x.LookupType.LookupTypeName)
           .Titled("Type")
           .Filterable(true)
           .SetFilterWidgetType("CustomTextFilterWidget");

       columns.Add(x => x.LookupName)
           .Titled("Name")
           .Filterable(true)
           .SetFilterWidgetType("CustomTextFilterWidget");

       columns.Add()
           .Encoded(false)
           .Sanitized(false)
           .SetWidth(30)
           .Css("no-border")
           .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

           columns.Add()
               .Encoded(false)
               .Sanitized(false)
               .Css("hidden")
               .RenderValueAs(x => Html.HiddenFor(y => x.LookupID));

       }).WithPaging(200).Sortable().Named("LookupGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters()
    </div>
</div>


@section scripts
{
    <script type="text/javascript">
        $(function () {

            checkJobInProgress('');

            pageGrids.LookupGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.LookupGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            pageGrids.LookupTypeGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.LookupTypeGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            $(document).on('click', '#lookup-type .grid-wrap tbody > tr .fa-pencil-square-o, #lookup-type .grid-wrap tbody > tr > td[data-name="LookupTypeName"]', function () {
                if ($(this.closest('tr')).find('#x_LookupTypeID').length > 0) {
                    window.location.href = '@Url.Action("EditType")/' + $(this.closest('tr')).find('#x_LookupTypeID').val();
                }
            })

            $(document).on('click', '#lookup-type .grid-wrap tbody > tr .fa-filter', function () {
                window.location.href = '@Url.Action("")/?grid-filter=LookupType.LookupTypeName__1__' + $(this.closest('tr')).find('[data-name="LookupTypeName"]').text();
            })

            $(document).on('click', '#lookup .grid-wrap tbody > tr', function () {
                if ($(this).find('#x_LookupID').length > 0) {
                    window.location.href = '@Url.Action("Edit")/' + $(this).find('#x_LookupID').val();
                }
            })
        })
    </script>
}

