@using DP001Website.Models;
@using System.Web.Mvc;
@using System.Web.Mvc.Html;
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Priceology - Optimised Pricing Software</title>
    <link href="~/Content/images/favicon.ico" rel="icon" type="image/x-icon" />
    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/saas.css")" rel="stylesheet" type="text/css" />
</head>
<body class="">
    <header>
        <nav class="navbar navbar-fixed-top" role="navigation">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-links" aria-expanded="false">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="fa fa-bars"></span>
                    </button>
                    <div class="g-m-r-20 brand-text">
                        &nbsp;
                        <a href="/"></a>
                    </div>
                </div>
                <div class="navbar-collapse collapse" id="navbar-links">
                    @*<ul class="nav navbar-left text-nowrap nav-justified">
                        <li role="presentation"><a href="#">Features</a></li>
                        <li role="presentation"><a href="#">Prices</a></li>
                        <li role="presentation"><a href="#">Contact Us</a></li>
                    </ul>*@
                    <ul class="nav navbar-nav navbar-right">
                        <li class="">
                            <div class="btn-group">
                                <button type="button" class="btn btn-header dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fa fa-user fa g-m-r-10"></i>
                                    <i class="fa fa-caret-down"></i>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><a href="@Url.Action("Login", "Account")">Login</a></li>
                                    @*<li><a href="@Url.Action("Register", "Account")">Register</a></li>*@
                                </ul>
                            </div>
                        </li>
                        @*<li class="">
                            <button class="btn btn-header">
                                <a href="@Url.Action("Index", "Help")">
                                    <i class="fa fa-question"></i>
                                </a>
                            </button>
                        </li>*@
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

    <footer class="container-fluid">
        <p class="text-center">Copyright &copy; @DateTime.Now.Year <span class="brand-text"></span></p>
    </footer>

    @Scripts.Render("~/bundles/alljs")
    @RenderSection("scripts", required: false)

</body>
</html>