@using GridMvc.Columns
@model GridMvc.IGrid
@if (Model == null) { return; }
@if (Model.RenderOptions.RenderRowsOnly)
{
    @RenderGridBody();
}
else
{
   if (Model.RenderOptions.ShowGridItemsCount)
    {
        <span class="grid-itemscount-caption visible-md visible-lg">(@Model.ItemsCount.ToString("N0") items)</span>
    }
    <section class="grid-mvc" data-lang="@Model.Language" data-gridname="@Model.RenderOptions.GridName" data-selectable="@Model.RenderOptions.Selectable.ToString().ToLower()" data-multiplefilters="@Model.RenderOptions.AllowMultipleFilters.ToString().ToLower()">
        <div class="grid-wrap">
            <table class="table table-hover grid-table sticky-header">
                @* Draw grid header *@
                <thead class="">
                    @RenderGridHeader()
                    @{
                        if (ViewBag.MvcGridAddRow != null && User.IsInRole("Administrator"))
                        {
                            <tr style="background-color: #ffffff">
                                <td colspan="100%">@ViewBag.MvcGridAddRow</td>
                            </tr>
                        }
                    }
                </thead>
                
                <tbody>                   
                    @RenderGridBody()
                </tbody>
            </table>
            @RenderGridFooter()
        </div>
    </section>
}
@helper RenderGridBody()
{
    if (!Model.ItemsToDisplay.Any())
    {
        <tr class="grid-empty-text">
            <td colspan="@(Model.Columns.Count())">
                @Model.EmptyGridText
            </td>
        </tr>
    }
    else
    {
        foreach (object item in Model.ItemsToDisplay)
        {
            <tr class="grid-row @Model.GetRowCssClasses(item)">
                @foreach (IGridColumn column in Model.Columns)
                {
                    @column.CellRenderer.Render(column, column.GetCell(item))
                }
            </tr>
        }
    }
}
@helper RenderGridHeader()
{
    <tr>
        @foreach (IGridColumn column in Model.Columns)
        {
            @column.HeaderRenderer.Render(column)
        }
    </tr>
}
@helper RenderGridFooter()
{
    <div class="grid-footer text-center">
        @if (Model.EnablePaging && Model.Pager != null)
        {
            @Html.Partial(Model.Pager.TemplateName, Model.Pager)
        }
    </div>
}