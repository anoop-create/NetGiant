@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using DP001Website.Models;
@using GridMvc.Html;
@model SupplierViewModel
@{
    ViewBag.Title = "Mfpn Aliases";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                <a href="@Url.Action("Main", "TenantSettings")" class="grey">
                    Main Settings
                </a>
                <i class="fa fa-chevron-right"></i>
                Supplier Part No. Aliases
            </h1>
        </div>


        @if (User.IsInRole("Administrator"))
        {
            <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
                <div class="btn-group">
                    <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-sliders fa-lg"></i>
                        <i class="fa fa-caret-down"></i>
                    </button>
                    <ul class="dropdown-menu g-p-10">
                        <li class="g-fw-b">MfPN Alias Options</li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "MfpnAliases", "Suppliers", null, null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-plus\"></i> Add Part No. Alias", "NewMfpnAlias", "Suppliers", null, null)
                        </li>
                    </ul>
                </div>
            </div>
        }

    </div>
</section>

@Html.Grid(Model.MfpnAliases).Columns(columns =>
{
    columns.Add(o => o.BrandName)
        .Titled("Brand Name")
        .Filterable(true)
        .SetFilterWidgetType("CustomBrandFilterWidget"); ;

    columns.Add(o => o.MatchTerm)
        .Titled("Match Term")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Lookup.LookupName)
        .Titled("Type")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .SetWidth(30)
            .Css("no-border")
            .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.SupplierMfpnMatchingID));


}).WithPaging(200).Sortable().Named("mfpnAliasesGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters()

@section scripts {
    <script type="text/javascript">
        $(function () {
            pageGrids.mfpnAliasesGrid.addFilterWidget(
                new DropDownListWidget("CustomBrandFilterWidget", "brandList", "/Shared/GetBrandNames")
            );

            pageGrids.mfpnAliasesGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            $(document).on('click', '.grid-wrap tbody > tr', function () {
                if ($(this).find('#x_SupplierMfpnMatchingID').length > 0) {
                    window.location.href = '@Url.Action("EditMfpnAlias")/' + $(this).find('#x_SupplierMfpnMatchingID').val();
                }
            })

        });
    </script>
}

