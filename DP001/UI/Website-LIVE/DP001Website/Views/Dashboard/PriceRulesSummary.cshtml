@using DP001BusinessLogic.ViewModels;
@model DashboardViewModel.Dash1

<div class="col-xs-12 col-md-6 col-lg-3 dashlet">
    <div class="g-bg-pink row">
        <div class="col-xs-8">
            <h4><i class="fa fa-question-circle-o fa-lg help-popup g-m-r-10" data-toggle="tooltip" title="A summary of how many rules are assigned to the current channel, how many products have rules and those that do not." data-helpsid="2" data-helpeid="2"></i>Price Rules Summary</h4>
            <div class="pull-left col-xs-12">
                <div data-toggle="tooltip" title="There are @Model.PriceRuleCount.ToString("N0") price rules assigned to the current channel, click here to view price rules." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("Index", "PriceRules")">Number of Price Rules</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("Index", "PriceRules")">@Model.PriceRuleCount.ToString("N0")</a></div>
                </div>
                <div data-toggle="tooltip" title="There are @Model.ProductRuleCount.ToString("N0") products with price rules, click here to view all products with rules applied." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("Comparison", "Reports")?rn=yes">Products With Rules</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("Comparison", "Reports")?rn=yes">@Model.ProductRuleCount.ToString("N0")</a></div>
                </div>
                <div data-toggle="tooltip" title="There are @((Model.ProductInventoryCount - Model.ProductRuleCount).ToString("N0")) products without any price rules, click here to view all products without rules applied." class="help-popup clearfix">
                    <div class="pull-left dash-lablel text-right col-xs-8"><a href="@Url.Action("Comparison", "Reports")?rn=no">Products Without Rules</a></div>
                    <div class="pull-left dash-value text-left col-xs-4"><a href="@Url.Action("Comparison", "Reports")?rn=no">@((Model.ProductInventoryCount - Model.ProductRuleCount).ToString("N0"))</a></div>
                </div>
            </div>
        </div>
        <div class="col-xs-4 dash-img">
            <i class="fa fa-calculator fa-4x"></i>
        </div>
    </div>
</div>
