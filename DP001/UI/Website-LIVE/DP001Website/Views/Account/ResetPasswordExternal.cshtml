@using DP001Website.Models;
@using Microsoft.AspNet.Identity.EntityFramework;

@model DP001Website.Models.ResetPasswordViewModel

@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Reset Password
            </h1>
        </div>
    </div>
</section>
<section class="container-fluid" style="padding-top: 130px;">
    <div class="row">
        <div class="col-sm-12 col-md-8 col-md-push-2">
            <div class="row page-form">
                <div class="container-fluid">
                    @using (Html.BeginForm("ResetPasswordExternal", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.ValidationSummary("", new { @class = "text-danger" })
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Code)
                        <div class="row g-m-t-20">
                            <div class="col-md-2 form-name">
                                <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter your Priceology email" data-helpsid="2" data-helpeid="2"></i>
                                Email
                            </div>
                            <div class="col-md-4 form-value">
                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control g-m-r-10" })
                            </div>
                        </div>
                        <div class="row g-m-t-20">
                            <div class="col-md-2 form-name">
                                <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter the new password you would like to use" data-helpsid="2" data-helpeid="2"></i>
                                Password
                            </div>
                            <div class="col-md-4 form-value">
                                @Html.PasswordFor(m => m.Password, new { @class = "form-control g-m-r-10" })
                            </div>
                        </div>
                        <div class="row g-m-t-20">
                            <div class="col-md-2 form-name">
                                <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Confirm the new password you would like to use" data-helpsid="2" data-helpeid="2"></i>
                                Confirm Password
                            </div>
                            <div class="col-md-4 form-value">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control g-m-r-10" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 form-actions">
                                <button type="submit" class="pull-right g-m-r-10 btn btn-default btn-sm" value="Submit">
                                    <i class="fa fa-floppy-o"></i> Reset
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
