@section Scripts {
    <script type="text/javascript">
        var optionsArray;

        $(document).on("click", ".lnkDeleteRole", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#roRoleDialog", $("#RoleDeleteURL").val(), $(this).attr("value"),
                "#roDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //Role Name
        }

    </script>
}