@using DP001Website.Models;
@using DP001Website.Models;
@using GridMvc.Html;

@*@model List<ApplicationUser>*@
@model UserViewModel

@Html.Hidden("UserDeleteURL", Url.Action("DeleteUser", "Account"))

@{
    ViewBag.Title = "User List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Users
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Users Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-user\"></i> Add User", "CreateUser", "Account", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.AllUsers).Columns(columns =>
{

columns.Add(x => x.AppUser.UserName)
    .Titled("User Name")
    .Filterable(true)
    .SetFilterWidgetType("CustomTextFilterWidget");

columns.Add(x => x.AppUser.Email)
    .Titled("Email Address")
    .Filterable(true)
    .SetFilterWidgetType("CustomTextFilterWidget");

columns.Add(x => x.Tenant.TenantID)
    .Titled("Tenant ID")
    .Filterable(true)
    .SetFilterWidgetType("CustomNumberFilterWidget");

columns.Add()
    .RenderValueAs(x =>
        Html.ActionLink("Reset Password", "ResetPassword", "Account", new { email = x.AppUser.Email }, null) + " | " +
        Html.ActionLink("Manage Roles", "ListUserRoles", "Account", new { email = x.AppUser.Email }, null) + " | " +
        Ajax.HtmlActionLink("Delete User",
            "DeleteUser",
            "Account",
            new { id = x.AppUser.Id },
            new AjaxOptions()
            {
                HttpMethod = "DELETE",
                Confirm = "Are you sure you want to delete this user?",
                OnSuccess = "deleteComplete"
            },
            new
            {
                @class = "lnkDeleteUser"
            })
        )
    .Encoded(false)
    .Sanitized(false)
    .Titled("Actions")
    .Filterable(true);

columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .SetWidth(30)
        .Css("no-border")
        .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.AppUser.Id));

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.AppUser.Email));

}).WithPaging(200).Sortable().Named("usersGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters()

@section Scripts{
    <script type="text/javascript">
        $(function () {

            pageGrids.usersGrid.addFilterWidget(
                    new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.usersGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            $(document).on('click', '.lnkDeleteUser', function () {
                var userId = $(this).attr('value');

                $('#roUserDialog').dialog({
                    resizable: false,
                    width: 600,
                    modal: true,
                    buttons: {
                        "Delete": function () {
                            window.location = $('#UserDeleteURL').val() + "/" + userId;
                        }
                    }
                });
            });
        });

        function deleteComplete(data) {
            if (data) {
                window.location = '@Url.Action("ListUsers")';
            }
        }

    </script>
}