@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using GridMvc.Html;
@using DP001Website.Models;
@model CompetitorViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Competitor Inventory
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Competitor Inventory Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Inventory", "Competitors", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-upload\"></i> Export Competitor Products", "ExportToExcel", "Competitors", null, null)
                    </li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-wrench\"></i> Inventory Exclusions", "Index", "ProviderExclusion", null, null)
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.InventoryList).Columns(columns =>
{
    columns.Add(o => o.ManufacturerPartNo)
            .Titled("Part Number")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ClientProductID)
        .Titled("Prod ID")
        .Filterable(true)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ProductInventory.Description)
        .RenderValueAs(x => Html.HtmlActionLink(x.ProductInventory != null ? x.ProductInventory.Description : "", "ProductDetail", "Products", new { id = x.ProductInventoryFK }, null))
        .Titled("Product Name")
        .Filterable(true)
        .Sanitized(false)
        .Encoded(false)
        .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Brand.BrandName)
            .Titled("Brand")
            .Filterable(true)
            .SetFilterWidgetType("CustomBrandFilterWidget");

    columns.Add(o => o.OriginalBrand)
            .Titled("Original Brand")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.Price)
            .RenderValueAs(x => x.Price.ToString("N2"))
            .Titled("Price")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.Competitor.CompetitorName)
            .Titled("Competitor Name")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.DateLastUpdated)
        .Format("{0:dd/MM/yyyy (HH:mm)}")
        .Titled("Date Updated");

    columns.Add()
        .Titled("Exclude")
        .Encoded(false)
        .Sanitized(false)
        .SetWidth(50)
        .RenderValueAs(d => @<i class="fa fa-times invisible exclCompetitorInv" style="cursor: pointer;"></i>);

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.CompetitorFK));

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.Brand.BrandName));

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.ManufacturerPartNo));

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.ClientProductID));

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.CompetitorInventoryID));

}).WithPaging(200).Sortable().Named("competitorsGrid").Selectable(false).WithMultipleFilters().WithGridItemsCount()

@section scripts {
    <script type="text/javascript">
        $(function () {

            $(document).on('click', '.exclCompetitorInv', function () {
                var clickedItem = $(this);
                $.confirm({
                    title: 'Exclude from inventory',
                    content: 'Are you sure you want to exclude this item from the Competitor Inventory?',
                    confirm: function () {
                        excludeItemFromInventory(clickedItem);
                    },
                    cancel: function () {
                        clickedItem.prop("checked", false);
                    }
                });                
            });

            pageGrids.competitorsGrid.addFilterWidget(
                new DropDownListWidget("CustomBrandFilterWidget", "brandList", "/Shared/GetBrandNames", "brand")
            );

            pageGrids.competitorsGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.competitorsGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            $('.grid-header-title > span:contains("Exclude")').closest('th').attr('title', 'Click the \'x\' to exclude this record\n from the Competitor Inventory');
        });       
    </script>
}

