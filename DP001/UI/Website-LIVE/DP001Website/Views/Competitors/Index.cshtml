@using DP001BusinessLogic.ViewModels;
@using PagedList.Mvc;
@using GridMvc.Html;
@using DP001Website.Models;
@model CompetitorViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                <a href="@Url.Action("Main", "TenantSettings")" class="grey">
                    Main Settings
                </a>
                <i class="fa fa-chevron-right"></i>
                Competitors
            </h1>
        </div>

        <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
            <div class="btn-group">
                <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fa fa-sliders fa-lg"></i>
                    <i class="fa fa-caret-down"></i>
                </button>
                <ul class="dropdown-menu g-p-10">
                    <li class="g-fw-b">Competitor Inventory Options</li>
                    <li role="presentation" class="divider"></li>
                    <li role="presentation">
                        @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "Competitors", null, null)
                    </li>
                    <li role="presentation">
                        @Ajax.HtmlActionLink("<i class=\"fa fa-upload\"></i> Load Inventories <i id=\"repriceSpinner\" style=\"display: none\" class=\"fa fa-spinner fa-pulse\"></i>",
                             "TriggerBatchProcess",
                             "Shared",
                             new
                             {
                                 process = "loadinventories",
                                 channelId = ViewBag.channelId,
                                 attributes = "t$loadinventories,tt$" + ViewBag.tenantID.ToString() + ",ch$" + ViewBag.channelId.ToString(),
                                 runImmediately = true
                             },
                             new AjaxOptions()
                             {
                                 HttpMethod = "POST",
                                 //OnComplete = "checkJobInProgress(''); $('.sub-menu .dropdown-toggle').trigger('click');"
                                 OnComplete = "triggerComplete"
                             },
                             new
                             {
                                 @class = "repriceBtn"
                             })
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

@Html.Grid(Model.CompetitorList).Columns(columns =>
{
    columns.Add(o => o.CompetitorName)
            .Titled("Competitor Name")
            .Filterable(true)
            .SetFilterWidgetType("CustomTextFilterWidget");

    columns.Add(o => o.ReviewTotal)
            .Titled("No. Of Reviews")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.ReviewRating)
            .Titled("Avg. Review Rating")
            .Filterable(true)
            .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.ProductMatchCount)
        .RenderValueAs(x => x.ProductMatchCount == null
            ? ""
            : Html.ActionLink($"{(x.ProductMatchCount):N0}", "Inventory", "Competitors", new RouteValueDictionary { { "grid-filter", "Competitor.CompetitorName__1__" + x.CompetitorName } }, null).ToString())
        .Titled("Product Matches")
        .Filterable(true)
        .Sanitized(false)
        .Encoded(false)
        .SetFilterWidgetType("CustomNumberFilterWidget");

    columns.Add(o => o.IsActive)
            .Titled("Active")
            .Filterable(true)
            .Encoded(false)
            .Sanitized(false)
            .RenderValueAs(o => "<div class=\"activateCompetitor checkbox checkbox-success\">" + Html.EditorFor(x => o.IsActive) + "<label class=\"errmsg\"></label></div>");

    columns.Add()
            .Encoded(false)
            .Sanitized(false)
            .Css("hidden")
            .RenderValueAs(x => Html.HiddenFor(y => x.CompetitorID));

}).WithPaging(200).Sortable().Named("competitorGrid").Selectable(false).WithMultipleFilters().WithGridItemsCount()        

@section scripts {
    <script type="text/javascript">
        $(function () {
            
            checkJobInProgress('');

            $('.selectpicker').selectpicker();

            $(document).on('click', '.activateCompetitor > .check-box', function () {
                var clickedItem = $(this);
                $.ajax({
                    async: false,
                    cache: false,
                    type: "POST",
                    url: "@Url.Action("Activate")",
                    data: {
                        "competitorId": $(this).closest('tr.grid-row').find('#x_CompetitorID').val(),
                        "isActive": $(this).is(':checked')
                    },
                    success: function (data) {
                        if (!data.isSuccess) {
                            clickedItem.closest('.activateCompetitor').find('.errmsg').html(data.html);
                            clickedItem.prop("checked", !clickedItem.is(':checked'));
                        }
                    }
                });
            });

            pageGrids.competitorGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.competitorGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );
        });
    </script>
}
