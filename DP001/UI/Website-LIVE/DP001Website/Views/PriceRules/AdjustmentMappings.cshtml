@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@model PriceRuleViewModel


<div class="row">
    <div class="col-md-2 form-name" style="justify-content: center;"></div>
    <div class="col-md-3 form-name" style="justify-content: center;">
        <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter a percentage adjustment that you wish to apply to the final calculated price." data-helpsid="2" data-helpeid="2"></i>
        Adjustment (%)
    </div>
    <div class="col-md-3 form-name" style="justify-content: center;">
        <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter a minimum margin to be respected for this adjustment." data-helpsid="2" data-helpeid="2"></i>
        Minimum Margin (%)
    </div>
    <div class="col-md-3 form-name" style="justify-content: center;">
        <i class="fa fa-question-circle help-popup" data-toggle="tooltip" title="Enter a maximum margin to be respected for this adjustment." data-helpsid="2" data-helpeid="2"></i>
        Maximum Margin (%)
    </div>
</div>


