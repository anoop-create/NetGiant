@using DP001BusinessLogic.ViewModels;
@using DP001DataAccess.Entities;
@using PagedList.Mvc;
@using DP001Website.Models;
@using GridMvc.Html;
@model PriceRuleViewModel

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* This is a fix for the Grid.Mvc when filtering to aviod null errors for possible Nullable joins *@
@foreach (var m in Model.PriceRulesList)
{
    if (m.Rule.Brand == null)
    {
        m.Rule.Brand = new Brand();
    }
    if (m.Rule.ProductCategory == null)
    {
        m.Rule.ProductCategory = new ProductCategory();
    }
    if (m.Rule.ProductInventory == null)
    {
        m.Rule.ProductInventory = new ProductInventory();
    }
}

<section class="container-fluid sub-menu">
    <div class="row row-height-fix">
        <div class="col-xs-5 col-md-8 col-lg-9 text-nowrap">
            <h1 class="text-nowrap">
                <a href="@Url.Action("Index", "Dashboard")">
                    <i class="fa fa-home grey"></i>
                </a>
                <i class="fa fa-chevron-right"></i>
                Price Rules
            </h1>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <div class="col-xs-7 col-md-4 col-lg-3 row-height-fix flex-right">
                <div class="btn-group">
                    <button type="button" class="btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                        <i class="fa fa-sliders fa-lg"></i>
                        <i class="fa fa-caret-down"></i>
                    </button>
                    <ul class="dropdown-menu g-p-10">
                        <li class="g-fw-b">Price Rule Options</li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-plus\"></i> Add Rule", "New", "PriceRules", null, null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-times\"></i> Reset Filters", "Index", "PriceRules", null, null)
                        </li>
                        <li role="presentation">
                            @Ajax.HtmlActionLink("<i class=\"fa fa-question\"></i> Test Price Rules <i id=\"repriceSpinner\" style=\"display: none\" class=\"fa fa-spinner fa-pulse\"></i>",
                                "TriggerBatchProcess",
                                "Shared",
                                new
                                {
                                    process = "calculateprices",
                                    channelId = ViewBag.channelId,
                                    attributes = "t$calculateprices,tt$" + ViewBag.tenantId.ToString() + ",ch$" + ViewBag.channelId.ToString() + ",dbg$1",
                                    runImmediately = true
                                },
                                new AjaxOptions()
                                {
                                    HttpMethod = "POST",
                                    OnComplete = "repriceComplete"
                                },
                                null)
                        </li>
                        <li role="presentation">
                            @Ajax.HtmlActionLink("<i class=\"fa fa-calculator\"></i> Calculate Prices <i id=\"repriceSpinner2\" style=\"display: none\" class=\"fa fa-spinner fa-pulse\"></i>",
                         "TriggerBatchProcess",
                         "Shared",
                         new
                         {
                             process = "calculateprices",
                             channelId = ViewBag.channelId,
                             attributes = "t$calculateprices,tt$" + ViewBag.tenantId.ToString() + ",ch$" + ViewBag.channelId.ToString(),
                             runImmediately = true
                         },
                         new AjaxOptions()
                         {
                             HttpMethod = "POST",
                             OnComplete = "repriceCompleteCalculatePrices"
                         },
                         null)
                        </li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-line-chart\"></i> Preview Test Results", "ComparisonStaging", "Reports", null, null)
                        </li>
                        <li role="presentation" class="divider"></li>
                        <li role="presentation">
                            @Html.HtmlActionLink("<i class=\"fa fa-upload\"></i> Export Rules", "ExportToExcel", "PriceRules", null, null)
                        </li>
                        @*<li role="presentation">
                                @Html.HtmlActionLink("<i class=\"fa fa-download\"></i> Import Rules", "ImportRules", "PriceRules", null, null)
                            </li>*@
                    </ul>
                </div>
            </div>
        }
    </div>
</section>

@Html.Grid(Model.PriceRulesList).Columns(columns =>
{

columns.Add(x => x.Rule.RuleName)
    .Titled("Rule Name")
    .Filterable(true)
    .SetFilterWidgetType("CustomTextFilterWidget");

columns.Add(x => x.Rule.Lookup1.LookupName)
    .Titled("Rule Type")
    .Filterable(true)
    .SetFilterWidgetType("CustomRuleTypeFilterWidget");

columns.Add(x => x.Rule.IsBanding)
    .Titled("Banding")
    .Filterable(true)
    .SetFilterWidgetType("CustomBooleanFilterWidget");

columns.Add(x => x.Rule.Lookup.LookupName)
    .Titled("Method")
    .Filterable(true)
    .SetFilterWidgetType("CustomMethodFilterWidget");

columns.Add(x => x.Rule.ProductCategory.CategoryName)
    .Titled("Category")
    .Filterable(true)
    .SetFilterWidgetType("CustomCategoryFilterWidget");

columns.Add(x => x.Rule.Brand.BrandName)
    .Titled("Brand")
    .Filterable(true)
    .SetFilterWidgetType("CustomBrandFilterWidget");

columns.Add(x => x.Rule.ProductInventory.ManufacturerPartNo)
    .Titled("Product")
    .Filterable(true)
    .SetFilterWidgetType("CustomTextFilterWidget");

columns.Add(x => x.ProductCount)
    .RenderValueAs(p => Html.ActionLink(p.ProductCount.ToString(), "Comparison", "Reports", new RouteValueDictionary { { "grid-filter", "Pi.PriceRule.RuleName__1__" + p.Rule.RuleName } }, null))
    .Encoded(false)
    .Sanitized(false)
    .Titled("Product Count")
    .Filterable(true)
    .SetFilterWidgetType("CustomNumberFilterWidget");

columns.Add(x => x.Rule.IsTest)
    .Titled("Test")
    .Filterable(true)
    .SetFilterWidgetType("CustomBooleanFilterWidget");

columns.Add(x => x.Rule.IsActive)
    .Titled("Active")
    .Filterable(true)
    .SetFilterWidgetType("CustomBooleanFilterWidget");

columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .SetWidth(30)
        .Css("no-border")
        .RenderValueAs(d => @<span class="fa fa-pencil-square-o invisible"></span>);

columns.Add()
        .Encoded(false)
        .Sanitized(false)
        .Css("hidden")
        .RenderValueAs(x => Html.HiddenFor(y => x.Rule.PriceRuleID));

}).WithPaging(200).Sortable().Named("priceRulesGrid").Selectable(false).SetRowCssClasses(x => "g-cur-p").WithMultipleFilters().WithGridItemsCount()

@section scripts
{
    <script type="text/javascript">
        $(function () {

            checkJobInProgress('');

            pageGrids.priceRulesGrid.addFilterWidget(
                new DropDownListWidget("CustomBrandFilterWidget", "brandList", "/Shared/GetBrandNames", "brand")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new DropDownListWidget("CustomRuleTypeFilterWidget", "ruleTypeList", "/Shared/GetRuleTypeList", "rule")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new DropDownListWidget("CustomMethodFilterWidget", "methodList", "/Shared/GetMethodList", "method")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new DropDownListWidget("CustomCategoryFilterWidget", "categoryList", "/Shared/GetCategoryList", "category")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new TextWidget("CustomTextFilterWidget")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new NumberWidget("CustomNumberFilterWidget")
            );

            pageGrids.priceRulesGrid.addFilterWidget(
                new BooleanWidget("CustomBooleanFilterWidget")
            );

            $(document).on('click', '.grid-wrap tbody > tr', function () {
                if ($(this).find('#x_Rule_PriceRuleID').length > 0) {
                    window.location.href = '@Url.Action("Edit")/' + $(this).find('#x_Rule_PriceRuleID').val();
                }
            })
        })
    </script>
}