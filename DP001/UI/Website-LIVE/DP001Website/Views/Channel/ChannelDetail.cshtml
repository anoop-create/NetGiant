@using DP001DataAccess.Entities;
@model List<Channel>

<table id="channel" class="table table-hover" data-url="@Url.Action("Edit", "Channel")">
    <thead>
        <tr>
            <th>Selected Channel</th>
            <th>Channel Name</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    @if (Model.Count == 0)
    {
        <thead>
            <tr>
                <th colspan="100%" style="padding: 5px;">
                    You don't have any Channels set up. You need to have at least 1 channel in order to begin setting up your product feeds, schedules and price rules.
                </th>
            </tr>
        </thead>
    }
    <tbody>
        @foreach (var channel in Model)
        {
            <tr class="list-form-row" data-id="@channel.ChannelID">
                <td style="padding: 5px;">
                    <i class="fa @(channel.ChannelID == ViewBag.thisChannel.ChannelID ? "fa-check-circle" : "")"></i>
                </td>
                <td style="padding: 5px;">
                    @Html.DisplayFor(m => channel.ChannelName)
                </td>
                <td style="padding: 5px;">
                    @(channel.IsActive == true ? "Yes" : "No")
                </td>
                <td width="40px">
                    <i class="fa fa-chevron-down" />
                </td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="list-form-row" data-newurl="@(Url.Action("New", "Channel", new {  }))">
            <td colspan="100%">
                @if (User.IsInRole("Administrator"))
                {
                    <button class="pull-right g-m-tb-5 g-cur-p btn btn-default btn-sm btn-add">
                        <i class="fa fa-plus"></i> Add Channel
                    </button>
                }
            </td>
        </tr>
    </tfoot>
</table>
