@using BusinessLogic.ViewModels;

@model CommonViewModel

<h2>Add Cookie</h2>
<form action="~/Debug/CreateCookie/" method="post">

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 form-name">
                Cookie Name
            </div>
            <div class="col-md-4 form-value">
                @Html.TextBox("name")
            </div>
            <div class="col-md-2 form-name">
                Cookie Value
            </div>
            <div class="col-md-4 form-value">
                @Html.TextBox("value")
            </div>
            <div class="form-actions">
                <button type="submit" class="pull-right g-m-r-10 btn btn-default btn-sm" value="Submit" name="action:Update">
                    <i class="fa fa-floppy-o"></i> Save
                </button>
            </div>
        </div>
    </div>
</form>

