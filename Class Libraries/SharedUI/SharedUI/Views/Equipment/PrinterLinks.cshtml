@using BusinessLogic;

@model WizardLists

@{
    bool showFamilyEquipment = ViewData.ContainsKey("ShowFamilyEquipment") && (bool)ViewData["ShowFamilyEquipment"];
    bool showLinks = ViewData.ContainsKey("ShowLinks") && (bool)ViewData["ShowLinks"];
    if (!showFamilyEquipment)
    {
        <div class="row clearfix">
            @if (Model.FamilyList.Find(x => x.Selected == true) != null)
            {
                if (Model.FamilyList.Count > 0)
                {
                    <hr class="g-m-t-60 g-m-b-20" />
                }
                <div class="col-md-12">
                    <h2>Select your printer from the list</h2>
                </div>
                foreach (ExtdSelectListItem sli in Model.EquipList)
                {
                    <div class="col-md-6 g-p-b-10">
                        <i class="fa fa-chevron-right g-p-r-10"></i>
                        <a class="primary" href="/model/@sli.Text.Replace(" ", "-")-@Model.CartridgeTypeName.Replace(" ", "-")/">@sli.Text</a>
                    </div>
                }
            }
            else
            {
                SelectListItem manu = Model.ManufacturerList.Find(x => x.Selected == true);
                if (manu != null)
                {
                    if (Model.FamilyList.Count > 0)
                    {
                        <hr class="g-m-t-60 g-m-b-20" />
                    }
                    <div class="col-md-12">
                        <h2>Select your printer family or series from the list</h2>
                    </div>
                    foreach (SelectListItem sli in Model.FamilyList)
                    {
                        string link = showLinks ? "javascript:scrollToSelector('#family" + sli.Value.ToString() + "')" : "/" + Model.CartridgeTypeName.Replace(" ", "-").ToLower() + "/" + manu.Text.Replace(" ", "-") + "/" + sli.Text.Replace(" ", "-") + "/";

                        <div class="col-md-6 g-p-b-10">
                            <i class="fa fa-chevron-right g-p-r-10"></i>
                            <a class="primary" href="@link">@sli.Text</a>
                        </div>
                    }
                }
            }
        </div>
    }
    else
    {
        <div class="row">
            @{
                int familyId = ViewData.ContainsKey("FamilyId") ? Int32.Parse(ViewData["FamilyId"].ToString()) : 0;
                foreach (ExtdSelectListItem sli in Model.EquipList)
                {
                    if (sli.LinkingId == familyId)
                    {
                        <div class="col-md-6 g-p-b-10">
                            <i class="fa fa-chevron-right g-p-r-10"></i>
                            <a class="primary" href="/model/@sli.Text.Replace(" ", "-")-@Model.CartridgeTypeName.Replace(" ", "-")/">@sli.Text</a>
                        </div>
                    }
                }
            }
            </div>
    }
}
