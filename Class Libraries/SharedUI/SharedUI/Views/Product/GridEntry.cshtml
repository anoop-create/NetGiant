@using BusinessLogic.ViewModels;
@using BusinessLogic;
@using System.Configuration;
@using SharedUI.Models;
@using Kendo.Mvc.UI

@model ProductViewModel

@{
    decimal mainPrice = 0;
    decimal subPrice = 0;
    string mainPriceVAT = "";
    string subPriceVAT = "";
    string tooltipHighlight = "";

    if(Model.Product.BrandFlag != BrandFlag.Compatible)
    {
        tooltipHighlight = "tooltip-highlight";
    }

    if (ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1")
    {
        mainPrice = Model.Product.PriceRetIncVat;
        subPrice = Decimal.Divide(Model.Product.PriceRetIncVat, Model.VatMultiplier);
        mainPriceVAT = "inc VAT";
        subPriceVAT = "ex VAT";
    }
    else
    {
        mainPrice = Decimal.Divide(Model.Product.PriceRetIncVat, Model.VatMultiplier);
        subPrice = Model.Product.PriceRetIncVat;
        mainPriceVAT = "ex VAT";
        subPriceVAT = "inc VAT";
    }

    Model.HideBasketCount = "g-v-h";
    if (Model.BasketContents != null)
    {
        BasketContents bc = Model.BasketContents.Find(x => x.StockRef == Model.Product.Reference);
        Model.BasketCount = bc != null ? bc.Quantity : 0;
        Model.HideBasketCount = Model.BasketCount == 0 ? "g-v-h" : "";
    }
}

<div class="g-bc-s g-b-1-p g-ps-r">
    <div class="pg-compare g-bc-secondary g-fc-st g-v-h">
        <div class="pull-left">
            <a class="second g-i g-p-l-10 compare"
               data-target=".custom-popup"
               data-url="@Url.Action("Comparison", "Product")/"
               data-container=".comparison">
                Compare Now
            </a>
        </div>
        <div class="pg-compare-select pull-right">
            <span>Compare</span>
            <span class="pg-compare-count">0</span>
            <span>/4</span>
            <i class="fa fa-lg fa-square-o" data-id="@Model.Product.ProductId"></i>
        </div>
    </div>
    <div class="atb-entry clearfix">
        <div class="g-flex-allcenter pg-image">
            <a href="@Model.Product.Url">
                <img src="/Content/Images/1pxTrans.png" class="g-bc-s lazy" data-original="@Model.Product.ImageUrl" alt="@Model.Product.Description" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';"/>
                <noscript>
                    <img class="g-bc-s" src="@Model.Product.ImageUrl" alt="@Model.Product.Description" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';" />
                </noscript>
            </a>
        </div>
        @if (Model.IsStationerySaleActive && Model.Product.IsStationerySaleItem)
        {
            @Html.RawFromDict(Model.SaleData, "StationerySash")
        }
        <div class="@tooltipHighlight" data-tooltipname="PricePromise">
            <div class="g-m-t-10 g-h-40 g-of-h">
                <a class="primary productName" href="@Model.Product.Url">
                    <strong class="productName">@Model.Product.Description</strong>
                </a>
            </div>
            <div class="">
                <strong>Product Code: </strong>@Model.Product.PartNo
            </div>
        </div>
        <div class="g-h-25">
            @if (Model.Product.Type == "Stationery")
        {
            if (Model.Product.PageYield > 1)
            {
                    <div class="popup g-cur-p g-fs-sm"
                         data-popupname="PackQuantity"
                         data-toggle="modal"
                         data-target="#popup">
                        <div class="g-lh-25 clearfix">
                            <div class="g-d-ib">
                                <span>Pack Quantity: @Model.Product.PageYield</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="g-m-t-10 g-fs-lg">
            &pound;@mainPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@mainPriceVAT</span>
        </div>
        <div class="g-fs-n">
            &pound;@subPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@subPriceVAT</span>
        </div>
        <div class="g-fc-st text-center g-m-t-10 g-fs-sm g-lh-20">
            @Html.ProductAvailability(Model.Product.Availability, Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()), true)
        </div>
        <div class="clearfix">
            <div class="row g-m-t-10">
                <div class="col-md-4 col-xs-4">
                    @(Html.Kendo().NumericTextBox<int>()
        .Format("#")
        .Name("qty-" + Model.Product.ProductId)
        .Value(1)
        .Placeholder("Enter quantity")
        .HtmlAttributes(new { style = "height: 34px", @class = "atb-qty" })
        .Min(1)
        .Max(1000)
        .Events(events => events
            .Change(
            @<text>
                function(e) {
                if(!this.value()) this.value(1);
                }
            </text>
            ).Spin(
            @<text>
                function(e) {
                if(!this.value()) this.value(1);
                }
            </text>
            )
        )
                        )
                    </div>
                    <div class="col-md-8 col-xs-8">
                        <button class="atb-add g-butt-primary g-butt-lg pull-right"
                                data-price="@mainPrice.ToString("N2")"
                                data-productid="@Model.Product.Reference"
                                data-partno="@Model.Product.PartNo"
                                data-imageurl="@Model.Product.ImageUrl"
                                data-desc="@Model.Product.Description">
                            Add to Basket
                        </button>
                        <span class="hidden">&pound;</span>
                        <span class="hidden price">@mainPrice.ToString("0.00")</span>
                    </div>
                </div>
            </div>
            <div class="g-fs-sm g-m-t-10 g-m-b-10 g-i text-center @Model.HideBasketCount">
                <div class="row visible-xs visible-sm g-m-0">
                    <div class="col-md-4 col-xs-4 g-bc-tt g-fc-st g-b-1-i">
                        <span class="atb-count">@Model.BasketCount</span> in Basket
                    </div>
                    <div class="col-md-8 col-xs-8 g-bc-tt g-b-1-i">
                        <a class="second" href="~/checkout/">Checkout</a>
                    </div>
                </div>
                <div class="hidden-sm hidden-xs">
                    <span class="atb-count">@Model.BasketCount</span> in Basket | <a href="~/checkout/"> Checkout</a>
                </div>
            </div>
        </div>

    @{
        List<int> inkTypes = new List<int>() { 1, 2, 5, 7 };

        if (((!Model.IsCompatibleSaleActive && Model.Product.BrandFlag.Equals(BrandFlag.Compatible) && inkTypes.Contains(Model.Product.ProductTypeID))
            || (!Model.IsOEMSaleActive && Model.Product.BrandFlag.Equals(BrandFlag.Original) && inkTypes.Contains(Model.Product.ProductTypeID))
            || (!Model.IsStationerySaleActive && !inkTypes.Contains(Model.Product.ProductTypeID))) && Model.Product.AttValue6 != 0 && Model.Product.AttValue6 != 25)
        {
            <a href="@Model.Product.Url">
                @Html.Raw(Model.Product.OfferSashImage)
            </a>
        }
    }
</div>