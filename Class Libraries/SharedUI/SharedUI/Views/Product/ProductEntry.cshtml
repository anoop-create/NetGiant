@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using SharedUI.Models;
@using System.Configuration;
@using Kendo.Mvc.UI

@model SearchViewModel

@{
    ProductEntry pe = Model.Product;

    decimal mainPrice = 0;
    decimal subPrice = 0;
    decimal salePrice = 0;
    decimal cashbackPrice1 = 0;
    decimal cashbackPrice2 = 0;
    string subPriceVAT = "";
    string mainPriceVAT = "";
    string voucher = "";
    string offerClass = "";
    bool isConsumable = false;
    bool compatibleHasOffer = false;
    string tooltipHighlight = "";

    List<int> inkTypes = new List<int>() { 1, 2, 5, 7 };
    if (pe.BrandFlag != BrandFlag.Compatible)
    {
        tooltipHighlight = "tooltip-highlight";
    }

    if (pe.Type == "Toner" || pe.Type == "Ink" || pe.Type == "Solid Ink" || pe.Type == "Franking")
    {
        isConsumable = true;
    }

    if (ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1")
    {
        mainPrice = pe.PriceRetIncVat;
        subPrice = Decimal.Divide(pe.PriceRetIncVat, Model.VatMultiplier);
        if (isConsumable)
        {
            if (pe.BrandFlag.Equals(BrandFlag.Compatible))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = pe.PPCPromoPriceIncVat;
                    voucher = ConfigurationManager.AppSettings["PPCPromoCode"];
                }
                if (Model.IsCompatibleSaleActive)
                {
                    salePrice = pe.PriceSaleIncVat;
                    voucher = Html.RawFromDict(Model.SaleData, "CompatibleVoucher").ToSafeString();
                    offerClass = "compatible";
                }
            }
            if (pe.BrandFlag.Equals(BrandFlag.Original))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = pe.PPCPromoPriceIncVat;
                    voucher = ConfigurationManager.AppSettings["PPCPromoCode"];
                }
                if (Model.IsOEMSaleActive)
                {
                    salePrice = pe.PriceSaleIncVat;
                    voucher = Html.RawFromDict(Model.SaleData, "OEMVoucher").ToSafeString();
                    offerClass = "oem";
                }
            }
        }
        if (Model.Product.AttValue6 == 1)
        {
            cashbackPrice1 = mainPrice - Convert.ToDecimal(Model.Product.SpecLine3);
            cashbackPrice2 = Decimal.Divide(cashbackPrice1, Model.VatMultiplier);
        }
        mainPriceVAT = "inc VAT";
        subPriceVAT = "ex VAT";
    }
    else
    {
        mainPrice = Decimal.Divide(pe.PriceRetIncVat, Model.VatMultiplier);
        subPrice = pe.PriceRetIncVat;
        if (isConsumable)
        {
            if (pe.BrandFlag.Equals(BrandFlag.Compatible))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = Decimal.Divide(pe.PPCPromoPriceIncVat, Model.VatMultiplier);
                    voucher = ConfigurationManager.AppSettings["PPCPromoCode"];
                }
                if (Model.IsCompatibleSaleActive)
                {
                    salePrice = Decimal.Divide(pe.PriceSaleIncVat, Model.VatMultiplier);
                    voucher = Html.RawFromDict(Model.SaleData, "CompatibleVoucher").ToSafeString();
                    offerClass = "compatible";
                }
            }
            if (pe.BrandFlag.Equals(BrandFlag.Original))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = Decimal.Divide(pe.PPCPromoPriceIncVat, Model.VatMultiplier);
                    voucher = ConfigurationManager.AppSettings["PPCPromoCode"];
                }
                if (Model.IsOEMSaleActive)
                {
                    salePrice = Decimal.Divide(pe.PriceSaleIncVat, Model.VatMultiplier);
                    voucher = Html.RawFromDict(Model.SaleData, "OEMVoucher").ToSafeString();
                    offerClass = "oem";
                }
            }
        }
        if (Model.Product.AttValue6 == 1)
        {
            cashbackPrice2 = subPrice - Convert.ToDecimal(Model.Product.SpecLine3);
            cashbackPrice1 = Decimal.Divide(cashbackPrice2, Model.VatMultiplier);
        }
        mainPriceVAT = "ex VAT";
        subPriceVAT = "inc VAT";
    }

    int basketCount = 0;
    string hideBasketCount = "g-v-h";
    BasketContents bc = new BasketContents();
    if (Model.BasketContents != null)
    {
        bc = Model.BasketContents.Find(x => x.StockRef == pe.Reference);
        basketCount = bc != null ? bc.Quantity : 0;
        hideBasketCount = basketCount == 0 ? "g-v-h" : "";
    }
    if (Model.IsCompatibleSaleActive
        || (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"])))
    {
        compatibleHasOffer = true;
    }
}
<div class="g-m-b-20 g-b-1-p pl-entry" data-att-006="#@pe.AttValue6.ToString("##0")#" data-att-008="#@pe.AttValue8.ToString("##0")#" data-att-021="#@pe.BrandFlag.ToString()#" data-att-022="#@pe.ManufacturerId.ToString("##0")#" data-logurl="@Model.SliLoggingUrl">

<div class="clearfix g-bc-s prd-summ-entry">
<div class="clearfix g-w-200 g-ps-r">
    <div class="text-center g-m-t-10 g-m-b-50">
        <a href="@pe.Url">
            <img src="/Content/Images/1pxTrans.png" class="lazy" data-original="@pe.ImageUrl" alt="@pe.Description" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';"/>
            <noscript>
                <img src="@pe.ImageUrl" alt="@pe.Description" onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';">
            </noscript>
        </a>
    </div>
    <div class="hidden-xs hidden-sm g-ps-a g-btm-0 g-m-l-m10 g-b-t-1 g-w-200">
        <div class="g-b-r-1-p pull-left">
            <img src="/Content/Images/1pxTrans.png" class="lazy" data-original="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(pe.Brand.ToLower().Replace(' ', '-')).jpg" alt="@pe.Brand" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';"/>
            <noscript>
                <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(pe.Brand.ToLower().Replace(' ', '-')).jpg" alt="@pe.Brand" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';" />
            </noscript>
        </div>
        <div class="g-m-l-10 g-lh-25 pull-left text-left g-fs-sm">
            <div>
                @if (pe.SpecLine6 == "Toner" || pe.SpecLine6 == "Ink" || pe.SpecLine6 == "Franking" || pe.SpecLine6 == "Solid Ink")
            {
                    @(pe.BrandFlag.Equals(BrandFlag.Compatible) ? "Best Value Own Brand" : "Genuine " + pe.Brand.Substring(0, (pe.Brand.Length > 9 ? 9 : pe.Brand.Length)))
                }
                else
                {
                    @(pe.Brand.Substring(0, (pe.Brand.Length > 15 ? 15 : pe.Brand.Length)))
                }
            </div>
            <a class="g-i" href="@pe.Url">View Product Details</a>
        </div>
    </div>
    @if (pe.CompatibleSaleIsApplicable && pe.BrandFlag.Equals(BrandFlag.Compatible) && isConsumable)
    {
        @Html.RawFromDict(Model.SaleData, "CompatibleSash")
    }
    @if (pe.OEMSaleIsApplicable && pe.BrandFlag.Equals(BrandFlag.Original) && isConsumable)
    {
        @Html.RawFromDict(Model.SaleData, "OEMSash")
    }
    @if (Model.IsStationerySaleActive && pe.IsStationerySaleItem)
    {
        @Html.RawFromDict(Model.SaleData, "StationerySash")
    }
    @if (((!pe.CompatibleSaleIsApplicable && pe.BrandFlag.Equals(BrandFlag.Compatible) && inkTypes.Contains(pe.ProductTypeID))
        || (!pe.OEMSaleIsApplicable && pe.BrandFlag.Equals(BrandFlag.Original) && inkTypes.Contains(pe.ProductTypeID))
        || (!Model.IsStationerySaleActive && !inkTypes.Contains(pe.ProductTypeID)))
        && pe.AttValue6 != 0
        && pe.AttValue6 != 25)
    {
    <a href="@pe.Url" alt="@pe.Description">
        @Html.Raw(pe.OfferSashImage)
    </a>
    }
</div>

<div class="clearfix g-ps-r g-va-t">
    <div class="@tooltipHighlight" data-tooltipname="PricePromise">
        <a class="primary" href="@pe.Url">
            <div class="g-fw-b g-m-t-10 productName">@Html.HighlightKeyWords(pe.Description, (string)ViewBag.Term, "search-highlight", true)</div>
        </a>
        <div class="g-fs-sm g-m-t-10">
            <strong>Product Code:</strong> @Html.HighlightKeyWords(pe.PartNo, (string)ViewBag.Term, "search-highlight", true)
        </div>
    </div>
    <div class="row g-fs-sm clearfix g-m-t-10">
    
    @if (pe.PrimarySortSeq.Equals(ProductFlag.Assembly))
    {
        foreach (ProductComponent ce in pe.ComponentList)
        {
            <div class="popup g-cur-p clearfix pull-left g-p-r-20 g-lh-35 col-lg-6 col-xs-12"
                 data-popupname="ColourChip"
                 data-toggle="modal"
                 data-target="#popup">
                <div class="pull-left">@(ce.AttValue9 != 2 ? ce.PackQuantity.ToString() + " x" : "")</div>
                <div class="pl-chip pull-left g-fc-st g-m-5 cc-@ce.AttValue8">@ce.AttDesc8</div>
                @if (ce.PageYield > 1)
                {
                    <div class="pull-left">@ce.PageYield.ToString("#,###,##0") Pages</div>
                }
            </div>
        }
    }
    @if (pe.PrimarySortSeq.Equals(ProductFlag.Product))
    {
        if (pe.AttValue8 > 0)
        {
            <div class="popup g-cur-p clearfix pull-left g-p-r-20 g-lh-35 col-lg-6 col-xs-12"
                 data-popupname="ColourChip"
                 data-toggle="modal"
                 data-target="#popup">
                <div class="pull-left">@(pe.AttValue9 != 2 ? "1 x" : "")</div>
                <div class="pl-chip pull-left g-fc-st g-m-5 cc-@pe.AttValue8">@pe.AttDesc8</div>
                @if (pe.PageYield > 1)
                {
                    <div class="pull-left">@pe.PageYield.ToString("#,###,##0") Pages</div>
                }
            </div>
            if (pe.PageYield > 1)
            {
                <div class="popup g-cur-p clearfix pull-left g-p-r-20 g-lh-35 col-lg-6 col-xs-12"
                     data-popupname="CostPerPage"
                     data-toggle="modal"
                     data-target="#popup">
                    <span class="fa-stack">
                        <i class="fa fa-file-o fa-stack-2x"></i>
                        <span class="fa-stack-1x fa-nudge-down">&pound;</span>
                    </span>
                    <span class="">Cost per page @((mainPrice * 100 / pe.PageYield).ToString("#,###,##0.00"))p</span>
                </div>
            }
        }
    }
    @if (pe.PrimarySortSeq.Equals(ProductFlag.Ancillary))
    {
        if (pe.AttValue9 > 0)
        {
            <div class="popup g-cur-p clearfix pull-left g-p-r-20 g-lh-35 col-lg-6 col-xs-12"
                 data-popupname="ColourChip"
                 data-toggle="modal"
                 data-target="#popup">
                <div class="pull-left">@(pe.AttValue9 != 2 ? "1 x" : "")</div>
                <div class="pl-chip pull-left g-fc-st g-m-5 cc-@pe.AttValue8">@pe.AttDesc8</div>
                @if (pe.PageYield > 1)
                {
                    <div class="pull-left">@pe.PageYield.ToString("#,###,##0") Cycles</div>
                }
            </div>
        }
    }
    </div>
    <div class="clearfix g-fs-sm g-m-b-10 g-m-t-30 row">
        @if (pe.AttValue6 == 25)
    {
            <div class="col-xs-12 pull-left g-lh-40">
                @Html.RawFromDict(Model.ProductData, "DeliveryMessageOverride");
            </div>
        }
        else
        {
            <div class="g-cur-p @(int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) == 3 ? "col-lg-12" : "col-lg-6") col-xs-12 g-flex-vcenter pull-left g-lh-40">
                <div class="popup" data-popupname="FreeDelivery" data-toggle="modal" data-target="#popup">
                    <div class="g-d-ib">
                        <img src="~/Content/Images/1pxTrans.png" class="msp_delivery" alt="Delivery" />
                    </div>
                    <div class="g-d-ib">
                        <span class="g-w-100p">@Html.Raw(int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) == 3 ? "Free Delivery on Orders Over &pound;100" : "Fast &amp; Free Delivery")</span>
                    </div>
                </div>
            </div>
        }
        @*@if (pe.PageYield > 1)
        {
            <div class="g-cur-p col-xs-12 g-flex-vcenter pull-left g-lh-40">
                <div class="popup"
                     data-popupname="EnduranceTool"
                     data-replacements="productid=@pe.ProductId"
                     data-toggle="modal"
                     data-target="#popup">
                    <div class="g-d-ib">
                        <img class="msp_bullOffer17" src="~/Content/Images/1pxTrans.png"/>
                    </div>
                    <div class="g-d-ib">
                        How long will this last?
                    </div>
                </div>
            </div>
        }*@
        @if (pe.BrandFlag.Equals(BrandFlag.Compatible))
        {
            <div class="g-cur-p col-lg-12 col-xs-12 g-flex-vcenter pull-left g-lh-40">
            <div class="popup" data-popupname="CompatibleGuarantee" data-toggle="modal" data-target="#popup">
                <div class="g-d-ib">
                    <img class="msp_bullGuarantee" src="~/Content/Images/1pxTrans.png" />
                </div>
                <div class="g-d-ib">
                    3 Year Guarantee
                </div>
            </div>
        </div>
        }
        @if (pe.AttValue6 != 0)
        {
            <div class="g-cur-p col-lg-12 col-xs-12 g-flex-vcenter pull-left g-lh-40">
                @Html.Raw(pe.OfferBullet)
            </div>
        }
        @if (pe.ItemType == 2 && pe.AssemblySaving > 0)
        {
            <div class="g-cur-p col-lg-6 col-xs-12 g-flex-vcenter pull-left g-lh-40">
            <div class="popup" data-popupname="MultiPackSaving" data-replacements="savingamount=&pound;@pe.AssemblySaving.ToString("#,###,##0.00")" data-toggle="modal" data-target="#popup">
                <div class="g-d-ib">
                    <img src="~/Content/Images/1pxTrans.png" class="msp_multibox" alt="Multipack Saving" />
                </div>
                <div class="g-d-ib">
                    <span>Multipack Saving </span>
                    <span>&pound;@pe.AssemblySaving.ToString("#,###,##0.00")</span>
                </div>
            </div>
        </div>
        }
    </div>
</div>

<div class="atb-entry clearfix g-w-235 g-va-t">
    @if (pe.BrandFlag.Equals(BrandFlag.Compatible))
    {
        if (isConsumable 
            && ((pe.CompatibleSaleIsApplicable && Model.CompatibleDiscount > 0) 
                || (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))))
        {
            @Html.RawFromDict(Model.ProductData, "CompatibleOverlayCss")

            <div class="@offerClass offer-overlay g-fc-st g-ps-r">
                <div class="clearfix g-p-5">
                    <div class="pull-left">
                        <strong>@(Model.IsCompatibleSaleActive ? "SALE PRICE" : "EXCLUSIVE OFFER PRICE")</strong>
                    </div>
                    <div class="pull-right">
                        <i class="fa fa-info-circle fa-lg"
                           data-toggle="tooltip"
                           data-html="true"
                           data-placement="bottom"
                           title="Voucher Instructions:<ol><li>Add items to your basket</li><li>Go to basket page</li><li>Enter voucher code shown</li></ol>">
                        </i>
                    </div>
                </div>
                <div class="g-fs-lg g-p-lr-5">
                    &pound;@salePrice.ToString("#,###,##0.00") <span class="g-fc-st g-fs-sm">@mainPriceVAT</span>
                </div>
                <div class="g-p-lr-5">
                    With Voucher Code: <strong>@voucher</strong>
                </div>

            </div>
        }
    }
    @if (pe.BrandFlag.Equals(BrandFlag.Original))
    {
        if (isConsumable 
            && ((pe.OEMSaleIsApplicable && Model.OEMDiscount > 0) 
                || (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCPromoIsOn"]) && Convert.ToBoolean(Session["U_IsFromPPC"]))))
        {
            @Html.RawFromDict(Model.ProductData, "OEMOverlayCss")

            <div class="@offerClass offer-overlay g-fc-st g-ps-r">
                <div class="clearfix g-p-5">
                    <div class="pull-left">
                        <strong>@(Model.IsOEMSaleActive ? "SALE PRICE" : "EXCLUSIVE OFFER PRICE")</strong>
                    </div>
                    <div class="pull-right">
                        <i class="fa fa-info-circle fa-lg"
                           data-toggle="tooltip"
                           data-html="true"
                           data-placement="bottom"
                           title="Voucher Instructions:<ol><li>Add items to your basket</li><li>Go to basket page</li><li>Enter voucher code shown</li></ol>">
                        </i>
                    </div>
                </div>
                <div class="g-fs-lg g-p-lr-5">
                    &pound;@salePrice.ToString("#,###,##0.00") <span class="g-fc-st g-fs-sm">@mainPriceVAT</span>
                </div>
                <div class="g-p-lr-5">
                    With Voucher Code: <strong>@voucher</strong>
                </div>

            </div>
        }
        else
        {
            if (pe.AttValue6 == 1)
            {
                <div class="cashback offer-overlay g-fc-st g-ps-r">
                    <div class="clearfix g-p-5">
                        <div class="pull-left">
                            <strong>PRICE AFTER CASHBACK</strong>
                        </div>
                        <div class="pull-right">
                            <i class="fa fa-info-circle fa-lg"
                               data-toggle="tooltip"
                               data-html="true"
                               data-placement="bottom"
                               title="To claim cashback follow the instructions on the product detail page.">
                            </i>
                        </div>
                    </div>
                    <div class="g-fs-lg g-p-lr-5">
                        &pound;@cashbackPrice1.ToString("#,###,##0.00") <span class="g-fc-st g-fs-sm">@mainPriceVAT</span>
                    </div>
                    <div class="g-p-lr-5">
                        &pound;@cashbackPrice2.ToString("#,###,##0.00") <span class="g-fc-st g-fs-sm">@subPriceVAT</span>
                    </div>
                </div>
            }
        }
    }
    <div class="product-price-message">
        @{
            Html.RenderPartial("~/Views/Product/InfoMessage.cshtml", bc, new ViewDataDictionary
            {
                {"Section", "Price"},
                {"ProductHasOffer", compatibleHasOffer},
                {"PriceEx", ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "0" ? mainPrice : subPrice},
                {"PriceInc", ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1" ? mainPrice : subPrice}
            });
        }
    </div>
    @*<div class="g-fs-lg g-m-t-10 g-m-l-5">
        <span><strong>&pound;</strong></span><span><strong>@mainPrice.ToString("#,###,##0.00")</strong></span>
    </div>
    <div class="g-fs-n g-m-l-5">
        &pound;@subPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@subPriceVAT</span>
    </div>*@
    <div class="text-center g-m-t-10 g-fs-sm g-lh-20">
        @Html.ProductAvailability(@pe.Availability, Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()))
    </div>
    <div class="clearfix">

        <div class="row g-m-t-10">
            <div class="col-md-4 col-xs-4">
                @(Html.Kendo().NumericTextBox<int>()
                    .Format("#")
                    .Name("qty-" + pe.ProductId)
                    .Value(1)
                    .Placeholder("Enter quantity")
                    .HtmlAttributes(new { style = "height: 34px", @class = "atb-qty" })
                    .Min(1)
                    .Max(1000)
                    .Events(events => events
                          .Change(
                      @<text>
                          function(e) {
                              if(!this.value()) this.value(1);
                          }
                      </text>
                          ).Spin(
                      @<text>
                          function(e) {
                              if(!this.value()) this.value(1);
                          }
                      </text>
                          )
                    )
                )
            </div>
            <div class="col-md-8 col-xs-8 g-p-l-8">
                <button class="atb-add g-butt-primary g-butt-lg"
                        data-price="@mainPrice.ToString("N2")"
                        data-productid="@pe.Reference"
                        data-partno="@pe.PartNo"
                        data-imageurl="@pe.ImageUrl"
                        data-desc="@pe.Description">
                    Add to Basket
                </button>
                <span class="hidden price">@mainPrice.ToString("0.00")</span>
            </div>
        </div>
    </div>
    <div class="product-info-message g-fs-sm g-m-t-10 g-m-b-10 text-center @hideBasketCount">
        @if (bc != null)
        {
            Html.RenderPartial("~/Views/Product/InfoMessage.cshtml", bc, new ViewDataDictionary
            {
                {"Section", "Info"},
                {"ProductHasOffer", compatibleHasOffer}
            });
        }
        @*<div class="row visible-xs visible-sm g-m-0">
            <div class="col-md-4 col-xs-4 g-bc-tt g-fc-st g-b-1-i">
                <span class="atb-count">@basketCount</span> in Basket
            </div>
            <div class="col-md-8 col-xs-8 g-bc-tt g-b-1-i">
                <a class="second" href="~/checkout/">Checkout</a>
            </div>
        </div>
        <div class="hidden-sm hidden-xs">
            <span class="atb-count">@basketCount</span> in Basket | <a href="~/checkout/"> Checkout</a>
        </div>*@
    </div>
</div>
</div>
</div>