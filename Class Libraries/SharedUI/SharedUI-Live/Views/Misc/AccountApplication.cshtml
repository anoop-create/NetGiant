@using BusinessLogic;
@using BusinessLogic.ViewModels;

@model MiscViewModel

@{
    Layout = "~/Views/Shared/_Empty.cshtml";
}

@section AddTags
{
    <link rel="stylesheet" type="text/css" href="https://services.postcodeanywhere.co.uk/css/captureplus-2.20.min.css?key=ZZ64-TH99-GD16-CT99"/>
    <script type="text/javascript" src="https://services.postcodeanywhere.co.uk/js/captureplus-2.20.min.js?key=ZZ64-TH99-GD16-CT99"></script>

    <script type="text/javascript">
        capturePlus.listen("load",
            function(control) {
                //custom code
                capturePlus.listen("options",
                    function(options) {
                        options.bar = options.bar || {};
                        options.bar.showLogo = false;
                        options.bar.showCountry = false;
                    });
                control.listen("populate",
                    function(address) {
                        if ($('#AccountApplicationDetails_BillingAddress_PostCode').val() != '') {
                            $('#co-acc-billadd-fields').removeClass('g-d-n');
                            $('#bill-manual-address').addClass('g-d-n');

                            // Increase the parent iframe height
                        }
                    });
            });
    </script>
}

<div id="account-application" class="container-fluid g-bc-p">
    @{
        using (Ajax.BeginForm("AccountApplication", "Misc", null, new AjaxOptions {HttpMethod = "POST", OnComplete = "applicationComplete", OnFailure = ""}, new {id = "account-application-form"} ))
        {
            Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
            {
                TemplateInfo = new TemplateInfo()
                {
                    HtmlFieldPrefix = "AccountApplicationDetails"
                }
            });

            <div class="row">
                <div id="co-submit-button" class="g-d-ib g-va-t">
                    <button type="submit" class="g-butt-primary g-butt-xl g-m-t-20">Submit Application</button>
                    <span id="submit-error" class="g-p-l-20"></span>
                </div>
                <div id="co-privacy-notice" class="g-d-ib g-d-n">
                    <p class="g-m-l-10 g-m-t-20">To understand how we use your data to<br>
                        process orders view our <a href="/blog/help/policies/" target="_blank">Privacy Policy.</a></p>
                </div>
            </div>

            @Html.ValidationSummary()
        }
    }
</div>

<iframe  id="iframe-height-adjust" class="g-ps-a g-top-0 g-btm-0 g-lf-0 g-h-100p g-w-0 g-b-n g-bc-transparent" data-containerid="#account-application" data-iframeid="@ViewBag.IframeId" tabindex="-1"></iframe>

@section scripts
{

    <script type="text/javascript">
        $.validator.setDefaults({ ignore: null });

        $('#account-application-form').bind("invalid-form.validate",
            function () {
                // Ensure Address is expanded
                $('#bill-manual-address').trigger('click');
            });

        function applicationComplete(data) {
            if (data.responseJSON.savereturn.IsSuccess) {
                $('#account-application').html(data.responseJSON.savereturn.Html);
            } else {
                $('#submit-error').html(data.responseJSON.savereturn.Html);
            }
        }
    </script>
}
