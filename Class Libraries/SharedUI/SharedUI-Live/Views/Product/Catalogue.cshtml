@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using SharedUI.Models;

@model ProductViewModel

@section AddTags {
    <link rel="canonical" href="https://@(Model.DomainNameTrunc + Request.Url.AbsolutePath.ToLower())/" />
}

<section data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.CommonData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-120-sm g-fc-st">
                <div class="bread-crumb hidden-xs hidden-sm">
                    <a class="second" href="/">Home</a>
                    <i class="fa fa-chevron-right g-fs-xs-i"></i>@Html.Raw(Model.Breadcrumb)
                </div>

                <div class="g-m-t-a">
                    <div class="pull-left">
                        <h1><span class="">@Model.CatalogueName</span></h1>
                    </div>
                    <div class="pull-right hidden-xs hidden-sm">
                        @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="comm-content g-bc-p g-p-b-60">
    <div class="container body-content g-ps-r">
        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-9">
                        <hr class="g-m-b-20" />
                        <div class="row">
                            @foreach (CategoryEntry ce in Model.CategoryList)
                            {
                                string link = "/" + ce.Url;
                                <div class="col-md-6">
                                    <div class="hm-pp-GridEntry g-p-tb-15 g-b-1-p g-flex-vcenter">
                                        <div class="pull-left g-p-lr-15">
                                            <a href="@link">
                                                <img class="hm-pp-Image" src="@(ConfigurationManager.AppSettings["CDN"] + "/Images/category-icons/" + Html.CleanUrl(ce.Name).ToLower() + ".jpg")" alt=""
                                                     onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';">
                                            </a>
                                        </div>
                                        <div>
                                            <a href="@link" class="primary">
                                                <div class="g-of-h g-h-40 g-fw-b">
                                                    @(ce.Name)
                                                </div>
                                            </a>
                                            <a href="@link">
                                                <div class="g-fw-b">
                                                    View Products
                                                    <i class="fa fa-chevron-right g-fs-xs-i g-p-l-5"></i>
                                                </div>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="row">
                            <div class="col-md-12">
                                @Html.Raw(Model.CategoryCode != null ? Model.CategoryCode.description : "")
                            </div>
                        </div>
                        @{
                            Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                        }
                    </div>

                    <div class="col-md-3 restrict-images hidden-xs hidden-sm">
                        <hr class="g-m-b-20" />
                        <h2>Our Services</h2>
                        @(Model.IsStationerySaleActive ? @Html.RawFromDict(Model.SaleData, "GridMarketing1", null, "hidden-xs hidden-sm") : @Html.RawFromDict(Model.ProductData, "ProductMarketing2", null, "hidden-xs hidden-sm"))

                        <div class="g-m-t-20"></div>

                        @Html.RawFromDict(Model.ProductData, "ModelMarketing1")
                    </div>  
                </div>
            </div>
        </div>
    </div>
</div>