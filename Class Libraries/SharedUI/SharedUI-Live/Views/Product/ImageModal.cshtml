@model List<string>

@if (Model.Count > 0)
{

    <div id="imageModal" class="modal fade custom-popup donotremove" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" style="overflow-y: auto;">
                <div class="g-ps-a g-top-0 g-rt-0 g-fc-st g-m-10 g-flex-allcenter">
                    <i class="fa fa-times fa-lg g-cur-p g-fc-pt" data-dismiss="modal" aria-label="Close"></i>
                </div>
                <div class="image-modal g-m-tb-10 g-bc-s modal-scroll">
                    <div class="text-center g-m-t-20 large-image-container g-flex-allcenter">
                        <img src="@Model.First()" alt="zoomImage" class="large-image g-va-m img-responsive"/>
                    </div>
                    <div class="image-slides text-center g-ps-a g-lf-0 g-rt-0">
                        <img id="previous-image" src="/Content/Images/1pxTrans.png" class="msp_chevronLeft g-cur-p g-m-r-20 hidden-xs hidden-sm" alt="left"/>

                        @for (var i = 0; i < Model.Count; i++)
                        {
                            if (Model[i].Contains("mediapool.getthespec.com"))
                            {
                                Model[i] = Model[i] + "&V=HR";
                            }

                            <div class="g-bc-s g-d-ib g-b-1-p g-m-r-10 g-cur-p image-slide-container">
                                <img src="@Model[i]" alt="slide"/>
                            </div>
                        }

                        <img id="next-image" src="/Content/Images/1pxTrans.png" class="msp_chevronRight g-cur-p g-m-l-10 hidden-xs hidden-sm" alt="left"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
