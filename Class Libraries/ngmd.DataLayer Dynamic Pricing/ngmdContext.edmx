          <EntitySet Name="AxisPriceView" EntityType="Self.AxisPriceView" store:Type="Views" store:Schema="ngmd">
            <DefiningQuery>SELECT 
    [AxisPriceView].[partNo] AS [partNo], 
    [AxisPriceView].[axisRef] AS [axisRef], 
    [AxisPriceView].[language] AS [language], 
    [AxisPriceView].[priceTypeID] AS [priceTypeID], 
    [AxisPriceView].[account] AS [account], 
    [AxisPriceView].[breakQuantity1] AS [breakQuantity1], 
    [AxisPriceView].[retailPriceExVat] AS [retailPriceExVat], 
    [AxisPriceView].[tradePriceExVat] AS [tradePriceExVat], 
    [AxisPriceView].[retailPriceIncVat] AS [retailPriceIncVat], 
    [AxisPriceView].[tradePriceIncVat] AS [tradePriceIncVat], 
    [AxisPriceView].[breakQuantity2] AS [breakQuantity2], 
    [AxisPriceView].[breakPrice2ExVat] AS [breakPrice2ExVat], 
    [AxisPriceView].[breakPrice2IncVat] AS [breakPrice2IncVat], 
    [AxisPriceView].[breakQuantity3] AS [breakQuantity3], 
    [AxisPriceView].[breakPrice3ExVat] AS [breakPrice3ExVat], 
    [AxisPriceView].[breakPrice3IncVat] AS [breakPrice3IncVat]
    FROM [ngmd].[AxisPriceView] AS [AxisPriceView]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="ds_attributeView" EntityType="Self.ds_attributeView" store:Type="Views" store:Schema="ngmd">
            <DefiningQuery>SELECT 
    [ds_attributeView].[attributeID] AS [attributeID], 
    [ds_attributeView].[partNo] AS [partNo], 
    [ds_attributeView].[manufacturer] AS [manufacturer], 
    [ds_attributeView].[dataSupplierID] AS [dataSupplierID], 
    [ds_attributeView].[attrName] AS [attrName], 
    [ds_attributeView].[attrValue] AS [attrValue]
    FROM [ngmd].[ds_attributeView] AS [ds_attributeView]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="ds_featureView" EntityType="Self.ds_featureView" store:Type="Views" store:Schema="ngmd">
            <DefiningQuery>SELECT 
    [ds_featureView].[attributeID] AS [attributeID], 
    [ds_featureView].[partNo] AS [partNo], 
    [ds_featureView].[manufacturer] AS [manufacturer], 
    [ds_featureView].[dataSupplierID] AS [dataSupplierID], 
    [ds_featureView].[featureName] AS [featureName], 
    [ds_featureView].[featureDesc] AS [featureDesc], 
    [ds_featureView].[featureSequence] AS [featureSequence]
    FROM [ngmd].[ds_featureView] AS [ds_featureView]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="ds_productView" EntityType="Self.ds_productView" store:Type="Views" store:Schema="ngmd">
            <DefiningQuery>SELECT 
    [ds_productView].[prodID] AS [prodID], 
    [ds_productView].[partno] AS [partno], 
    [ds_productView].[manufacturer] AS [manufacturer], 
    [ds_productView].[dataSupplierID] AS [dataSupplierID], 
