@using System.Configuration

<div class="g-fs-lg g-fw-b">Your results</div>
<div class="row g-m-0 g-b-rlt-1-p g-m-t-5 g-flex-vcenter g-bc-s">
    <div class="g-w-140 restrict-images">
        <img class="g-p-20" src="@ViewBag.ImageUrl" alt="@ViewBag.ProductName" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg ';" />
    </div>
    <div class="g-p-l-10">
        <div class="g-fw-b">@ViewBag.ProductName</div>
        <div>
            <i class="fa fa-question-circle" data-toggle="tooltip" data-placement="bottom" title="Here we quote the average number of pages that this cartridge will print at the standard coverage rate of 5%"></i>
            <span class="g-fw-b"> 5 % Coverage: </span>@ViewBag.PageYield Pages
        </div>
    </div>
</div>
<div class="g-b-1-p g-p-20 g-bc-s">
    <div class="g-fw-b">Printing <span class="g-fc-s">@ViewBag.PrintsPerDay</span> pages per <span class="g-fc-s">@ViewBag.FLegend</span> at <span class="g-fc-s">@ViewBag.PageCoverage%</span> coverage, it is estimated your cartridge will last...</div>
    <div class="g-b-1-p text-center g-p-10 g-m-t-10 g-fc-s g-fw-b">@ViewBag.Endurance</div>
    <div class="g-m-t-20 text-center"><a class="btn g-butt-primary g-butt-100p" id="productLink" href="@ViewBag.Url">View Product</a></div>
</div>