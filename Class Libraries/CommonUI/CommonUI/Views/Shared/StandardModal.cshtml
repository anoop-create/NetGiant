<div class="modal fade custom-popup donotremove" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" style="overflow-y: auto;">
            <div class="g-ps-r g-bc-secondary">
                <div class="g-fs-lg g-fc-st g-w-100p text-center g-p-20">@ViewBag.StandardModalTitle</div>
                <div class="g-ps-a g-top-0 g-rt-0 g-fc-st g-m-10 g-flex-allcenter">
                    <i class="fa fa-times fa-lg g-cur-p" data-dismiss="modal" aria-label="Close"></i>
                </div>
            </div>
            <div class="comparison g-m-tb-10 g-bc-s modal-scroll">
                <div class="text-center g-m-t-20">
                    <i class="fa fa-spinner fa-pulse fa-3x fa-fw"></i>
                </div>
            </div>
        </div>
    </div>
</div>
