@using System.Configuration;
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;

@model CheckoutViewModel

@{
    Layout = "~/Views/Shared/_LayoutCheckout.cshtml";

    bool zeroBasket = Model.BasketTotals.GrandTotalIncVat < 0.01m;
    bool canApplyForCredit = Convert.ToInt32(ConfigurationManager.AppSettings["WebsiteId"]) == 1 && @Model.BasketTotals.GrandTotalIncVat > 0;
    bool hasBillingAddress = Model.CheckoutDetails.BillingAddress != null;
}

<div class="comm-content g-bc-p g-p-b-60 g-b-t-1">
    <div class="container body-content g-ps-r">

        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <div class="row">

                    <!-- Left Hand Column -->
                    <div class="col-md-9">
                        <hr class="g-m-b-20" />
                        @using (Html.BeginForm(zeroBasket ? "Stage3" : "Stage2",
                            "Checkout",
                            FormMethod.Post,
                            new { id = "co-stage1", autocomplete = "off", onsubmit = "return tidyUpStage1()" }))
                        {
                            bool isAccountCustomer = Convert.ToBoolean(Session["U_IsAccountCustomer"]);
                            @Html.HiddenFor(x => x.CheckoutDetails.DeliveryMethod)
                            @Html.HiddenFor(x => x.PreviousPage, new { @Value = "Stage1" })

                            <!-- Recipient Name / Tel -->
                            <h2>Your Details</h2>

                            <div class="container-fluid">
                                <div class="row">
                                    <div class="pull-left g-inp-sm">
                                        <div class="g-m-t-10">TITLE*</div>
                                        <div class="pull-left g-inp-sm g-m-t-3 clearfix">
                                            @Html.DropDownListFor(x => x.CheckoutDetails.Name.Title, Model.TitleList, "Select", new { @class = "selectpicker" })
                                        </div>
                                    </div>

                                    <div class="pull-left g-w-20">&nbsp;</div>

                                    <div class="pull-left g-inp-md">
                                        <div class="g-m-t-10">FIRST NAME*</div>
                                        <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                            @Html.EditorFor(x => x.CheckoutDetails.Name.Firstname, new { htmlAttributes = new { placeholder = "First Name", @class = "g-b-1-p" } })
                                        </div>
                                    </div>

                                    <div class="pull-left g-w-20">&nbsp;</div>

                                    <div class="pull-left g-inp-md">
                                        <div class="g-m-t-10">LAST NAME*</div>
                                        <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                            @Html.EditorFor(x => x.CheckoutDetails.Name.Surname, new { htmlAttributes = new { placeholder = "Last Name", @class = "g-b-1-p" } })
                                        </div>
                                    </div>
                                </div>

                                <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

                                @if (!isAccountCustomer && canApplyForCredit)
                                {
                                    <div class="row g-m-t-5">
                                        <div class="g-inp-md">CONTACT NUMBER*</div>
                                    </div>
                                    <div class="row g-m-t-3">
                                        <div class="g-inp-md clearfix g-d-ib">
                                            @Html.EditorFor(x => x.CheckoutDetails.TelephoneNumber, new { htmlAttributes = new { placeholder = "Landline or Mobile Number", @class = "g-b-1-p" } })
                                        </div>
                                        <div class="g-d-ib g-fc-tt g-fs-sm g-w-225 g-va-m g-p-l-10">
                                            Our courier may need to use this number when delivering the order.
                                        </div>
                                    </div>
                                    <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

                                    Model.AccountApplicationDetails.Section = AccountApplicationSection.CustomerType;
                                    Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                    {
                                        TemplateInfo = new TemplateInfo()
                                        {
                                            HtmlFieldPrefix = "AccountApplicationDetails"
                                        }
                                    });
                                }
                                else
                                {
                                    <div class="row g-m-t-5">
                                        <div class="g-inp-md">CONTACT NUMBER*</div>
                                    </div>
                                    <div class="row g-m-t-3">
                                        <div class="g-inp-md clearfix">
                                            @Html.EditorFor(x => x.CheckoutDetails.TelephoneNumber, new { htmlAttributes = new { placeholder = "Landline or Mobile Number", @class = "g-b-1-p" } })
                                        </div>
                                    </div>
                                    <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                }
                            </div>

                            <hr class="g-m-t-40 g-m-b-20" />

                            <!-- Delivery Details -->
                            <div id="co-section-delivery" class="clearfix">
                                <h2>Delivery Details</h2>

                                <div class="container-fluid">

                                    <!-- Recipient Name -->
                                    <div>
                                        <div class="row">
                                            <div class="pull-left g-inp-sm">
                                                <div class="g-m-t-10">TITLE*</div>
                                                <div class="pull-left g-inp-sm g-m-t-3 clearfix">
                                                    @Html.DropDownListFor(x => x.CheckoutDetails.RecipientName.Title, Model.TitleList, "Select...", new { @class = "selectpicker" })
                                                </div>
                                            </div>

                                            <div class="pull-left g-w-20">&nbsp;</div>

                                            <div class="pull-left g-inp-md">
                                                <div class="g-m-t-10">FIRST NAME*</div>
                                                <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                                    @Html.EditorFor(x => x.CheckoutDetails.RecipientName.Firstname, new { htmlAttributes = new { placeholder = "First Name", @class = "g-b-1-p" } })
                                                </div>
                                            </div>

                                            <div class="pull-left g-w-20">&nbsp;</div>

                                            <div class="pull-left g-inp-md">
                                                <div class="g-m-t-10">LAST NAME*</div>
                                                <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                                    @Html.EditorFor(x => x.CheckoutDetails.RecipientName.Surname, new { htmlAttributes = new { placeholder = "Last Name", @class = "g-b-1-p" } })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                    </div>

                                    <!-- Recipient Address -->
                                    <!-- New Address Or Single Address -->
                                    <div id="single-address" class="@(ViewBag.SingleAddress ? "" : "g-d-n")">
                                        @Html.EditorFor(m => m.CheckoutDetails.DeliveryAddress)
                                    </div>

                                    <!-- Multiple Addresses -->
                                    <div id="multi-address" class="@(ViewBag.SingleAddress ? "g-d-n" : "")">
                                        <div class="row g-m-t-5">
                                            <div>SELECT A DELIVERY ADDRESS</div>
                                        </div>
                                        <div id="additional-addresses" class="g-d-n">@Model.AdditionalAddressesJson</div>
                                        <div class="row g-b-1-p g-bc-s g-m-t-3">
                                            <div class="moreLess" data-num-items="10" data-buttclass="g-m-20 g-butt-lg" data-scroll-offset="40">
                                                @{
                                                    bool check = true;

                                                    foreach (Address add in Model.AdditionalAddresses)
                                                    {
                                                        <div class="g-p-10">
                                                            <div class="clearfix">
                                                                <div class="checkbox checkbox-success pull-left g-m-0">
                                                                    @if (check)
                                                                    {
                                                                        <input class="g-h-a" name="multiaddress" id="multiaddress@(add.Id.ToString())" value="@(add.Id.ToString())" checked="checked" type="radio">
                                                                    }
                                                                    else
                                                                    {
                                                                        <input class="g-h-a" name="multiaddress" id="multiaddress@(add.Id.ToString())" value="@(add.Id.ToString())" type="radio">
                                                                    }
                                                                    <label for="multiaddress@(add.Id.ToString())"></label>
                                                                </div>
                                                                <div class="g-p-l-50">@add.Line1</div>
                                                                <div class="g-p-l-50">@add.Line2</div>
                                                                <div class="g-p-l-50">@add.Line3</div>
                                                                <div class="g-p-l-50">@add.Line4</div>
                                                                <div class="g-p-l-50">@add.Line5</div>
                                                                <div class="g-p-l-50">@add.PostCode</div>
                                                            </div>
                                                        </div>
                                                        <hr />

                                                        check = false;
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <div class="row g-m-t-10">
                                            <button class="g-butt-second-reg g-butt-lg-2" type="button">
                                                <i class="fa fa-plus fa g-p-r-10"></i>
                                                Add Address
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <hr class="g-m-t-40 g-m-b-20" />

                            <!-- Delivery Options -->
                            <div id="co-section-delivery-options" class="clearfix">
                                <h2>Delivery Options</h2>
                                @if (Model.DeliveryOptions.Count == 0)
                                            {
                                    <div class="enter-delivery-label">Please enter a delivery address to show delivery options</div>
                                    <div id="delivery-options" class="g-bc-s"></div>
                                }
                                else
                                {
                                    <div id="delivery-options" class="g-bc-s g-b-rlt-1-p">
                                        @{
                                            Html.RenderPartial("~/Views/Checkout/DeliveryOptions.cshtml", Model.DeliveryOptions, new ViewDataDictionary { { "DeliveryServiceId", Model.CheckoutDetails.DeliveryServiceId } });
                                        }
                                    </div>
                                }
                            </div>

                            <!-- Zero Stock -->
                            if (Model.CheckoutDetails.ZeroStock)
                            {
                                Dictionary<string, string> replacements = new Dictionary<string, string>();
                                            replacements.Add("[Tel-No]", Html.RawFromDict(Model.CommonData, "TelephoneNumber").ToString());
                                <div class="g-bc-note g-b-1-p g-p-10 g-m-t-10">@(Html.RawFromDict(Model.CheckoutData, "ZeroStock", replacements))</div>
                            }

                            <!-- Password -->
                            if (!ViewBag.IsPortalUser)
                            {
                                <div class="clearfix @(ViewBag.IsAuthenticated ? "g-d-n" : "")">
                                    <hr class="g-m-t-40 g-m-b-20" />

                                    <h2>Set a Password</h2>

                                    <div class="container-fluid">
                                        <div class="row g-m-t-5">
                                            <div class="g-inp-md">PASSWORD*</div>
                                        </div>
                                        <div class="row g-m-t-3">
                                            <div class="g-inp-md clearfix pull-left">
                                                @if (ViewBag.IsAuthenticated)
                                            {
                                                @Html.PasswordFor(x => x.CheckoutDetails.Password, new { placeholder = "New Password (Min 6 Characters)", @class = "g-b-1-p", data_val = "false", autocomplete = "new-password" })
                                                }
                                                else
                                                {
                                                    @Html.PasswordFor(x => x.CheckoutDetails.Password, new { placeholder = "New Password (Min 6 Characters)", @class = "g-b-1-p", autocomplete = "new-password" })
                                                }
                                            </div>
                                            <div class="pull-left g-m-l-10 g-fs-sm g-m-t-5 g-lh-15">
                                                <div>By creating an account, you agree</div>
                                                <div>
                                                    to our <a href="/help/policies/" target="_blank">Terms and Conditions</a>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                    </div>
                                </div>

                                @Html.HiddenFor(x => x.CheckoutDetails.SuppressEmail)
                            }
                            else
                            {
                                if (Model.CheckoutDetails.Password.Length < 6)
                                {
                                    @Html.HiddenFor(x => x.CheckoutDetails.Password, new { data_val = false })
                                }
                                else
                                {
                                    @Html.HiddenFor(x => x.CheckoutDetails.Password)
                                }

                                <hr class="g-m-t-40 g-m-b-20" />

                                <div class="container-fluid">
                                    <div class="row g-flex-vcenter">
                                        <div class="checkbox checkbox-success">
                                            @Html.CheckBoxFor(x => x.CheckoutDetails.SuppressEmail)
                                            <label for="SuppressEmail">
                                                <span class="g-i">
                                                    <strong>Do not</strong>
                                                </span> send the order confirmation email.
                                            </label>
                                        </div>
                                    </div>
                                    <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                </div>
                            }

                            <!-- Newsletter -->
                            <div class="clearfix @(ViewBag.HideNewsletter ? "g-d-n" : "")">
                                <hr class="g-m-t-40 g-m-b-20" />
                                <div class="container-fluid">
                                    <div class="row g-flex-vcenter">
                                        <div class="checkbox checkbox-success">
                                            @Html.CheckBoxFor(x => x.CheckoutDetails.Newsletter)
                                            <label for="Newsletter">I agree to receive the @Html.RawFromDict(Model.CommonData, "SiteName").ToString() newsletter exclusive offers and services.</label>
                                        </div>
                                    </div>
                                    @Html.RawFromDict(Model.CheckoutData, "NewsletterNotice")
                                    <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                </div>
                            </div>

                            <div id="paym-required">
                                <hr class="g-m-t-40 g-m-b-20">

                                <!-- Payment Method -->
                                <h2>Select a Payment Method</h2>

                                <div class="row co-paym">
                                    @if (isAccountCustomer)
                                            {
                                        <div class="col-lg-5ths col-md-6 col-sm-6">
                                            <div class="text-center g-m-b-5">
                                                <strong>Credit Account</strong>
                                            </div>
                                            <div class="co-paym-button g-cur-p g-bc-secondary" data-id="@PaymentMethod.Account.ToString()">
                                                <input type="radio" class="g-m-lr-ai g-d-b g-w-20 g-h-40 g-cur-p" name="radioPaymentMethod" />
                                                <span class="g-m-a-0 g-w-100p g-h-90 g-flex-allcenter g-m-t-m5 g-p-b-10" title="Pay on account">
                                                    <img class="msp_paym_account" src="~/Content/Images/1pxTrans.png" alt="Pay on account" />
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-lg-5ths col-md-6 col-sm-6">
                                        <div class="text-center g-m-b-5">
                                            <strong>Credit / Debit Card</strong>
                                        </div>
                                        <div class="co-paym-button g-cur-p g-bc-secondary" data-id="@PaymentMethod.CreditDebit.ToString()">
                                            <input type="radio" class="g-m-lr-ai g-d-b g-w-20 g-h-40 g-cur-p" name="radioPaymentMethod" />
                                            <span class="g-m-a-0 g-w-100p g-h-90 g-flex-allcenter g-m-t-m5 g-p-b-10" title="Pay by credit/debit card">
                                                <img class="msp_paym_creditDebit" src="~/Content/Images/1pxTrans.png" alt="Pay by credit/debit card" />
                                            </span>
                                        </div>
                                    </div>
                                    @if (Session["U_AffiliateNo"] == null || (Session["U_AffiliateNo"].ToString() != "54760" && Session["U_AffiliateNo"].ToString() != "57697"))
                                    {
                                        <div class="col-lg-5ths col-md-6 col-sm-6">
                                            <div class="text-center g-m-b-5">
                                                <strong>Pay Over the Phone</strong>
                                            </div>
                                            <div class="co-paym-button g-cur-p g-bc-secondary" data-id="@PaymentMethod.Phone.ToString()">
                                                <input type="radio" class="g-m-lr-ai g-d-b g-w-20 g-h-40 g-cur-p" name="radioPaymentMethod" />
                                                <span class="g-m-a-0 g-w-100p g-h-90 g-flex-allcenter g-m-t-m5 g-p-b-10" title="Pay over the phone">
                                                    <img class="msp_paym_phone" src="~/Content/Images/1pxTrans.png" alt="Pay over the phone" />
                                                </span>
                                            </div>
                                        </div>
                                        if (!isAccountCustomer)
                                        {
                                            <div class="col-lg-5ths col-md-6 col-sm-6">
                                                <div class="text-center g-m-b-5">
                                                    <strong>Bank Transfer</strong>
                                                </div>
                                                <div class="co-paym-button g-cur-p g-bc-secondary" data-id="@PaymentMethod.BACS.ToString()">
                                                    <input type="radio" class="g-m-lr-ai g-d-b g-w-20 g-h-40 g-cur-p" name="radioPaymentMethod" />
                                                    <span class="g-m-a-0 g-w-100p g-h-90 g-flex-allcenter g-m-t-m5 g-p-b-10" title="Pay by BACS">
                                                        <img class="msp_paym_bacs" src="~/Content/Images/1pxTrans.png" alt="Pay by BACS" />
                                                    </span>
                                                </div>
                                            </div>

                                            if (canApplyForCredit && !ViewBag.IsPortalUser)
                                            {

                                                <div class="co-paym-accapp col-lg-5ths col-md-6 col-sm-6 @(Model.AccountApplicationDetails.CustomerType == 1 || Model.AccountApplicationDetails.CustomerType == 0 ? "g-d-n" : "")">
                                                    <div class="text-center g-m-b-5 g-m-lr-m5">
                                                        <strong>Apply for Credit Account</strong>
                                                    </div>
                                                    <div class="co-paym-button g-cur-p g-bc-secondary g-h-130" data-id="@PaymentMethod.AccountApplication.ToString()">
                                                        <input type="radio" class="g-m-lr-ai g-d-b g-w-20 g-h-40 g-cur-p" name="radioPaymentMethod" />
                                                        <div class="g-m-a-0 g-w-100p g-h-90 g-m-t-m5 g-p-b-10 g-fc-st g-ta-c" title="Apply for Credit">
                                                            <p class="g-m-5">Quick Apply</p>
                                                            <hr class="g-m-l-20 g-m-r-20" />
                                                            <div class="g-p-t-10 g-p-l-5">
                                                                <img class="msp_paym_app g-d-ib g-va-t" src="~/Content/Images/1pxTrans.png" alt="Credit Account Application" />
                                                                <p class="g-d-ib g-w-80 g-va-t">Decision in under 24 hrs</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <img src="/Content/Images/1pxTrans.png" class="msp_navTabNewLabel g-ps-a co-new-sash" alt="New" />
                                                </div>
                                                <div class="co-paym-accapp col-lg-5ths col-md-6 hidden-xs hidden-sm @(Model.AccountApplicationDetails.CustomerType == 1 || Model.AccountApplicationDetails.CustomerType == 0 ? "g-d-n" : "")">
                                                    @Html.RawFromDict(Model.CheckoutData, "CreditAccountMessage")
                                                </div>
                                            }
                                        }
                                    }
                                </div>

                            </div>

                            @Html.TextBoxFor(x => x.CheckoutDetails.PaymentMethod, new { @class = "g-d-n" })
                            <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

                            <!-- Payment Method Dynamic Content -->
                            <!-- Account -->
                            if (isAccountCustomer)
                            {
                                <div id="co-account" class="container-fluid co-paym-addinfo g-m-b-20">
                                    <div class="row">
                                        @Html.RawFromDict(Model.CheckoutData, "PayByAccount")
                                        <div class="g-bc-s g-b-1-p g-m-t-20">
                                            <div class="g-p-10">
                                                <strong>Your Credit Account</strong>
                                            </div>
                                            <hr />
                                            <div class="g-p-10 g-lh-30">
                                                <div>
                                                    <strong>Credit Account Number: </strong>@Model.CheckoutDetails.AccountNumber
                                                </div>
                                                <div>
                                                    <strong>Main Contact: </strong>@Model.CheckoutDetails.AccountContact
                                                </div>
                                                <div>
                                                    <strong>Contact Number: </strong>@Model.CheckoutDetails.AccountTelNo
                                                </div>
                                                <div>
                                                    <strong>Invoice Email Address: </strong>@Model.CheckoutDetails.AccountEmail
                                                </div>
                                                <div>
                                                    <strong>Invoice Address: </strong>@Model.CheckoutDetails.AccountInvoiceAddress
                                                </div>
                                            </div>
                                        </div>
                                        <div class="g-m-t-10 g-b-1-p g-bc-note g-p-10">
                                            Are these details correct? To make a change to your credit account details please contact us on <strong>@Html.RawFromDict(Model.CommonData, "TelephoneNumber")</strong>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- PayPal -->
                            <div id="co-paypal" class="container-fluid co-paym-addinfo">
                                <div class="row">
                                    <hr class="g-m-t-20 g-m-b-20" />
                                    <h2>Continue to Payment</h2>
                                </div>
                            </div>
                            <!-- Phone -->
                            <div id="co-phone" class="container-fluid co-paym-addinfo">
                                <div class="row">
                                    <hr class="g-m-t-20 g-m-b-20" />
                                    @Html.RawFromDict(Model.CheckoutData, "PayByPhone")
                                </div>
                            </div>
                            <!-- BACS -->
                            <div id="co-bacs" class="container-fluid co-paym-addinfo">
                                <div class="row">
                                    <hr class="g-m-t-20 g-m-b-20" />
                                    @Html.RawFromDict(Model.CheckoutData, "PayByBACS")
                                </div>
                            </div>

                            if (!isAccountCustomer && canApplyForCredit)
                            {
                                <!-- Apply for Credit -->
                                <div id="co-accountapplication" class="container-fluid co-paym-addinfo">
                                    <div class="row">
                                        <hr class="g-m-t-20 g-m-b-20" />
                                    </div>

                                    @{
                                        Model.AccountApplicationDetails.Section = AccountApplicationSection.CreditAccountText;
                                        Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                        {
                                            TemplateInfo = new TemplateInfo()
                                            {
                                                HtmlFieldPrefix = "AccountApplicationDetails"
                                            }
                                        });
                                    }

                                    <div class="row">
                                        <div class="col-md-6 g-p-l-0">
                                            <div class="container-fluid">
                                                @{
                                                    Model.AccountApplicationDetails.Section = AccountApplicationSection.ContactDetails;
                                                    Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                                    {
                                                        TemplateInfo = new TemplateInfo()
                                                        {
                                                            HtmlFieldPrefix = "AccountApplicationDetails"
                                                        }
                                                    });
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6 g-p-r-0">
                                            <div class="container-fluid">
                                                @{
                                                    Model.AccountApplicationDetails.Section = AccountApplicationSection.OrganisationInformation;
                                                    Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                                    {
                                                        TemplateInfo = new TemplateInfo()
                                                        {
                                                            HtmlFieldPrefix = "AccountApplicationDetails"
                                                        }
                                                    });
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div id="co-company-id">
                                        @{
                                            Model.AccountApplicationDetails.Section = AccountApplicationSection.CompanyIdentifier;
                                            Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                            {
                                                TemplateInfo = new TemplateInfo()
                                                {
                                                    HtmlFieldPrefix = "AccountApplicationDetails"
                                                }
                                            });
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Billing Address -->
                            if (ViewBag.IsAccountCustomer)
                            {
                                <div class="co-bill-address g-m-t-20 g-d-n">
                                    <h2>Billing Address</h2>
                                    <div class="g-bc-note g-b-1-p g-p-10 g-m-t-20 clearfix">
                                        <span>
                                            We have detected you are registered with a credit account, please contact us to change your billing address. Call @Html.RawFromDict(Model.CommonData, "TelephoneNumber") or email
                                            <a href="mailto:@Html.RawFromDict(Model.CommonData, "SupportEmail")">@Html.RawFromDict(Model.CommonData, "SupportEmail")</a>
                                        </span>
                                    </div>
                                    <div class="g-bc-s g-b-1-p g-m-t-20 g-p-10">
                                        <div>Your current billing address is:</div>
                                        @Html.DisplayAddressDetails(Model.CheckoutDetails.BillingAddress)
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div id="co-bill-search" class="g-m-t-20 g-d-n">
                                    <hr class="g-m-t-20 g-m-b-20" />
                                    <h2>Billing Address</h2>

                                    <div class="container-fluid">
                                        <div class="row g-flex-vcenter">
                                            <div class="checkbox checkbox-success">
                                                <input id="same-address" type="checkbox" class="no-validation" />
                                                <label for="same-address">Same as delivery address.</label>
                                            </div>
                                        </div>

                                        <div id="co-billadd-search" class="">
                                            @Html.EditorFor(m => m.CheckoutDetails.BillingAddress)
                                        </div>
                                    </div>
                                </div>
                            }


                            if (!isAccountCustomer && canApplyForCredit)
                            {
                                <div class="container">
                                    @{
                                        Model.AccountApplicationDetails.Section = AccountApplicationSection.BillingAddress;
                                        Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                        {
                                            TemplateInfo = new TemplateInfo()
                                            {
                                                HtmlFieldPrefix = "AccountApplicationDetails"
                                            }
                                        });
                                    }
                                </div>
                            }

                            <!-- Purchase Order Reference -->
                            <div id="co-po-ref" class="g-d-n">
                                <hr class="g-m-t-40 g-m-b-20" />
                                <h2>Purchase Order Reference (Optional)</h2>

                                <div class="container-fluid">
                                    <div class="row g-m-t-5">
                                        <div class="g-inp-md">REFERENCE</div>
                                    </div>
                                    <div class="row g-m-t-3">
                                        @if (!isAccountCustomer && canApplyForCredit)
                                        {
                                            <div class="g-inp-md clearfix g-d-ib">
                                                @Html.EditorFor(x => x.CheckoutDetails.Reference, new { htmlAttributes = new { placeholder = "Purchase order reference", @class = "g-b-1-p" } })
                                            </div>
                                            <div class="g-d-ib g-fc-tt g-fs-sm g-w-225 g-va-m g-p-l-10">
                                                Optional reference to identify this order in your account, this will also show on your invoice.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="g-inp-md clearfix">
                                                @Html.EditorFor(x => x.CheckoutDetails.Reference, new { htmlAttributes = new { placeholder = "Purchase order reference", @class = "g-b-1-p" } })
                                            </div>
                                        }
                                    </div>
                                    <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                    @if (ViewBag.IsPortalUser)
                                    {
                                        <div class="row">
                                            <div class="pull-left g-inp-md">CUSTOMER SERVICE NOTES</div>
                                        </div>
                                        <div class="row g-m-t-3">
                                            <div class="g-inp-md clearfix">
                                                @Html.TextAreaFor(x => x.CheckoutDetails.OrderNote, new { cols = 86, @rows = 3, placeholder = "Enter Customer Service Notes", @class = "g-b-1-p g-p-10" })
                                            </div>
                                        </div>
                                        <div class="row clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>
                                    }
                                </div>
                            </div>

                            if (!isAccountCustomer && canApplyForCredit)
                            {
                                <!-- Direct debit -->
                                <div id="co-credit-paym" class="container-fluid g-d-n">
                                    @{
                                        Model.AccountApplicationDetails.Section = AccountApplicationSection.Payment;
                                        Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                        {
                                            TemplateInfo = new TemplateInfo()
                                            {
                                                HtmlFieldPrefix = "AccountApplicationDetails"
                                            }
                                        });
                                    }
                                </div>

                                <!-- Credit terms and conditions -->
                                <div id="co-credit-tc" class="container-fluid g-d-n">
                                    @{
                                        Model.AccountApplicationDetails.Section = AccountApplicationSection.CreditTerms;
                                        Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
                                        {
                                            TemplateInfo = new TemplateInfo()
                                            {
                                                HtmlFieldPrefix = "AccountApplicationDetails"
                                            }
                                        });
                                    }
                                </div>
                            }

                            <div>
                                <div id="co-submit-button" class="g-d-n g-d-ib g-va-t">
                                    <button type="submit" class="g-butt-primary g-butt-xl g-m-t-20"></button>
                                </div>
                                <div id="co-privacy-notice" class="g-d-n g-d-ib">
                                    @Html.RawFromDict(Model.CheckoutData, "PrivacyNotice")
                                </div>
                            </div>

                            @Html.ValidationSummary()

                        }

                        <input type="hidden" id="IsAuthenticated" value="@(ViewBag.IsAuthenticated ? "1" : "0")" />

                        <div class="g-m-t-60">
                            @{
                                Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                            }
                        </div>
                    </div>
                    <!-- Right Hand Column -->
                    <div class="col-md-3 restrict-images hidden-xs hidden-sm">
                        <hr class="g-m-b-20" />
                        <div id="orderSummaryContainer">
                            @{
                                Html.RenderPartial("~/Views/Checkout/OrderSummary.cshtml", Model);
                            }
                        </div>

                        <div class="g-bc-s g-b-1-p g-m-t-10">
                            <div class="g-p-10">
                                <strong>Payment Methods</strong>
                            </div>
                            <hr />
                            <div class="g-p-10 text-center">
                                @Html.Raw(Model.CheckoutData["PaymentMethods"].Replace("[newline]", "&#013;"))
                            </div>
                        </div>

                        <div class="g-m-t-20">
                            @Html.RawFromDict(Model.CheckoutData, "SecureMessage")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input hidden="hidden" class="IsInCheckout" />

@section scripts
{
    <script type="text/javascript">

        $.validator.setDefaults({ ignore: null });

        $(function () {
            $('#co-stage1').data('validator').settings.showErrors = function(map, errors) {
                this.defaultShowErrors();
                if ($('div[data-valmsg-summary=true] li:visible').length) {
                    this.checkForm();
                    if (this.errorList.length) {
                        $(this.currentForm).triggerHandler("invalid-form", [this]);
                    } else {
                        $(this.currentForm).find("[data-valmsg-summary=true]")
                                           .removeClass("validation-summary-errors")
                                           .addClass("validation-summary-valid")
                                           .find("ul")
                                           .empty();
                    }
                }
            }
        });

        $(document).ready(function () {

            if (@Model.BasketTotals.GrandTotalIncVat < 0.01) {
                $('#paym-required').addClass('g-d-n');
                $('#co-submit-button').removeClass('g-d-n');
                $('#co-submit-button > button').text('Complete Order');
            } else {
                $('#paym-required').removeClass('g-d-n');
                $('#co-submit-button').addClass('g-d-n');
            }
        });
    </script>
    @Scripts.Render("~/bundles/checkoutBundle.js")
}


