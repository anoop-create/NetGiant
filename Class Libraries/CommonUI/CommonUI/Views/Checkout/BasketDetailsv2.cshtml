@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework
@using CommonUI.Models;
@using Kendo.Mvc.UI
@using VmVoucherType = VMerchantWrapper.Entities.VoucherType

@model CheckoutViewModel

@if (Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery > 0)
{
    bool isAdminDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.AdminDiscount);
    bool isCompatibleDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.CompatibleDiscount);

    <div class="row">
        <div class="col-md-12">
            <hr class="g-m-b-10 hidden-xs hidden-sm" />
            <div class="row g-fw-b">
                <div class="col-lg-6 col-md-5">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-lg-10 col-md-12 pull-left">
                                Items <span class="g-fc-s">(<span class="basketQuantity">@Model.BasketTotals.Quantity.ToString("##0")</span>)</span>
                            </div>
                            <div class="col-lg-2 g-m-l-a g-p-r-10 hidden-md hidden-sm hidden-xs pull-right">Price</div>
                        </div>
                    </div>
                </div>
                @if (!Model.IsMobile)
                {
                    <div class="col-md-7 col-lg-6 hidden-xs hidden-sm">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="col-md-3 g-p-lr-0">
                                    <div class="g-m-l-10 text-center pull-left">
                                        Quantity
                                    </div>
                                </div>
                                <div class="col-md-6 g-p-lr-0">
                                    <div class="text-center">
                                        Potential Saving
                                    </div>
                                </div>
                                <div class="col-md-3 g-p-lr-0">
                                    <div class="g-m-l-a g-p-r-20 hidden-xs hidden-sm pull-right">
                                        Sub-Total
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div id="basketSummary" class="basketSummaryContainer">
                @{
                    bool isMultiBuy = false;
                    decimal multibuyAmount = decimal.Zero;
                    Model.CheckZeroStock();
                    foreach (BasketContents bc in Model.BasketContents)
                    {
                        if (bc.ItemType == BasketItemType.Item || bc.ItemType == BasketItemType.AdminDiscount)
                        {
                            string neg = bc.ItemType == BasketItemType.AdminDiscount ? "-" : "";
                            string strike = "";
                            string discClass = "g-d-n";
                            decimal discUnitPrice = decimal.Zero;
                            decimal subt = bc.PriceEx * bc.Quantity;
                            decimal discountRate = Utilities.GetUpsellRate();
                            //decimal potentialDiscountRate = decimal.Zero;
                            if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                !isAdminDiscount &&
                                //bc.IsUpsellTriggered &&
                                bc.Quantity > bc.QtyStart)
                            {
                                discUnitPrice = Math.Round(bc.PriceEx, 2) - Math.Round(bc.PriceEx * discountRate / 100, 2);
                                //discUnitPrice = Math.Round(bc.PriceEx * (100 - discountRate) / 100, 2);
                                subt = discUnitPrice * bc.Quantity;
                                strike = "g-s";
                                discClass = "";
                            }

                            <hr class="g-m-tb-10" />
                            <div class="row basket-entry g-m-tb-10 clearfix atb-entry" data-productid="@bc.StockRef">
                                <div class="col-md-5 col-lg-6 clearfix">
                                    <div class="container-fluid">
                                        <div class="row">
                                            <div class="col-lg-4 col-md-5 g-p-lr-0 g-m-t-5">
                                                <a class="primary" href="@bc.ProductUrl">
                                                    <img class="g-b-1-p" src="@bc.ImageUrl" alt="@bc.Description" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';">
                                                </a>
                                            </div>
                                            <div class="col-lg-6 col-md-7 g-p-lr-0 g-m-t-10">
                                                <div class="">
                                                    <a class="primary" href="@bc.ProductUrl">@bc.Description</a>
                                                </div>
                                                <div class="g-fs-sm g-m-t-5">
                                                    <strong>Product Code:</strong> @bc.PartNo
                                                </div>
                                                @if (!Model.IsMobile)
                                                {
                                                    <div class="text-center g-m-t-10 g-fs-sm g-lh-20 hidden-sm hidden-xs">@Html.ProductAvailability(bc.Availability, Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()))</div>
                                                }
                                            </div>
                                            @if (!Model.IsMobile)
                                            {
                                                <div class="col-lg-2 g-p-lr-0 g-m-l-a be-Price pull-right hidden-md hidden-sm hidden-xs text-center">
                                                    <div class="g-m-tb-50p">
                                                        <div class="@strike">@neg@string.Format("{0:C}", bc.PriceEx)</div>
                                                        <div class="@discClass">@neg@string.Format("{0:C}", discUnitPrice)</div>
                                                    </div>
                                                </div>
                                            }
                                            <div class="col-xs-12 g-p-lr-0 be-Price hidden-lg">
                                                <span class="@strike">@neg@string.Format("{0:C}", bc.PriceEx)</span>&nbsp;
                                                <span class="@discClass">@neg@string.Format("{0:C}", discUnitPrice) ea.</span>
                                            </div>
                                            <div class="atb-add g-d-n"
                                                 data-price="0"
                                                 data-productid="@bc.StockRef"
                                                 data-partno="@bc.PartNo"
                                                 data-imageurl="@bc.ImageUrl"
                                                 data-desc="@bc.Description">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-7 col-lg-6">
                                    <div class="container-fluid">
                                        <div class="row">
                                            <div class="col-md-3 g-p-lr-0">
                                                <div class="g-m-l-10-md g-m-t-30 text-md-center">
                                                    @if (!bc.IsFreeGift)
                                                    {
                                                        <div class="g-w-78 g-h-40">

                                                            @* NB The settings in the Kendo statement below are repeated in site.js:changeBasketQty *@
                                                            @(Html.Kendo().NumericTextBox<int>()
                                                          .Format("#")
                                                          .Name("qty-" + bc.StockRef)
                                                          .Value(int.Parse(bc.Quantity.ToString()))
                                                          .Placeholder("Enter quantity")
                                                          .HtmlAttributes(new { style = "width: 100%; height: 34px; background-color: transparent;", @class = "atb-qty" })
                                                          .Min(1)
                                                          .Max(1000)
                                                          .Events(e => e
                                                            .Change("changeBasketQty")
                                                            .Spin("changeBasketQty"))
                                                          .Deferred()
                                                            )

                                                        </div>
                                                        <div class="delete g-m-t-10 g-fs-sm g-i g-cur-p" data-productid="@bc.StockRef" title="Remove this item from the basket">
                                                            Remove
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6 g-p-lr-0 text-md-right">
                                                @if (!bc.IsCompatible && !String.IsNullOrEmpty(bc.CrossSellingStockRef) && !bc.ExcludeFromUpSell)
                                                {
                                                    List<int> inStock = new List<int> { 1, 7 }; // Availability codes which indicate item in stock
                                                    if (inStock.Contains(bc.CrossSellingAvailability))
                                                    {
                                                        decimal saving = (bc.PriceEx - bc.CrossSellingPriceEx) * bc.Quantity;
                                                        if (saving > 0)
                                                        {
                                                            <button class="atb-replace btn g-butt-important g-br-3 g-m-t-30 g-p-lr-5 g-h-40"
                                                                    title="Click to replace this item with the equivalent &#10;@bc.CrossSellingDescription"
                                                                    data-productid="@bc.CrossSellingStockRef"
                                                                    data-price="@bc.CrossSellingPriceEx"
                                                                    data-removeid="@bc.StockRef"
                                                                    data-qty="@bc.Quantity.ToString()">
                                                                Save @string.Format("{0:C}", saving) Now!
                                                                <div class="g-fs-sm">Replace with compatible product</div>
                                                            </button>
                                                        }
                                                    }
                                                }
                                                @if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                                     Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                                     !isAdminDiscount)
                                                {
                                                    decimal saving = Math.Round(bc.PriceEx * discountRate / 100, 2);
                                                    string btnMsg = "";
                                                    if (bc.Quantity <= bc.QtyStart)
                                                    {
                                                        btnMsg = "Get " + discountRate + "% off (" + saving.ToString("C") + " ex VAT)<div class=\"g-fs-sm\">Each item when you put " + (bc.QtyStart + 1) + "+ in the basket</div>"; // "Save " + saving.ToString("C") + " ex VAT per item</div>");
                                                        <button class="btn g-butt-important g-br-3 g-m-t-30 g-p-lr-5 g-h-40"
                                                                title="Click to get this offer"
                                                                onclick="changeBasketQty('@bc.StockRef', @(bc.QtyStart + 1))">
                                                            @Html.Raw(btnMsg)
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        if (bc.Quantity > 1)
                                                        {
                                                            btnMsg = "Wow, you're saving " + discountRate + "%, that's<div>" + saving.ToString("C") + " ex VAT on each item!";
                                                            <button class="btn g-butt-important g-br-3 g-m-t-30 g-p-lr-5 g-h-40"
                                                                    title="Click to add another to the basket"
                                                                    onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))">
                                                                @Html.Raw(btnMsg)
                                                            </button>
                                                        }
                                                    }
                                                }
                                            </div>
                                            <div class="col-md-3 g-p-lr-0">
                                                <div class="g-m-l-a g-m-t-40 g-p-r-20 text-md-right">
                                                    <div>@neg @string.Format("{0:C}", subt)</div>
                                                    @{
                                                        if (Session["V_Voucher"] != null)
                                                        {
                                                            VoucherPromo vp = (VoucherPromo)Session["V_Voucher"];
                                                            if (bc.IsVoucherQualifyingItem && vp.VoucherTypeFk == (int)VmVoucherType.Percentage)
                                                            {
                                                                <div class="g-m-t-20 g-fs-sm g-fc-pm g-i g-cur-p">
                                                                    Voucher Applied
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        if (bc.ItemType == BasketItemType.CompatibleDiscount)
                        {
                            isMultiBuy = true;
                            multibuyAmount = bc.PriceEx;

                        }
                    }

                    <hr class="g-m-tb-10" />
                }
            </div>
        </div>
    </div>

    <div class="row">
        <div class="basket-voucher col-md-8">
            @if ((Model.CheckoutDetails.ZeroStock || Model.CheckoutDetails.IsSpecialOrder) && !Convert.ToBoolean(Session["U_IsPortalUser"]))
            {
                Dictionary<string, string> replacements = new Dictionary<string, string>();
                <div class="g-bc-note g-b-1-p g-p-10 g-m-t-10 g-w-345 g-fs-sm">@(Html.RawFromDict(Model.CheckoutData, "ZeroStock", replacements))</div>
            }

            @if (!isAdminDiscount)
            {
                if (Session["B_VoucherCode"].ToSafeString() != "")
                {
                    <div class="g-fc-secondary g-m-t-10">
                        <strong>Voucher code</strong>
                    </div>
                    <div id="voucher-msg" class="g-m-t-10">
                        <span>Voucher<strong> @Session["B_VoucherCode"].ToSafeString()</strong> has been recognised. Please note that only one offer can be applied to an order.</span>
                        <span>
                            <a class="remove-voucher">[Remove]</a>
                        </span>
                    </div>
                    if (!string.IsNullOrEmpty(ViewBag.VoucherMessage))
                    {
                        <div class="g-d-ib">
                            <div class="error-message g-m-t-10">
                                @Html.Raw(ViewBag.VoucherMessage)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="g-fc-secondary g-m-t-10">
                        <strong>Add a voucher code</strong>
                    </div>
                    <div class="bkt-voucher input-group g-m-t-10 g-w-345">
                        <input id="voucher-code" class="form-control g-h-40 pull-left" placeholder="Enter Voucher Code ..." type="text">
                        <span class="input-group-btn">
                            <button id="apply-voucher" class="g-butt-secondary g-butt-lg g-fs-n" type="button">Apply Voucher</button>
                        </span>
                    </div>
                    <div class="g-d-ib">
                        <div class="error-message g-d-n g-m-t-10">
                            <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                            <p class="g-m-0 g-d-i g-p-r-10"></p>
                        </div>
                    </div>
                }
            }
            @if (Convert.ToBoolean(Session["U_IsPortalUser"]))
            {
                <div class="g-m-t-60 g-m-b-20 g-br-0 panel panel-default">
                    <div class="panel-heading g-fw-b">Customer Service Tools</div>
                    <div class="panel-body">
                        @if (String.IsNullOrEmpty(Session["B_VoucherCode"] as string))
                        {
                            if (isAdminDiscount)
                            {
                                <div class="g-m-t-10 g-fw-b">ADMIN DISCOUNT HAS BEEN APPLIED TO THIS ORDER</div>
                            }
                            else
                            {
                                <div class="g-fc-secondary g-m-t-10">Administrator Discount Inc.Vat</div>
                                <div class="atb-entry bkt-discount input-group g-m-t-10 g-w-345">
                                    <span class="input-group-addon g-br-0 g-fc-tt g-b-n g-bc-s" style="border-right: 1px solid #cccccc !important;">-&pound;</span>
                                    <input id="admin-discount" class="form-control g-h-40 pull-left" placeholder="Enter discount ..." type="number">
                                    <span class="input-group-btn">
                                        <button id="apply-discount" class="g-butt-secondary g-butt-lg g-fs-n" type="button">Apply Discount</button>
                                        <button id="discount-atb" class="atb-add g-d-n"
                                                data-vatm="@Model.VatMultiplier"
                                                data-productid="4957"
                                                data-partno=""
                                                data-price=""
                                                data-itemtype="2"></button>
                                    </span>
                                </div>
                            }
                        }
                        <div class="g-m-t-10 basket-entry">
                            <div class="atb-entry input-group g-m-t-10 g-w-345">
                                <span class="input-group-addon g-br-0 g-b-n g-bc-s">Clear All Products</span>
                                <button id="admn-clear-basket" class="g-butt g-butt-secondary g-butt-lg pull-right"
                                        title="Clear all items from the basket">
                                    Clear
                                </button>
                            </div>
                            <div class="g-m-t-10">
                                <div class="atb-entry input-group g-m-t-10 g-w-345">
                                    @if (ViewBag.OrderIsOnHold)
                                    {
                                        <span class="input-group-addon g-br-0 g-b-n g-bc-s">Order is On Hold</span>
                                        <button class="g-butt g-butt-secondary g-butt-lg delete pull-right"
                                                data-productid="ONHOLD"
                                                title="Remove from on hold">
                                            Remove
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="input-group-addon g-br-0 g-b-n g-bc-s">Place Order On Hold</span>
                                        <button class="g-butt g-butt-secondary g-butt-lg atb-add pull-right"
                                                data-price="0.00"
                                                data-productid="ONHOLD"
                                                data-partno="ONHOLD"
                                                data-imageurl="unknown.jpg"
                                                data-itemtype="3"
                                                title="Place this order on hold">
                                            Place On Hold
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-4">
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Delivery</strong>
                </div>
                <div class="pull-right g-p-r-20">
                    @if (Model.BasketTotals.Delivery == 0)
                    {
                        @:FREE
                    }
                    else
                    {
                        @Html.Raw("&pound;" + string.Format("{0:N2}", Math.Abs(Model.BasketTotals.Delivery)))
                    }
                </div>
            </div>
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Sub Total</strong>
                </div>
                <div class="pull-right g-p-r-20">&pound;@string.Format("{0:N2}", Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery)</div>
            </div>
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>VAT</strong>
                </div>
                <div class="pull-right g-p-r-20">&pound;@string.Format("{0:N2}", Model.BasketTotals.Vat + Model.BasketTotals.VoucherVat)</div>
            </div>

            <div class="@(ViewBag.HideVoucher ? "g-d-n" : "")">
                <hr class="g-m-tb-10" />
                <div id="voucherTotal" class="g-m-t-10 clearfix g-lh-40">
                    <div class="pull-left">
                        <strong>Voucher</strong>
                    </div>
                    <div class="pull-right g-p-r-20 g-i g-fc-pm">
                        <span id="voucherValue">
                            @if (Model.BasketTotals.Voucher == 0)
                            {
                                @:FREE GIFT
                            }
                            else
                            {
                                @((Model.BasketTotals.Voucher < 0 ? "-" : ""))
                                @Html.Raw(("&pound;" + string.Format("{0:N2}", Math.Abs(Model.BasketTotals.Voucher)) + " (inc VAT)"))
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="@(isMultiBuy ? "" : "g-d-n")">
                <hr class="g-m-tb-10" />
                <div id="voucherTotal" class="g-m-t-10 clearfix g-lh-40">
                    <div class="pull-left">
                        <strong>You have saved</strong>
                    </div>
                    <div class="pull-right g-p-r-20 g-i g-fc-pm">
                        <span id="voucherValue">
                            @Html.Raw(("&pound;" + string.Format("{0:N2}", multibuyAmount) + " (ex VAT)"))
                        </span>
                    </div>
                </div>
            </div>

            <hr class="g-m-tb-10" />
            <div class="g-m-t-10 clearfix g-lh-40">
                <div class="pull-left">
                    <strong>Grand Total</strong>
                </div>
                <div class="pull-right g-fs-lg g-p-r-20">
                    <strong>
                        <span>&pound;@string.Format("{0:N2}", Model.BasketTotals.GrandTotalIncVat)</span>
                    </strong>
                </div>
            </div>

            <button type="button" class="checkout-button btn g-butt-primary g-butt-100p g-m-t-20 g-m-b-20 pull-right" title="Checkout">Proceed to Checkout</button>
            @Html.AntiForgeryToken()
            <form id="co-form" method="post" action="~/Checkout/Stage1/">
                @Html.HiddenFor(x => x.CheckoutDetails.IsNewCustomer)
                @Html.HiddenFor(x => x.CheckoutDetails.Email)
                @Html.HiddenFor(x => x.CheckoutDetails.Password)
                @Html.HiddenFor(x => x.CheckoutDetails.ZeroStock)
            </form>

            @if (!Convert.ToBoolean(Session["U_IsPortalUser"]) && Model.BasketTotals.GrandTotalIncVat > 0.01m)
            {
                <div id="paypal-button2" class="g-m-t-20"></div>
                <form id="paypal-form" action="/checkout/stage3/" method="post">
                    <input type="hidden" name="PayPalPaid" id="PayPalPaid" value="true" />
                    @Html.Hidden("PaymentAmountPaid", Model.BasketTotals.GrandTotalIncVat)
                </form>
            }
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <span>Your basket is currently empty, @Html.ActionLink("continue shopping", "Index", "Home")</span>
        </div>
    </div>
}

