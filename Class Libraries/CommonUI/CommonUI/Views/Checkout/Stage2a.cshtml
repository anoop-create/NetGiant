@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework;
@using CommonUI.Models;
@using System.Configuration;
@using System.Web.Optimization;
@using PaymentMethod = BusinessLogic.PaymentMethod

@model CheckoutViewModel

@{
    Layout = "~/Views/Shared/_LayoutCheckout.cshtml";
}

<div class="comm-content g-bc-p g-p-b-60 g-b-t-1">
    <div class="container body-content g-ps-r">
        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <div class="row">
                    @{
                        bool isAccountCustomer = Convert.ToBoolean(Session["U_IsAccountCustomer"]);
                    }

                    <div class="container-fluid">
                        <div class="row">

                            <!-- Left Hand Column -->
                            <div class="col-md-9">
                                <!-- Saved Cards Form -->
                                <div id="saved-cards" class="@(!ViewBag.ShowSavedCards ? "g-d-n" : "")">
                                    @using (Html.BeginForm("Stage2b",
                                        "Checkout",
                                        FormMethod.Post,
                                        new { id = "co-stage2-savedCard" }))
                                    {
                                        @*@Html.AntiForgeryToken()*@
                                        @Html.HiddenFor(x => x.PreviousPage, new { @Value = "Stage2" })

                                        if (Model.CheckoutDetails.PaymentMethod == PaymentMethod.CreditDebit.ToString())
                                        {
                                            @Html.HiddenFor(x => x.CheckoutDetails.UseASavedCard, new { @Value = "True" })
                                            @Html.HiddenFor(x => x.CheckoutDetails.SaveThisCard, new { @Value = "False" })
                                            @Html.Hidden("activated")
                                            @Html.HiddenFor(x => x.BrowserColorDepth, new { @class = "browserColorDepth" })
                                            @Html.HiddenFor(x => x.BrowserScreenHeight, new { @class = "browserScreenHeight" })
                                            @Html.HiddenFor(x => x.BrowserScreenWidth, new { @class = "browserScreenWidth" })
                                            @Html.HiddenFor(x => x.CheckoutDetails.MerchantSessionKey.merchantSessionKey)
                                            @Html.HiddenFor(x => x.CardIdentifier)

                                            <hr class="g-m-b-20" />

                                            <div id="co-section-credit-debit" class="clearfix">
                                                <div>
                                                    <h2>
                                                        Your Saved Cards <span class="g-fc-s">(@Model.CardList.Count)</span>
                                                        <span class="g-fc-s g-fs-n g-p-l-20">
                                                            <button id="add-card" class="g-butt-second-reg g-butt-lg-2" type="button">
                                                                <i class="fa fa-plus fa g-p-r-10"></i>
                                                                Add a New Card
                                                            </button>
                                                        </span>
                                                    </h2>
                                                    <div id="saved-error" class="g-fc-nm"></div>
                                                    <table id="co-old-cards" class="table table-responsive">
                                                        <thead>
                                                            <tr>
                                                                <th class="text-center">Use Card</th>
                                                                <th class="text-center">Card Type</th>
                                                                <th class="text-center">Card Number</th>
                                                                <th class="text-center">Expires</th>
                                                                <th class="text-center">Remove Card</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody class="g-bc-s g-b-1-p">
                                                            @{
                                                                bool firsttime = true;
                                                                foreach (SagePayToken spt in Model.CardList)
                                                                {
                                                                    if (spt.card_type == "")
                                                                    {
                                                                        spt.card_type = "VISA";
                                                                    }
                                                                    // Has card expired
                                                                    int currYear = Int32.Parse(DateTime.Now.ToString("yy"));
                                                                    int currMonth = DateTime.Now.Month;
                                                                    int cardYear = int.Parse(spt.expiry_date.Substring(2, 2));
                                                                    int cardMonth = int.Parse(spt.expiry_date.Substring(0, 2));
                                                                    bool hasExpired = currYear > cardYear || (currYear == cardYear && currMonth > cardMonth);

                                                                    <tr id="card@(spt.id)">
                                                                        <td class="text-center g-va-m">
                                                                            <div class="checkbox checkbox-success radio-single">
                                                                                @if (!hasExpired)
                                                                                {
                                                                                    if (firsttime)
                                                                                    {
                                                                                        @Html.RadioButton("CheckoutDetails_OpayoCardId", spt.id.ToString() + "_" + spt.sid, firsttime, new { id = "CardId_" + spt.id.ToString() + "_" + spt.sid, data_cardtype = spt.card_type, data_tokenId = spt.token, data_schemeTraceId = spt.scheme_trace_id, @checked = "checked" })
                                                                                        firsttime = false;
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        @Html.RadioButton("CheckoutDetails_OpayoCardId", spt.id.ToString() + "_" + spt.sid, firsttime, new { id = "CardId_" + spt.id.ToString() + "_" + spt.sid, data_cardtype = spt.card_type, data_tokenId = spt.token, data_schemeTraceId = spt.scheme_trace_id })
                                                                                    }
                                                                                    <label for="CardId_@(spt.id.ToString())_@(spt.sid)" title="Select this card"></label>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div>Expired</div>
                                                                                }
                                                                            </div>
                                                                        </td>
                                                                        <td class="text-left">
                                                                            <img src="~/Content/Images/1pxTrans.png" class="msp_@spt.card_type.ToLower()" alt="@spt.card_type" />
                                                                            <span class="g-p-l-20 hidden-sm hidden-xs">@spt.CardName</span>
                                                                        </td>
                                                                        <td class="text-center g-va-m"><span class="hidden-sm hidden-xs">**** ****</span> ****@spt.last_4_digits</td>
                                                                        <td class="text-center g-va-m">@string.Format("{0}/{1}", spt.expiry_date.Substring(0, 2), spt.expiry_date.Substring(2, 2))</td>
                                                                        <td class="text-center g-va-m g-fs-n">
                                                                            <i id="deleteOpayoCard-@(spt.id.ToString())_@(spt.sid)" data-tokenid="@spt.token" data-id="@spt.id" class="fa fa-close g-fc-nm g-cur-p" title="Delete this card"></i>
                                                                        </td>
                                                                        @Html.Hidden("cardToken_" + spt.sid.ToString() + "_", spt.token.ToString())
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>                                                

                                                <div class="clearfix">
                                                    <div class="g-m-t-10">SECURITY CODE*</div>
                                                    <div class="pull-left g-inp-s g-m-t-3 clearfix">
                                                        <input id="cvv" class="g-b-1-p" placeholder="CVV / CVC" size="10" maxlength="4" data-card-details="security-code-a">
                                                    </div>
                                                    <div class="pull-left g-p-l-20 popup g-cur-p"
                                                         data-toggle="tooltip"
                                                         data-html="true"
                                                         data-placement="right"
                                                         title="The Card Verification Code (CVC) is the three-digit number printed on the back of your card. <br />For American Express it's the four-digit number printed on the front.">
                                                        <i class="fa fa-info-circle g-lh-40 g-fs-18"></i>
                                                    </div>
                                                </div>

                                                <button id="co-submit-savedCard" class="g-butt-primary g-butt-xl g-m-t-40" type="submit">Place Order</button>
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- New Card Form -->
                                <div id="card-entry" class="@(!ViewBag.ShowSavedCards ? "" : "g-d-n")">
                                    @using (Html.BeginForm("Stage2b",
                                        "Checkout",
                                        FormMethod.Post,
                                        new { id = "co-stage2-card" }))
                                    {
                                        @*@Html.AntiForgeryToken()*@
                                        @Html.HiddenFor(x => x.PreviousPage, new { @Value = "Stage2" })

                                        if (Model.CheckoutDetails.PaymentMethod == PaymentMethod.CreditDebit.ToString())
                                        {
                                            @Html.HiddenFor(x => x.CheckoutDetails.UseASavedCard, new { @Value = "False" })
                                            @Html.HiddenFor(x => x.BrowserColorDepth, new { @class = "browserColorDepth" })
                                            @Html.HiddenFor(x => x.BrowserScreenHeight, new { @class = "browserScreenHeight" })
                                            @Html.HiddenFor(x => x.BrowserScreenWidth, new { @class = "browserScreenWidth" })
                                            @Html.HiddenFor(x => x.CheckoutDetails.MerchantSessionKey.merchantSessionKey)
                                            @Html.HiddenFor(x => x.CardIdentifier)

                                            <hr class="g-m-b-20" />
                                            <h2>Card Details</h2>

                                            if (Model.CardList.Count > 0)
                                            {
                                                <div class="g-m-b-20">
                                                    <button id="show-saved-cards" class="g-butt-second-reg g-p-5" type="button">
                                                        <i class="fa fa-mail-reply fa g-p-r-10"></i>
                                                        Use <span id="saved-different">Saved</span> Card
                                                    </button>
                                                </div>
                                            }

                                            if (!Convert.ToBoolean(Session["U_IsPortalUser"]))
                                            {
                                                <div id="chk-save">
                                                    <div class="checkbox checkbox-success">
                                                        @Html.CheckBoxFor(x => x.CheckoutDetails.SaveThisCard)
                                                        <label for="CheckoutDetails_SaveThisCard">
                                                            Save card for future orders. Read our
                                                            <span class="popup g-u g-fw-b g-cur-p"
                                                                  title="Terms & Conditions"
                                                                  data-popupname="SavedCardTandC"
                                                                  data-popupwidth="md"
                                                                  data-replacements=""
                                                                  data-toggle="modal"
                                                                  data-target="#popup">
                                                                Terms & Conditions
                                                            </span>
                                                        </label>
                                                    </div>
                                                </div>
                                            }

                                            <div class="clearfix">
                                                <div class="g-m-t-10">NAME ON CARD*</div>
                                                <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                                    <input id="id1" class="g-b-1-p" placeholder="Name on Card" size="30" data-card-details="cardholder-name" autocomplete="off">
                                                </div>
                                            </div>
                                            <div class="clearfix">
                                                <div class="g-m-t-10">CARD NUMBER*</div>
                                                <div class="pull-left g-inp-md g-m-t-3 clearfix">
                                                    <input id="id2" class="g-b-1-p" placeholder="Card Number" size="30" data-card-details="card-number" autocomplete="off">
                                                </div>
                                            </div>
                                            <div class="clearfix">
                                                <div class="g-m-t-10">EXPIRY DATE (MM/YY)*</div>
                                                <div class="pull-left g-inp-s g-m-t-3 clearfix">
                                                    <input id="id3a" class="g-b-1-p g-p-r-10" placeholder="MM" size="2" maxlength="2" data-card-details="expiry-date-mm" autocomplete="off">
                                                    <span>/</span>
                                                    <input id="id3b" class="g-b-1-p g-p-r-10" placeholder="YY" size="2" maxlength="2" data-card-details="expiry-date-yy" autocomplete="off">
                                                </div>
                                            </div>
                                            <div class="clearfix">
                                                <div class="g-m-t-10">SECURITY CODE*</div>
                                                <div class="pull-left g-inp-s g-m-t-3 clearfix">
                                                    <input id="id4" class="g-b-1-p" placeholder="CVV / CVC" size="10" maxlength="4" data-card-details="security-code-b" autocomplete="off">
                                                </div>
                                                <div class="pull-left g-p-l-20 g-cur-p"
                                                     data-toggle="tooltip"
                                                     data-html="true"
                                                     data-placement="right"
                                                     title="The Card Verification Code (CVC) is the three-digit number printed on the back of your card. <br />For American Express it's the four-digit number printed on the front.">
                                                    <i class="fa fa-info-circle g-lh-40 g-fs-18"></i>
                                                </div>
                                            </div>

                                            <div class="clearfix">
                                                <button id="co-submit-card" type="submit" class="g-butt-primary g-butt-xl g-m-t-40">Place Order</button>
                                            </div>
                                        }
                                    }
                                </div>
                                @if (Model.CheckoutDetails.PaymentMethod == PaymentMethod.PayPal.ToString())
                                {
                                    <div id="co-section-paypal" class="clearfix">
                                        @{
                                            @Html.RawFromDict(Model.CheckoutData, "PayByPayPal")
                                        }
                                    </div>
                                }

                                <div class="g-m-t-20">
                                    @{
                                        @Html.RawFromDict(Model.CheckoutData, "Stage2Message")
                                    }
                                </div>

                                <div class="g-m-t-60">
                                    @{
                                        Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                                    }
                                </div>
                            </div>

                            <!-- Right Hand Column -->
                            <div class="col-md-3 restrict-images hidden-xs hidden-sm">
                                <hr class="g-m-b-20" />
                                @{
                                    Html.RenderPartial("~/Views/Checkout/OrderSummary.cshtml", Model);
                                }

                                <div class="g-bc-s g-b-1-p g-m-t-10">
                                    <div class="g-p-10 text-center"><strong>Payment Methods</strong></div>
                                    <hr />
                                    <div class="g-p-10">
                                        @Html.Raw(Model.CheckoutData["PaymentMethods"].Replace("[newline]", "&#013;"))
                                    </div>
                                </div>

                                <div class="g-m-t-20">
                                    @Html.RawFromDict(Model.CheckoutData, "SecureMessage")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input hidden="hidden" class="IsInCheckout" />

@section scripts
{
    @Scripts.Render("~/bundles/checkoutBundle.js")
    <script src="https://@(ConfigurationManager.AppSettings["Environment"] == "Live" ? "live" : "sandbox").opayo.eu.elavon.com/api/v1/js/sagepay.js"></script>
}

