@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;
@using Kendo.Mvc.UI

@model ProductViewModel

@section AddTags {
    <link rel="canonical" href="@("https://" + Model.DomainNameTrunc + ViewBag.cUrl)" />
}

<section id="loadbg" class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" data-bgimg="@Html.RawFromDict(Model.CommonData, "FeatureBackground")">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-120-sm g-fc-st">
                @if (!Model.IsMobile)
                {
                    <div class="bread-crumb hidden-xs hidden-sm">
                        @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                        {
                            <a class="second" href="/@bc.Value">@bc.Key</a>
                            <i class="fa fa-chevron-right g-fs-xs-i"></i>
                        }
                    </div>
                }

                <div class="g-m-t-a">
                    <div class="pull-left">
                        <h1>
                            <span class="">@Model.CategoryCode.categoryCodeName</span>
                        </h1>
                    </div>
                    @if (!Model.IsMobile)
                    {
                        <div class="pull-right hidden-xs hidden-sm">
                            @*<div class="g-m-t-m20">
                                    <button class="popup g-cur-p g-butt-second-inv g-butt-lg"
                                            data-popupname="AskAQuestion"
                                            data-replacements="@ViewBag.AskAQuestionRep"
                                            data-toggle="modal"
                                            data-target="#popup">
                                        Ask a Question
                                    </button>
                                </div>*@
                            @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@{
    //int basketCount = 0;
    //string hideBasketCount;

    //List<BasketContents> lbc = (List<BasketContents>)Session["B_BasketArray"];
}

<div class="comm-content g-bc-p g-p-b-100">
    <div class="container body-content g-ps-r">

        <div class="row g-m-t-20">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-3 fltr-filters restrict-images">
                        @if (!Model.IsMobile)
                        {
                            if (Model.IsStationerySaleActive)
                            {
                                @Html.RawFromDict(Model.SaleData, "GridMarketing1", null, "hidden-xs hidden-sm")
                            }
                        }
                        <hr class="g-m-b-20" />

                        @if (!Model.IsMobile)
                        {
                            <!-- Desktop -->
                            <div class="clearfix hidden-xs hidden-sm">
                                <div class="row">
                                    <h2 class="col-md-12 col-lg-7">Filter Results</h2>
                                    <div class="col-md-12 col-lg-5">
                                        <button id="clearFilter" class="g-butt-second-reg g-butt-md-2 pull-right-lg">Clear All</button>
                                    </div>
                                    <div class="col-md-12 g-m-t-10 visible-md"></div>
                                </div>
                            </div>
                        }
                        <!-- Mobile -->
                        <div class="clearfix hidden-md hidden-lg g-bc-s g-b-1-p g-m-b-10 g-p-lr-10 g-lh-40">
                            <h2 class="toggle-filter pull-left g-fs-n g-lh-40 g-m-0" onClick="">
                                <strong>Filter Results</strong>
                            </h2>
                            <div class="toggle-filter pull-left g-p-l-20" onClick="">
                                <i class="fa fa-chevron-down g-p-r-40"></i>
                            </div>
                            <div class="pull-right">
                                <button id="clearFilter" class="g-butt-second-reg g-butt-md-2">Clear All</button>
                            </div>
                        </div>
                        @{
                            Html.RenderPartial("~/Views/Product/ProductFilters.cshtml", Model);
                        }
                    </div>
                    <div class="col-md-9">
                        <hr class="g-m-b-20" />
                        <div class="clearfix">
                            <div class="pull-left">
                                <h2>
                                    Products <span class="g-fc-s">(<span id="pg-product-count">@Model.ProductList.Count</span>)</span>
                                </h2>
                            </div>
                            @if (!Model.IsMobile)
                            {
                                <div class="pull-right hidden-xs hidden-sm">
                                    <button class="compare g-butt-second-reg g-butt-lg-2 pull-left g-m-r-10 g-fs-sm"
                                            data-toggle="modal"
                                            data-target=".custom-popup"
                                            data-url="@Url.Action("Comparison", "Product")/"
                                            data-container=".comparison">
                                        <i class="fa fa-adjust"></i> &nbsp;Compare Products
                                    </button>
                                    <select class="sortResults selectpicker auto-width" data-style="g-butt-second-reg g-butt-sm-2 g-fs-sm">
                                        <option value="3">Price (Low-Hi)</option>
                                        <option value="4">Price (Hi-Low)</option>
                                        <option value="1">Description (A-Z)</option>
                                        <option value="2">Description (Z-A)</option>
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="row pg-products">

                            @foreach (ProductEntry ce in Model.ProductList)
                            {
                                Model.Product = ce;

                                <div class="col-md-6 col-lg-4 pg-entry g-m-b-30" data-att-022="#@Model.Product.BoBrandNo.ToString("##0")#" data-att-031="#@Model.Product.AttribValue7.ToString("##0")#" @Html.FilterAttributes(Model.Product.Attributes)>
                                    @{
                                        Html.RenderPartial("~/Views/Product/GridEntry.cshtml", Model);
                                    }
                                </div>
                            }
                        </div>

                        @{
                            ViewBag.StandardModalTitle = "Compare";
                            Html.RenderPartial("~/Views/Shared/StandardModal.cshtml");
                        }

                        @{
                            Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section StructuredData {
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    ]
}

@section AddScript
{
    @Scripts.Render("~/bundles/productBundle.js")
}
