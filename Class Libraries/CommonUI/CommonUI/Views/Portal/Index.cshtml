@using BusinessLogic
@using BusinessLogic.ViewModels
@using Kendo.Mvc.UI

@model PortalViewModel

@{
    Layout = "~/Views/Shared/_Portal.cshtml";
}

<div class="g-fs-lg g-p-l-20 g-p-t-10 g-p-b-10 g-bc-s g-m-b-20 g-b-1-p">
    Results for "<span id="search-term"></span>"
</div>

<div id="customer-grid" class="g-m-l-20 g-m-r-20">
    @(Html.Kendo().Grid<PortalViewModel.TelerikUsers>()
          .Name("grid")
          .DataSource(dataSource => dataSource
              .Ajax()
              .Read(read => read.Action("CustomerSearch", "Portal").Data("getAdditionalFilters"))
              .PageSize(200)
          )
          .Columns(columns =>
          {
              columns.Bound(x => x.WebsiteName).Width(70).Title("Site").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(x => x.CustomerGroup).Width(150).Title("Customer Group").HeaderHtmlAttributes(new { style = "text-align: center;" })
                .ClientTemplate("<span class=\"fa fa-credit-card-alt #:CustomerGroupColor# g-m-r-10\"></span>#:CustomerGroup#</a>");
              columns.Bound(x => x.OrgName).Width(170).Title("Org Name").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(x => x.FullName).Width(100).Title("Name").HeaderHtmlAttributes(new { style = "text-align: center;" })
                .ClientTemplate("#= (IsPrimaryContact) ? '<span class=\"fa fa-asterisk ' %2B CustomerGroupColor %2B '\"></span>' : '' #" + "#:FullName#");
              columns.Bound(x => x.BillingAddress).Title("Billing Address").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(x => x.FriendlyPostcode).Width(110).Title("Post Code").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(product => product.LastOrdered).Title("Last Ordered").HeaderHtmlAttributes(new { style = "text-align: center;" }).Width(120)
                .ClientTemplate("#= (LastOrdered == null) ? '-' : kendo.toString(kendo.parseDate(LastOrdered, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
              columns.Bound(x => x.Record).Width(150).Title("Customer No").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(x => x.Email).Width(200).Title("Email").HeaderHtmlAttributes(new { style = "text-align: center;" });
              columns.Bound(x => x.Record).Width(80).HeaderHtmlAttributes(new { style = "text-align: center; font-weight: bold;" }).ClientTemplate(
                  "<div data-id=\"#:kendo.toString(Record)#\" data-site=\"#:kendo.toString(WebsiteId)#\" data-tracking=\"#:kendo.toString(HasTracking)#\" class=\"record-options text-center\"><i class=\"fa fa-caret-square-o-down fa-lg\"></i></div>"
                  ).Width("100px").Title("Action").Filterable(false).Sortable(false).Groupable(false).HtmlAttributes(new { @class = "exclude-from-click-event"});
          })
          .Pageable(pager => pager.Refresh(true))
          .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
          .Sortable(sortable => sortable
              .AllowUnsort(true))
          .Scrollable()
          .Filterable(ftb => ftb
              .Mode(GridFilterMode.Menu))
          .ColumnMenu()
          .Resizable(resize => resize.Columns(true))
          .Reorderable(reorder => reorder.Columns(true))
          .NoRecords("There are no items to display")
          .Events(events => events.Change("Grid_OnRowSelect"))
          .Selectable()
          .Deferred()
    )
</div>
