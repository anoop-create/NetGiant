@using BusinessLogic
@using BusinessLogic.ViewModels
@using Kendo.Mvc.UI
@using CommonUI.Models;

@model PortalViewModel

@{
    Layout = "~/Views/Shared/_Portal.cshtml";
}

<div class="g-fs-lg g-p-l-20 g-p-t-10 g-p-b-10 g-bc-s g-m-b-20 g-b-1-p">
    @(Model.VoucherScope == "customer" ? "Customer Vouchers" : "Current Promotional Vouchers")
</div>

<div id="portal-grid" class="g-m-l-20 g-m-r-20">
    @if (Model.VoucherScope == "customer")
    {
        @(Html.Kendo().Grid<PortalViewModel.TelerikVouchers>()
            .Name("grid")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(read => read.Action("Voucher_Read", "Portal", new { scope = Model.VoucherScope }))
                .Filter(f => f.Add(x => x.IsUsed).IsEqualTo(false))
                .PageSize(200)
            )
            .Columns(columns =>
            {
                columns.Bound(x => x.WebsiteName).Width(50).Title("Site").HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
                columns.Bound(x => x.AccountNumber).Width(100).Title("Account No").HeaderHtmlAttributes(new { title = "Account Number", style = "text-align: center;" });
                columns.Bound(x => x.VoucherCode).Width(100).Title("Code").HeaderHtmlAttributes(new { title = "Voucher Code", style = "text-align: center;" });
                columns.Bound(x => x.VoucherTypeName).Width(80).Title("Type").HeaderHtmlAttributes(new { title = "Type", style = "text-align: center;" });
                columns.Bound(x => x.VoucherPromoGroupName).Width(200).Title("Group").HeaderHtmlAttributes(new { title = "Group", style = "text-align: center;" });
                columns.Bound(x => x.IsGlobal).Width(80).Title("Global").HeaderHtmlAttributes(new { title = "For Global Use", style = "text-align: center;" });
                columns.Bound(x => x.Description).Width(100).Title("Description").HeaderHtmlAttributes(new { title = "Description", style = "text-align: center;" });
                columns.Bound(x => x.ValidFrom).Title("Valid From").HeaderHtmlAttributes(new { title = "Valid From", style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(ValidFrom, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.ValidTo).Title("Valid To").HeaderHtmlAttributes(new { title = "Valid To", style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(ValidTo, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.Amount).Width(100).Title("Amount").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { title = "Amount", style = "text-align: center;" });
                columns.Bound(x => x.StockRef).Width(80).Title("StockRef").HeaderHtmlAttributes(new { title = "Item Ref", style = "text-align: center;" });
                columns.Bound(x => x.IsUsed).Width(60).Title("Used").HeaderHtmlAttributes(new { title = "Has Been Used", style = "text-align: center;" });
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable
                .AllowUnsort(true))
            .Scrollable()
            .Filterable(ftb => ftb
                .Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no items to display")
            //.Events(events => events.Change("Grid_OnRowSelect"))
            //.Selectable()
            .Deferred()
        )
    }
    else
    {
        @(Html.Kendo().Grid<PortalViewModel.TelerikVouchers>()
            .Name("grid")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(read => read.Action("Voucher_Read", "Portal", new { scope = Model.VoucherScope }))
                .Filter(f => f.Add(x => x.IsUsed).IsEqualTo(false))
                .PageSize(200)
            )
            .Columns(columns =>
            {
                columns.Bound(x => x.WebsiteName).Width(50).Title("Site").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.VoucherCode).Width(100).Title("Code").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.VoucherTypeName).Width(80).Title("Type").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.Description).Width(150).Title("Description").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.VoucherPromoGroupName).Width(200).Title("Group").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.IsGlobal).Width(80).Title("Global").HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.ValidFrom).Title("Valid From").HeaderHtmlAttributes(new { style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(ValidFrom, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.ValidTo).Title("Valid To").HeaderHtmlAttributes(new { style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(ValidTo, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.Amount).Width(100).Title("Amount").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.Percentage).Width(100).Title("Percentage").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.MinBasketValue).Width(100).Title("Min Basket Val").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { style = "text-align: center;" });
                columns.Bound(x => x.MinQualValue).Width(100).Title("Min Qual Val").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { style = "text-align: center;" });
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable
                .AllowUnsort(true))
            .Scrollable()
            .Filterable(ftb => ftb
                .Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no items to display")
            //.Events(events => events.Change("Grid_OnRowSelect"))
            //.Selectable()
            .Deferred()
        )
    }
</div>
