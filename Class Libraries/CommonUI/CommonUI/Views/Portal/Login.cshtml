@using BusinessLogic.ViewModels

@model PortalViewModel

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Empty.cshtml";
}

<div id="page-content" class="comm-content">
    <div class="container body-content g-p-b-60 g-b-1-p g-bc-p" style="width:800px">
        <div class="row g-m-t-20">
            @Html.ValidationSummary(true, "", new { @class = "text-danger", @style = "margin-left: 125px; width: 540px" })
        </div>
        <div class="row">
            @using (Html.BeginForm("Login",
                    "Portal",
                    FormMethod.Post,
                    new { id = "portal-login" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.NextUrl)
                <div class="col-lg-12">
                    <div class="g-m-t-40" style="margin-left: 125px">
                        <div class="g-m-t-20-i">
                            <div class="g-fs-n g-f-l g-m-r-20 g-m-t-7">USERNAME</div>
                            @Html.TextBoxFor(m => m.UserEmail, new { @class = "form-control g-w-320 g-f-l g-m-r-20", @placeholder = "Email Address", @type = "email", @id = "signin-email" })
                            <input id="btn-next" type="submit" value="Next" class="g-butt-primary g-butt-md g-f-l" />
                        </div>
                    </div>
                </div>
                <div class="col-lg-3"></div>
                <div class="col-lg-6 error-message g-d-n">
                    <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                    <p class="g-m-0 g-d-i g-p-r-10"></p>
                </div>
                <div class="col-lg-3"></div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $('#portal-login').submit(function () {
            if ($(this).valid()) {
                $.alert({
                    title: 'Two Factor Authentication',
                    content: 'Awaiting authentication',
                });
            }
            else {
                displayErrorMessage('#portal-login', 'Incorrect Username');
            }
        })
    </script>
}

