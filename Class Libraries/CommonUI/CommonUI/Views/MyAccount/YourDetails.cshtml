@using BusinessLogic;
@using CommonUI.Models;

@model MyAccountDetails

@using (Ajax.BeginForm("UpdateDetails",
    "MyAccount",
    null,
    new AjaxOptions { HttpMethod = "POST", OnComplete = "myAccountUpdateComplete", OnFailure = "logAjaxFormError" },
    new { id = "updateDetails" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Record)

    <div class="update-details">
        <div class="g-m-t-10 clearfix">
            @*<div class="pull-left g-inp-sm clearfix">
                <div class="g-m-t-10">TITLE*</div>
                @Html.DropDownListFor(x => x.Name.Title, Model.TitleList, "Select", new { @class = "selectpicker g-m-t-3" })
                @Html.HiddenFor(x => x.Name.Title, new { @Value = "" })
            </div>
            <div class="pull-left g-w-20">&nbsp;</div>*@
            <div class="pull-left g-inp-md clearfix">
                <div class="g-m-t-10">FIRST NAME*</div>
                @Html.EditorFor(x => x.Name.Firstname, new { htmlAttributes = new { placeholder = "First Name", @class = "g-b-1-p g-m-t-3" } })
            </div>
            <div class="pull-left g-w-20">&nbsp;</div>
            <div class="pull-left g-inp-md clearfix">
                <div class="g-m-t-10">LAST NAME*</div>
                @Html.EditorFor(x => x.Name.Surname, new { htmlAttributes = new { placeholder = "Last Name", @class = "g-b-1-p g-m-t-3" } })
            </div>
        </div>
        <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

        <div class="clearfix g-m-t-5">
            <div class="g-inp-md">EMAIL ADDRESS*</div>
        </div>
        <div class="clearfix g-m-t-3">
            <div class="g-inp-md clearfix">
                @Html.EditorFor(x => x.Email, new { htmlAttributes = new { placeholder = "Email", @class = "g-b-1-p" } })
            </div>
        </div>
        <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

        <div class="clearfix g-m-t-5">
            <div class="g-inp-md">CONTACT NUMBER*</div>
        </div>
        <div class="clearfix g-m-t-3">
            <div class="g-inp-md clearfix">
                @Html.EditorFor(x => x.TelephoneNumber, new { htmlAttributes = new { placeholder = "Contact Number", @class = "g-b-1-p" } })
            </div>
        </div>
        <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

        <div class="clearfix g-m-t-5">
            <div class="g-inp-md">NEW PASSWORD</div>
        </div>
        <div class="clearfix g-m-t-3">
            <div class="g-inp-md clearfix g-d-ib">
                @Html.PasswordFor(x => x.Password, new { placeholder = "New Password", @class = "g-b-1-p", autocomplete = "new-password" })
            </div>
            <div class="g-d-ib g-fc-tt g-fs-sm g-w-225 g-va-m g-p-l-10">
                Please type your new password here should you wish to change it.
            </div>
        </div>
        <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

        <div class="clearfix g-m-t-5">
            <div class="g-inp-md">CURRENT PASSWORD*</div>
        </div>
        <div class="clearfix g-m-t-3">
            <div class="g-inp-md clearfix">
                @Html.PasswordFor(x => x.OldPassword, new { placeholder = "Current Password", @class = "g-b-1-p" })
            </div>
        </div>
        <div id="forgot-password" class="g-cur-p g-m-t-5 g-u">Reset Password</div>
        <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

        <div class="">
            <button type="submit" class="g-butt-primary g-butt-xl g-m-t-20">Save Changes</button>
        </div>

        @Html.ValidationSummary()

        <div class="g-d-ib">
            <div class="error-message g-d-n g-m-t-20-i">
                <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                <p class="g-m-0 g-d-i g-p-r-10"></p>
            </div>
        </div>
        <div id="password-success" class="g-m-t-20 g-fc-pm g-d-n">
            <i class="fa fa-check g-p-r-5"></i>
            <span class="">Changes successfully saved!</span>
        </div>
    </div>
}

<script type="text/javascript">
    var form = $("#updateDetails");
    form.removeData('validator');
    form.removeData('unobtrusiveValidation');
    $.validator.unobtrusive.parse(form);
</script>