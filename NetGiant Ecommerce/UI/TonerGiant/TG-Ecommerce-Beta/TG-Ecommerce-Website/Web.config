      <add name="productBundle" verb="*" path="productBundle.js" type="System.Web.Optimization.BundleHandler, System.Web.Optimization" preCondition="managedHandler"/>
      <add name="wizardBundle" verb="*" path="wizardBundle.js" type="System.Web.Optimization.BundleHandler, System.Web.Optimization" preCondition="managedHandler"/>
    </handlers>
    <validation validateIntegratedModeConfiguration="false"/>
    <httpErrors errorMode="Detailed"/>
    <httpProtocol>
      <customHeaders>
        <!-- Remove any potentially existing X-Frame-Options header just in case -->
        <!-- Although SuppressXFrameOptionsHeader should prevent it, this is belts and braces -->
        <remove name="X-Frame-Options"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
