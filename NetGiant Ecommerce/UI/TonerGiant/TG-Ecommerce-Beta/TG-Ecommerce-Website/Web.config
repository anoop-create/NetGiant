    <add name="DefaultConnection" connectionString="Data Source=(LocalDb)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\aspnet-TG_Ecommerce-Website-20161107120237.mdf;Initial Catalog=aspnet-Website-TG-Beta-20161107120237;Integrated Security=True" providerName="System.Data.SqlClient"/>
    <add name="backoffice_Dev" connectionString="Server=NETG-DEVSQL02;Database=tonergiant2;User Id=tonergiant;Password=ujNOtofkwFYdojwo2594;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>
    <add name="backoffice_Live" connectionString="Server=NETG-SQLCLSTR02;Database=tonergiant2;User Id=tonergiant;Password=ujNOtofkwFYdojwo2594;MultipleActiveResultSets=True;" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="owin:AutomaticAppStartup" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="WebsiteId" value="1"/>
    <add key="DomainName_Live" value="www.tonergiant.co.uk/"/>
    <add key="DomainName_Dev" value="beta.tonergiant.co.uk/"/>
    <add key="CacheTime_Long" value="4"/>
    <add key="CacheTime_Short" value="1"/>
    <add key="UseVatInclusivePrices" value="0"/>
    <!-- Basket "Buy More & Save" qty-upsell offer (compatible/own-brand cartridges only) -
         gates BusinessLogic.Utilities.GetUpsellRate() and the card in
         Views/Checkout/BasketDetails.cshtml. IsCompatibleUpsellActive turns the offer on/off;
         CompatibleUpsellRates is the % saved per unit once qty is increased past the
         quantity the item was added at. Set here for local/beta testing - if this doesn't
         make the offer appear on beta.tonergiant.co.uk, the deployed site is likely reading
         a separate Web.config on the server rather than this checked-in one (this file is
         missing several other keys - e.g. Environment, CDN - that the app also reads, which
         points the same way), so the same two keys would need adding there too. -->
    <add key="IsCompatibleUpsellActive" value="true"/>
    <add key="CompatibleUpsellRates" value="10"/>
    <add value="157.231.72.210,157.231.72.211,157.231.72.212,157.231.72.213,157.231.72.214,185.170.176.7,10.0.0.9,45.145.102.190,::1" key="AllowedIPAddresses"/>
    <!-- Above: 157.231... Netgiant Office IPs; 62.232...&185.170.176.7 Netgiant Office IP's; 10.0.0.9,45.145.102.190 NETG-APP03 -->
    <add key="PayPalLogger" value="PayPal.Log.Log4netLogger"/>
    <add key="AlertLevel" value="0"/>
    <!-- 0 = No Problems, 4 = Read Only, 5 = Disaster-->
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

