@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;
@using System.Configuration;
@using System.Linq;

@model MyAccountViewModel

@if (ViewBag.IsNone)
{
    <div class="g-m-t-20">You have not placed any orders within the last 12 months.</div>
}
else
{
    <div class="row g-m-t-20 g-h-40">
        <div class="text-center col-sm-2 col-xs-4">
            <strong>Order Number</strong>
        </div>
        <div class="text-center col-sm-2 hidden-xs">
            <strong>Your Reference</strong>
        </div>
        <div class="text-center col-sm-2 col-xs-4">
            <strong>Order Date</strong>
        </div>
        <div class="text-center col-sm-2 hidden-xs">
            <strong>Order Total</strong>
        </div>
        <div class="text-center col-sm-2 col-xs-4">
            <strong>Order Status</strong>
        </div>
        <div class="text-center col-sm-2">
            <strong>Order Details</strong>
        </div>
    </div>
    <div class="g-bc-s g-b-1-p">
        <div class="moreLess collapsable-sections" data-num-items="20" data-buttclass="g-m-20 g-butt-lg" data-scroll-offset="80">
            @{
                foreach (OrderHistory oh in Model.OrderHistoryList)
                {
                    <div class="container-fluid collapsable-section" data-url="@(Url.Action("OrderDetail", "MyAccount", new { orderno = oh.OrderNumber }))">
                        <div class="clearfix">
                            <div class="row g-b-b-1 g-flex-vcenter g-p-tb-10">
                                <div class="text-center col-sm-2 col-xs-3">@oh.OrderNumber</div>
                                <div class="text-center col-sm-2 hidden-xs">@oh.CustomerReference</div>
                                <div class="text-center col-sm-2 col-xs-4">@oh.OrderDate.ToString("dd-MM-yyyy")</div>
                                <div class="text-center col-sm-2 hidden-xs">&pound;@oh.Total.ToString("#,###,##0.00")</div>
                                <div class="text-center col-sm-2 g-fc-st g-fs-sm col-xs-5">
                                    <div class="g-bc-pos g-flex-allcenter g-w-140-sm">@oh.StatusDesc.ToString()</div>
                                    @{
                                        if (!string.IsNullOrEmpty(oh.TrackingLinks))
                                        {
                                            int trackingCount = 1;
                                            string[] trackingLinks = oh.TrackingLinks.Split('|');
                                            foreach (string trackingLink in trackingLinks)
                                            {
                                                <a href="@trackingLink" target="_blank" class="g-butt-primary g-butt-xs g-flex-allcenter g-w-140-sm g-h-20 g-m-t-2">Track Consignment (@trackingCount)</a>
                                                trackingCount++;
                                            }
                                        }
                                    }
                                </div>
                                <div class="text-right col-sm-2">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                </div>
                            </div>
                            <div class="row collapsable-detail"></div>
                        </div>
                    </div>
                }
            }
                    </div>
    </div>
}