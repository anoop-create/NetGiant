@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework;

@model MyAccountViewModel

@if (ViewBag.IsNone)
{
    <div class="g-m-t-20">There are currently no saved cards associated with your account.</div>
}
else
{
    <div class="row g-m-t-20 g-h-40">
        <div class="text-center col-xs-2">
            <strong>Card Type</strong>
        </div>
        <div class="text-center col-xs-4">
            <strong>Card Number</strong>
        </div>
        <div class="text-center col-xs-2">
            <strong>Expires</strong>
        </div>
        <div class="text-center col-xs-2">
            <strong>Card Expired</strong>
        </div>
        <div class="text-center col-xs-2">
            <strong>Action</strong>
        </div>
    </div>
    <div class="g-bc-s g-b-1-p">
        <div class="moreLess collapsable-sections" data-num-items="20" data-buttclass="g-m-20 g-butt-lg" data-scroll-offset="80">
            <div class="container-fluid">
                <div class="clearfix">
                    @{
                        foreach (SagePayToken spt in Model.CardList)
                        {
                            if (spt.card_type == "")
                            {
                                spt.card_type = "VISA";
                            }
                            // Has card expired
                            int currYear = Int32.Parse(DateTime.Now.ToString("yy"));
                            int currMonth = DateTime.Now.Month;
                            int cardYear = int.Parse(spt.expiry_date.Substring(2, 2));
                            int cardMonth = int.Parse(spt.expiry_date.Substring(0, 2));
                            bool hasExpired = currYear > cardYear || (currYear == cardYear && currMonth > cardMonth);
                            <div class="row g-b-b-1 g-flex-vcenter g-h-60">
                                <div class="text-center col-xs-2">@spt.card_type</div>
                                <div class="text-center col-xs-4">xxxx xxxx xxxx @spt.last_4_digits</div>
                                <div class="text-center col-xs-2">@String.Format("{0}/{1}", cardMonth, cardYear)</div>
                                <div class="text-center col-xs-2">@(hasExpired ? "Yes" : "No")</div>
                                <div class="text-right col-xs-2">
                                    <button id="deleteOpayoCard-@(spt.id.ToString())_@(spt.sid)" data-tokenid="@spt.token" data-id="@spt.id" class="btn g-butt-second-reg g-butt-md-2" role="button">
                                        <i class="fa fa-close g-fc-nm g-cur-p" title="Delete this card"></i> Delete
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
