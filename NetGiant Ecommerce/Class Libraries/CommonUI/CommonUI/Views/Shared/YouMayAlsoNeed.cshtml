@using System.Configuration
@using BusinessLogic
@using BusinessLogic.ViewModels
@model List<BasketContents>
@* ----------------------------------------------------------------------------
   Two views of the same add-on list, toggled purely by CSS (both are always
   rendered - the AJAX partial doesn't need two controller code paths, and the
   extra hidden markup is a small one-time cost):
     - .ymn-desktop-view: the ORIGINAL carousel-beside-mini-cart / centered
       add-to-cart popup design, unchanged - shown at >= 768px.
     - .ymn-mobile-view: the redesigned single-column card/list popup (per the
       mockup) - shown below 768px.
   The header/close button and the "Proceed to Checkout" footer button are
   shared by both (same elements, just restyled per breakpoint) since their
   structure doesn't need to differ, only colours/shape. All real behaviour is
   unchanged - .ymn-close/.ymn-proceed/.ymn-add and the data-context attribute
   (set by site.js's showAddSellPopup()) are the same classes/attributes the
   existing click handlers in site.js already bind to.
   ---------------------------------------------------------------------------- *@

<div id="you-may-also-need-backdrop"></div>

<div id="you-may-also-need">

    <div class="ymn-header">
        <span>You May Also Need...</span>

        <button type="button" class="ymn-close" aria-label="Close">
            <i class="fa fa-times"></i>
        </button>
    </div>

    @* ---- Desktop/tablet (>= 768px): original carousel, unchanged ---- *@
    <div class="ymn-desktop-view">

        <div class="you-may-need-wrapper" data-index="0">

            @if (Model.Count > 3)
            {
                <button type="button" class="need-arrow prev" disabled aria-label="Previous">
                    <i class="fa fa-chevron-left"></i>
                </button>
            }

            <div class="you-may-need-products">
                <div class="you-may-need-track">

                    @foreach (BasketContents addOn in Model)
                    {
                        <div class="need-product">

                            <a href="@addOn.ProductUrl">
                                <img src="@addOn.ImageUrl"
                                     alt="@addOn.Description"
                                     onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                            </a>

                            <a href="@addOn.ProductUrl" class="need-title">
                                @addOn.Description
                            </a>
                            <a href="@addOn.ProductUrl" class="need-title">
                                @addOn.PartNo
                            </a>
                            <div class="need-price">
                                £@string.Format("{0:N2}", addOn.PriceEx) exc. VAT
                            </div>

                            <button type="button"
                                    class="ymn-add"
                                    data-productid="@addOn.StockRef">
                                Add to Basket
                            </button>

                        </div>
                    }

                </div>
            </div>

            @if (Model.Count > 3)
            {
                <button type="button" class="need-arrow next" aria-label="Next">
                    <i class="fa fa-chevron-right"></i>
                </button>
            }

        </div>

    </div>

    @* ---- Mobile (< 768px): redesigned card/list ---- *@
<div class="ymn-mobile-view">
        <div class="popup-header">
            <h2 id="popup-title">You May Also Need…</h2>
            <button class="close-btn ymn-close" id="closeBtn" aria-label="Close">×</button>
        </div>
    <div class="item-list">

        @foreach (BasketContents addOn in Model)
        {
            <div class="item">

                <div class="item-thumb">
                    <a href="@addOn.ProductUrl">
                        <img src="@addOn.ImageUrl"
                             alt="@addOn.Description"
                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                    </a>
                </div>

                <div class="item-info">

                    <a href="@addOn.ProductUrl" class="item-title">@addOn.Description</a>

                    <p class="item-price">
                        £@string.Format("{0:N2}", addOn.PriceEx) <span>exc. VAT</span>
                    </p>

                    <button type="button"
                            class="ymn-add"
                            data-productid="@addOn.StockRef">
                        Add to Basket
                    </button>

                </div>

            </div>
        }

    </div>

</div>

    <div class="popup-footer">
        <button type="button" class="ymn-proceed">
            Proceed to Checkout
        </button>
    </div>

</div>