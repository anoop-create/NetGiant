@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework
@using CommonUI.Models;
@using Kendo.Mvc.UI
@using VmVoucherType = VMerchantWrapper.Entities.VoucherType;
@using System.Linq;
@{
    var bt = (BasketTotals)Session["B_BasketTotals"];
    Tuple<string, decimal> summPrice = Utilities.SetPrice(bt.GrandTotalIncVat, bt.GrandTotalExcVat);
    List<BasketContents> lbc = Utilities.LoadSession<List<BasketContents>>("B_BasketArray");
    bool isVatExempt = HttpContext.Current.Session["D_IsVatExempt"] != null && Convert.ToBoolean(HttpContext.Current.Session["D_IsVatExempt"]);
    decimal vatMultiplier = Convert.ToDecimal(ConfigurationManager.AppSettings["VatMultiplier"]);
    bool hasSwitchProducts = false;
    decimal basketSwitchSaving = 0;
    List<BasketContents> switchProducts = new List<BasketContents>();
    bool isAdminDiscount = false;//Model.BasketContents.Exists(x => x.ItemType == BasketItemType.AdminDiscount);
    bool isCompatibleDiscount = false;// Model.BasketContents.Exists(x => x.ItemType == BasketItemType.CompatibleDiscount);
    int switchCount = 0;
    bool isTradeCustomer = HttpContext.Current.Session["U_IsTradeCustomer"] != null && Convert.ToBoolean(HttpContext.Current.Session["U_IsTradeCustomer"]);
    // TonerGiant delivery message: a constant "Free Next Day Delivery" up to the order cutoff
    // (17:30 Mon-Thu, 17:00 Fri), switching to "Free Next Working Day Delivery" after that -
    // this covers Friday evening through the weekend until Monday's cutoff. TG has no spend
    // threshold for free delivery (that's a CartridgeMonkey-only rule).
    DateTime nowLocal = DateTime.Now;
    TimeSpan orderCutoff = nowLocal.DayOfWeek == DayOfWeek.Friday ? new TimeSpan(17, 0, 0) : new TimeSpan(17, 30, 0);
    bool isDeliveryWeekday = nowLocal.DayOfWeek >= DayOfWeek.Monday && nowLocal.DayOfWeek <= DayOfWeek.Friday;
    bool beforeDeliveryCutoff = isDeliveryWeekday && nowLocal.TimeOfDay < orderCutoff;
    string deliveryMessage = beforeDeliveryCutoff ? "Free Next Day Delivery" : "Free Next Working Day Delivery";
}
<style>
    :root {
        --dark: #2b2b2b;
        --pink: #e6007e;
        --green: #00a651;
        --border: #e5e5e5;
        --text: #333;
        --muted: #777;
    }
    /* Floating cart button */
    .cart-fab {
        position: fixed;
        right: 6px;
        top: 36px;
        transform: translateY(-50%);
        z-index: 9998;
        width: 56px;
        height: 56px;
        border-radius: 4px;
        background: #0099cc;
        color: #fff;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .cart-fab:hover {
            background: #000;
        }

    .cart-fab__count {
        position: absolute;
        top: -4px;
        right: -4px;
        background: var(--pink);
        color: #fff;
        font-size: 11px;
        font-weight: 700;
        min-width: 18px;
        height: 18px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
    }
    /* Overlay + slide-in panel */
    .mini-cart-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.4);
        z-index: 9999;
        opacity: 0;
        pointer-events: none;
        transition: opacity .25s ease;
    }

        .mini-cart-overlay.is-open {
            opacity: 1;
            pointer-events: auto;
        }

    .mini-cart-wrap {
        position: fixed;
        top: 0;
        right: 0;
        height: auto;
        z-index: 10000;
        transform: translateX(100%);
        transition: transform .25s ease;
    }

    .mini-cart-overlay.is-open .mini-cart-wrap {
        transform: translateX(0);
    }

    .mini-cart {
        max-width: 300px;
        width: 300px;
        background: #fff;
        display: flex;
        flex-direction: column;
        height: 100%;
        max-height: 100vh;
    }

    .mini-cart__header {
        background: var(--dark);
        color: #fff;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 16px;
        font-weight: 600;
    }

    .mini-cart__close {
        background: none;
        border: none;
        color: #fff;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        width: 26px;
        height: 26px;
        border: 1px solid #666;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

        .mini-cart__close:hover {
            background: rgba(255,255,255,0.15);
        }

    .mini-cart__body {
        flex: 1;
        overflow-y: auto;
        padding: 12px 16px;
    }
    /* Cart item */
    .cart-item {
        display: flex;
        gap: 10px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
    }

    .cart-item__link {
        flex-shrink: 0;
        display: block;
    }

    .cart-item__img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .cart-item__details {
        flex: 1;
        min-width: 0;
    }

    .cart-item__title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin: 0 0 11px;
        line-height: 1.3;
        text-decoration: none;
    }

        .cart-item__title:hover {
            color: #000;
            text-decoration: underline;
        }

    .cart-item__sku {
        font-size: 11px;
        color: var(--muted);
        margin: 0 0 6px;
    }

    .cart-item__price {
        font-size: 17px;
        font-weight: 700;
        color: #09c;
        margin: 0;
    }

        .cart-item__price .vat {
            font-size: 11px;
            font-weight: 400;
            color: var(--muted);
        }

    .cart-item__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: space-between;
        gap: 8px;
    }

    .cart-item__remove {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--muted);
        font-size: 14px;
    }

    .qty-stepper {
        display: flex;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
    }

        .qty-stepper button {
            background: #fafafa;
            border: none;
            width: 24px;
            height: 24px;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            color: #000000;
        }

        .qty-stepper input {
            width: 28px;
            text-align: center;
            border: none;
            border-left: 1px solid var(--border);
            border-right: 1px solid var(--border);
            font-size: 13px;
            height: 24px;
            color: #000000;
        }
    /* Switch & Save */
    .switch-save {
        border: 1px solid var(--pink);
        border-radius: 6px;
        padding: 14px;
        margin: 10px 0 16px;
        position: relative;
    }

    .switch-save__label {
        position: absolute;
        top: -9px;
        left: 12px;
        background: #fff;
        padding: 0 6px;
        color: var(--pink);
        font-size: 12px;
        font-weight: 700;
    }

    .switch-save__content {
        display: flex;
        gap: 10px;
    }

    .switch-save__img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .switch-save__title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        margin: 0 0 4px;
    }

        .switch-save__title:hover {
            color: var(--pink);
            text-decoration: underline;
        }

    .switch-save__sku {
        font-size: 11px;
        color: var(--muted);
        margin: 0 0 6px;
    }

    .switch-save__price {
        font-size: 14px;
        font-weight: 700;
        margin: 0 0 2px;
        color: #000000;
    }

    .switch-save__save {
        font-size: 12px;
        font-weight: 700;
        color: var(--pink);
        margin: 0 0 10px;
    }

    .switch-save__btn {
        display: block;
        width: 100%;
        background: #fff;
        border: 1px solid var(--pink);
        color: var(--pink);
        font-weight: 700;
        font-size: 13px;
        padding: 8px;
        border-radius: 4px;
        cursor: pointer;
    }
    /* Footer */
    .mini-cart__footer {
        border-top: 1px solid var(--border);
        padding: 14px 16px 16px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #000000;
    }

    .promo {
        margin-bottom: 12px;
    }

        .promo summary {
            font-size: 13px;
            color: #000;
            cursor: pointer;
            list-style: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 0;
        }

            .promo summary::-webkit-details-marker {
                display: none;
            }

            .promo summary::after {
                content: "▾";
                transition: transform .2s;
                font-size: 20px;
            }

        .promo[open] summary::after {
            transform: rotate(180deg);
        }

    .promo-form {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }

        .promo-form input {
            flex: 1;
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 10px;
            font-size: 13px;
        }

        .promo-form button {
            background: var(--green);
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

    .free-delivery {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--green);
        margin-bottom: 12px;
    }

    .checkout-btn {
        display: block;
        width: 100%;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 14px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

        .checkout-btn:hover {
            background: #008f45;
        }
</style>
<!-- Floating button to open mini cart -->
<button class="cart-fab"
        id="cartFab"
        aria-label="Open cart"
        aria-haspopup="dialog"
        aria-controls="miniCartOverlay">

    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24"
         width="26"
         height="26"
         fill="none"
         stroke="#fff"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round">

        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <span class="cart-fab__count" id="cartFabCount">
        @(lbc == null
        ? 0
        : lbc.Where(x => x.ItemType == BasketItemType.Item ||
                         x.ItemType == BasketItemType.AdminDiscount)
             .Sum(x => x.Quantity))
    </span>
</button>


<!-- Overlay + Mini cart panel -->
<div class="mini-cart-overlay"
     id="miniCartOverlay"
     role="dialog"
     aria-modal="true"
     aria-label="Mini cart">

    <div class="mini-cart-wrap">

        <div class="mini-cart">

            <!-- Header -->
            <div class="mini-cart__header">

                <span>
                    Summary
                </span>

                <button type="button"
                        class="mini-cart__close"
                        id="miniCartClose"
                        aria-label="Close cart">

                    <i class="fa fa-times"></i>

                </button>

            </div>


            <!-- Body -->
            <div class="mini-cart__body">

                @if (lbc != null && lbc.Count > 0)
                {
                    bool isMultiBuy = false;
                    decimal multibuyAmount = decimal.Zero;

                    int cardsRendered = 0;

                    /*
                     * Find products which have a compatible/cross-selling
                     * alternative that is cheaper.
                     */
                    foreach (BasketContents item in lbc)
                    {
                        if (item.ItemType != BasketItemType.Item)
                        {
                            continue;
                        }

                        if (item.IsCompatible)
                        {
                            continue;
                        }

                        if (item.ExcludeFromUpSell)
                        {
                            continue;
                        }

                        if (String.IsNullOrEmpty(item.CrossSellingStockRef))
                        {
                            continue;
                        }

                        if (item.CrossSellingAvailability != 1 &&
                            item.CrossSellingAvailability != 7)
                        {
                            continue;
                        }

                        decimal lineSaving =
                            (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;

                        if (lineSaving <= 0)
                        {
                            continue;
                        }

                        if (!switchProducts.Any(x => x.StockRef == item.StockRef))
                        {
                            switchProducts.Add(item);
                        }
                    }

                    hasSwitchProducts = switchProducts.Count > 0;
                    switchCount = switchProducts.Count;

                    /*
                     * Calculate total Switch & Save saving once.
                     */
                    basketSwitchSaving = switchProducts.Sum(x =>
                        (x.PriceEx - x.CrossSellingPriceEx) * x.Quantity
                    );


                    /*
                     * Switch All
                     */
                    if (hasSwitchProducts && switchCount > 1)
                    {
                        <div class="switch-save switch-save--all">

                            <span class="switch-save__label">
                                SWITCH &amp; SAVE
                            </span>

                            <div class="switch-save-all__body">

                                <p class="switch-save-all__msg">
                                    Save £@basketSwitchSaving.ToString("N2")
                                    by switching your whole basket to compatible products.
                                </p>

                                <button id="btnSwitchAll"
                                        type="button"
                                        class="switch-save__btn">

                                    Switch All Products

                                </button>

                            </div>

                        </div>
                    }


                    /*
                     * Render basket products
                     */
                    foreach (BasketContents bc in lbc)
                    {
                        if (bc.ItemType == BasketItemType.Item ||
                            bc.ItemType == BasketItemType.AdminDiscount)
                        {
                            cardsRendered++;

                            /*
                             * Product URL
                             */
                            string productUrl = "#";

                            if (!String.IsNullOrEmpty(bc.ProductUrl))
                            {
                                productUrl = bc.ProductUrl.StartsWith("/")
                                    ? bc.ProductUrl
                                    : "/" + bc.ProductUrl;
                            }


                            /*
                             * Admin discount
                             */
                            string neg =
                                    bc.ItemType == BasketItemType.AdminDiscount
                                    ? "-"
                                    : "";


                            /*
                             * Compatible product discount
                             */
                            decimal discUnitPrice = decimal.Zero;

                            decimal discountRate =
                                Utilities.GetUpsellRate();


                            /*
                             * Normal subtotal
                             */
                            decimal subt =
                                bc.PriceEx * bc.Quantity;


                            /*
                             * Compatible upsell discount
                             */
                            if (bc.IsCompatible &&
                                Session["V_Voucher"] == null &&
                                Convert.ToBoolean(
                                    ConfigurationManager.AppSettings[
                                        "IsCompatibleUpsellActive"
                                    ]) &&
                                !isTradeCustomer &&
                                !isAdminDiscount &&
                                bc.Quantity > bc.QtyStart)
                            {
                                discUnitPrice =
                                    Math.Round(bc.PriceEx, 2)
                                    -
                                    Math.Round(
                                        bc.PriceEx * discountRate / 100,
                                        2
                                    );

                                subt =
                                    discUnitPrice * bc.Quantity;
                            }


                            <div>

                                <!-- Basket Item -->
                                <div class="cart-item atb-entry"
                                     data-productid="@bc.StockRef">


                                    <!-- Product image -->
                                    <a href="@productUrl"
                                       class="cart-item__link">

                                        <img src="@bc.ImageUrl"
                                             alt="@bc.Description"
                                             class="cart-item__img"
                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                    </a>


                                    <!-- Product details -->
                                    <div class="cart-item__details">

                                        <a href="@productUrl"
                                           class="cart-item__title">

                                            @bc.Description

                                        </a>

                                        <div class="cart-item__sku">
                                            Product Code: @bc.PartNo
                                        </div>

                                        <div class="cart-item__price">

                                            @neg@bc.PriceEx.ToString("N2")

                                            <span class="vat">
                                                @(isTradeCustomer
                                                    ? "Trade Price, ex VAT"
                                                    : "Ex VAT")
                                            </span>

                                            @if (discUnitPrice > 0)
                                            {
                                                <div class="price-saving">
                                                    Save
                                                    £@(bc.PriceEx - discUnitPrice).ToString("N2")
                                                </div>
                                            }

                                        </div>

                                    </div>


                                    <!-- Actions -->
                                    <div class="cart-item__actions">

                                        @if (!bc.IsFreeGift)
                                        {
                                            <button class="cart-item__remove basket-remove delete"
                                                    data-productid="@bc.StockRef"
                                                    type="button"
                                                    aria-label="Remove item">

                                                <i class="fa fa-trash"></i>

                                            </button>


                                            <div class="qty-stepper">

                                                <button type="button"
                                                        @(bc.Quantity <= 1 ? "disabled" : "")
                                                        onclick="changeBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity - 1)))">

                                                    -

                                                </button>

                                                <input type="text"
                                                       readonly
                                                       value="@bc.Quantity" />

                                                <button type="button"
                                                        onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))">

                                                    +

                                                </button>

                                            </div>
                                        }


                                        @if (Session["V_Voucher"] != null)
                                        {
                                            VoucherPromo vp =
                                                (VoucherPromo)Session["V_Voucher"];

                                            if (bc.IsVoucherQualifyingItem &&
                                                vp.VoucherTypeFk ==
                                                (int)VmVoucherType.Percentage)
                                            {
                                                <div class="voucher-applied">

                                                    <i class="fa fa-check-circle"></i>

                                                    Voucher Applied

                                                </div>
                                            }
                                        }

                                    </div>

                                </div>


                                <!-- Switch & Save for this product -->
                                @if (!bc.IsCompatible &&
                                    !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                                    !bc.ExcludeFromUpSell)
                                {
                                    List<int> inStock =
                                        new List<int> { 1, 7 };

                                    if (inStock.Contains(
                                        bc.CrossSellingAvailability))
                                    {
                                        decimal switchUnitPriceEx =
                                            bc.CrossSellingPriceEx;

                                        decimal switchLinePriceEx =
                                            switchUnitPriceEx * bc.Quantity;

                                        decimal switchLinePriceInc =
                                            switchLinePriceEx *
                                            Model.VatMultiplier;

                                        decimal saving =
                                            (bc.PriceEx -
                                             switchUnitPriceEx) *
                                            bc.Quantity;


                                        if (saving > 0)
                                        {
                                            <div class="switch-save">

                                                <span class="switch-save__label">
                                                    SWITCH &amp; SAVE
                                                </span>

                                                <div class="switch-save__content">

                                                    <!-- Switch product image -->
                                                    <a href="@bc.CrossSellingProductUrl">

                                                        <img src="@(
                                                            !String.IsNullOrEmpty(
                                                                bc.CrossSellingImageURL)
                                                            ? bc.CrossSellingImageURL
                                                            : bc.ImageUrl
                                                        )"
                                                             alt="@bc.CrossSellingDescription"
                                                             class="switch-save__img"
                                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                                    </a>


                                                    <div style="flex:1;">

                                                        <!-- Switch product name -->
                                                        <a href="@bc.CrossSellingProductUrl"
                                                           class="switch-save__title">

                                                            @bc.CrossSellingDescription

                                                        </a>


                                                        <!-- Product reference -->
                                                        <div class="switch-save__sku">

                                                            Compatible for @bc.PartNo

                                                        </div>


                                                        <!-- Availability -->
                                                        <div class="stock-status in-stock">

                                                            <i class="fa fa-check-circle"></i>

                                                            <span>
                                                                In Stock
                                                            </span>

                                                        </div>


                                                        <!-- Switch price -->
                                                        <div class="switch-save__price">

                                                            £@switchLinePriceEx.ToString("N2")

                                                            <span class="vat">

                                                                @(isTradeCustomer
                                                                    ? "Trade Price, ex VAT"
                                                                    : "exc. VAT")

                                                            </span>

                                                        </div>


                                                        <!-- Saving -->
                                                        <div class="switch-save__save">

                                                            Save £@saving.ToString("N2")
                                                            ex VAT

                                                        </div>


                                                        <!-- Switch button -->
                                                        <button class="switch-save__btn atb-replace"
                                                                type="button"
                                                                data-productid="@bc.CrossSellingStockRef"
                                                                data-price="@bc.CrossSellingPriceEx"
                                                                data-removeid="@bc.StockRef"
                                                                data-qty="@bc.Quantity">

                                                            Switch Now

                                                        </button>

                                                    </div>

                                                </div>

                                            </div>
                                        }
                                    }
                                }

                            </div>
                        }


                        /*
                         * Compatible discount / multibuy line
                         */
                        if (bc.ItemType == BasketItemType.CompatibleDiscount)
                        {
                            isMultiBuy = true;
                            multibuyAmount = bc.PriceEx;
                        }
                    }


                    /*
                     * Basket contains lines but no actual products.
                     */
                    if (cardsRendered == 0)
                    {
                        <div class="mini-cart__empty">

                            We're just updating your basket -
                            please refresh this page.

                        </div>
                    }
                }
                else
                {
                    <div class="mini-cart__empty">

                        Your basket is empty.

                    </div>
                }

            </div>


            <!-- Footer -->
            <div class="mini-cart__footer">


                <!-- Total -->
                <div class="total-row">

                    <span>
                        Total Payable
                    </span>

                    <span>
                        £@bt.GrandTotalIncVat.ToString("0.00")
                    </span>

                </div>


                <!-- Voucher -->
                @if (Session["B_VoucherCode"].ToSafeString() != "")
                {
                    decimal totalSaving =
                        bt.Voucher + bt.VoucherVat;

                    <details class="promo" open="open">

                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-applied">

                            <span class="promo-applied__code">
                                @Session["B_VoucherCode"]
                            </span>

                            <button type="button"
                                    class="voucher-remove"
                                    title="Remove voucher code">

                                <i class="fa fa-times"></i>

                            </button>

                            <span class="promo-applied__saving">

                                -£@Math.Abs(totalSaving).ToString("0.00")

                            </span>

                        </div>

                    </details>
                }
                else
                {
                    <details class="promo">

                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-form">

                            <input id="voucher-code1"
                                   type="text"
                                   placeholder="Enter voucher code" />

                            <button id="apply-voucher"
                                    type="button">

                                Apply

                            </button>

                        </div>

                        <div id="voucher-code-error"
                             class="promo-error g-v-h">
                        </div>

                    </details>
                }


                <!-- Delivery -->
                <div class="free-delivery">

                    <i class="fa fa-truck"></i>

                    <span>
                        @deliveryMessage
                    </span>

                </div>


                <!-- Checkout -->
                <button class="checkout-btn"
                        type="button"
                        onclick="proceedToCheckout()">

                    Proceed to Checkout

                </button>


                <!-- View basket -->
                <a href="/checkout/"
                   class="view-basket-link">

                    View / Edit Basket

                </a>

            </div>

        </div>

    </div>

</div>
<script>
    // Open / close mini cart
    var cartFab = document.getElementById('cartFab');
    var overlay = document.getElementById('miniCartOverlay');
    var closeBtn = document.getElementById('miniCartClose');

    function openCart() {
        overlay.classList.add('is-open');
        document.body.style.overflow = 'hidden';
    }
    function closeCart() {
        overlay.classList.remove('is-open');
        document.body.style.overflow = '';
    }

    cartFab.addEventListener('click', openCart);
    closeBtn.addEventListener('click', closeCart);
    overlay.addEventListener('click', function (e) {
        if (e.target === overlay) { closeCart(); } // click outside panel closes it
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeCart(); }
    });

    document.querySelectorAll('.qty-stepper').forEach(function (stepper) {
        var input = stepper.querySelector('input');
        var minusBtn = stepper.querySelector('.qty-minus');
        var plusBtn = stepper.querySelector('.qty-plus');
        var min = 1;

        minusBtn.addEventListener('click', function () {
            var val = parseInt(input.value, 10) || min;
            if (val > min) {
                input.value = val - 1;
            }
        });

        plusBtn.addEventListener('click', function () {
            var val = parseInt(input.value, 10) || min;
            input.value = val + 1;
        });
    });
</script>
