<!-- Single stable wrapper around the whole widget (button + overlay + its script) so AJAX
     handlers in site.js have exactly one element to target with replaceWith(data.basketSummary) -
     the button and the overlay used to be two unwrapped sibling roots, which left nothing for
     a basket-mutating AJAX call to swap out as a unit. -->
<div id="minibasket-widget">
    @* Floating "cart-fab" button removed per request - the mini-cart is now triggered only
       from the header's Basket link (desktop) / cart icon (mobile), wired via the
       ".open-mini-cart" class + delegated handler in site.js. The #miniCartOverlay/#miniCartClose
       elements below (and the openCart()/closeCart() functions in the script block further
       down) are unchanged - they're what site.js's handler actually opens; only the fab button
       itself and its own click binding have been removed. *@
    <!-- Overlay + Mini cart panel -->
    <div class="mini-cart-overlay"
         id="miniCartOverlay"
         role="dialog"
         aria-modal="true"
         aria-label="Mini cart">
        <div class="mini-cart-wrap">
            <div class="mini-cart">
                <!-- Header -->
                <div class="mini-cart__header">
                    <span>
                        Summary
                    </span>
                    <button type="button"
                            class="mini-cart__close"
                            id="miniCartClose"
                            aria-label="Close cart">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
                <!-- Body -->
                <div class="mini-cart__body">
                    @if (lbc != null && lbc.Count > 0)
                    {
                        bool isMultiBuy = false;
                        decimal multibuyAmount = decimal.Zero;
                        int cardsRendered = 0;
                        /*
                         * Find products which have a compatible/cross-selling
                         * alternative that is cheaper.
                         */
                        foreach (BasketContents item in lbc)
                        {
                            if (item.ItemType != BasketItemType.Item)
                            {
                                continue;
                            }
                            if (item.IsCompatible)
                            {
                                continue;
                            }
                            if (item.ExcludeFromUpSell)
                            {
                                continue;
                            }
                            if (String.IsNullOrEmpty(item.CrossSellingStockRef))
                            {
                                continue;
                            }
                            if (item.CrossSellingAvailability != 1 &&
                                item.CrossSellingAvailability != 7)
                            {
                                continue;
                            }
                            decimal lineSaving =
                                (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;
                            if (lineSaving <= 0)
                            {
                                continue;
                            }
                            if (!switchProducts.Any(x => x.StockRef == item.StockRef))
                            {
                                switchProducts.Add(item);
                            }
                        }
                        hasSwitchProducts = switchProducts.Count > 0;
                        switchCount = switchProducts.Count;
                        /*
                         * Calculate total Switch & Save saving once.
                         */
                        basketSwitchSaving = switchProducts.Sum(x =>
                            (x.PriceEx - x.CrossSellingPriceEx) * x.Quantity
                        );
                        /*
                         * Switch All
                         */
                        if (hasSwitchProducts && switchCount > 1)
                        {
                            <div class="switch-save switch-save--all">
                                <span class="switch-save__label">
                                    SWITCH &amp; SAVE
                                </span>
                                <div class="switch-save-all__body">
                                    <p class="switch-save-all__msg">
                                        Save <strong>£@(basketSwitchSaving.ToString("N2"))</strong>
                                        by switching your whole basket to compatible products.
                                    </p>
                                    <button id="btnMiniBasketSwitchAll"
                                            type="button"
                                            class="switch-save__btn">
                                        Switch All Items
                                    </button>
                                </div>
                            </div>
                        }
                        /*
                         * Render basket products
                         */
                        foreach (BasketContents bc in lbc)
                        {
                            if (bc.ItemType == BasketItemType.Item ||
                                bc.ItemType == BasketItemType.AdminDiscount)
                            {
                                cardsRendered++;
                                /*
                                 * Product URL
                                 */
                                string productUrl = "#";
                                if (!String.IsNullOrEmpty(bc.ProductUrl))
                                {
                                    productUrl = bc.ProductUrl.StartsWith("/")
                                        ? bc.ProductUrl
                                        : "/" + bc.ProductUrl;
                                }
                                /*
                                 * Admin discount
                                 */
                                string neg =
                                        bc.ItemType == BasketItemType.AdminDiscount
                                        ? "-"
                                        : "";
                                /*
                                 * Compatible product discount
                                 */
                                decimal discUnitPrice = decimal.Zero;
                                decimal discountRate =
                                    Utilities.GetUpsellRate();
                                /*
                                 * Normal subtotal
                                 */
                                decimal subt =
                                    bc.PriceEx * bc.Quantity;
                                /*
                                 * Compatible upsell discount
                                 */
                                if (bc.IsCompatible &&
                                    Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(
                                        ConfigurationManager.AppSettings[
                                            "IsCompatibleUpsellActive"
                                        ]) &&
                                    !isTradeCustomer &&
                                    !isAdminDiscount &&
                                    bc.Quantity > bc.QtyStart)
                                {
                                    discUnitPrice =
                                        Math.Round(bc.PriceEx, 2)
                                        -
                                        Math.Round(
                                            bc.PriceEx * discountRate / 100,
                                            2
                                        );
                                    subt =
                                        discUnitPrice * bc.Quantity;
                                }
                                /*
                                 * "Buy more, save an extra X%" qty-upsell offer - same
                                 * eligibility rule as the discount above (CompatibleUpsellRates
                                 * config), just evaluated without the "already past threshold"
                                 * gate so it can also prompt before the discount kicks in. This
                                 * mirrors the "Buy More & Save" card added to the full basket
                                 * page (Views/Checkout/BasketDetails.cshtml) - was missing here.
                                 */
                                decimal upsellPerItemSaving =
                                    Math.Round(bc.PriceEx * discountRate / 100, 2);
                                bool showQtyUpsell =
                                    bc.IsCompatible &&
                                    Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(
                                        ConfigurationManager.AppSettings[
                                            "IsCompatibleUpsellActive"
                                        ]) &&
                                    !isTradeCustomer &&
                                    !isAdminDiscount &&
                                    upsellPerItemSaving > 0;
                                <div>
                                    <!-- Basket Item -->
                                    <div class="cart-item atb-entry"
                                         data-productid="@bc.StockRef">
                                        <!-- Product image -->
                                        <a href="@productUrl"
                                           class="cart-item__link">
                                            <img src="@bc.ImageUrl"
                                                 alt="@bc.Description"
                                                 class="cart-item__img"
                                                 onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                        </a>
                                        <!-- Product details -->
                                        <div class="cart-item__details">
                                            <a href="@productUrl"
                                               class="cart-item__title">
                                                @bc.Description
                                            </a>
                                            <div class="cart-item__sku">
                                                @bc.PartNo
                                            </div>
                                            <!-- In stock / delivery messaging - same "In Stock -
                                                Delivered [day]" wording and Availability 1/7 ("in
                                                stock" / "in stock at an alternate warehouse") stock
                                                check already used for this product on the full
                                                basket page (BasketDetails.cshtml) and the PDP
                                                (HtmlHelper.ProductAvailability) - kept out of the
                                                Switch & Save card below, which is a different
                                                (cross-sell) product line. -->
                                            @if (bc.Availability == 1 || bc.Availability == 7)
                                            {
                                                <div class="stock-status in-stock">
                                                    <i class="fa fa-check-circle"></i>
                                                    <span><strong>In Stock</strong> - Delivered @Session["D_standardDeliveryDay"]</span>
                                                </div>
                                            }
                                            <div class="cart-item__price">
                                                £@neg@bc.PriceEx.ToString("N2")
                                                <span class="vat">
                                                    @* Was showing "Trade Price, ex VAT" for trade customers instead of the plain
                                                        "Ex VAT" label - the price itself is already the trade price (PriceEx is
                                                        already the customer's actual net price, trade or otherwise; there's no
                                                        separate trade-vs-non-trade price to disambiguate here), so the extra
                                                        wording added nothing except length. That length is what broke the layout:
                                                        "Trade Price, ex VAT" doesn't fit on one line next to the price in this
                                                        narrow mini-cart column, so it wrapped the price line onto two rows, which
                                                        in turn pushed this card's height over the mini-cart's own fixed/scrollable
                                                        area and forced an unwanted scrollbar. Always showing the short "Ex VAT"
                                                        fixes the wrap (and the scroll it caused) without losing any actual price
                                                        information - the number itself is unaffected. *@
                                                    Ex VAT
                                                </span>
                                                @if (discUnitPrice > 0)
                                                {
                                                    <div class="price-saving">
                                                        Save
                                                        £@((bc.PriceEx - discUnitPrice).ToString("N2"))
                                                    </div>
                                                }
                                            </div>
                                            <!-- Buy More & Save for this product -->
                                            @if (showQtyUpsell)
                                            {
                                                if (bc.Quantity <= bc.QtyStart)
                                                {
                                                    <button class="qty-upsell-pill"
                                                            type="button"
                                                            onclick="changeMiniBasketQty('@bc.StockRef', @(bc.QtyStart + 1))">
                                                        Buy @(bc.QtyStart + 1 - bc.Quantity) More, Save @discountRate%
                                                    </button>
                                                }
                                                else if (bc.Quantity > 1)
                                                {
                                                    <button class="qty-upsell-pill"
                                                            type="button"
                                                            onclick="changeMiniBasketQty('@bc.StockRef', @(bc.Quantity + 1))">
                                                        Add More, Keep Saving
                                                    </button>
                                                }
                                            }
                                        </div>
                                        <!-- Actions -->
                                        <div class="cart-item__actions">
                                            @if (!bc.IsFreeGift)
                                            {
                                                <button class="cart-item__remove minibasket-remove delete"
                                                        data-productid="@bc.StockRef"
                                                        type="button"
                                                        aria-label="Remove item">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                                <div class="qty-stepper">
                                                    <button type="button"
                                                            @(bc.Quantity <= 1 ? "disabled" : "")
                                                            onclick="changeMiniBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity - 1)))">
                                                        -
                                                    </button>
                                                    <input type="text"
                                                           readonly
                                                           value="@bc.Quantity" />
                                                    <button type="button"
                                                            onclick="changeMiniBasketQty('@bc.StockRef', @(bc.Quantity + 1))">
                                                        +
                                                    </button>
                                                </div>
                                            }
                                            @if (Session["V_Voucher"] != null)
                                            {
                                                VoucherPromo vp =
                                                    (VoucherPromo)Session["V_Voucher"];
                                                if (bc.IsVoucherQualifyingItem &&
                                                    vp.VoucherTypeFk ==
                                                    (int)VmVoucherType.Percentage)
                                                {
                                                    <div class="voucher-applied">
                                                        <i class="fa fa-check-circle"></i>
                                                        Voucher Applied
                                                    </div>
                                                }
                                            }

                                        </div>
                                    </div>
                                    <!-- Switch & Save for this product -->
                                    @if (!bc.IsCompatible &&
                                        !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                                        !bc.ExcludeFromUpSell)
                                    {
                                        List<int> inStock =
                                            new List<int> { 1, 7 };
                                        if (inStock.Contains(
                                            bc.CrossSellingAvailability))
                                        {
                                            decimal switchUnitPriceEx =
                                                bc.CrossSellingPriceEx;
                                            decimal switchLinePriceEx =
                                                switchUnitPriceEx * bc.Quantity;
                                            decimal switchLinePriceInc =
                                                switchLinePriceEx *
                                                Model.VatMultiplier;
                                            decimal saving =
                                                (bc.PriceEx -
                                                 switchUnitPriceEx) *
                                                bc.Quantity;
                                            if (saving > 0)
                                            {
                                                <div class="switch-save">
                                                    <span class="switch-save__label">
                                                        SWITCH &amp; SAVE
                                                    </span>
                                                    <div class="switch-save__content">
                                                        <!-- Switch product image -->
                                                        <a href="@bc.CrossSellingProductUrl">
                                                            <img src="@(
                                                                !String.IsNullOrEmpty(
                                                                    bc.CrossSellingImageURL)
                                                                ? bc.CrossSellingImageURL
                                                                : bc.ImageUrl
                                                            )"
                                                                 alt="@bc.CrossSellingDescription"
                                                                 class="switch-save__img"
                                                                 onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                                        </a>
                                                        <div style="flex:1;">
                                                            <!-- Switch product name -->
                                                            <a href="@bc.CrossSellingProductUrl"
                                                               class="switch-save__title">
                                                                @bc.CrossSellingDescription
                                                            </a>
                                                            <!-- Product reference -->
                                                            <div class="switch-save__sku">
                                                                @bc.PartNo
                                                            </div>

                                                            <!-- Switch price -->
                                                            <div class="switch-save__price">
                                                                £@switchLinePriceEx.ToString("N2")
                                                                <span class="vat">
                                                                    @* Same "Trade Price" label fix as the main cart-item price
                                                                        above - dropped for trade customers, which also removes
                                                                        the same wrap/scroll trigger in this narrower card. *@
                                                                    exc. VAT
                                                                </span>
                                                            </div>
                                                            <!-- Saving -->
                                                            <div class="switch-save__save">
                                                                @* Was also appending "Trade Price, ex VAT"/"exc. VAT" after the
                                                                    saving amount (e.g. "Save £2.00 exc. VAT"), which doesn't
                                                                    belong here at all - this line is a saving amount, not a
                                                                    price, so a VAT-basis label never made sense on it and was
                                                                    presumably copy-pasted down from switch-save__price above.
                                                                    Removed entirely rather than just de-labelled. *@
                                                                Save £@saving.ToString("N2")
                                                            </div>
                                                            <!-- Switch button -->
                                                            <button class="switch-save__btn minibasket-replace"
                                                                    type="button"
                                                                    data-productid="@bc.CrossSellingStockRef"
                                                                    data-price="@bc.CrossSellingPriceEx"
                                                                    data-removeid="@bc.StockRef"
                                                                    data-qty="@bc.Quantity">
                                                                Switch Now
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }

                                </div>
                            }
                            /*
                             * Compatible discount / multibuy line
                             */
                            if (bc.ItemType == BasketItemType.CompatibleDiscount)
                            {
                                isMultiBuy = true;
                                multibuyAmount = bc.PriceEx;
                            }
                        }
                        /*
                         * Basket contains lines but no actual products.
                         */
                        if (cardsRendered == 0)
                        {
                            <div class="mini-cart__empty">
                                We're just updating your basket -
                                please refresh this page.
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mini-cart__empty">
                            Your basket is empty.
                        </div>
                    }
                </div>
                <!-- Footer -->
                <div class="mini-cart__footer">
                    <!-- Total -->
                    <div class="total-row">
                        <span>
                            Total Payable
                        </span>
                        <span>
                            £@bt.GrandTotalIncVat.ToString("0.00")
                        </span>
                    </div>
                    <!-- Voucher -->
                    @if (Session["B_VoucherCode"].ToSafeString() != "")
                    {
                        decimal totalSaving =
                            bt.Voucher + bt.VoucherVat;
                        <details class="promo" open="open">
                            <summary>
                                Promotion Code
                            </summary>
                            <div class="promo-applied">
                                <span class="promo-applied__code">
                                    @Session["B_VoucherCode"]
                                </span>
                                <button type="button"
                                        class="minibasket-voucher-remove"
                                        title="Remove voucher code">
                                    <i class="fa fa-times"></i>
                                </button>
                                <span class="promo-applied__saving">
                                    -£@Math.Abs(totalSaving).ToString("0.00")
                                </span>
                            </div>
                        </details>
                    }
                    else
                    {
                        <details class="promo">
                            <summary>
                                Promotion Code
                            </summary>
                            <div class="promo-form">
                                <input id="minibasket-voucher-code"
                                       type="text"
                                       placeholder="Enter voucher code" />
                                <button class="minibasket-apply-voucher"
                                        type="button">
                                    Apply
                                </button>
                            </div>
                            <div id="minibasket-voucher-code-error"
                                 class="promo-error g-v-h">
                            </div>
                        </details>
                    }
                    <!-- Delivery -->
                    <div class="free-delivery">
                        <i class="fa fa-truck"></i>
                        <span>
                            @deliveryMessage
                        </span>
                    </div>
                    <!-- Checkout -->
                    <button class="checkout-btn checkout-button"
                            type="button">
                        Proceed to Checkout
                    </button>
                    <!-- View basket -->
                    <div class="checkout-edit">
                        <a href="/checkout/"
                           class="view-basket-link">
                            View / Edit Basket
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        // Open / close mini cart - this whole block re-runs every time site.js swaps in fresh
        // data.basketSummary (see .replaceWith(data.basketSummary) calls in site.js), because
        // jQuery executes <script> tags contained in HTML passed to replaceWith/html. That's
        // required here since a plain DOM replace gives the new #miniCartOverlay/#miniCartClose
        // nodes no listeners at all - re-running this re-attaches them to the fresh elements
        // every time. querySelectorAll('.qty-stepper') block that used to live here (looking
        // for .qty-minus/.qty-plus) has been removed - those classes don't exist on the actual
        // buttons (they use onclick="changeMiniBasketQty(...)" directly, which already updates
        // the real server-side quantity), so that old block was dead code that threw on every
        // run instead of doing anything useful.
        // The floating #cartFab button (and its own click->openCart() binding) has been removed
        // - the mini-cart is now opened only via the header's ".open-mini-cart" links, handled
        // by a delegated click handler in site.js. openCart()/closeCart() themselves stay
        // defined here (global functions, per the original design) since site.js's fallback
        // path and any other future trigger can still call them directly.
        var overlay = document.getElementById('miniCartOverlay');
        var closeBtn = document.getElementById('miniCartClose');
        function openCart() {
            overlay.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }
        function closeCart() {
            overlay.classList.remove('is-open');
            document.body.style.overflow = '';
        }
        closeBtn.addEventListener('click', closeCart);
        overlay.addEventListener('click', function (e) {
            if (e.target === overlay) { closeCart(); } // click outside panel closes it
        });
        // The keydown listener below is bound to `document`, which never gets replaced by
        // the basket-refresh AJAX calls - only the widget's own markup does. Re-running this
        // script on every refresh would otherwise stack a fresh duplicate listener on
        // `document` each time (harmless individually since closeCart() is idempotent, but it
        // leaks over a long browsing session). Guarded with a one-time flag so it only binds
        // once per page load no matter how many times the widget itself gets refreshed.
        if (!document.body.dataset.miniCartEscBound) {
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    var ov = document.getElementById('miniCartOverlay');
                    if (ov && ov.classList.contains('is-open')) {
                        ov.classList.remove('is-open');
                        document.body.style.overflow = '';
                    }
                }
            });
            document.body.dataset.miniCartEscBound = '1';
        }
    </script>
</div>
