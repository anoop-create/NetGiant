@using System.Configuration
@using BusinessLogic;
@using CommonUI.Models;
@using System.Data;

@{
    var bt = (BasketTotals)Session["B_BasketTotals"];
    Tuple<string, decimal> summPrice = Utilities.SetPrice(bt.TotalIncVat, bt.TotalExcVat);
}

@{
    Html.RenderPartial("~/Views/Shared/MiniBasket.cshtml");
}

<div style="display: none !important;" id="recent" class="navbar-toggle offcanvas-toggle collapsed pull-left" type="button" data-toggle="offcanvas-open" data-target="#utility-bar" aria-expanded="false">
    <div class="header g-flex-vcenter" data-label="Recently Viewed">
        <span class="sr-only">Toggle Recently Viewed</span>
        <span class="fa fa-eye fa-lg"></span>
        <span class="g-fs-lg g-p-l-20">Recently Viewed</span>
    </div>
    <div class="content clearfix">
        @{
            if (Session["U_RecentlyViewed"] != null)
            {
                List<RecentlyViewed> lrv = (List<RecentlyViewed>)Session["U_RecentlyViewed"];
                foreach (RecentlyViewed rv in lrv)
                {
                    <hr class="g-m-tb-10" />
                    <div class="myprinter-entry g-m-t-10 clearfix g-flex-vcenter">
                        <div class="pull-left">
                            <img src="/Content/Images/1pxTrans.png" class="deferImage" data-original="@rv.ImageUrl" data-used="@ConfigurationManager.AppSettings["CDN"]/@rv.ImageUrl" alt="@rv.Description" />
                        </div>
                        <div class="g-m-l-10 g-fs-sm">
                            <div class="">@rv.Description</div>
                            <a class="btn g-butt-second-reg g-butt-xl g-m-t-10" href="@rv.Url" role="button">View @(rv.Type == "Product" ? "Product" : "Cartridges")</a>
                        </div>
                    </div>
                }
                @*<div class="keep g-m-t-10">
                        <div class="message">*More entries in My Account</div>
                        <a class="btn g-butt-second-reg g-butt-100p g-m-t-10" href="/MyAccount/Index/RecentlyViewed" role="button">View All</a>
                    </div>*@
            }
        }

        <hr class="g-m-tb-10" />
    </div>
</div>

<div style="display: none !important;" id="my-printers" class="navbar-toggle offcanvas-toggle collapsed pull-left" type="button" data-toggle="offcanvas-open" data-target="#utility-bar" aria-expanded="false">
    <div class="header g-flex-vcenter" data-label="My Printers">
        <span class="sr-only">Toggle My Printers</span>
        <img class="msp_printer" src="~/Content/Images/1pxTrans.png" />
        <span class="g-fs-lg g-p-l-20">My Printers</span>
    </div>
    <div class="content clearfix">
        @*<div id="myPrinters">*@
        @{
            if (Session["U_FavoutirePrinters"] != null)
            {
                DataTable dt = (DataTable)Session["U_FavoutirePrinters"];
                foreach (DataRow dr in dt.Rows)
                {
                    string printername = dr["Name"].ToSafeString();
                    if (printername == "My Printer")
                    {
                        printername = dr["modelName"].ToSafeString();
                    }
                    <hr class="g-m-tb-10" />
                    <div class="myprinter-entry g-m-t-10 clearfix g-flex-vcenter myprinter-id-@dr["FavouritePrinterID"].ToString()"
                         xdata-toggle="tooltip"
                         xdata-placement="bottom"
                         xtitle="@(dr["ModelName"].ToSafeString())">
                        <div class="pull-left">
                            <img src="/Content/Images/1pxTrans.png" class="deferImage" data-original="@dr["ImageURL"].ToString()" alt="@dr["ModelName"].ToString()" title="@(dr["ModelName"].ToSafeString())" />
                        </div>
                        <div class="g-m-l-10 g-fs-sm">
                            <div title="@(dr["ModelName"].ToSafeString())">@printername</div>
                            <a class="btn g-butt-second-reg g-butt-xl g-m-t-10" href="/model/@dr["modelName"].ToString().Replace(" ", "-")-@dr["CartridgeTypeName"].ToString().Replace(" ", "-").ToLower()/" role="button">View Cartridges</a>
                        </div>
                    </div>
                }
                <div class="keep g-m-t-10">
                    <div class="message">*More entries in My Account</div>
                    <a class="btn g-butt-second-reg g-butt-100p g-m-t-10" href="/MyAccount/Index/MyPrinters" role="button">View All</a>
                </div>
            }
            else
            {
                <hr class="g-m-tb-10" />
                <div>@(Authentication.IsNotAuthenticated() ? "Please login to see your saved printers" : "You don't currently have any saved printers")</div>
            }
        }
        @*</div>*@

        <hr class="g-m-tb-10" />
    </div>
</div>

<div style="display: none !important;" id="quick-order" class="navbar-toggle offcanvas-toggle collapsed pull-left" type="button" data-toggle="offcanvas-open" data-target="#utility-bar" aria-expanded="false">
    <div class="header g-flex-vcenter" data-label="Quick Reorder">
        <span class="sr-only">Toggle Quick Reorder</span>
        <img class="msp_quickreorder" src="~/Content/Images/1pxTrans.png" />
        <span class="g-fs-lg g-p-l-20">Quick Reorder</span>
    </div>
    <div class="content clearfix">
        @{
            if (Session["U_RecentlyOrdered"] != null)
            {
                DataTable dt = (DataTable)Session["U_RecentlyOrdered"];
                foreach (DataRow dr in dt.Rows)
                {
                    <hr class="g-m-tb-10" />
                    <div class="quickreorder-entry g-m-t-10 clearfix g-flex-vcenter product-id-@dr["ProductID"].ToString()">
                        <div class="pull-left">
                            <img src="/Content/Images/1pxTrans.png" class="deferImage" data-original="@dr["ImageURL"].ToString()" alt="@dr["Description"].ToString()" />
                        </div>
                        <div class="atb-entry g-m-l-10 g-fs-sm">
                            <div class="">@dr["Description"].ToString()</div>
                            <button class="atb-add btn g-butt-second-reg g-butt-xl g-m-t-10"
                                    data-price="0"
                                    data-productid="@dr["ProductReference"].ToSafeString()"
                                    data-partno="@dr["PartNo"].ToSafeString()"
                                    data-imageurl="@dr["ImageURL"].ToSafeString()"
                                    data-desc="@dr["Description"].ToSafeString()">
                                Add to Basket
                            </button>
                        </div>
                    </div>
                }
                <div class="keep g-m-t-10">
                    <div class="message">*More entries in My Account</div>
                    <a class="btn g-butt-second-reg g-butt-100p g-m-t-10" href="/MyAccount/Index/QuickReorder" role="button">View All</a>
                </div>
            }
            else
            {
                <hr class="g-m-tb-10" />
                <div>@(Authentication.IsNotAuthenticated() ? "Please login to see your recently ordered products" : "You don't currently have any recently ordered products")</div>
            }
        }

        <hr class="g-m-tb-10" />
    </div>
</div>

