        }

            .hdr-utility-menu .active .header span {
                color: #fff !important;
                font-size: 18px
            }

        .mini-cart__header small {
            color: #fff !important;
            font-weight: 500 !important;
        }

        .mini-cart__header button i {
            color: #fff !important;
            font-weight: 500 !important;
        }

        .free-delivery span {
            color: #00a651 !important;
            font-weight: 500;
        }

        .free-delivery i {
