        display: flex;
        gap: 10px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
    }

    .cart-item__link {
        flex-shrink: 0;
        display: block;
    }

    .cart-item__img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .cart-item__details {
        flex: 1;
        min-width: 0;
    }

    .cart-item__title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin: 0 0 6px;
        line-height: 1.3;
