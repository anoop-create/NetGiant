</style>

<div id="basket" class="navbar-toggle offcanvas-toggle collapsed pull-left" type="button" data-toggle="offcanvas-open"
     data-target="#utility-bar" aria-expanded="false">
    <div class="header g-flex-vcenter" data-label="View Basket">
        <span class="sr-only">Toggle Basket</span>
        <img class="msp_basket" src="~/Content/Images/1pxTrans.png" />
        <span class="g-fs-lg g-p-l-20">Basket</span>
    </div>
    <div class="content clearfix">
        <div class="mini-cart">
            <div class="mini-cart__header">
                <span style=" color: white !important; ">
                    Summary
                </span>
                <button type="button"
                        class="mini-cart__close"
                        data-toggle="offcanvas-close"
                        data-target="#utility-bar">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="mini-cart__body">
                @if (lbc.Count > 0)
                {
                    bool isMultiBuy = false;
                    decimal multibuyAmount = decimal.Zero;
                    // Counts real product cards actually rendered below - lbc.Count > 0 only
                    // tells us the basket has SOME lines (could be delivery/discount-only
                    // lines with no ItemType == Item/AdminDiscount). Without this, a basket
                    // that has lines but nothing renderable falls through silently blank.
                    int cardsRendered = 0;
                    var list = lbc;
                    if (list != null && list.Count > 1)
                    {
                        foreach (BasketContents item in lbc)
                        {
                            if (item.ItemType != BasketItemType.Item)
                            { continue; }
                            if (item.IsCompatible)
                            { continue; }
                            if (item.ExcludeFromUpSell)
                            { continue; }
                            if (item.CrossSellingStockRef == null || item.CrossSellingStockRef == "")
                            {
                                continue;
                            }
                            if (item.CrossSellingAvailability != 1 &&
                            item.CrossSellingAvailability != 7)
                            { continue; }
                            decimal lineSaving =
                            (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;
                            if (lineSaving <= 0)
                            { continue; }
                            basketSwitchSaving += lineSaving;
                            switchProducts.Add(item);
                        }
                        hasSwitchProducts = switchProducts.Count > 0;
                        switchCount = switchProducts.Count;
                    }
                    if (hasSwitchProducts && switchCount > 1)
                    {
                        <div class="switch-save switch-save--all">
                            <span class="switch-save__label">
                                SWITCH &amp; SAVE
                            </span>
                            <div class="switch-save-all__body">
                                <p class="switch-save-all__msg">
                                    Save £@string.Format("{0:N2}", basketSwitchSaving) by switching your whole basket to compatible products.
                                </p>
                                <button id="btnSwitchAll" type="button" class="switch-save__btn">
                                    Switch All Items
                                </button>
                            </div>
                        </div>
                    }
                    foreach (BasketContents bc in list)
                    {
                        if (bc.ItemType == BasketItemType.Item || bc.ItemType == BasketItemType.AdminDiscount)
                        {
                            cardsRendered++;
                            // Guard against a null/malformed ProductUrl - if a line's data is
                            // incomplete, a bare @bc.ProductUrl renders a broken href="" instead
                            // of failing loudly, so normalize it here and use productUrl below.
                            var productUrl = !string.IsNullOrEmpty(bc.ProductUrl) && bc.ProductUrl.StartsWith("/")
                                ? bc.ProductUrl
                                : "/" + (bc.ProductUrl ?? "");
                            string neg = bc.ItemType == BasketItemType.AdminDiscount ? "-" : "";
                            string strike = "";
                            string discClass = "g-d-n";
                            decimal discUnitPrice = decimal.Zero;
                            decimal subt = bc.PriceEx * bc.Quantity;
                            decimal discountRate = Utilities.GetUpsellRate();
                            if (!bc.IsCompatible &&
                            !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                            !bc.ExcludeFromUpSell &&
                            (bc.CrossSellingAvailability == 1 || bc.CrossSellingAvailability == 7))
                            {
                                decimal lineSaving = (bc.PriceEx - bc.CrossSellingPriceEx) * bc.Quantity;
                                if (lineSaving > 0)
                                {
                                    basketSwitchSaving += lineSaving;
                                    hasSwitchProducts = true;
                                }
                            }
                            if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                !isAdminDiscount &&
                                bc.Quantity > bc.QtyStart)
                            {
                                discUnitPrice = Math.Round(bc.PriceEx, 2) - Math.Round(bc.PriceEx * discountRate / 100, 2);
                                subt = discUnitPrice * bc.Quantity;
                                strike = "g-s";
                                discClass = "";
                            }
                            <div>
                                <div class="cart-item atb-entry" data-productid="@bc.StockRef">
                                    <a href="@productUrl" class="cart-item__link">
                                        <img src="@bc.ImageUrl"
                                             alt="@bc.Description"
                                             class="cart-item__img"
                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                    </a>
                                    <div class="cart-item__details">
                                        <a href="@productUrl" class="cart-item__title">
                                            @bc.Description
                                        </a>
                                        <div class="cart-item__sku">
                                            Product Code: @bc.PartNo
                                        </div>
                                        <div class="cart-item__price">
                                            @neg@string.Format("{0:N2}", bc.PriceEx)
                                            <span class="vat">
                                                @* FIX: was "Trade Price, ex VAT" for trade customers vs plain "Ex VAT"
                                                    for everyone else - the "Trade Price, " prefix isn't wanted here,
                                                    trade customers should see the exact same "Ex VAT" label as
                                                    anyone else. *@
                                                Ex VAT
                                            </span>
                                            @if (discUnitPrice > 0)
                                            {
                                                <div class="price-saving">
                                                    Save @string.Format("{0:N2}", bc.PriceEx - discUnitPrice)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="cart-item__actions">
                                        @if (!bc.IsFreeGift)
                                        {
                                            <button class="cart-item__remove basket-remove delete"
                                                    data-productid="@bc.StockRef"
                                                    type="button">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                            <div class="qty-stepper">
                                                <button type="button"
                                                        @(bc.Quantity <= 1 ? "disabled" : "")
                                                        onclick="changeBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity-1)))">
                                                    -
                                                </button>
                                                <input type="text"
                                                       readonly
                                                       value="@bc.Quantity" />
                                                <button type="button"
                                                        onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity+1))">
                                                    +
                                                </button>
                                            </div>
                                        }
                                        @if (Session["V_Voucher"] != null)
                                        {
                                            VoucherPromo vp = (VoucherPromo)Session["V_Voucher"];
                                            if (bc.IsVoucherQualifyingItem &&
                                                vp.VoucherTypeFk == (int)VmVoucherType.Percentage)
                                            {
                                                <div class="voucher-applied">
                                                    <i class="fa fa-check-circle"></i>
                                                    Voucher Applied
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                                @if (!bc.IsCompatible && !String.IsNullOrEmpty(bc.CrossSellingStockRef) && !bc.ExcludeFromUpSell)
                                {
                                    List<int> inStock = new List<int> { 1, 7 };
                                    if (inStock.Contains(bc.CrossSellingAvailability))
                                    {
                                        decimal switchUnitPriceEx = bc.CrossSellingPriceEx;
                                        decimal switchLinePriceEx = switchUnitPriceEx * bc.Quantity;
                                        decimal switchLinePriceInc = switchLinePriceEx * Model.VatMultiplier;
                                        decimal saving = (bc.PriceEx - switchUnitPriceEx) * bc.Quantity;
                                        if (saving > 0)
                                        {
                                            <div class="switch-save">
                                                <span class="switch-save__label">
                                                    SWITCH &amp; SAVE
                                                </span>
                                                <div class="switch-save__content">
                                                    <a href="@bc.CrossSellingProductUrl">
                                                        <img src="@(!String.IsNullOrEmpty(bc.CrossSellingImageURL) ? bc.CrossSellingImageURL : bc.ImageUrl)"
                                                             alt="@bc.CrossSellingDescription"
                                                             class="switch-save__img"
                                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                                    </a>
                                                    <div style="flex:1;">
                                                        <a href="@bc.CrossSellingProductUrl"
                                                           class="switch-save__title">
                                                            @bc.CrossSellingDescription
                                                        </a>
                                                        <div class="switch-save__sku">
                                                            Compatible for @bc.PartNo
                                                        </div>
                                                        <div class="stock-status in-stock">
                                                            <i class="fa fa-check-circle"></i>
                                                            <span>In Stock</span>
                                                        </div>
                                                        <div class="switch-save__price">
                                                            £@string.Format("{0:N2}", switchLinePriceEx)
                                                            <span class="vat">
                                                                @* FIX: same "Trade Price, " prefix removed as the main
                                                                    cart-item price above - trade customers should see
                                                                    the plain "exc. VAT" label here too. *@
                                                                exc. VAT
                                                            </span>
                                                        </div>
                                                        <div class="switch-save__save">
                                                            Save £@string.Format("{0:N2}", saving) ex VAT
                                                        </div>
                                                        <button class="switch-save__btn atb-replace"
                                                                data-productid="@bc.CrossSellingStockRef"
                                                                data-price="@bc.CrossSellingPriceEx"
                                                                data-removeid="@bc.StockRef"
                                                                data-qty="@bc.Quantity">
                                                            Switch Now
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                            </div>
                        }
                        if (bc.ItemType == BasketItemType.CompatibleDiscount)
                        {
                            isMultiBuy = true;
                            multibuyAmount = bc.PriceEx;
                        }
                    }

                    if (cardsRendered == 0)
                    {
                        <div class="mini-cart__empty">
                            We're just updating your basket - please refresh this page.
                        </div>
                    }
                }
                else
                {
                    <div class="mini-cart__empty">
                        Your basket is empty.
                    </div>
                }
            </div>
            <div class="mini-cart__footer">
                <div class="total-row">
                    <span>Total Payable</span>
                    <span>
                        £@bt.GrandTotalIncVat.ToString("0.00")
                    </span>
                </div>
                @if (Session["B_VoucherCode"].ToSafeString() != "")
                {
                    decimal totalSaving = bt.Voucher + bt.VoucherVat;
                    <details class="promo" open="open">
                        <summary>
                            Promotion Code
                        </summary>
                        <div class="promo-applied">
                            <span class="promo-applied__code">
                                @Session["B_VoucherCode"]
                            </span>
                            <button type="button"
                                    class="voucher-remove"
                                    title="Remove voucher code">
                                <i class="fa fa-times"></i>
                            </button>
                            <span class="promo-applied__saving">
                                -£@Math.Abs(totalSaving).ToString("0.00")
                            </span>
                        </div>
                    </details>
                }
                else
                {
                    <details class="promo">
                        <summary>
                            Promotion Code
                        </summary>
                        <div class="promo-form">
                            <input id="voucher-code1"
                                   type="text"
                                   placeholder="Enter voucher code" />
                            <button id="apply-voucher"
                                    type="button">
                                Apply
                            </button>
                        </div>
                        <div id="voucher-code-error" class="promo-error g-v-h"></div>
                    </details>
                }
                <div class="free-delivery">
                    <i class="fa fa-truck"></i>
                    <span>
                        @deliveryMessage
                    </span>
                </div>
                <button class="checkout-btn"
                        type="button"
                        onclick="proceedToCheckout()">
                    Proceed to Checkout
                </button>
                @*<a href="/checkout/"
                   class="view-basket-link">
                    View / Edit Basket
                </a>*@
            </div>
        </div>
    </div>
</div>
