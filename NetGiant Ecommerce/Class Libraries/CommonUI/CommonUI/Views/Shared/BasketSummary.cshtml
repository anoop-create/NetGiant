            font-weight: 600;
            margin-bottom: 8px
        }

        .delivery-cutoff {
            color: #262626 !important;
            margin-bottom: 8px
        }

            .delivery-cutoff i {
                color: #262626 !important;
            }

        .cart-item__price {
            color: #09c !important
        }

        .switch-save__price strong {
            color: #09c !important
