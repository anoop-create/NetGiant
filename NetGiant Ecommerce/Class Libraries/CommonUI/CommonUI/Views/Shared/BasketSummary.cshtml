        border: 1px solid #666;
        border-radius: 50%;
    }

    .mini-cart__body {
        flex: 1;
        overflow-y: auto;
        padding: 12px 16px;
    }
    /* Cart item */
    .cart-item {
        display: flex;
        gap: 10px;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
    }

    .cart-item__link {
        flex-shrink: 0;
        display: block;
    }

    .cart-item__img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .cart-item__details {
        flex: 1;
        min-width: 0;
    }

    .cart-item__title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin: 0 0 11px;
        line-height: 1.3;
        text-decoration: none;
    }

        .cart-item__title:hover {
            color: #000;
            text-decoration: underline;
        }

    .cart-item__sku {
        font-size: 11px;
        color: var(--muted);
        margin: 0 0 6px;
    }

    .cart-item__price {
        font-size: 17px;
        font-weight: 700;
        color: #09c;
        margin: 0;
    }

        .cart-item__price .vat {
            font-size: 11px;
            font-weight: 400;
            color: var(--muted);
        }

    .cart-item__actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: space-between;
        gap: 8px;
    }

    .cart-item__remove {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--muted);
        font-size: 14px;
    }

    .qty-stepper {
        display: flex;
        align-items: center;
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
    }

        .qty-stepper button {
            background: #fafafa;
            border: none;
            width: 24px;
            height: 24px;
            cursor: pointer;
            font-size: 14px;
            line-height: 1;
            color: #000000;
        }

        .qty-stepper input {
            width: 28px;
            text-align: center;
            border: none;
            border-left: 1px solid var(--border);
            border-right: 1px solid var(--border);
            font-size: 13px;
            height: 24px;
            color: #000000;
        }
    /* Switch & Save */
    .switch-save {
        border: 1px solid var(--pink);
        border-radius: 6px;
        padding: 14px;
        margin: 10px 0 16px;
        position: relative;
    }

    .switch-save__label {
        position: absolute;
        top: -9px;
        left: 12px;
        background: #fff;
        padding: 0 6px;
        color: var(--pink);
        font-size: 12px;
        font-weight: 700;
    }

    .switch-save__content {
        display: flex;
        gap: 10px;
    }

    .switch-save__img {
        width: 48px;
        height: 48px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .switch-save__title {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        text-decoration: none;
        margin: 0 0 4px;
    }

        .switch-save__title:hover {
            color: var(--pink);
            text-decoration: underline;
        }

    .switch-save__sku {
        font-size: 11px;
        color: var(--muted);
        margin: 0 0 6px;
    }

    .switch-save__price {
        font-size: 14px;
        font-weight: 700;
        margin: 0 0 2px;
        color: #000000;
    }

        .switch-save__price .vat {
            font-size: 11px;
            font-weight: 400;
            color: var(--muted);
        }

    .switch-save__save {
        font-size: 12px;
        font-weight: 700;
        color: var(--pink);
        margin: 0 0 10px;
    }

    .switch-save__btn {
        display: block;
        width: 100%;
        background: #fff;
        border: 1px solid var(--pink);
        color: var(--pink);
        font-weight: 700;
        font-size: 13px;
        padding: 8px;
        border-radius: 4px;
        cursor: pointer;
    }
    /* Footer */
    .mini-cart__footer {
        border-top: 1px solid var(--border);
        padding: 14px 16px 16px;
    }

    .total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 16px;
        font-weight: 700;
        margin-bottom: 10px;
        color: #000000;
    }

    .promo {
        margin-bottom: 12px;
    }

        .promo summary {
            font-size: 13px;
            color: #000;
            cursor: pointer;
            list-style: none;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 0;
        }

            .promo summary::-webkit-details-marker {
                display: none;
            }

            .promo summary::after {
                content: "▾";
                transition: transform .2s;
                font-size: 20px;
            }

        .promo[open] summary::after {
            transform: rotate(180deg);
        }

    .promo-form {
        display: flex;
        gap: 8px;
        margin-top: 8px;
    }

        .promo-form input {
            flex: 1;
            border: 1px solid var(--border);
            border-radius: 4px;
            padding: 8px 10px;
            font-size: 13px;
        }

        .promo-form button {
            background: var(--green);
            color: #fff;
            border: none;
            border-radius: 4px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

    .promo-error {
        color: #c0392b;
        font-size: 12px;
        margin-top: 6px;
    }

    .promo-applied {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }

    .promo-applied__code {
        font-weight: 700;
        font-size: 13px;
        color: #000;
    }

    .voucher-remove {
        background: none;
        border: none;
        color: var(--pink);
        cursor: pointer;
        font-size: 13px;
        padding: 0;
    }

    .promo-applied__saving {
        margin-left: auto;
        font-weight: 700;
        font-size: 13px;
        color: var(--pink);
    }

    .free-delivery {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        color: var(--green);
        margin-bottom: 12px;
    }

    .checkout-btn {
        display: block;
        width: 100%;
        background: var(--green);
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 14px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
    }

        .checkout-btn:hover {
            background: #008f45;
        }

    /* Spec: "Transparent overlay added to the background of the screen, so that the tray has
       more definition" - dimmed backdrop shown behind the tray while it's open (see site.js). */
    .offcanvas-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.35);
        z-index: 1040;
    }

    .sidebar-offcanvas * {
        color: black !important;
    }
</style>

<div id="basket" class="navbar-toggle offcanvas-toggle collapsed pull-left" type="button" data-toggle="offcanvas-open"
     data-target="#utility-bar" aria-expanded="false">
    <div class="header g-flex-vcenter" data-label="View Basket">
        <span class="sr-only">Toggle Basket</span>
        <img class="msp_basket" src="~/Content/Images/1pxTrans.png" />
        <span class="g-fs-lg g-p-l-20">Basket</span>
    </div>
    <div class="">
        <div class="mini-cart">
            <div class="mini-cart__header">
                <span style=" color: white !important; ">
                    Summary
                </span>

                <button type="button"
                        class="mini-cart__close"
                        data-toggle="offcanvas-close"
                        data-target="#utility-bar">
                    <i class="fa fa-times"></i>
                </button>
            </div>
            <div class="mini-cart__body">
               
                @if (lbc.Count > 0)
                {
                    //bool isAdminDiscount = false;// Model.BasketContents.Exists(y => y.ItemType == BasketItemType.AdminDiscount);
                    //bool isCompatibleDiscount = false;// Model.BasketContents.Exists(x => x.ItemType == BasketItemType.CompatibleDiscount);
                    bool isMultiBuy = false;
                    decimal multibuyAmount = decimal.Zero;
                    // Model.CheckZeroStock();

                    // Logic to build Basket Switch & Save section

                    var list = lbc;
                    if (list != null && list.Count > 1)
                    {
                        foreach (BasketContents item in lbc)
                        {
                            // Ignore non-product lines
                            if (item.ItemType != BasketItemType.Item)
                            { continue; }

                            // Ignore compatible products (already switched)
                            if (item.IsCompatible)
                            { continue; }

                            // Ignore excluded products
                            if (item.ExcludeFromUpSell)
                            { continue; }

                            // Cross-sell product must exist
                            if (item.CrossSellingStockRef == null || item.CrossSellingStockRef == "")
                            {
                                continue;
                            }

                            // Cross-sell product must be in stock
                            if (item.CrossSellingAvailability != 1 &&
                            item.CrossSellingAvailability != 7)
                            { continue; }

                            decimal lineSaving =
                            (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;

                            // Only show if customer actually saves money
                            if (lineSaving <= 0)
                            { continue; }

                            basketSwitchSaving += lineSaving;
                            switchProducts.Add(item);
                        }
                        hasSwitchProducts = switchProducts.Count > 0;
                        switchCount = switchProducts.Count;
                    }
                    if (hasSwitchProducts && switchCount>1)
                    {


                        <div class="basket-switch-save">
                            <button class="btn switchsave">
                                Switch &amp; Save
                            </button>
                            <div class="">

                                Switch &amp; Save

                                <p>
                                    Save £@string.Format("{0:N2}", basketSwitchSaving) by switching your basket to compatible products.
                                </p>

                            </div>

                            <div class="basket-switch-btn">

                            </div><button id="btnSwitchAll" class="btn replaceall">
                                Switch All Products
                            </button>

                        </div>
                    }
                    foreach (BasketContents bc in list)
                    {
                        if (bc.ItemType == BasketItemType.Item || bc.ItemType == BasketItemType.AdminDiscount)
                        {
                            string neg = bc.ItemType == BasketItemType.AdminDiscount ? "-" : "";
                            string strike = "";
                            string discClass = "g-d-n";
                            decimal discUnitPrice = decimal.Zero;
                            decimal subt = bc.PriceEx * bc.Quantity;
                            decimal discountRate = Utilities.GetUpsellRate();
                            if (!bc.IsCompatible &&
                            !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                            !bc.ExcludeFromUpSell &&
                            (bc.CrossSellingAvailability == 1 || bc.CrossSellingAvailability == 7))
                            {
                                decimal lineSaving = (bc.PriceEx - bc.CrossSellingPriceEx) * bc.Quantity;

                                if (lineSaving > 0)
                                {
                                    basketSwitchSaving += lineSaving;
                                    hasSwitchProducts = true;
                                }
                            }
                            if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                !isAdminDiscount &&
                                bc.Quantity > bc.QtyStart)
                            {
                                discUnitPrice = Math.Round(bc.PriceEx, 2) - Math.Round(bc.PriceEx * discountRate / 100, 2);
                                subt = discUnitPrice * bc.Quantity;
                                strike = "g-s";
                                discClass = "";
                            }
                            <div>
                            <div class="cart-item atb-entry" data-productid="@bc.StockRef">

                                <!-- Product Image -->
                                <a href="@bc.ProductUrl" class="cart-item__link">
                                    <img src="@bc.ImageUrl"
                                         alt="@bc.Description"
                                         class="cart-item__img"
                                         onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </a>

                                <!-- Product Details -->
                                <div class="cart-item__details">

                                    <a href="@bc.ProductUrl" class="cart-item__title">
                                        @bc.Description
                                    </a>

                                    <div class="cart-item__sku">
                                        Product Code: @bc.PartNo
                                    </div>

                                    <div class="basket-status">

                                        @if (bc.Availability == 1 || bc.Availability == 7)
                                        {
                                            <div class="stock-status in-stock">
                                                <i class="fa fa-check-circle"></i>
                                                <span>In Stock</span>
                                            </div>

                                            if (!Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"]))
                                            {
                                                <div class="delivery-cutoff">
                                                    <i class="fa fa-clock-o"></i>
                                                    Order Within
                                                    <strong>
                                                        <span class="cutoffCountdownFalse"></span>
                                                    </strong>
                                                </div>

                                                <div class="delivery-date">
                                                    Delivered @Session["D_standardDeliveryDay"]
                                                </div>
                                            }
                                        }
                                        else if (bc.Availability == 10)
                                        {
                                            <div class="stock-status special-order">
                                                <i class="fa fa-info-circle"></i>
                                                <span>Special Order Item</span>
                                            </div>

                                            <div class="delivery-status">
                                                Call
                                                <a href="tel:@Utilities.GetItemFromDict(Model.CommonData,"TelephoneNumber")">
                                                    @Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")
                                                </a>
                                                for delivery information.
                                            </div>
                                        }
                                        else if (bc.Availability == 11 || bc.Availability == 13)
                                        {
                                            <div class="stock-status out-of-stock">
                                                <i class="fa fa-times-circle"></i>
                                                <span>Out of Stock</span>
                                            </div>

                                            <div class="delivery-status">
                                                Currently unavailable.
                                            </div>
                                        }
                                        else if (bc.Availability == 2 || bc.Availability == 4)
                                        {
                                            <div class="stock-status availability">
                                                <i class="fa fa-clock-o"></i>
                                                <span>Availability 2–3 Days</span>
                                            </div>

                                            <div class="delivery-status">
                                                Dispatched when stock returns.
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="stock-status back-order">
                                                <i class="fa fa-history"></i>
                                                <span>Back In Stock Soon</span>
                                            </div>

                                            <div class="delivery-status">
                                                Dispatched when stock returns.
                                            </div>
                                        }

                                    </div>

                                    <div class="cart-item__price">

                                        @neg@string.Format("{0:N2}", bc.PriceEx)

                                        <span class="vat">
                                            @(isTradeCustomer ? "Trade Price, ex VAT" : "Ex VAT")
                                        </span>

                                        @if (discUnitPrice > 0)
                                        {
                                            <div class="price-saving">
                                                Save @string.Format("{0:N2}", bc.PriceEx - discUnitPrice)
                                            </div>
                                        }

                                    </div>

                                </div>

                                <!-- Right Actions -->
                                <div class="cart-item__actions">

                                    @if (!bc.IsFreeGift)
                                    {
                                        <button class="cart-item__remove basket-remove delete"
                                                data-productid="@bc.StockRef"
                                                type="button">
                                            <i class="fa fa-trash"></i>
                                        </button>

                                        <div class="qty-stepper">

                                            <button type="button"
                                                    @(bc.Quantity <= 1 ? "disabled" : "")
                                                    onclick="changeBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity-1)))">
                                                -
                                            </button>

                                            <input type="text"
                                                   readonly
                                                   value="@bc.Quantity" />

                                            <button type="button"
                                                    onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity+1))">
                                                +
                                            </button>

                                        </div>
                                    }

                                    @if (Session["V_Voucher"] != null)
                                    {
                                        VoucherPromo vp = (VoucherPromo)Session["V_Voucher"];

                                        if (bc.IsVoucherQualifyingItem &&
                                            vp.VoucherTypeFk == (int)VmVoucherType.Percentage)
                                        {
                                            <div class="voucher-applied">
                                                <i class="fa fa-check-circle"></i>
                                                Voucher Applied
                                            </div>
                                        }
                                    }

                                </div>

                            </div>
                                @* ---------------- Switch & Save ----------------
                                    Fully data-bound - every value below comes from bc / Model,
                                    nothing hardcoded. Eligibility rules unchanged from before:
                                    not already compatible, has a cross-sell ref, that ref is
                                    in stock (1 or 7), and switching genuinely saves money. *@
                                @if (!bc.IsCompatible && !String.IsNullOrEmpty(bc.CrossSellingStockRef) && !bc.ExcludeFromUpSell)
                                {
                                    List<int> inStock = new List<int> { 1, 7 };

                                    if (inStock.Contains(bc.CrossSellingAvailability))
                                    {
                                        decimal switchUnitPriceEx = bc.CrossSellingPriceEx;
                                        decimal switchLinePriceEx = switchUnitPriceEx * bc.Quantity;
                                        decimal switchLinePriceInc = switchLinePriceEx * Model.VatMultiplier;
                                        decimal saving = (bc.PriceEx - switchUnitPriceEx) * bc.Quantity;

                                        if (saving > 0)
                                        {
                                            <div class="switch-save">

                                                <span class="switch-save__label">
                                                    SWITCH &amp; SAVE
                                                </span>

                                                <div class="switch-save__content">

                                                    <a href="@bc.ProductUrl">

                                                        <img src="@(!String.IsNullOrEmpty(bc.CrossSellingImageURL) ? bc.CrossSellingImageURL : bc.ImageUrl)"
                                                             alt="@bc.CrossSellingDescription"
                                                             class="switch-save__img"
                                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                                    </a>

                                                    <div style="flex:1;">

                                                        <a href="@bc.ProductUrl"
                                                           class="switch-save__title">

                                                            @bc.CrossSellingDescription

                                                        </a>

                                                        <div class="switch-save__sku">
                                                            Compatible for @bc.PartNo
                                                        </div>

                                                        <div class="stock-status in-stock">
                                                            <i class="fa fa-check-circle"></i>
                                                            <span>In Stock</span>
                                                        </div>

                                                        <div class="switch-save__price">
                                                            £@string.Format("{0:N2}", switchLinePriceEx)
                                                            <span class="vat">
                                                                @(isTradeCustomer ? "Trade Price, ex VAT" : "exc. VAT")
                                                            </span>
                                                        </div>

                                                        <div class="switch-save__save">
                                                            Save £@string.Format("{0:N2}", saving) ex VAT
                                                        </div>

                                                        <button class="switch-save__btn atb-replace"
                                                                data-productid="@bc.CrossSellingStockRef"
                                                                data-price="@bc.CrossSellingPriceEx"
                                                                data-removeid="@bc.StockRef"
                                                                data-qty="@bc.Quantity">

                                                            Switch Now

                                                        </button>

                                                    </div>

                                                </div>

                                            </div>
                                        }
                                    }
                                }
                            </div>

                        }
                        if (bc.ItemType == BasketItemType.CompatibleDiscount)
                        {
                            isMultiBuy = true;
                            multibuyAmount = bc.PriceEx;

                        }
                    }
                }
            </div>
            <div class="mini-cart__footer">

                <div class="total-row">
                    <span>Total Payable</span>

                    <span>
                        £@bt.GrandTotalIncVat.ToString("0.00")
                    </span>
                </div>

                @if (Session["B_VoucherCode"].ToSafeString() != "")
                {
                    decimal totalSaving = bt.Voucher + bt.VoucherVat;

                    <details class="promo" open="open">

                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-applied">

                            <span class="promo-applied__code">
                                @Session["B_VoucherCode"]
                            </span>

                            <button type="button"
                                    class="voucher-remove"
                                    title="Remove voucher code">
                                <i class="fa fa-times"></i>
                            </button>

                            <span class="promo-applied__saving">
                                -£@Math.Abs(totalSaving).ToString("0.00")
                            </span>

                        </div>

                    </details>
                }
                else
                {
                    <details class="promo">

                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-form">

                            <input id="voucher-code1"
                                   type="text"
                                   placeholder="Enter voucher code" />

                            <button id="apply-voucher"
                                    type="button">

                                Apply

                            </button>

                        </div>

                        <div id="voucher-code-error" class="promo-error g-v-h"></div>

                    </details>
                }

                <div class="free-delivery">

                    <i class="fa fa-truck"></i>

                    <span>
                        @deliveryMessage
                    </span>

                </div>

                <button class="checkout-btn"
                        type="button"
                        onclick="proceedToCheckout()">

                    Proceed to Checkout

                </button>

                <a href="/checkout/"
                   class="view-basket-link">

                    View / Edit Basket

                </a>

            </div>
        </div>


    </div>
</div>






