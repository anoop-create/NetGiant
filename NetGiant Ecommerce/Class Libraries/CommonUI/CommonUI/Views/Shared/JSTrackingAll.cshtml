    </text>

    // Affiliate Window
    if (!Convert.ToBoolean(HttpContext.Current.Session["U_IsPortalUser"]))
    {
        <text>
            //var awin_url = 'https://www.dwin1.com/@(affiliateWindowId).js';
            var awin_url = 'https://@(Html.RawFromDict(Model.CommonData, "DomainName"))data/static-files/cpy_affilliatewindow.js';
