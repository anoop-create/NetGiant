        </text>
    }
    if (@gaId2 != "")
    {
        <text>
            gtag('config', '@gaId2');
        </text>
    }
    if (@gaId3 != "")
    {
        <text>
            gtag('config', '@gaId3');
        </text>
    }
    if (@gaId4 != "")
    {
        <text>
            gtag('config', '@gaId4');
        </text>
    }

    //Bing Tracking
    @*if (bingId != "")
    {
        <text>
                (function (w, d, t, r, u) {
                    var f, n, i;
                    w[u] = w[u] || [], f = function () {
                        var o = { ti: "@(bingId)", enableAutoSpaTracking: true };
                        o.q = w[u], w[u] = new UET(o), w[u].push("pageLoad")
                    }, n = d.createElement(t), n.src = r, n.async = 1, n.onload = n.onreadystatechange =
                        function () {
                            var s = this.readyState;
                            s && s !== "loaded" && s !== "complete" ||
                                (f(), n.onload = n.onreadystatechange = null)
                        }, i = d.getElementsByTagName(t)[0], i.parentNode.insertBefore(n, i)
                })(window, document, "script", "//bat.bing.com/bat.js", "uetq");

                window.uetq = window.uetq || [];
                window.uetq.push('consent', 'default', {
                'ad_storage': 'denied'
                });
        </text>
    }*@


    // Checkout/ViewBasket
    if (Html.Controller() == "checkout" && Html.Action() == "viewbasket")
    {
        <text>
            $(document).on('click', '.atb-replace', function (event) {
            gtag("event", "select_content", {
            content_type: "Compatible Switch",
            });
            });
        </text>
    }

    if ((Html.Controller() == "home" && Html.Action() == "index") || (Html.Controller() == "equipment" && Html.Action() == "printerwizard"))
    {
        <text>
            // Track Wizard Action
            $('.wiz-widget').on('change', '#wiz-manufacturer', function(event) {
            var manuId = $('#wiz-manufacturer').val() == "" ? 0 : $('#wiz-manufacturer').val();
            if (manuId != 0) {
            gtag("event", "select_content", {
            content_type: "Printer Wizard Manufacturer",
            item_id: $('#wiz-manufacturer').prev().find('.k-input').html()
            });
            }
            });
            $('.wiz-widget').on('change', '#wiz-family', function(event) {
            var familyId = $('#wiz-family').val() == "" ? 0 : $('#wiz-family').val();
            if (familyId != 0) {
            gtag("event", "select_content", {
            content_type: "Printer Wizard Family",
            item_id: $('#wiz-family').prev().find('.k-input').html()
            });
            }
            });
            $('.wiz-widget').on('change', '#wiz-equipment', function(event) {
            var equipId = $('#wiz-equipment').val() == "" ? 0 : $('#wiz-equipment').val();
            if (equipId != 0) {
            gtag("event", "select_content", {
            content_type: "Printer Wizard Model",
            item_id: $('#wiz-equipment').prev().find('.k-input').html()
            });
            }
            });;
        </text>
    }

    <text>
        // Site audit (May 2026) item 2: "Legacy Google Analytics (ga.js): Remove and standardise
        // on Google Tag Manager / GA4." ga.js was the deprecated Universal Analytics loader -
        // Google retired UA processing entirely in July 2024, and GA4 (gtag.js, loaded further
        // up this file) is the only analytics this site needs. Removing this IIFE only drops
        // the dead ga.js script tag itself; _goog_id() below (reads the _ga cookie, used
        // elsewhere on the site) still works fine without it, since gtag.js sets that same
        // cookie on its own.
        //
        // This exact block was found back in the file on a later re-check after already being
        // removed once - if it reappears again, something upstream (a git revert, a stale
        // branch merge, or an editor auto-restoring an old version) is putting it back rather
        // than this being a one-off. Worth checking `git log -p` on this file if it keeps
        // resurfacing.

        function _goog_id() {
        var id, a, c = document.cookie.split('; ');
        for(i in c){a = c[i].split('=');if(a[0]=='_ga'){id = a[1].split('.')[2];}}
        return id || 'unknown';
        }

        function deferScriptLoad(fileType, fileAddress, fileOptions, fileInsert) {
        if (window.attachEvent) {
        // If the browser supports attachEvent (e.g. IE)
        window.attachEvent("onload",
        function () { async_load(fileType, fileAddress, fileOptions, fileInsert); });
        } else {
        // If the browser does not support attachEvent (e.g. FireFox)
        window.addEventListener("load",
        function () { async_load(fileType, fileAddress, fileOptions, fileInsert); },
        false);
        }
        }

        function async_load(fileType, fileAddress, fileOptions, fileInsert) {
        //The code block being created (e.g. script or link)
        var s = document.createElement(fileType);
        //Finds the tag in the page and places the new code block before it
        var x = document.getElementsByTagName(fileType)[0];
        if (fileType == "link") {
        //If the file type is link (stylesheet)
        //Set the type, rel, href and media attributes of the code block
        s.type = "text/css";
        s.rel = "stylesheet";
        s.href = fileAddress;
        s.media = "print";
        x.parentNode.insertBefore(s, x);
        } else if (fileType == "script") {
        //If the file type is script
        //Set the type, async (only supported by HTML5) and src attributes of the code block
        s.type = "text/javascript";
        s.async = true;
        s.src = fileAddress;
        x.parentNode.insertBefore(s, x);
        } else if (fileType == "img") {
        //If the file type is img
        //Set the type, async (only supported by HTML5) and src attributes of the code block
        s.src = fileAddress;
        for (var prop in fileOptions) {
        s[prop] = fileOptions[prop];
        }
        x = document.getElementById(fileInsert);
        x.appendChild(s);
        }
        }
    </text>
}