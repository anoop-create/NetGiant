@using System.Configuration;
@using CommonUI.Models;
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using System.Web.Optimization
@using Kendo.Mvc.UI

@model CommonViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <title>@Html.RawFromDict(Model.MetaData, "Title")</title>
    <meta name="description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="msvalidate.01" content="25C06F8BDF2376F495D44F19998FAE5F">
    @if (ConfigurationManager.AppSettings["Environment"] != "Live")
    {
        // Ensure google will not index beta site pages
        <meta name="robots" content="noindex, nofollow" />
    }

    <meta property="og:title" content="@Html.RawFromDict(Model.MetaData, "Title")">
    <meta property="og:type" content="website">
    <meta property="og:image" content="@ConfigurationManager.AppSettings["CDN"]/images/soc-logo.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="https://@Model.DomainNameTrunc@Request.Url.PathAndQuery">
    <meta property="og:site_name" content="@Html.RawFromDict(Model.CommonData, "SiteName")">
    <meta property="og:description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="twitter:title" content="@Html.RawFromDict(Model.MetaData, "Title")">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="twitter:image" content="@ConfigurationManager.AppSettings["CDN"]/images/soc-logo.jpg">

    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Asap:400,400i,700,700i&amp;display=swap">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" href="https://@Model.DomainNameTrunc/touch-icon-iphone.png">
    <link rel="apple-touch-icon" sizes="76x76" href="https://@Model.DomainNameTrunc/touch-icon-ipad.png">
    <link rel="apple-touch-icon" sizes="120x120" href="https://@Model.DomainNameTrunc/touch-icon-iphone-retina.png">
    <link rel="apple-touch-icon" sizes="152x152" href="https://@Model.DomainNameTrunc/touch-icon-ipad-retina.png">

    <link rel="manifest" href="/Content/manifest.json">

    <link href="@Html.RawFromDict(Model.CommonData, "GooglePlusPage")" rel="publisher">
    @Html.RawFromDict(Model.CommonData, "HtmlHeaderExtras")
    @{
        Dictionary<string, string> replacements = new Dictionary<string, string>();
        replacements.Add("[Aggregate-Rating]", Model.AggregateRating);
    }

    @Styles.Render("~/Content/cssBundle.css")
    @RenderSection("AddTags", required: false)
    @if (ConfigurationManager.AppSettings["ChatIsOn"] == "True")
    {
        <script type="text/javascript" src="https://@(Html.RawFromDict(Model.CommonData, "DomainName"))data/static-files/cpy_sfliveagent.js" defer></script>
    }
    <script type="text/javascript">
        @{
            Html.RenderPartial("~/Views/Shared/JSTrackingAllHdr.cshtml", Model);
        }
    </script>

</head>

<body class="g-ps-r @(Model.IsStationerySaleActive || Model.IsOEMSaleActive || Model.IsCompatibleSaleActive ? "saleIsActive" : "")">
    @* Site audit (May 2026) item 6: jqueryBundle.js used to render in <head>, with no async/defer -
       a genuinely render-blocking script that delayed <head>'s own parsing (and so delayed
       discovery of everything in <body>) until jQuery downloaded and executed. Nothing between
       its old position and </head> touches $ (confirmed: the chat-widget script and
       JSTrackingAllHdr.cshtml's Piwik/Clarity snippets are both vanilla JS), so moving the tag
       here - first thing in <body>, before anything that does use $ - removes it from the
       render-blocking-resources Lighthouse flag without changing execution order at all: jQuery
       still loads and runs before Header.cshtml, RenderBody(), Footer.cshtml, and the
       $(document).on(...) handlers further down this same page. Deliberately not using `defer`
       instead - several inline <script> blocks lower in <body> call $(...) immediately at their
       point in the document, and a deferred script only executes after the whole document has
       parsed, so defer would make those throw "$ is not defined". *@
    @Scripts.Render("~/bundles/jqueryBundle.js")
    @{
        Html.RenderPartial("~/Views/Shared/Header.cshtml");
    }
    <div id="youMayAlsoNeedContainer"></div>
    @RenderBody()

    @{
        Html.RenderPartial("~/Views/Shared/Footer.cshtml");
    }

    @if (!Authentication.IsFullyAuthenticated())
    {
        Html.RenderPartial("~/Views/MyAccount/SignIn.cshtml");
    }
    <input type="hidden" id="SearchApplication" value="@(ConfigurationManager.AppSettings["SearchApplication"] == "SLI" ? "1" : "0")" />

    @if (!Model.IsMobile)
    {
        @Scripts.Render("~/bundles/bootstrapBundle.js")
    }
    else
    {
        @Scripts.Render("~/bundles/bootstrapBundleM.js")
    }
    @Scripts.Render("~/bundles/jqueryvalBundle.js")
    @RenderSection("scripts", required: false)
    @if (!Model.IsMobile)
    {
        <script src="https://apis.google.com/js/platform.js?onload=renderBadge" defer></script>
    }
    @if (ConfigurationManager.AppSettings["SearchApplication"] == "SLI")
    {
        <script type="text/javascript" src="https://@(ConfigurationManager.AppSettings["SLIDomain"])/autocomplete/rac-resources-@(ConfigurationManager.AppSettings["WebsiteShortCode"])/sli-rac.config.js" defer></script>
    }
    <script type="text/javascript">
        @{
            Html.RenderPartial("~/Views/Shared/JSTrackingAll.cshtml", Model);
            Html.RenderPartial("~/Views/Shared/JSTrackingStandard.cshtml", Model);
            <text>
                @Html.RawFromDict(Model.CommonData, "MessageAndRedirect")
            </text>
        }
    </script>

    @RenderSection("AddScript", required: false)

    <script type="application/ld+json">
        @RenderSection("StructuredData", required: false)
    </script>

    @Html.Kendo().DeferredScripts()

    <!--[if lt IE 9]>
        <script type="text/javascript">
            alert('@ConfigurationManager.AppSettings["UnsupportedBrowser"]');
        </script>
    <![endif]-->

    @{ string siteName = string.Join("-", Utilities.SplitCamelCase(Utilities.GetItemFromDict(Model.CommonData, "ShortSiteName"))).ToLower(); }
    @* Site audit (May 2026) item 3: Feefo's bootstrap script was already async, but as soon as it
       loads it immediately fires ~7 API calls (widget config, translations, reviews list/summary,
       interaction tracking) plus 3 custom webfonts - on every page, regardless of whether the
       review widget is anywhere near the viewport. deferScriptLoad() (defined in
       JSTrackingAll.cshtml, rendered earlier in this same page) waits for the window "load" event
       before injecting the script tag - the same already-proven pattern this codebase already
       uses for the Affiliate Window script - so this pushes all of that off the critical
       rendering path without changing what eventually loads or how the widget behaves once it's up. *@
    <script type="text/javascript">
        deferScriptLoad("script", "https://api.feefo.com/api/javascript/@siteName");
    </script>
</body>
</html>
