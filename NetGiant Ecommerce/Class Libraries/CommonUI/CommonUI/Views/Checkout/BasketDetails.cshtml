@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework
@using CommonUI.Models;
@using Kendo.Mvc.UI
@using VmVoucherType = VMerchantWrapper.Entities.VoucherType;
@using System.Linq;
@model CheckoutViewModel
@*@Styles.Render("~/Content/css")*@
<style>
    .summary-basket-card1 {
        border: 1px solid #8e8e8e !important;
        padding: 15px;
    }

    .summary-basket-card2 {
        border: 1px solid #8e8e8e !important;
        padding: 15px;
    }

    .summary-basket-card3 {
        border: 1px solid #8e8e8e !important;
        padding: 15px;
    }

    .summary-basket-card4 {
        border: 1px solid #8e8e8e !important;
        padding: 15px;
    }

    .summary-basket-card5 {
        border: 1px solid #8e8e8e !important;
        padding: 15px;
    }
</style>
@if (Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery > 0)
{
    bool isAdminDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.AdminDiscount);
    bool isCompatibleDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.CompatibleDiscount);
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-12">
                <button type="button"
                        class="checkout-button checkout1 btn g-butt-primary g-butt-100p g-m-t-20 g-m-b-20 pull-right mobile-checkout-btn"
                        title="Checkout">
                    Proceed to Checkout
                </button>
                <div id="basketSummary" class="basketSummaryContainer">
                    @{
                        bool isMultiBuy = false;
                        decimal multibuyAmount = decimal.Zero;
                        Model.CheckZeroStock();
                        decimal basketSwitchSaving = 0;
                        bool hasSwitchProducts = false;
                        // Logic to build Basket Switch & Save section
                        List<BasketContents> switchProducts = new List<BasketContents>();
                        var list = Model.BasketContents; int switchCount = 0;
                        if (list != null && list.Count > 1)
                        {
                            foreach (BasketContents item in Model.BasketContents)
                            {
                                // Ignore non-product lines
                                if (item.ItemType != BasketItemType.Item)
                                { continue; }

                                // Ignore compatible products (already switched)
                                if (item.IsCompatible)
                                { continue; }

                                // Ignore excluded products
                                if (item.ExcludeFromUpSell)
                                { continue; }

                                // Cross-sell product must exist
                                if (item.CrossSellingStockRef == null || item.CrossSellingStockRef == "")
                                {
                                    continue;
                                }

                                // Cross-sell product must be in stock
                                if (item.CrossSellingAvailability != 1 &&
                                                    item.CrossSellingAvailability != 7)
                                { continue; }

                                decimal lineSaving =
                                    (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;

                                // Only show if customer actually saves money
                                if (lineSaving <= 0)
                                { continue; }

                                basketSwitchSaving += lineSaving;
                                switchProducts.Add(item);
                            }

                            hasSwitchProducts = switchProducts.Count > 0;
                            switchCount = switchProducts.Count;
                        }
                        if (hasSwitchProducts && switchCount > 1)
                        {


                            <div class="basket-switch-save">
                                <img src="/cdn/Images/switch-save.png" alt="Visa" style="height: 44px;">
                                <div style="font-weight: bold;">

                                    Switch &amp; Save

                                    <p>
                                        Save £@string.Format("{0:N2}", basketSwitchSaving) by switching your basket to compatible products.
                                    </p>

                                </div>

                                <div class="basket-switch-btn">

                                </div><button id="btnSwitchAll" class="btn replaceall">Switch All Items</button>

                            </div>
                        }
                        foreach (BasketContents bc in list)
                        {
                            if (bc.ItemType == BasketItemType.Item || bc.ItemType == BasketItemType.AdminDiscount)
                            {
                                string neg = bc.ItemType == BasketItemType.AdminDiscount ? "-" : "";
                                string strike = "";
                                string discClass = "g-d-n";
                                decimal discUnitPrice = decimal.Zero;
                                decimal subt = bc.PriceEx * bc.Quantity;
                                decimal discountRate = Utilities.GetUpsellRate();
                                // "Increase qty in your basket, save an extra X%" lozenge - the same
                                // qty-upsell offer/rate (CompatibleUpsellRates) as the discount logic
                                // below, but evaluated without the "already past threshold" gate so
                                // it can also show the "not yet unlocked" prompt state. This mechanic
                                // used to be a clickable button on the old Views/Checkout/BasketDetailsv2.cshtml
                                // page (now unreachable - no controller action renders it) and was lost
                                // when the basket page was redesigned; restored here re-skinned to match
                                // this page's current look.
                                decimal upsellPerItemSaving = Math.Round(bc.PriceEx * discountRate / 100, 2);
                                bool showUpsellLozenge = bc.IsCompatible && Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                    !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                    !isAdminDiscount &&
                                    upsellPerItemSaving > 0;
                                if (!bc.IsCompatible &&
                                !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                                !bc.ExcludeFromUpSell &&
                                (bc.CrossSellingAvailability == 1 || bc.CrossSellingAvailability == 7))
                                {
                                    decimal lineSaving = (bc.PriceEx - bc.CrossSellingPriceEx) * bc.Quantity;

                                    if (lineSaving > 0)
                                    {
                                        basketSwitchSaving += lineSaving;
                                        hasSwitchProducts = true;
                                    }
                                }
                                if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                    !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                    !isAdminDiscount &&
                                    bc.Quantity > bc.QtyStart)
                                {
                                    discUnitPrice = Math.Round(bc.PriceEx, 2) - Math.Round(bc.PriceEx * discountRate / 100, 2);
                                    subt = discUnitPrice * bc.Quantity;
                                    strike = "g-s";
                                    discClass = "";
                                }

                                <div class="basket-card atb-entry g-m-b-20"
                                     data-productid="@bc.StockRef">

                                    <div class="row dv-basket-card">

                                        <!-- Product Image -->
                                        @* "col-4"/"col-8" below (and on the Switch & Save card further down) are Bootstrap 4
                                           syntax - this project is Bootstrap 3 throughout (col-xs-*/col-sm-*/col-md-*/col-lg-*),
                                           where a bare "col-4" is not a real grid class and does nothing. Since col-sm-3/col-md-3
                                           only take effect at >=768px, this column had NO width/float applied at all below that -
                                           on real phones (<768px) it fell back to plain block/full-width, stacking image, details,
                                           and price/qty into three separate full-width rows instead of sitting image-left with the
                                           rest to the right. Changed to the Bootstrap 3 equivalent (col-xs-4) so the same
                                           image-left layout already used at sm/md/lg also applies on actual mobile phones. *@
                                        <div class="col-lg-2 col-md-3 col-sm-3 col-xs-4">
                                            @{
                                                var productUrl = bc.ProductUrl.StartsWith("/")
                                                    ? bc.ProductUrl
                                                    : "/" + bc.ProductUrl;
                                            }
                                            <a href="@productUrl" class="basket-card-image">

                                                <img src="@bc.ImageUrl"
                                                     alt="@bc.Description"
                                                     class="img-responsive"
                                                     onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                            </a>

                                        </div>

                                        <!-- Product Details -->
                                        <div class="col-lg-6 col-md-5 col-sm-9 col-xs-8">

                                            <div class="basket-card-details">

                                                <h4 class="basket-product-title">
                                                    <a href="@productUrl">
                                                        @bc.Description
                                                    </a>
                                                </h4>

                                                <div class="basket-product-code">
                                                    <strong>@bc.PartNo</strong>
                                                </div>

                                                <div class="basket-status g-m-t-15">

                                                    @if (bc.Availability == 1 || bc.Availability == 7)
                                                    {
                                                        <div class="stock-status in-stock">

                                                            <i class="fa fa-check-circle"></i>

                                                            <span>In Stock</span>

                                                        </div>

                                                        <div class="delivery-status">

                                                            @if (!Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"]))
                                                            {
                                                                <div class="delivery-cutoff">

                                                                    <i class="fa fa-clock-o"></i>

                                                                    Order Within

                                                                    <strong>
                                                                        <span class="cutoffCountdownFalse"></span>
                                                                    </strong>

                                                                </div>
                                                                <div class="delivery-date">

                                                                    <strong>
                                                                        Delivered @Session["D_standardDeliveryDay"]
                                                                    </strong>

                                                                </div>

                                                            }


                                                        </div>
                                                    }
                                                    else if (bc.Availability == 10)
                                                    {
                                                        <div class="stock-status special-order">

                                                            <i class="fa fa-info-circle"></i>

                                                            <span>Special Order Item</span>

                                                        </div>

                                                        <div class="delivery-status">

                                                            Call
                                                            <a href="tel:@Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")">
                                                                @Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")
                                                            </a>
                                                            for delivery information.

                                                        </div>
                                                    }
                                                    else if (bc.Availability == 11 || bc.Availability == 13)
                                                    {
                                                        <div class="stock-status out-of-stock">

                                                            <i class="fa fa-times-circle"></i>

                                                            <span>Out of Stock</span>

                                                        </div>

                                                        <div class="delivery-status">

                                                            Currently unavailable.

                                                        </div>
                                                    }
                                                    else if (bc.Availability == 2 || bc.Availability == 4)
                                                    {
                                                        <div class="stock-status availability">

                                                            <i class="fa fa-clock-o"></i>

                                                            <span>Availability 2–3 Days</span>

                                                        </div>

                                                        <div class="delivery-status">

                                                            Dispatched when stock returns.

                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="stock-status back-order">

                                                            <i class="fa fa-history"></i>

                                                            <span>Back In Stock Soon</span>

                                                        </div>

                                                        <div class="delivery-status">

                                                            Dispatched when stock returns.

                                                        </div>
                                                    }

                                                </div>
                                                @if (showUpsellLozenge)
                                                {
                                                    if (bc.Quantity <= bc.QtyStart)
                                                    {
                                                        <button class="qty-upsell-pill"
                                                                type="button"
                                                                title="Click to get this offer"
                                                                onclick="changeBasketQty('@bc.StockRef', @(bc.QtyStart + 1))">
                                                            Buy @(bc.QtyStart + 1 - bc.Quantity) More, Save @discountRate%
                                                        </button>
                                                    }
                                                    else if (bc.Quantity > 1)
                                                    {
                                                        <button class="qty-upsell-pill"
                                                                type="button"
                                                                title="Click to add another and keep saving"
                                                                onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))">
                                                            Add More, Keep Saving
                                                        </button>
                                                    }
                                                }
                                            </div>

                                        </div>

                                        <!-- Quantity / Remove / Total -->
                                        <div class="col-lg-4 col-md-4 col-sm-12">

                                            <div class="basket-card-actions">
                                                <div class="basket-price-box">
                                                    <div class="price-row ex-vat1">
                                                        <strong>£@neg@string.Format("{0:N2}", bc.PriceEx)</strong>
                                                        <strong>Ex VAT</strong>
                                                    </div>
                                                    <div class="price-row">
                                                        <span>£@string.Format("{0:N2}", bc.PriceInc)</span>
                                                        <span>Inc VAT</span>
                                                    </div>

                                                </div>
                                                @if (!bc.IsFreeGift)
                                                {
                                                    <div class="basket-qty-wrapper">
                                                        <label class="qty-label">
                                                            Quantity
                                                        </label>

                                                        <div class="basket-qty">

                                                            <button type="button"
                                                                    class="qty-btn qty-minus"
                                                                    @(bc.Quantity <= 1 ? "disabled" : "")
                                                                    onclick="changeBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity - 1)))">

                                                                <i class="fa fa-minus"></i>

                                                            </button>

                                                            <input class="qty-input" type="text" readonly value="@bc.Quantity" />

                                                            <button type="button"
                                                                    class="qty-btn qty-plus"
                                                                    onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))">

                                                                <i class="fa fa-plus"></i>

                                                            </button>

                                                        </div>

                                                    </div>

                                                    <div class="basket-remove-container">
                                                        <button class="basket-remove delete"
                                                                data-productid="@bc.StockRef"
                                                                type="button">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </div>

                                                    @* ---------------- Buy More & Save (Promotional Lozenge) ----------------
                                                        Per the "Basket Switch & Save / Add Ons" design spec: a small pill
                                                        sitting directly under the qty stepper on this same product card,
                                                        not a separate promo card. *@

                                                }




                                            </div>

                                        </div>
                                        @if (Session["V_Voucher"] != null)
                                        {
                                            VoucherPromo vp = (VoucherPromo)Session["V_Voucher"];

                                            if (bc.IsVoucherQualifyingItem &&
                                                vp.VoucherTypeFk == (int)VmVoucherType.Percentage)
                                            {
                                                <div class="voucher-applied g-m-t-10">

                                                    <i class="fa fa-check-circle"></i>

                                                    Voucher Applied

                                                </div>
                                            }
                                        }

                                    </div>
                                    @* ---------------- Switch & Save ----------------
                                        Fully data-bound - every value below comes from bc / Model,
                                        nothing hardcoded. Eligibility rules unchanged from before:
                                        not already compatible, has a cross-sell ref, that ref is
                                        in stock (1 or 7), and switching genuinely saves money. *@
                                    @if (!bc.IsCompatible && !String.IsNullOrEmpty(bc.CrossSellingStockRef) && !bc.ExcludeFromUpSell)
                                    {
                                        List<int> inStock = new List<int> { 1, 7 };

                                        if (inStock.Contains(bc.CrossSellingAvailability))
                                        {
                                            decimal switchUnitPriceEx = bc.CrossSellingPriceEx;
                                            decimal switchLinePriceEx = switchUnitPriceEx * bc.Quantity;
                                            decimal switchLinePriceInc = switchLinePriceEx * Model.VatMultiplier;
                                            decimal saving = (bc.PriceEx - switchUnitPriceEx) * bc.Quantity;

                                            if (saving > 0)
                                            {
                                                <div class="switch-save-card">
                                                    @* Same Bootstrap-4-vs-3 "col-4" fix as the main product card above - was
                                                       inert below 768px, leaving this image full-width/stacked on real phones. *@
                                                    <div class="col-lg-2 col-md-3 col-sm-3 col-xs-4">
                                                        @{
                                                            var CrossSellingProductUrl = bc.CrossSellingProductUrl.StartsWith("/")
                                                            ? bc.CrossSellingProductUrl
                                                            : "/" + bc.CrossSellingProductUrl;
                                                        }
                                                        <a href="@CrossSellingProductUrl" class="basket-card-image">

                                                            <img src="@bc.CrossSellingImageURL"
                                                                 alt="@bc.CrossSellingDescription"
                                                                 class="img-responsive"
                                                                 onerror="this.src='@ConfigurationManager.AppSettings[" CDN"] /Images/noImage.jpg';" />

                                                        </a>
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-5 col-sm-12">

                                                            <div class="switch-heading"> Switch &amp; Save </div>

                                                            <div class="switch-product-name"> @bc.CrossSellingDescription </div>
                                                            <div class="basket-product-code">
                                                                <strong>@bc.PartNo</strong>
                                                            </div>
                                                            <div class="stock-status in-stock">
                                                                <i class="fa fa-check-circle"></i>
                                                                <span>In Stock</span>
                                                            </div>

                                                        </div>
                                                        <div class="col-md-4 col-sm-12 text-right">

                                                            <div class="basket-price-box">
                                                                <div class="price-row ex-vat">
                                                                    <strong>£@string.Format("{0:N2}", switchLinePriceEx)</strong>
                                                                    <span>Ex VAT</span>
                                                                </div>
                                                                <div class="price-row inc-vat">
                                                                    <strong>£@string.Format("{0:N2}", switchLinePriceInc)</strong>
                                                                    <span>Inc VAT</span>
                                                                </div>
                                                                <div class="price-row save-saving">
                                                                    <span>Save</span>
                                                                    <strong>£@string.Format("{0:N2}", saving)</strong>
                                                                    <span>Ex. VAT</span>
                                                                </div>
                                                            </div>

                                                            <button class="btn btn-success atb-replace"
                                                                    data-productid="@bc.CrossSellingStockRef"
                                                                    data-price="@bc.CrossSellingPriceEx"
                                                                    data-removeid="@bc.StockRef"
                                                                    data-qty="@bc.Quantity">
                                                                Switch Product
                                                            </button>

                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>

                            }
                            if (bc.ItemType == BasketItemType.CompatibleDiscount)
                            {
                                isMultiBuy = true;
                                multibuyAmount = bc.PriceEx;

                            }
                        }

                        <hr class="g-m-tb-10" />
                        @{
                            // Flatten + dedupe across every basket line's add-ons - without this,
                            // the same add-on could show once per basket line that links to it.
                            var seenAddOnRefs = new HashSet<string>();
                            var addOnsToShow = new List<BasketContents>();
                            foreach (var items in list)
                            {
                                foreach (var addOn in items.AddonProducts)
                                {
                                    if (seenAddOnRefs.Add(addOn.StockRef))
                                    {
                                        addOnsToShow.Add(addOn);
                                    }
                                }
                            }
                        }
                        if (addOnsToShow.Count > 0)
                        {
                            <div class="you-may-need">

                                <div class="you-may-need-header">
                                    You May Also Need...
                                </div>

                                <div class="you-may-need-wrapper" data-index="0">

                                    @if (addOnsToShow.Count > 3)
                                    {
                                        <button type="button" class="need-arrow prev" disabled aria-label="Previous">
                                            <i class="fa fa-chevron-left"></i>
                                        </button>
                                    }

                                    <div class="you-may-need-products">
                                        <div class="you-may-need-track">

                                            @foreach (var addOn in addOnsToShow)
                                            {
                                                <div class="need-product">
                                                    @{
                                                        var productUrl = addOn.ProductUrl.StartsWith("/")
                                                            ? addOn.ProductUrl
                                                            : "/" + addOn.ProductUrl;
                                                    }
                                                    <a href="@productUrl">
                                                        <img src="@addOn.ImageUrl"
                                                             class="img-responsive"
                                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                                    </a>

                                                    <a class="need-title"
                                                       href="@productUrl">
                                                        @addOn.Description
                                                    </a>
                                                    <a href="@addOn.ProductUrl" class="need-title">
                                                        @addOn.PartNo
                                                    </a>
                                                    <div class="need-price">
                                                        £@string.Format("{0:N2}", addOn.PriceEx)Ex VAT
                                                    </div>

                                                    <button class="btn btn-success atb-add"
                                                            data-productid="@addOn.StockRef"
                                                            data-price="@addOn.PriceEx"
                                                            data-qty="1">
                                                        Add to Basket
                                                    </button>

                                                </div>

                                            }

                                        </div>
                                    </div>

                                    @if (addOnsToShow.Count > 3)
                                    {
                                        <button type="button" class="need-arrow next" aria-label="Next">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    }

                                </div>

                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="basket-voucher col-md-8">
                @if ((Model.CheckoutDetails.ZeroStock || Model.CheckoutDetails.IsSpecialOrder) && !Convert.ToBoolean(Session["U_IsPortalUser"]))
                {
                    Dictionary<string, string> replacements = new Dictionary<string, string>();
                    <div class="g-bc-note g-b-1-p g-p-10 g-m-t-10 g-w-345 g-fs-sm">@(Html.RawFromDict(Model.CheckoutData, "ZeroStock", replacements))</div>
                }


                @if (Convert.ToBoolean(Session["U_IsPortalUser"]))
                {
                    <div class="g-m-t-60 g-m-b-20 g-br-0 panel panel-default">
                        <div class="panel-heading g-fw-b">Customer Service Tools</div>
                        <div class="panel-body">
                            @if (String.IsNullOrEmpty(Session["B_VoucherCode"] as string))
                            {
                                if (isAdminDiscount)
                                {
                                    <div class="g-m-t-10 g-fw-b">ADMIN DISCOUNT HAS BEEN APPLIED TO THIS ORDER</div>
                                }
                                else
                                {
                                    <div class="g-fc-secondary g-m-t-10">Administrator Discount Inc.Vat</div>
                                    <div class="atb-entry bkt-discount input-group g-m-t-10 g-w-345">
                                        <span class="input-group-addon g-br-0 g-fc-tt g-b-n g-bc-s" style="border-right: 1px solid #cccccc !important;">-&pound;</span>
                                        <input id="admin-discount" class="form-control g-h-40 pull-left" placeholder="Enter discount ..." type="number">
                                        <span class="input-group-btn">
                                            <button id="apply-discount" class="g-butt-secondary g-butt-lg g-fs-n" type="button">Apply Discount</button>
                                            <button id="discount-atb" class="atb-add g-d-n"
                                                    data-vatm="@Model.VatMultiplier"
                                                    data-productid="4957"
                                                    data-partno=""
                                                    data-price=""
                                                    data-itemtype="2"></button>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="g-m-t-10 basket-entry">
                                <div class="atb-entry input-group g-m-t-10 g-w-345">
                                    <span class="input-group-addon g-br-0 g-b-n g-bc-s">Clear All Products</span>
                                    <button id="admn-clear-basket" class="g-butt g-butt-secondary g-butt-lg pull-right"
                                            title="Clear all items from the basket">
                                        Clear
                                    </button>
                                </div>
                                <div class="g-m-t-10">
                                    <div class="atb-entry input-group g-m-t-10 g-w-345">
                                        @if (ViewBag.OrderIsOnHold)
                                        {
                                            <span class="input-group-addon g-br-0 g-b-n g-bc-s">Order is On Hold</span>
                                            <button class="g-butt g-butt-secondary g-butt-lg delete pull-right"
                                                    data-productid="ONHOLD"
                                                    title="Remove from on hold">
                                                Remove
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="input-group-addon g-br-0 g-b-n g-bc-s">Place Order On Hold</span>
                                            <button class="g-butt g-butt-secondary g-butt-lg atb-add pull-right"
                                                    data-price="0.00"
                                                    data-productid="ONHOLD"
                                                    data-partno="ONHOLD"
                                                    data-imageurl="unknown.jpg"
                                                    data-itemtype="3"
                                                    title="Place this order on hold">
                                                Place On Hold
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 dv-basket-card">

        @* ---------------- Delivery message ----------------
        CM: shows the "spend X more for free delivery" threshold message.
        TG: constant "Free Next Day/Working Day Delivery" message.
        Site is distinguished the same way other site-specific config is
        read elsewhere in this file (ConfigurationManager.AppSettings) -
        adjust the key/values below to match your actual site flag. *@
        @{
            bool isCartridgeMarket = ConfigurationManager.AppSettings["SiteBrand"] == "CM";
            decimal freeDeliveryThreshold = 45.00m; // CM threshold - move to config if it varies
            decimal subTotalExVat = Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery;
        }
        <div class="summary-basket-card1">
            <div class="main-basket-summary">

                <h4>Summary</h4>
                <div class="basket-summary">
                    @{
                        IHtmlString deliveryMessage = Html.Raw("");
                    }

                    @if (isCartridgeMarket)
                    {
                        decimal remaining = freeDeliveryThreshold - subTotalExVat;

                        if (remaining > 0)
                        {
                            deliveryMessage = Html.Raw("Spend &pound;" + string.Format("{0:N2}", remaining) + " more for free delivery");
                        }
                        else
                        {
                            deliveryMessage = Html.Raw("Free Delivery Included");
                        }
                    }
                    else
                    {
                        bool isFriday = DateTime.Now.DayOfWeek == DayOfWeek.Friday;
                        TimeSpan cutoff = isFriday ? new TimeSpan(17, 0, 0) : new TimeSpan(17, 30, 0);
                        bool pastCutoff = DateTime.Now.TimeOfDay > cutoff;

                        if (pastCutoff)
                        {
                            deliveryMessage = Html.Raw("Free Next Working Day Delivery");
                        }
                        else
                        {
                            deliveryMessage = Html.Raw("Free Next Day Delivery");
                        }
                    }
                    <span><i class="fa fa-truck fa-flip-horizontal fa-2x"></i></span>
                    <span>@deliveryMessage</span>
                </div>

                <span>

                </span>
            </div>

            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Delivery</strong>
                </div>
                <div class="pull-right g-p-r-20">
                    @if (Model.BasketTotals.Delivery == 0)
                    {
                        @:FREE
                    }
                    else
                    {
                        @Html.Raw("&pound;" + string.Format("{0:N2}", Math.Abs(Model.BasketTotals.Delivery)))
                    }
                </div>
            </div>
        </div>
        <div class="summary-basket-card2">
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Sub Total</strong>
                </div>
                <div class="pull-right g-p-r-20">&pound;@string.Format("{0:N2}", subTotalExVat)</div>
            </div>
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>VAT</strong>
                </div>
                <div class="pull-right g-p-r-20">&pound;@string.Format("{0:N2}", Model.BasketTotals.Vat + Model.BasketTotals.VoucherVat)</div>
            </div>

            <div class="@(ViewBag.HideVoucher ? "g-d-n" : "")">
                <hr class="g-m-tb-10" />
                <div id="voucherTotal" class="g-m-t-10 clearfix g-lh-40">
                    <div class="pull-left">
                        <strong>Voucher</strong>
                    </div>
                    <div class="pull-right g-p-r-20 g-i g-fc-pm">
                        <span id="voucherValue">
                            @if (Model.BasketTotals.Voucher == 0)
                            {
                                @:FREE GIFT
                            }
                            else
                            {
                                @((Model.BasketTotals.Voucher < 0 ? "-" : ""))
                                @Html.Raw(("&pound;" + string.Format("{0:N2}", Math.Abs(Model.BasketTotals.Voucher)) + " (inc VAT)"))
                            }
                        </span>
                    </div>
                </div>
            </div>

            <div class="@(isMultiBuy ? "" : "g-d-n")">
                <hr class="g-m-tb-10" />
                <div id="voucherTotal" class="g-m-t-10 clearfix g-lh-40">
                    <div class="pull-left">
                        <strong>You have saved</strong>
                    </div>
                    <div class="pull-right g-p-r-20 g-i g-fc-pm">
                        <span id="voucherValue">
                            @Html.Raw(("&pound;" + string.Format("{0:N2}", multibuyAmount) + " (ex VAT)"))
                        </span>
                    </div>
                </div>
            </div>

            <hr class="g-m-tb-10" />
            <div class="g-m-t-10 clearfix g-lh-40">
                <div class="pull-left">
                    <strong>Grand Total</strong>
                </div>
                <div class="pull-right g-fs-lg g-p-r-20">
                    <strong>
                        <span>&pound;@string.Format("{0:N2}", Model.BasketTotals.GrandTotalIncVat)</span>
                    </strong>
                </div>
            </div>
            @if (!isAdminDiscount)
            {
                if (Session["B_VoucherCode"].ToSafeString() != "")
                {
                    <details class="promo" open="open">
                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-applied">

                            <span class="promo-applied__code">
                                @Session["B_VoucherCode"].ToSafeString()
                            </span>

                            <button type="button"
                                    class="remove-voucher"
                                    title="Remove voucher code">
                                <i class="fa fa-trash"></i>
                            </button>

                            <span class="promo-applied__saving">
                                -&pound;@Math.Abs(Model.BasketTotals.Voucher + Model.BasketTotals.VoucherVat).ToString("0.00")
                            </span>

                        </div>

                        @if (!string.IsNullOrEmpty(ViewBag.VoucherMessage))
                        {
                            <div class="error-message">
                                @Html.Raw(ViewBag.VoucherMessage)
                            </div>
                        }

                    </details>
                }
                else
                {
                    <details class="promo">
                        <summary>
                            Promotion Code
                        </summary>

                        <div class="promo-form">

                            <input id="voucher-code"
                                   type="text"
                                   placeholder="Enter voucher code">

                            <button id="apply-voucher"
                                    type="button">
                                Apply
                            </button>

                        </div>

                        <div id="error-message"
                             class="error-message"
                             style="display:none;">
                            <p></p>
                        </div>

                    </details>
                }
            }
            <button type="button" class="checkout-button checkout1 btn g-butt-primary g-butt-100p g-m-t-20 g-m-b-20 pull-right" title="Checkout">Proceed to Checkout</button>
            @Html.AntiForgeryToken()
            <form id="co-form" method="post" action="~/Checkout/Stage1/">
                @Html.HiddenFor(x => x.CheckoutDetails.IsNewCustomer)
                @Html.HiddenFor(x => x.CheckoutDetails.Email)
                @Html.HiddenFor(x => x.CheckoutDetails.Password)
                @Html.HiddenFor(x => x.CheckoutDetails.ZeroStock)
            </form>
            @if (!Convert.ToBoolean(Session["U_IsPortalUser"]) && Model.BasketTotals.GrandTotalIncVat > 0.01m)
            {
                if (ConfigurationManager.AppSettings["AmazonPayMerchantId"] != "OFF")
                {
                    <div style="height:70px;"></div>
                    <div id="AmazonPayButton" class="g-m-t-20"></div>

                    <script src="https://static-eu.payments-amazon.com/checkout.js"></script>

                    <script type="text/javascript" charset="utf-8">
                         amazon.Pay.renderButton('#AmazonPayButton', {
                             merchantId: '@Html.Raw(ConfigurationManager.AppSettings["AmazonPayMerchantId"])',
                             publicKeyId: '@Html.Raw(ConfigurationManager.AppSettings["AmazonPayPublicKeyId"])',
                             ledgerCurrency: 'GBP',
                             checkoutLanguage: 'en_GB',
                             productType: 'PayAndShip',
                             placement: 'Cart',
                             buttonColor: 'Gold',
                             createCheckoutSessionConfig: {
                                 payloadJSON: '@Html.Raw(Model.AmazonButtonJSONPayLoad)',
                                 signature: '@Html.Raw(Model.AmazonButtonSignature)'
                             }
                         });
                    </script>
                }

                <div id="paypal-button2" class="g-m-t-20"></div>
                <div id="paypal-button3"></div>

                <div id="paypal-message" data-pp-message data-pp-style-layout="text"
                     data-pp-style-logo-type="inline" data-pp-style-text-color="black"
                     data-pp-amount="@string.Format("{0:N2}", Model.BasketTotals.GrandTotalIncVat)">
                </div>
                <form id="paypal-form" action="/checkout/stage3/" method="post">
                    <input type="hidden" name="PayPalPaid" id="PayPalPaid" value="true" />
                    @Html.Hidden("PaymentAmountPaid", Model.BasketTotals.GrandTotalIncVat)
                </form>
            }
            @{
                // Sidebar content (sale banner + "Find Out More" cards) is managed via the
                // Intranet's Website Info Cards admin screen and read straight from
                // dbo.WebsiteInfoCard - see BusinessLogic.EntityAccess.ReadWebsiteInfoCards().
                // Falls back to nothing rendered if the table/rows don't exist yet, rather
                // than erroring the whole basket page.
                List<WebsiteInfoCard> infoCards = new List<WebsiteInfoCard>();
                try
                {
                    infoCards = EntityAccess.ReadWebsiteInfoCards();
                }
                catch { /* table not migrated yet on this environment - render nothing below */ }

                WebsiteInfoCard bannerCard = infoCards.FirstOrDefault(x => x.Category == "Banner" && !String.IsNullOrEmpty(x.ImageUrl));
                List<WebsiteInfoCard> findOutMoreCards = infoCards.Where(x => x.Category != "Banner").ToList();
            }
        </div>
        <div class="summary-basket-card3">
            @if (bannerCard != null)
            {
                <div class="sidebar-card banner">
                    @if (!String.IsNullOrEmpty(bannerCard.LinkUrl))
                    {
                        // Clicking opens the same "Sale Details" modal as Html.ShowSaleInfoButton()
                        // elsewhere on the site (CMS "PopupData" entry keyed "SaleInfo"), instead of
                        // navigating away via LinkUrl - the same ".popup" click convention used by
                        // CMS-authored sale banners (site.js's generic ".popup" click handler reads
                        // data-popupname off whatever element was clicked, so no JS changes needed).
                        <div class="popup g-cur-p g-fc-s" data-popupname="SaleInfo" data-replacements="" data-toggle="modal" data-target="#popup">
                            <img src="@bannerCard.ImageUrl" alt="@bannerCard.Title" class="sidebar-banner-img" />
                        </div>
                    }
                    else
                    {
                        <img src="@bannerCard.ImageUrl" alt="@bannerCard.Title" class="sidebar-banner-img" />
                    }
                </div>
            }
        </div>
        <div class="summary-basket-card4">
            <div class="basket-sidebar-info">

                

                @foreach (WebsiteInfoCard card in findOutMoreCards)
                {
                    <div class="sidebar-card @card.Category.ToLower()">

                        <div class="card-header">
                            <i class="@card.IconClass"></i>
                            <span>@card.Title</span>
                        </div>

                        <div class="card-body">
                            @Html.Raw(card.BodyText)
                        </div>

                        @if (!String.IsNullOrEmpty(card.FindOutMoreContent))
                        {
                            <div class="card-toggle @card.Category.ToLower()">
                                <a href="javascript:void(0);" class="toggle-link">
                                    Find Out More
                                </a>

                                <i class="fa fa-angle-down"></i>
                            </div>

                            <div class="card-content @card.Category.ToLower()">
                                @Html.Raw(card.FindOutMoreContent)
                            </div>
                        }

                    </div>
                }



            </div>
        </div>
        <div class="summary-basket-card5">
            <div class="sidebar-card payment-card">

                <div class="card-header">
                    <i class="fa fa-credit-card"></i>
                    <span>Payment Cards Accepted</span>
                </div>

                <div class="payment-icons">

                    <img src="/Content/Images/visa.png" alt="Visa">
                    <img src="/Content/Images/mastercard.png" alt="Mastercard">
                    <img src="/Content/Images/american-express.png" alt="Amex">

                </div>

            </div>
        </div>

        @*@if (!Model.IsMobile)
        {
            <div class="g-bc-s g-b-1-p g-m-t-20 hidden-xs hidden-sm">
                <div class="g-p-10">
                    <strong>Payment Options at Checkout</strong>
                </div>
                <hr />
                <div class="g-p-10">
                    @Html.Raw(Model.CheckoutData["PaymentMethods"].Replace("[newline]", "&#013;"))
                </div>
            </div>
        }*@
    </div>
}
else
{
    <div class="row">
        <div class="col-md-12">
            <span>Your basket is currently empty, @Html.ActionLink("continue shopping", "Index", "Home")</span>
        </div>
    </div>
}

<script>
    $(document).on("click", ".card-toggle", function (e) {

        e.preventDefault();

        var card = $(this).closest(".sidebar-card");

        card.toggleClass("active");

        card.find(".card-content").stop(true, true).slideToggle(250);

    });
    (function () {
        var wrapper = document.querySelector('.basket-wrapper');
        if (!wrapper) return;

        function setQty(input, newVal) {
            var min = parseInt(input.min, 10) || 1;
            if (isNaN(newVal) || newVal < min) newVal = min;
            input.value = newVal;
            input.dispatchEvent(new Event('change', { bubbles: true }));
        }

        wrapper.addEventListener('click', function (e) {
            var incBtn = e.target.closest('[data-inc]');
            var decBtn = e.target.closest('[data-dec]');

            if (incBtn || decBtn) {
                var wrap = e.target.closest('[data-qty]');
                var input = wrap.querySelector('[data-qty-input]');
                var current = parseInt(input.value, 10);
                if (isNaN(current)) current = 1;
                setQty(input, incBtn ? current + 1 : current - 1);
                return;
            }

            var likeBtn = e.target.closest('.like-btn');
            if (likeBtn) {
                likeBtn.classList.toggle('liked');
                return;
            }

            var removeBtn = e.target.closest('.basket-remove');
            if (removeBtn) {
                var item = e.target.closest('.basket-items');
                if (item) item.remove();
                return;
            }
        });

        wrapper.addEventListener('input', function (e) {
            if (e.target.matches('[data-qty-input]')) {
                e.target.value = e.target.value.replace(/[^\d]/g, '');
            }
        });

        wrapper.addEventListener('blur', function (e) {
            if (e.target.matches('[data-qty-input]')) {
                setQty(e.target, parseInt(e.target.value, 10));
            }
        }, true);
    })();
</script>