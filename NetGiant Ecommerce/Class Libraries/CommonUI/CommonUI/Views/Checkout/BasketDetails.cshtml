@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework
@using CommonUI.Models;
@using Kendo.Mvc.UI
@using VmVoucherType = VMerchantWrapper.Entities.VoucherType;
@using System.Linq;
@model CheckoutViewModel
@*@Styles.Render("~/Content/css")*@

@if (Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery > 0)
{
    bool isAdminDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.AdminDiscount);
    bool isCompatibleDiscount = Model.BasketContents.Exists(x => x.ItemType == BasketItemType.CompatibleDiscount);
    <div class="col-md-8">
        <div class="row">
            <div class="col-md-12">
                <button type="button"
                        class="checkout-button checkout1 btn g-butt-primary g-butt-100p g-m-t-20 g-m-b-20 pull-right mobile-checkout-btn"
                        title="Checkout">
                    Proceed to Checkout
                </button>
                <div id="basketSummary" class="basketSummaryContainer">
                    @{
                        bool isMultiBuy = false;
                        decimal multibuyAmount = decimal.Zero;
                        Model.CheckZeroStock();
                        decimal basketSwitchSaving = 0;
                        bool hasSwitchProducts = false;
                        // Logic to build Basket Switch & Save section
                        List<BasketContents> switchProducts = new List<BasketContents>();
                        var list = Model.BasketContents; int switchCount = 0;
                        if (list != null && list.Count > 1)
                        {
                            foreach (BasketContents item in Model.BasketContents)
                            {
                                // Ignore non-product lines
                                if (item.ItemType != BasketItemType.Item)
                                { continue; }

                                // Ignore compatible products (already switched)
                                if (item.IsCompatible)
                                { continue; }

                                // Ignore excluded products
                                if (item.ExcludeFromUpSell)
                                { continue; }

                                // Cross-sell product must exist
                                if (item.CrossSellingStockRef == null || item.CrossSellingStockRef == "")
                                {
                                    continue;
                                }

                                // Cross-sell product must be in stock
                                if (item.CrossSellingAvailability != 1 &&
                                                    item.CrossSellingAvailability != 7)
                                { continue; }

                                decimal lineSaving =
                                    (item.PriceEx - item.CrossSellingPriceEx) * item.Quantity;

                                // Only show if customer actually saves money
                                if (lineSaving <= 0)
                                { continue; }

                                basketSwitchSaving += lineSaving;
                                switchProducts.Add(item);
                            }

                            hasSwitchProducts = switchProducts.Count > 0;
                            switchCount = switchProducts.Count;
                        }
                        if (hasSwitchProducts && switchCount > 1)
                        {


                            <div class="basket-switch-save">
                                <img src="/cdn/Images/switch-save.png" alt="Visa" style="height: 44px;">
                                <div style="font-weight: bold;">

                                    Switch &amp; Save

                                    <p>
                                        Save £@string.Format("{0:N2}", basketSwitchSaving) by switching your basket to compatible products.
                                    </p>

                                </div>

                                <div class="basket-switch-btn">

                                </div><button id="btnSwitchAll" class="btn replaceall">Switch All Items</button>

                            </div>
                        }
                        foreach (BasketContents bc in list)
                        {
                            if (bc.ItemType == BasketItemType.Item || bc.ItemType == BasketItemType.AdminDiscount)
                            {
                                string neg = bc.ItemType == BasketItemType.AdminDiscount ? "-" : "";
                                string strike = "";
                                string discClass = "g-d-n";
                                decimal discUnitPrice = decimal.Zero;
                                decimal subt = bc.PriceEx * bc.Quantity;
                                decimal discountRate = Utilities.GetUpsellRate();
                                // "Increase qty in your basket, save an extra X%" lozenge - the same
                                // qty-upsell offer/rate (CompatibleUpsellRates) as the discount logic
                                // below, but evaluated without the "already past threshold" gate so
                                // it can also show the "not yet unlocked" prompt state. This mechanic
                                // used to be a clickable button on the old Views/Checkout/BasketDetailsv2.cshtml
                                // page (now unreachable - no controller action renders it) and was lost
                                // when the basket page was redesigned; restored here re-skinned to match
                                // this page's current look.
                                decimal upsellPerItemSaving = Math.Round(bc.PriceEx * discountRate / 100, 2);
                                bool showUpsellLozenge = bc.IsCompatible && Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                    !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                    !isAdminDiscount &&
                                    upsellPerItemSaving > 0;
                                if (!bc.IsCompatible &&
                                !String.IsNullOrEmpty(bc.CrossSellingStockRef) &&
                                !bc.ExcludeFromUpSell &&
                                (bc.CrossSellingAvailability == 1 || bc.CrossSellingAvailability == 7))
                                {
                                    decimal lineSaving = (bc.PriceEx - bc.CrossSellingPriceEx) * bc.Quantity;

                                    if (lineSaving > 0)
                                    {
                                        basketSwitchSaving += lineSaving;
                                        hasSwitchProducts = true;
                                    }
                                }
                                if (bc.IsCompatible && Session["V_Voucher"] == null &&
                                    Convert.ToBoolean(ConfigurationManager.AppSettings["IsCompatibleUpsellActive"]) &&
                                    !Convert.ToBoolean(Session["U_IsTradeCustomer"]) &&
                                    !isAdminDiscount &&
                                    bc.Quantity > bc.QtyStart)
                                {
                                    discUnitPrice = Math.Round(bc.PriceEx, 2) - Math.Round(bc.PriceEx * discountRate / 100, 2);
                                    subt = discUnitPrice * bc.Quantity;
                                    strike = "g-s";
                                    discClass = "";
                                }

                                <div class="basket-items atb-entry g-m-b-20"
                                     data-productid="@bc.StockRef">

                                    <div class="basket-items-normal">

                                        <!-- Product Image -->
                                        <div class="item-img">
                                            @{
                                                var productUrl = bc.ProductUrl.StartsWith("/")
                                                    ? bc.ProductUrl
                                                    : "/" + bc.ProductUrl;
                                            }
                                            <a href="@productUrl">

                                                <img src="@bc.ImageUrl"
                                                     alt="@bc.Description"
                                                     onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                            </a>

                                        </div>

                                        <!-- Product Details -->
                                        <div class="item-title-area">

                                            <h2><a href="@productUrl">@bc.Description</a></h2>

                                            <span class="product-code">@bc.PartNo</span>

                                            @* Stock line - the same content is rendered twice (once here for
                                               desktop, once again below as a sibling of .p-price-q-area for
                                               mobile) and toggled by the max-width:768px .desktop/.mobile rules
                                               in style.css, matching the reference design's own layout. *@
                                            @if (bc.Availability == 1 || bc.Availability == 7)
                                            {
                                                <span class="desktop stock stock-in">
                                                    <text>In Stock</text>
                                                    @if (!Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"]))
                                                    {
                                                        <text>. Delivered</text> <strong>@Session["D_standardDeliveryDay"]</strong><br />
                                                        <text>Order Within</text> <strong><span class="cutoffCountdownFalse"></span></strong>
                                                    }
                                                </span>
                                            }
                                            else if (bc.Availability == 10)
                                            {
                                                <span class="desktop stock stock-out">
                                                    <text>Special Order Item. Call</text>
                                                    <a href="tel:@Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")">@Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")</a>
                                                    <text>for delivery information.</text>
                                                </span>
                                            }
                                            else if (bc.Availability == 11 || bc.Availability == 13)
                                            {
                                                <span class="desktop stock stock-out">
                                                    Out of Stock. Currently unavailable.
                                                </span>
                                            }
                                            else if (bc.Availability == 2 || bc.Availability == 4)
                                            {
                                                <span class="desktop stock stock-out">
                                                    Availability 2&ndash;3 Days. Dispatched when stock returns.
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="desktop stock stock-out">
                                                    Back In Stock Soon. Dispatched when stock returns.
                                                </span>
                                            }

                                            @if (showUpsellLozenge)
                                            {
                                                if (bc.Quantity <= bc.QtyStart)
                                                {
                                                    <button class="qty-upsell-pill"
                                                            type="button"
                                                            title="Click to get this offer"
                                                            onclick="changeBasketQty('@bc.StockRef', @(bc.QtyStart + 1))">
                                                        Buy @(bc.QtyStart + 1 - bc.Quantity) More, Save @discountRate%
                                                    </button>
                                                }
                                                else if (bc.Quantity > 1)
                                                {
                                                    <button class="qty-upsell-pill"
                                                            type="button"
                                                            title="Click to add another and keep saving"
                                                            onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))">
                                                        Add More, Keep Saving
                                                    </button>
                                                }
                                            }

                                            @if (Session["V_Voucher"] != null)
                                            {
                                                VoucherPromo vp = (VoucherPromo)Session["V_Voucher"];

                                                if (bc.IsVoucherQualifyingItem &&
                                                    vp.VoucherTypeFk == (int)VmVoucherType.Percentage)
                                                {
                                                    <div class="voucher-applied g-m-t-10">

                                                        <i class="fa fa-check-circle"></i>

                                                        Voucher Applied

                                                    </div>
                                                }
                                            }

                                        </div>

                                        <!-- Price / Quantity / Remove -->
                                        <div class="p-price-q-area">

                                            <div class="p-price">
                                                <span class="p-without-vat">£@neg@string.Format("{0:N2}", bc.PriceEx) exc. VAT</span>
                                                <span class="p-with-vat">£@string.Format("{0:N2}", bc.PriceInc) inc. VAT</span>
                                            </div>

                                            @if (!bc.IsFreeGift)
                                            {
                                                <div class="p-qnt">

                                                    <span class="trash-like">
                                                        <span class="trash">
                                                            <button class="basket-remove delete"
                                                                    data-productid="@bc.StockRef"
                                                                    type="button">
                                                                <img src="/Content/Images/icons/trash-icon.png">
                                                            </button>
                                                        </span>
                                                        <span class="like">
                                                            <button class="like-btn" type="button">
                                                            <img src="/Content/Images/icons/like-icon.png" class="unlike-b">
                                                            <img src="/Content/Images/icons/like-icon01.png" class="like-b"></button>
                                                        </span>
                                                    </span>
                                                    <span class="qnt-w">
                                                        <div class="cbi-qty cbi-g-qty">

                                                            <button type="button"
                                                                    @(bc.Quantity <= 1 ? "disabled" : "")
                                                                    onclick="changeBasketQty('@bc.StockRef', @(Math.Max(1, bc.Quantity - 1)))"
                                                                    aria-label="Decrease quantity">
                                                                &minus;
                                                            </button>

                                                            <input class="qty-input" type="text" readonly value="@bc.Quantity" />

                                                            <button type="button"
                                                                    onclick="changeBasketQty('@bc.StockRef', @(bc.Quantity + 1))"
                                                                    aria-label="Increase quantity">
                                                                +
                                                            </button>

                                                        </div>
                                                    </span>

                                                </div>
                                            }

                                        </div>

                                        @* Mobile duplicate of the stock line above - see comment there. *@
                                        @if (bc.Availability == 1 || bc.Availability == 7)
                                        {
                                            <span class="mobile stock stock-in">
                                                <text>In Stock</text>
                                                @if (!Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"]))
                                                {
                                                    <text>. Delivered</text> <strong>@Session["D_standardDeliveryDay"]</strong><br />
                                                    <text>Order Within</text> <strong><span class="cutoffCountdownFalse"></span></strong>
                                                }
                                            </span>
                                        }
                                        else if (bc.Availability == 10)
                                        {
                                            <span class="mobile stock stock-out">
                                                <text>Special Order Item. Call</text>
                                                <a href="tel:@Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")">@Utilities.GetItemFromDict(Model.CommonData, "TelephoneNumber")</a>
                                                <text>for delivery information.</text>
                                            </span>
                                        }
                                        else if (bc.Availability == 11 || bc.Availability == 13)
                                        {
                                            <span class="mobile stock stock-out">
                                                Out of Stock. Currently unavailable.
                                            </span>
                                        }
                                        else if (bc.Availability == 2 || bc.Availability == 4)
                                        {
                                            <span class="mobile stock stock-out">
                                                Availability 2&ndash;3 Days. Dispatched when stock returns.
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="mobile stock stock-out">
                                                Back In Stock Soon. Dispatched when stock returns.
                                            </span>
                                        }

                                    </div>
                                    @* ---------------- Switch & Save ----------------
                                        Fully data-bound - every value below comes from bc / Model,
                                        nothing hardcoded. Eligibility rules unchanged from before:
                                        not already compatible, has a cross-sell ref, that ref is
                                        in stock (1 or 7), and switching genuinely saves money. *@
                                    @if (!bc.IsCompatible && !String.IsNullOrEmpty(bc.CrossSellingStockRef) && !bc.ExcludeFromUpSell)
                                    {
                                        List<int> inStock = new List<int> { 1, 7 };

                                        if (inStock.Contains(bc.CrossSellingAvailability))
                                        {
                                            decimal switchUnitPriceEx = bc.CrossSellingPriceEx;
                                            decimal switchLinePriceEx = switchUnitPriceEx * bc.Quantity;
                                            decimal switchLinePriceInc = switchLinePriceEx * Model.VatMultiplier;
                                            decimal saving = (bc.PriceEx - switchUnitPriceEx) * bc.Quantity;

                                            if (saving > 0)
                                            {
                                                <div class="basket-items switch-save">
                                                    <span class="cbi-switch-save-label">Switch &amp; Save</span>
                                                    <div class="basket-items-normal">

                                                        <div class="item-img">
                                                            @{
                                                                var CrossSellingProductUrl = bc.CrossSellingProductUrl.StartsWith("/")
                                                                ? bc.CrossSellingProductUrl
                                                                : "/" + bc.CrossSellingProductUrl;
                                                            }
                                                            <a href="@CrossSellingProductUrl">

                                                                <img src="@bc.CrossSellingImageURL"
                                                                     alt="@bc.CrossSellingDescription"
                                                                     onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />

                                                            </a>
                                                        </div>

                                                        <div class="item-title-area">

                                                            <h2><a href="@CrossSellingProductUrl">@bc.CrossSellingDescription</a></h2>

                                                            <span class="product-code">@bc.PartNo</span>

                                                            <span class="desktop stock stock-in">In Stock</span>

                                                        </div>

                                                        <div class="p-price-q-area">

                                                            <div class="p-price">
                                                                <span class="p-without-vat">£@string.Format("{0:N2}", switchLinePriceEx) exc. VAT</span>
                                                                <span class="p-with-vat">£@string.Format("{0:N2}", switchLinePriceInc) inc. VAT</span>
                                                                <p class="cbi-save-amount">Save £@string.Format("{0:N2}", saving) ex. VAT</p>
                                                            </div>

                                                            <div class="p-qnt">
                                                                <span class="qnt-w">
                                                                    <button type="button"
                                                                            class="cbi-switch-btn atb-replace"
                                                                            data-productid="@bc.CrossSellingStockRef"
                                                                            data-price="@bc.CrossSellingPriceEx"
                                                                            data-removeid="@bc.StockRef"
                                                                            data-qty="@bc.Quantity">
                                                                        Switch Now
                                                                    </button>
                                                                </span>
                                                            </div>

                                                        </div>

                                                        <span class="mobile stock stock-in">In Stock</span>

                                                    </div>
                                                </div>
                                            }
                                        }
                                    }
                                </div>

                            }
                            if (bc.ItemType == BasketItemType.CompatibleDiscount)
                            {
                                isMultiBuy = true;
                                multibuyAmount = bc.PriceEx;

                            }
                        }

                        <hr class="g-m-tb-10" />
                        @{
                            // Flatten + dedupe across every basket line's add-ons - without this,
                            // the same add-on could show once per basket line that links to it.
                            var seenAddOnRefs = new HashSet<string>();
                            var addOnsToShow = new List<BasketContents>();
                            foreach (var items in list)
                            {
                                foreach (var addOn in items.AddonProducts)
                                {
                                    if (seenAddOnRefs.Add(addOn.StockRef))
                                    {
                                        addOnsToShow.Add(addOn);
                                    }
                                }
                            }
                        }
                        if (addOnsToShow.Count > 0)
                        {
                            <div class="you-may-need">

                                <div class="you-may-need-header">
                                    You May Also Need...
                                </div>

                                <div class="you-may-need-wrapper" data-index="0">

                                    @if (addOnsToShow.Count > 3)
                                    {
                                        <button type="button" class="need-arrow prev" disabled aria-label="Previous">
                                            <i class="fa fa-chevron-left"></i>
                                        </button>
                                    }

                                    <div class="you-may-need-products">
                                        <div class="you-may-need-track">

                                            @foreach (var addOn in addOnsToShow)
                                            {
                                                <div class="need-product">
                                                    @{
                                                        var productUrl = addOn.ProductUrl.StartsWith("/")
                                                            ? addOn.ProductUrl
                                                            : "/" + addOn.ProductUrl;
                                                    }
                                                    <a href="@productUrl">
                                                        <img src="@addOn.ImageUrl"
                                                             class="img-responsive"
                                                             onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                                    </a>

                                                    <a class="need-title"
                                                       href="@productUrl">
                                                        @addOn.Description
                                                    </a>
                                                    <a href="@addOn.ProductUrl" class="need-title">
                                                        @addOn.PartNo
                                                    </a>
                                                    <div class="need-price">
                                                        £@string.Format("{0:N2}", addOn.PriceEx)Ex VAT
                                                    </div>

                                                    <button class="btn btn-success atb-add"
                                                            data-productid="@addOn.StockRef"
                                                            data-price="@addOn.PriceEx"
                                                            data-qty="1">
                                                        Add to Basket
                                                    </button>

                                                </div>

                                            }

                                        </div>
                                    </div>

                                    @if (addOnsToShow.Count > 3)
                                    {
                                        <button type="button" class="need-arrow next" aria-label="Next">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                    }

                                </div>

                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="row">
            <div class="basket-voucher col-md-8">
                @if ((Model.CheckoutDetails.ZeroStock || Model.CheckoutDetails.IsSpecialOrder) && !Convert.ToBoolean(Session["U_IsPortalUser"]))
                {
                    Dictionary<string, string> replacements = new Dictionary<string, string>();
                    <div class="g-bc-note g-b-1-p g-p-10 g-m-t-10 g-w-345 g-fs-sm">@(Html.RawFromDict(Model.CheckoutData, "ZeroStock", replacements))</div>
                }


                @if (Convert.ToBoolean(Session["U_IsPortalUser"]))
                {
                    <div class="g-m-t-60 g-m-b-20 g-br-0 panel panel-default">
                        <div class="panel-heading g-fw-b">Customer Service Tools</div>
                        <div class="panel-body">
                            @if (String.IsNullOrEmpty(Session["B_VoucherCode"] as string))
                            {
                                if (isAdminDiscount)
                                {
                                    <div class="g-m-t-10 g-fw-b">ADMIN DISCOUNT HAS BEEN APPLIED TO THIS ORDER</div>
                                }
                                else
                                {
                                    <div class="g-fc-secondary g-m-t-10">Administrator Discount Inc.Vat</div>
                                    <div class="atb-entry bkt-discount input-group g-m-t-10 g-w-345">
                                        <span class="input-group-addon g-br-0 g-fc-tt g-b-n g-bc-s" style="border-right: 1px solid #cccccc !important;">-&pound;</span>
                                        <input id="admin-discount" class="form-control g-h-40 pull-left" placeholder="Enter discount ..." type="number">
                                        <span class="input-group-btn">
                                            <button id="apply-discount" class="g-butt-secondary g-butt-lg g-fs-n" type="button">Apply Discount</button>
                                            <button id="discount-atb" class="atb-add g-d-n"
                                                    data-vatm="@Model.VatMultiplier"
                                                    data-productid="4957"
                                                    data-partno=""
                                                    data-price=""
                                                    data-itemtype="2"></button>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="g-m-t-10 basket-entry">
                                <div class="atb-entry input-group g-m-t-10 g-w-345">
                                    <span class="input-group-addon g-br-0 g-b-n g-bc-s">Clear All Products</span>
                                    <button id="admn-clear-basket" class="g-butt g-butt-secondary g-butt-lg pull-right"
                                            title="Clear all items from the basket">
                                        Clear
                                    </button>
                                </div>
                                <div class="g-m-t-10">
                                    <div class="atb-entry input-group g-m-t-10 g-w-345">
                                        @if (ViewBag.OrderIsOnHold)
                                        {
                                            <span class="input-group-addon g-br-0 g-b-n g-bc-s">Order is On Hold</span>
                                            <button class="g-butt g-butt-secondary g-butt-lg delete pull-right"
                                                    data-productid="ONHOLD"
                                                    title="Remove from on hold">
                                                Remove
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="input-group-addon g-br-0 g-b-n g-bc-s">Place Order On Hold</span>
                                            <button class="g-butt g-butt-secondary g-butt-lg atb-add pull-right"
                                                    data-price="0.00"
                                                    data-productid="ONHOLD"
                                                    data-partno="ONHOLD"
                                                    data-imageurl="unknown.jpg"
                                                    data-itemtype="3"
                                                    title="Place this order on hold">
                                                Place On Hold
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4 dv-basket-card">

        @* ---------------- Delivery message ----------------
        CM: shows the "spend X more for free delivery" threshold message.
        TG: constant "Free Next Day/Working Day Delivery" message.
        Site is distinguished the same way other site-specific config is
        read elsewhere in this file (ConfigurationManager.AppSettings) -
        adjust the key/values below to match your actual site flag. *@
        @{
            bool isCartridgeMarket = ConfigurationManager.AppSettings["SiteBrand"] == "CM";
            decimal freeDeliveryThreshold = 45.00m; // CM threshold - move to config if it varies
            decimal subTotalExVat = Model.BasketTotals.TotalExcVat - Model.BasketTotals.Delivery;
        }
        <div class="summary-basket-card1">
            <div class="main-basket-summary">

                <h4>Summary</h4>
                <div class="basket-summary">
                    @{
                        IHtmlString deliveryMessage = Html.Raw("");
                    }

                    @if (isCartridgeMarket)
                    {
                        decimal remaining = freeDeliveryThreshold - subTotalExVat;

                        if (remaining > 0)
                        {
                            deliveryMessage = Html.Raw("Spend &pound;" + string.Format("{0:N2}", remaining) + " more for free delivery");
                        }
                        else
                        {
                            deliveryMessage = Html.Raw("Free Delivery Included");
                        }
                    }
                    else
                    {
                        bool isFriday = DateTime.Now.DayOfWeek == DayOfWeek.Friday;
                        TimeSpan cutoff = isFriday ? new TimeSpan(17, 0, 0) : new TimeSpan(17, 30, 0);
                        bool pastCutoff = DateTime.Now.TimeOfDay > cutoff;

                        if (pastCutoff)
                        {
                            deliveryMessage = Html.Raw("Free Next Working Day Delivery");
                        }
                        else
                        {
                            deliveryMessage = Html.Raw("Free Next Day Delivery");
                        }
                    }
                    <span><img src="~/Content/Images/icons/shipping-icon01.png"></span>
                    <span>@deliveryMessage</span>
                </div>

                <span>

                </span>
            </div>

            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Delivery</strong>
                </div>
                <div class="pull-right g-p-r-20">
                    @if (Model.BasketTotals.Delivery == 0)
                    {
                        @:FREE
                    }
                    else
                    {
                        @Html.Raw("&pound;" + string.Format("{0:N2}", Math.Abs(Model.BasketTotals.Delivery)))
                    }
                </div>
            </div>
        </div>
        <div class="summary-basket-card2">
            <div class="g-m-t-10 clearfix">
                <div class="pull-left">
                    <strong>Sub Total</strong>
                </div>
                <div class="pull-right g-p-r-20">&pound;@string.Format("{0:N2}", subTotalExVat)</div>
