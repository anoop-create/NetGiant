@using BusinessLogic;
@using BusinessLogic.ViewModels
@using CommonUI.Models;
@using Kendo.Mvc.UI
@using System.Configuration;

@model CheckoutViewModel

@section AddTags
{
    @{
        int sessionTimeout = (Session.Timeout > 1 ? Session.Timeout - 1 : 1) * 60;
    }
    <meta http-equiv="refresh" content="@sessionTimeout.ToString(); URL=/?pm=SessionExpired&sz=md">
    <link rel="preconnect" href="https://www.paypal.com/">
    <link rel="preconnect" href="https://www.paypalobjects.com/">
    <link rel="canonical" href="https://@Model.DomainNameTrunc@Request.Url.AbsolutePath.ToLower()">
}

<section id="loadbg" class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" data-bgimg="@Html.RawFromDict(Model.CommonData, "FeatureBackground")">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-120 g-fc-st">
                @if (!Model.IsMobile)
                {
                    <div class="bread-crumb hidden-xs hidden-sm">
                        @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                        {
                            <a class="second" href="/@bc.Value">@bc.Key</a>
                            <i class="fa fa-chevron-right g-fs-xs-i"></i>
                        }
                    </div>
                }
                <div class="g-m-t-10">
                    <div class="pull-left">
                        <h1>
                            <span class="">Your Basket</span>
                        </h1>
                        <div class="g-m-t-10">
                            <i class="fa fa-reply"></i>
                            <a class="second g-m-l-10 g-i" href="/">
                                Continue Shopping
                            </a>
                        </div>
                    </div>
                    @if (!Model.IsMobile)
                    {
                        <div class="pull-right hidden-xs hidden-sm">
                            @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="g-bc-p g-p-t-20 g-p-b-100">
    <div class="container body-content g-ps-r">
        <div class="row g-m-t-20">
            <div class="col-md-12">
                <div class="row">
                    <!-- Left Hand Column -->
                    <div class="col-md-12">
                        <div id="vbBasketDetails">
                            @{
                                Html.RenderPartial("~/Views/Checkout/BasketDetails.cshtml", Model);
                            }
                        </div> 

                        @* Amazon Pay / PayPal Checkout buttons live here, outside #vbBasketDetails, so they
                            render once per real page load and are never touched by the AJAX partial refresh
                            that #vbBasketDetails gets on every quantity/voucher/add/remove change (see
                            refreshVbFields() in site.js). #paypal-button2 is exactly what
                            renderPaypalButtonV2() (called after every add/remove/voucher change, and once on
                            initial load below) expects to find.
                            The Amazon Pay button (script tag + amazon.Pay.renderButton() call) was previously
                            found duplicated inside BasketDetails.cshtml itself - i.e. inside the AJAX-refreshed
                            region - which re-fetched/re-executed the Amazon Pay SDK and rebuilt the button on
                            every quantity change. That's the actual cause of the reported "Amazon and PayPal
                            buttons refresh on quantity change" bug. Moved here for the same reason PayPal's
                            buttons already were; BasketDetails.cshtml's copy (and its duplicate, invalid-HTML
                            #paypal-button2/3 IDs) has been removed.
                            FIX: #paypal-button3 (a second, separate "Pay Later" branded PayPal button,
                            rendered with fundingSource: paypal.FUNDING.PAYLATER in renderPaypalButtonV2()) was
                            reported as appearing at the bottom of the basket page and shouldn't be there -
                            removed the container here (and the matching render call in site.js, and the
                            enable-funding=paylater flag on the SDK script tag below) so only the plain PayPal 
                            button (#paypal-button2) renders.
                            FIX (bug report: "Paypal does not allow you to complete an order - it simply returns
                            you to the basket page"): renderPaypalButtonV2()'s onApprove handler in site.js
                            captures the PayPal payment via /Checkout/PayPalCapture (which actually creates the
                            order server-side - Touchpoints.SaveOrder gets called, the customer IS charged) and
                            then, on success, does $("#paypal-form").submit() to POST to /checkout/stage3/ and
                            show the order-confirmation page. That form used to live in BasketDetails.cshtml but
                            got swept into the same Razor comment block as #paypal-button3/#paypal-message at
                            some point (see that file) and was never re-added anywhere live - so on this page
                            $("#paypal-form") matches nothing, .submit() silently no-ops, and the customer is
                            left sitting on the basket page after a successful-but-uncelebrated PayPal payment,
                            looking exactly like the order failed. Restored the form here, outside
                            #vbBasketDetails, for the same reason #paypal-button2 lives here and not in
                            BasketDetails.cshtml - so it survives the AJAX partial refresh and isn't duplicated
                            by it. Field names/action match the original BasketDetails.cshtml copy exactly. *@
                        @if (!Convert.ToBoolean(Session["U_IsPortalUser"]) && Model.BasketTotals.GrandTotalIncVat > 0.01m)
                        {

                            <div id="paypal-button2" class="g-m-t-20"></div>
                            <form id="paypal-form" action="/checkout/stage3/" method="post">
                                <input type="hidden" name="PayPalPaid" id="PayPalPaid" value="true" />
                                @Html.Hidden("PaymentAmountPaid", Model.BasketTotals.GrandTotalIncVat)
                            </form>
                        }

                        @*<div class="g-bc-s g-b-1-p g-m-t-20 visible-xs visible-sm restrict-images vb-pay-methods">
                            <div class="g-p-10">
                                <strong>Payment Methods</strong>
                            </div>
                            <hr />
                            <div class="g-p-10 text-center">
                                @Html.Raw(Model.CheckoutData["PaymentMethods"].Replace("[newline]", "&#013;"))
                            </div>
                        </div>*@

                        <div class="row">
                            <div class="col-md-12 g-m-t-60">
                                @{
                                    Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Hand Column -->
                    
                </div>
            </div>
        </div>
    </div>
</section>

<input hidden="hidden" class="IsInCheckout" />

@{
    if (Authentication.IsNotFullyAuthenticated())
    {
        Html.RenderPartial("~/Views/Checkout/Ident.cshtml", Model);
    }
}
 
@section scripts
{
    <script type="text/javascript">

        function runCheckoutButtonAction() {
            //if ($('.hdr-basket .basketTotal').html() == '0.00') {
            //    return;
            //}
            if (checkSessionExists('C_IsInCheckout')) {
                launchPopup('IsInCheckout', 'popup', 'lg', '');
                return;
            }
            if ('@(Authentication.IsFullyAuthenticated())' == 'True') {
                // Authenticated
                $('#co-form').submit();
            } else {
                // Not Authenticated - so ask to Login/Register
                $('#ident-modal').modal();
            }
        }

        $(document).on('click', '.checkout-button', runCheckoutButtonAction);

        $(function () {
            if (checkSessionExists('C_IsInCheckout')) {
                $('.IsInCheckout').val('true');
                $('#voucher-code, #apply-voucher').prop('disabled', true);
            } else {
                $('#voucher-code, #apply-voucher').prop('disabled', false);
            }

            // FIX: this used to auto-trigger the Checkout button action (and so the "Secure
            // Checkout" login popup) the instant this page loaded via ?showlogin=1, sent by the
            // mini-cart's "Proceed to Checkout" (site.js, proceedToCheckout()/checkoutUrl()) for
            // a signed-out customer. Per explicit business direction, that's no longer wanted -
            // it removed the customer's exposure to the express payment buttons (Amazon Pay,
            // PayPal) and this page's proposition messaging before they'd even seen them.
            // checkoutUrl() no longer ever appends ?showlogin=1 (every customer now always lands
            // on the plain basket URL), so this block is intentionally removed rather than left
            // as permanently-dead code.

            // Render the PayPal button once on initial page load - every other
            // renderPaypalButtonV2() call site only fires after a basket mutation
            // (add/remove/qty/voucher), so without this the button wouldn't appear
            // until the customer had already changed something. Guarded on the
            // container actually being on the page (it's only rendered server-side
            // for non-portal users with a basket total above zero).
            if ($('#paypal-button2').length) {
                renderPaypalButtonV2();
            }
        });

        $(window).on('unload', function () {
            if ($('.paypal-checkout-sandbox').is(':visible') == true && $('.IsInCheckout').val() != 'true') {
                setSession("C_IsInCheckout", null);
            }
        });

    </script>
    @if (!Convert.ToBoolean(Session["U_IsPortalUser"]) && Model.BasketTotals.GrandTotalIncVat > 0.01m)
    {
        @* FIX: removed &enable-funding=paylater - it exists to enable the "Pay Later" funding
            source, which the site no longer renders a button for (see #paypal-button3 removal
            above and in site.js). components=messages is kept even though the on-page message
            banner is currently commented out below, since it's the SDK's messaging component,
            unrelated to the Pay Later button itself. *@
        <script src="https://www.paypal.com/sdk/js?client-id=@(ConfigurationManager.AppSettings["PayPalClientId"])&currency=GBP&locale=en_GB&intent=authorize&components=messages,buttons&debug=@(ConfigurationManager.AppSettings["Environment"] == "Live" ? "false" : "true")">
        </script>
    }

}

@section AddScript
{
    @{
        Html.RenderPartial("~/Views/Checkout/JSTracking.cshtml", Model);
    }
    @Scripts.Render("~/bundles/checkoutBundle.js")
}

@section StructuredData
{
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    ]
}


