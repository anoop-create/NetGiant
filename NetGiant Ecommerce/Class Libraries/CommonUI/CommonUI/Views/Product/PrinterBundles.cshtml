@using System.Configuration;
@using BusinessLogic;
@using BusinessLogic.ViewModels;

@model ProductViewModel

@*
    Printer PDP - "Save When You Buy A Printer Bundle" (brief page 4).

    Only rendered when Model.IsPrinterProduct is true (see Views/Product/Index.cshtml) - a
    no-op include for every existing consumable product page.

    Data source: Model.PrinterBundles (populated by ProductViewModel.GetPrinterBundles() from
    the existing ProductAddon table, the same table that already powers the mini-cart's "You
    May Also Need" popup) plus Model.PrinterBundleDiscount (the new per-product discount field).

    Per the brief ("No logic needed for the colour backgrounds"), the Compatible column is
    always green and the Original column is always red - fixed, not data-driven. If a printer
    only has bundle addons of one brand, only that column renders.

    Add to basket: each side of the bundle gets its own standard .atb-add button (the exact
    same markup/class already used by the Buy Box above and MiniProductEntry.cshtml elsewhere
    on this page), rather than a single combined "add both" action - this reuses the existing,
    already-tested site.js click handler unchanged instead of introducing new multi-item basket
    logic that can't be exercised against a real printer product yet.
*@
@{
    var compatibleBundles = Model.PrinterBundles.Where(b => b.IsCompatible).ToList();
    var originalBundles = Model.PrinterBundles.Where(b => !b.IsCompatible).ToList();
    bool useVatInclusive = ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1";
    string vatLabel = useVatInclusive ? "inc VAT" : "ex VAT";

    Func<PrinterBundleGroup, decimal> bundlePrice = b => useVatInclusive
        ? b.BundlePriceIncVat - Model.PrinterBundleDiscount
        : Decimal.Divide(b.BundlePriceIncVat, Model.VatMultiplier) - Decimal.Divide(Model.PrinterBundleDiscount, Model.VatMultiplier);
}

@if (Model.PrinterBundles.Count > 0)
{
    <div class="row g-m-t-20">
        <div class="col-xs-12">
            <div class="ppdp-bundles g-boxshadow">
                <div class="ppdp-bundles-header">
                    <h2>Save When You Buy A Printer Bundle</h2>
                    @if (Model.PrinterBundleDiscount > 0)
                    {
                        <div class="ppdp-bundles-subtitle">Buy this printer with a cartridge bundle and save &pound;@Model.PrinterBundleDiscount.ToString("#,###,##0.00")</div>
                    }
                </div>
                <div class="ppdp-bundle-columns clearfix">
                    @if (compatibleBundles.Count > 0)
                    {
                        <div class="ppdp-bundle-column ppdp-bundle-compatible">
                            <div class="ppdp-bundle-column-title">Compatible Cartridges</div>
                            @foreach (var b in compatibleBundles)
                            {
                                @RenderBundleCard(b, bundlePrice(b), vatLabel)
                            }
                        </div>
                    }
                    @if (originalBundles.Count > 0)
                    {
                        <div class="ppdp-bundle-column ppdp-bundle-original">
                            <div class="ppdp-bundle-column-title">Original Cartridges</div>
                            @foreach (var b in originalBundles)
                            {
                                @RenderBundleCard(b, bundlePrice(b), vatLabel)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@helper RenderBundleCard(PrinterBundleGroup b, decimal price, string vatLabel)
{
    <div class="ppdp-bundle-card atb-entry">
        <div class="ppdp-bundle-card-image">
            <img class="lazy" src="/Content/Images/1pxTrans.png" data-original="@b.AddonProduct.ImageUrl" alt="@b.AddonProduct.Description" />
            <noscript><img src="@b.AddonProduct.ImageUrl" alt="@b.AddonProduct.Description" /></noscript>
        </div>
        <div class="ppdp-bundle-card-desc">@b.AddonProduct.Description</div>
        @if (b.PerMlCost > 0)
        {
            <div class="ppdp-bundle-permlbadge">&pound;@b.PerMlCost.ToString("#,##0.00") per ml</div>
        }
        <div class="ppdp-bundle-card-price">
            &pound;@price.ToString("#,###,##0.00") <span class="g-fs-sm">@vatLabel</span>
        </div>
        <button class="atb-add g-butt-primary g-butt-100p"
                data-productid="@b.AddonProduct.Reference"
                data-partno="@b.AddonProduct.PartNo"
                data-imageurl="@b.AddonProduct.ImageUrl"
                data-desc="@b.AddonProduct.Description">
            Add Cartridges to Basket
        </button>
    </div>
}
