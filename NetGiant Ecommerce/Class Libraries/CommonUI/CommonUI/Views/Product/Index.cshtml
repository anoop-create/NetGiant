@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;
@using System.Configuration;
@using Kendo.Mvc.UI;
@using System.Text.RegularExpressions;
@using DataAccess.EntityFramework

@model ProductViewModel

@{
    ProductEntry pe = Model.Product;

    decimal feefowidth = (pe.FeeFoRating * 16);
    decimal mainPrice = 0;
    decimal subPrice = 0;
    decimal salePrice = 0;
    decimal cashbackPrice1 = 0;
    decimal cashbackPrice2 = 0;
    decimal crossSellPrice = 0;
    decimal mainB1Price = 0;
    decimal subB1Price = 0;
    decimal mainB2Price = 0;
    decimal subB2Price = 0;
    string mainPriceVAT = "";
    string subPriceVAT = "";
    string voucher = "";
    string offerClass = "";
    string hideBasketCount = "g-v-h";
    bool isConsumable = false;
    bool compatibleHasOffer = false;
    bool isSaving = false;
    string tooltipHighlight = "";

    if (pe.BrandFlag != BrandFlag.Compatible)
    {
        tooltipHighlight = "tooltip-highlight";
    }

    if (pe.Type == "Toner" || pe.Type == "Ink" || pe.Type == "Solid Ink" || pe.Type == "Franking")
    {
        isConsumable = true;
    }

    decimal tradePrice = pe.PriceTrExVat;
    decimal xSTradePrice = pe.PriceTrExVat;
    if (ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1")
    {
        mainPrice = pe.PriceRetIncVat;
        mainB1Price = pe.BreakPrice2IncVat;
        mainB2Price = pe.BreakPrice3IncVat;
        subPrice = Decimal.Divide(pe.PriceRetIncVat, Model.VatMultiplier);
        subB1Price = Decimal.Divide(pe.BreakPrice2IncVat, Model.VatMultiplier);
        subB2Price = Decimal.Divide(pe.BreakPrice3IncVat, Model.VatMultiplier);
        crossSellPrice = pe.CrossSellPriceIncVat;
        mainPriceVAT = "inc VAT";
        subPriceVAT = "ex VAT";

        if (isConsumable)
        {
            if (pe.BrandFlag.Equals(BrandFlag.Compatible))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCCOMPPromoIsOn"])
                    && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = pe.PPCPromoPriceIncVat;
                    voucher = ConfigurationManager.AppSettings["PPCCOMPPromoCode"];
                }
                if (Model.IsCompatibleSaleActive)
                {
                    salePrice = pe.PriceSaleIncVat;
                    voucher = Html.RawFromDict(Model.SaleData, "CompatibleVoucher").ToSafeString();
                    offerClass = "compatible";
                }
            }
            if (pe.BrandFlag.Equals(BrandFlag.Original))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCOEMPromoIsOn"])
                    && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = pe.PPCPromoPriceIncVat;
                    voucher = ConfigurationManager.AppSettings["PPCOEMPromoCode"];
                }
                if (Model.IsOEMSaleActive)
                {
                    salePrice = pe.PriceSaleIncVat;
                    voucher = Html.RawFromDict(Model.SaleData, "OEMVoucher").ToSafeString();
                    offerClass = "oem";
                }
            }
        }
        if (pe.IsStationerySaleItem)
        {
            if (Model.IsStationerySaleActive)
            {
                salePrice = pe.PriceSaleIncVat;
                voucher = Html.RawFromDict(Model.SaleData, "StationeryVoucher").ToSafeString();
                offerClass = "stat";
            }
        }
        if (Model.Product.AttValue6 == 1)
        {
            cashbackPrice1 = mainPrice - Convert.ToDecimal(Model.Product.SpecLine3);
            cashbackPrice2 = Decimal.Divide(cashbackPrice1, Model.VatMultiplier);
        }
    }
    else
    {
        mainPrice = Decimal.Divide(pe.PriceRetIncVat, Model.VatMultiplier);
        mainB1Price = Decimal.Divide(pe.BreakPrice2IncVat, Model.VatMultiplier);
        mainB2Price = Decimal.Divide(pe.BreakPrice3IncVat, Model.VatMultiplier);
        subPrice = pe.PriceRetIncVat;
        subB1Price = pe.BreakPrice2IncVat;
        subB2Price = pe.BreakPrice3IncVat;
        crossSellPrice = Decimal.Divide(pe.CrossSellPriceIncVat, Model.VatMultiplier);
        mainPriceVAT = "ex VAT";
        subPriceVAT = "inc VAT";

        if (isConsumable)
        {
            if (pe.BrandFlag.Equals(BrandFlag.Compatible))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCCOMPPromoIsOn"])
                    && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = Decimal.Divide(pe.PPCPromoPriceIncVat, Model.VatMultiplier);
                    voucher = ConfigurationManager.AppSettings["PPCCOMPPromoCode"];
                }
                if (Model.IsCompatibleSaleActive)
                {
                    salePrice = Decimal.Divide(pe.PriceSaleIncVat, Model.VatMultiplier);
                    voucher = Html.RawFromDict(Model.SaleData, "CompatibleVoucher").ToSafeString();
                    offerClass = "compatible";
                }
            }
            if (pe.BrandFlag.Equals(BrandFlag.Original))
            {
                if (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCOEMPromoIsOn"])
                    && Convert.ToBoolean(Session["U_IsFromPPC"]))
                {
                    salePrice = Decimal.Divide(pe.PPCPromoPriceIncVat, Model.VatMultiplier);
                    voucher = ConfigurationManager.AppSettings["PPCOEMPromoCode"];
                }
                if (Model.IsOEMSaleActive)
                {
                    salePrice = Decimal.Divide(pe.PriceSaleIncVat, Model.VatMultiplier);
                    voucher = Html.RawFromDict(Model.SaleData, "OEMVoucher").ToSafeString();
                    offerClass = "oem";
                }
            }
        }
        if (pe.IsStationerySaleItem)
        {
            if (Model.IsStationerySaleActive)
            {
                salePrice = Decimal.Divide(pe.PriceSaleIncVat, Model.VatMultiplier);
                voucher = Html.RawFromDict(Model.SaleData, "StationeryVoucher").ToSafeString();
                offerClass = "stat";
            }
        }
        if (Model.Product.AttValue6 == 1)
        {
            cashbackPrice2 = subPrice - Convert.ToDecimal(Model.Product.SpecLine3);
            cashbackPrice1 = Decimal.Divide(cashbackPrice2, Model.VatMultiplier);
        }
    }
    if (Model.IsCompatibleSaleActive
        || (Convert.ToBoolean(Session["U_IsFromPPC"])
        && (Convert.ToBoolean(ConfigurationManager.AppSettings["PPCOEMPromoIsOn"]) || Convert.ToBoolean(ConfigurationManager.AppSettings["PPCCOMPPromoIsOn"]))))
    {
        compatibleHasOffer = true;
    }
    if (salePrice < mainPrice - Convert.ToDecimal(0.1))
    {
        isSaving = true;
    }
    decimal xsSaving = 0;
    if (Model.XsProduct != null)
    {
        if (Convert.ToBoolean(HttpContext.Current.Session["U_IsTradeCustomer"]))
        {
            xsSaving = pe.PriceTrExVat - Model.XsProduct.PriceTrExVat;
        }
        else
        {
            xsSaving = Decimal.Divide(pe.PriceRetIncVat, Model.VatMultiplier) - Decimal.Divide(pe.CrossSellPriceIncVat, Model.VatMultiplier);
        }
    }
    bool showCrossSell = false;
    if (pe.CrossSellProductID != 0
    && pe.BrandFlag == BrandFlag.Original
    && !Model.IsOEMSaleActive
    && !Model.PpcSuppress
    && !Model.CrossSellSuppress)
    {
        showCrossSell = true;
    }
}

@section AddTags {
    <link rel="canonical" href="@("https://" + Model.DomainNameTrunc + ViewBag.cUrl)" />
}

<div class="product">
    <section id="loadbg" class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" data-bgimg="@Html.RawFromDict(Model.CommonData, "FeatureBackground")">
        <div class="container body-content">
            <div class="row">
                <div class="col-md-12 comm-title-banner xg-h-150-md g-fc-st">
                    @if (!Model.IsMobile)
                    {
                        <div class="bread-crumb hidden-xs hidden-sm">
                            @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                            {
                                <a class="second" href="/@bc.Value">@bc.Key</a>
                                <i class="fa fa-chevron-right g-fs-xs-i"></i>
                            }
                        </div>
                    }

                    <div class="comm-title-margin g-m-t-a">

                        <div class="@tooltipHighlight clearfix" data-tooltipname="PricePromise">
                            <h1 class="g-w-630">@pe.Description</h1>
                            <div class="g-i">
                                <div class="pull-left g-p-t-5"><strong>Product Code:</strong> @pe.PartNo</div>
                                @if (!Model.IsMobile)
                                {
                                    <div class="pull-left g-m-l-20 hidden-xs hidden-sm">
                                        <div>
                                            <button class="popup g-cur-p g-butt-second-inv g-butt-lg-2"
                                                    onclick="scrollToSelector('#questions');">
                                                Ask a Question
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Model.FeeFoList.Count > 0)
                        {
                            <div class="clearfix g-cur-p g-m-t-10 col-xs-12 col-md-3"
                                 onclick="scrollToSelector('#reviews');"
                                 data-toggle="tooltip"
                                 data-placement="bottom"
                                 title="@pe.FeeFoCount reviews, average rating: @pe.FeeFoRating.ToString("0.00")">
                                <div class="pull-left g-of-h g-m-l-m15" style="white-space: nowrap; width: @(feefowidth)px">
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                </div>
                                <div class="pull-left g-p-l-5">
                                    (@pe.FeeFoCount.ToString() Reviews)
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="g-h-30"></div>
                        }
                    </div>

                    <div class="comm-title-image g-b-1-p g-bc-s g-flex-allcenter hidden-xs hidden-sm">
                        <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(pe.Brand.Replace(' ', '-').Replace("-&", "").ToLower()).jpg" alt="@pe.Brand" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div id="page-content" class="comm-content g-bc-p g-p-b-100">
        <div class="container body-content g-ps-r">

            <!-- New -->
            <div class="row g-m-t-20">
                <div class="col-md-12 g-bc-p">
                    <div class="row g-m-lr-0">
                        <div class="prd-main-entry">
                            <div>
                                <!-- Product Box -->
                                <div class="g-ps-a">
                                    @Html.Raw(ViewBag.ImageSash)
                                </div>
                                <div class="g-boxshadow g-bc-s clearfix g-p-30">
                                    <!-- Product Image -->
                                    <div class="g-w-55p-md g-f-l-md">
                                        <div class="">
                                            <div class="g-flex-allcenter prd-image-container g-cur-p g-ps-r">
                                                <img id="prd-image" src="@pe.ImageUrl" alt="@pe.Description" data-toggle="modal" data-target="#imageModal"
                                                     onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                                @if (Model.ImageList.Count > 0)
                                                {
                                                    <span>
                                                        <img id="image-zoom" class="msp_zoom g-ps-a g-d-n" src="/Content/Images/1pxTrans.png" alt="zoom" />
                                                    </span>
                                                }
                                            </div>
                                            <div class="g-w-100p">
                                                <div class="g-flex-allcenter g-lh-30 g-w-100p g-m-lr-a">
                                                    @if (Model.ImageList.Count > 1)
                                                    {
                                                        Html.RenderPartial("~/Views/Product/ImageCarousel.cshtml", Model);
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Feature Bullets -->
                                    <div class="g-w-45p-md g-fs-15 g-f-l-md">
                                        <div class="clearfix xg-p-lr-20 g-p-tb-10 g-va-t">
                                            <div class="g-flex-column">
                                                <div class="visible-xs visible-sm g-m-t-20"></div>
                                                @if (pe.BrandFlag.Equals(BrandFlag.Original))
                                                {
                                                    <div class="g-lh-25 clearfix g-m-b-20">
                                                        <div class="g-d-ib g-w-35">
                                                            <i class="fa fa-check g-fs-lg g-fc-pm g-p-l-5"></i>
                                                        </div>
                                                        <div class="g-d-ib">
                                                            <span>Original @pe.Brand Product</span>
                                                        </div>
                                                    </div>
                                                }

                                                @if (pe.Type == "Toner" || pe.Type == "Ink" || pe.Type == "Franking" || pe.Type == "Solid Ink")
                                                {
                                                    <div class="row g-cur-p g-m-b-20" onclick="javascript:scrollToSelector('#compatiblePrinters')" title="Click here to see which printers this cartridge will work in">
                                                        <div class="col-xs-2 col-md-2" style="width:55px;">
                                                            <i class="fa fa-print g-fs-lg g-p-l-5"></i>
                                                        </div>
                                                        <div class="col-xs-10 col-md-10 g-p-lr-0" style="width:auto;">
                                                            <div>Which printers does this work in?</div>
                                                        </div>
                                                    </div>
                                                }

                                                @* Site audit (May 2026) items 25/32: these USP badges (guarantee/warranty/
                                                   offer bullet) previously rendered as separate stacked "clearfix" rows,
                                                   each with a small sprite icon and a line of text - visually reading more
                                                   like a strip of small marketing thumbnails than a clear USP list. Wrapped
                                                   in a single horizontal bar (icon-over-text, side by side) per the audit's
                                                   recommendation. Every existing data-toggle/data-popupname attribute (the
                                                   info popups) and condition is unchanged - this is a layout/CSS change
                                                   only, nothing that opens these popups was touched. *@
                                                <div class="prd-usp-bar clearfix">
                                                    @if (pe.BrandFlag.Equals(BrandFlag.Compatible))
                                                    {
                                                        <div class="prd-usp-item popup g-cur-p"
                                                             data-popupname="CompatibleGuarantee"
                                                             data-toggle="modal"
                                                             data-target="#popup">
                                                            <img src="/Content/Images/1pxTrans.png" class="msp_bullGuarantee" alt="BulletInfo" />
                                                            <span>3 Year Guarantee</span>
                                                        </div>
                                                        <div class="prd-usp-item popup g-cur-p"
                                                             data-popupname="CompatibleWarranty"
                                                             data-toggle="modal"
                                                             data-target="#popup">
                                                            <img src="/Content/Images/1pxTrans.png" class="msp_bullOffer2" alt="Printer Warranty Protected" />
                                                            <span>Printer Warranty Protected</span>
                                                        </div>
                                                    }

                                                    @if (pe.AttValue6 != 0 && pe.OfferBullet != null)
                                                    {
                                                        <div class="prd-usp-item g-cur-p">
                                                            @Html.Raw(pe.OfferBullet)
                                                        </div>
                                                    }
                                                </div>

                                                @if (Model.ProductPdfs.Count > 0)
                                                {
                                                    <div class="g-m-b-20">
                                                        <div class="g-ps-r">
                                                            <div class="product-pdfs g-lh-25 clearfix">
                                                                <div class="g-d-ib g-w-35">
                                                                    <img src="/Content/Images/1pxTrans.png" class="msp_bullInfo" alt="information" />
                                                                </div>
                                                                <div class="g-d-ib">
                                                                    <span>Product Documentation</span>
                                                                </div>
                                                                <div class="hide content g-ps-a g-bc-s g-b-1-p g-p-10">
                                                                    <div>
                                                                        <div class="g-m-b-10">
                                                                            <strong>Documents</strong>
                                                                        </div>
                                                                        @{ var count = 1; }
                                                                        @foreach (var pdf in Model.ProductPdfs)
                                                                        {
                                                                            <div>
                                                                                <a href="@pdf.Url" target="_blank">@(pdf.Description ?? "Document " + count)</a>
                                                                            </div>

                                                                            count++;
                                                                        }
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }

                                                @if (pe.Type == "Stationery")
                                                {
                                                    if (pe.PageYield > 1)
                                                    {
                                                        <div class="popup g-cur-p g-p-t-20 g-m-b-20"
                                                             data-popupname="PackQuantity"
                                                             data-toggle="modal"
                                                             data-target="#popup">
                                                            <div class="g-lh-25 clearfix">
                                                                <div class="g-d-ib g-w-35">
                                                                    <img src="~/Content/Images/1pxTrans.png" class="msp_packSize" alt="Pack Quantity" />
                                                                </div>
                                                                <div class="g-d-ib">
                                                                    <span>Pack Quantity: @pe.PageYield</span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }

                                                @if (Model.Product.SpecLine6 == "Paper" || Model.Product.SpecLine6 == "Printer" || Model.Product.SpecLine6 == "Stationery"
                                                    || Model.Product.SpecLine6 == "Audio Visual")
                                                {
                                                    <div class="flix-container">
                                                        <div id="flix-minisite"></div>
                                                    </div>
                                                }

                                                <div class="row clearfix">
                                                    @if (pe.PrimarySortSeq.Equals(ProductFlag.Assembly))
                                                    {
                                                        if (pe.AssemblySaving > 0)
                                                        {
                                                            <div class="popup g-cur-p clearfix g-flex-vcenter g-p-b-20 col-xs-12"
                                                                 data-popupname="MultiPackSaving"
                                                                 data-replacements="savingamount=&pound;@pe.AssemblySaving.ToString("#,###,##0.00")"
                                                                 data-toggle="modal"
                                                                 data-target="#popup">
                                                                <img src="~/Content/Images/1pxTrans.png" class="msp_multibox" alt="Multipack Saving" />
                                                                <span class="g-m-l-5">Multipack Saving </span>
                                                                <span class="g-p-l-5">&pound;@pe.AssemblySaving.ToString("#,###,##0.00")</span>
                                                            </div>
                                                        }
                                                        foreach (ProductComponent ce in pe.ComponentList)
                                                        {
                                                            if (pe.ComponentList.Count > 20) // <-- Always use single column layout
                                                            {
                                                                <div class="popup g-cur-p col-xs-6 g-p-b-20"
                                                                     data-popupname="ColourChip"
                                                                     data-toggle="modal"
                                                                     data-target="#popup">
                                                                    <div class="g-m-l-10 g-f-l">@(ce.AttValue9 != 2 ? ce.PackQuantity.ToString() + " x" : "")</div>
                                                                    <div class="pl-chip g-fc-st g-m-lr-5 g-f-l cc-@ce.AttValue8">@ce.AttDesc8</div>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="popup g-cur-p clearfix g-flex-vcenter g-p-b-20 g-c-b col-xs-12 xx"
                                                                     data-popupname="ColourChip"
                                                                     data-toggle="modal"
                                                                     data-target="#popup">
                                                                    <div class="g-m-l-10">@(ce.AttValue9 != 2 ? ce.PackQuantity.ToString() + " x" : "")</div>
                                                                    <div class="pl-chip g-fc-st g-m-lr-5 cc-@ce.AttValue8">@ce.AttDesc8</div>
                                                                    @if (ce.PageYield > 0)
                                                                    {
                                                                        <div>@ce.PageYield.ToString("#,###,##0") Pages</div>
                                                                    }
                                                                    @if (ce.Capacity.ToSafeString() != "")
                                                                    {
                                                                        <div class="pull-left g-p-l-5 g-fc-tt">(@ce.Capacity.ToSafeString()ml)</div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    }

                                                    @if (pe.Type == "Toner" || pe.Type == "Ink" || pe.Type == "Franking" || pe.Type == "Solid Ink")
                                                    {
                                                        if (pe.PageYield > 1)
                                                        {
                                                            <div class="popup g-cur-p clearfix g-flex-vcenter g-p-b-20 col-xs-12"
                                                                 data-popupname="CostPerPage"
                                                                 data-toggle="modal"
                                                                 data-target="#popup">
                                                                <span class="fa-stack g-p-t-5 g-p-l-8">
                                                                    <i class="fa fa-file-o xfa-stack-2x" style="font-size: 1.6em"></i>
                                                                    <span class="fa-stack-1x fa-nudge-down">&pound;</span>
                                                                </span>
                                                                <span class="g-m-l-10">Cost per page @((mainPrice * 100 / pe.PageYield).ToString("#,###,##0.00"))p</span>
                                                            </div>
                                                        }
                                                        if (pe.PrimarySortSeq.Equals(ProductFlag.Ancillary))
                                                        {
                                                            if (pe.AttValue9 > 0)
                                                            {
                                                                <div class="popup g-cur-p clearfix g-flex-vcenter g-p-b-20 col-xs-12"
                                                                     data-popupname="ColourChip"
                                                                     data-toggle="modal"
                                                                     data-target="#popup">
                                                                    <div class="g-m-l-10">1 x</div>
                                                                    <div class="pl-chip g-fc-st g-m-lr-5 cc-@pe.AttValue8">
                                                                        @if (pe.AttDesc8 == "Maintenance")
                                                                        {
                                                                            <i class="fa fa-wrench"></i>
                                                                        }
                                                                    </div>
                                                                    @if (pe.PageYield > 1)
                                                                    {
                                                                        <div>@pe.PageYield.ToString("#,###,##0") Cycles</div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                        if (pe.AttValue8 > 0)
                                                        {
                                                            if (pe.PrimarySortSeq.Equals(ProductFlag.Product))
                                                            {
                                                                <div class="popup g-cur-p clearfix g-flex-vcenter g-p-b-20 col-xs-12"
                                                                     data-popupname="ColourChip"
                                                                     data-toggle="modal"
                                                                     data-target="#popup">

                                                                    @if (pe.AttValue9 != 2)
                                                                    {
                                                                        <div class="g-m-l-10">1 x</div>
                                                                    }

                                                                    <div class="pl-chip g-fc-st @(pe.AttValue9 != 2 ? "g-m-l-10" : "g-m-l-5") g-m-r-10 cc-@pe.AttValue8">@pe.AttDesc8</div>
                                                                    @if (pe.PageYield > 1)
                                                                    {
                                                                        <div>@pe.PageYield.ToString("#,###,##0") Pages</div>
                                                                    }
                                                                    @if (pe.Capacity.ToSafeString() != "")
                                                                    {
                                                                        <div class="pull-left g-p-l-5 g-fc-tt">(@pe.Capacity.ToSafeString()ml)</div>
                                                                    }
                                                                </div>
                                                            }
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="g-w-30 hidden-sm hidden-xs"></div>

                                <!-- Price Box -->
                                <div id="price-box" class="g-boxshadow g-bc-s g-p-lr-30 g-p-t-30 @(showCrossSell ? "" : "g-p-b-30") g-va-t">
                                    <div class="atb-entry g-ps-r clearfix">
                                        @{
                                            bool productHasOffer = false;
                                            if (pe.BrandFlag.Equals(BrandFlag.Compatible) && !Convert.ToBoolean(HttpContext.Current.Session["U_IsTradeCustomer"]))
                                            {
                                                if (isConsumable
                                                    && (Model.Product.CompatibleSaleIsApplicable && Model.CompatibleDiscount > 0
                                                        || (isSaving
                                                        && Convert.ToBoolean(Session["U_IsFromPPC"])
                                                        && Convert.ToBoolean(ConfigurationManager.AppSettings["PPCCOMPPromoIsOn"]))))
                                                {
                                                    productHasOffer = true;
                                                    @Html.RawFromDict(Model.ProductData, "CompatibleOverlayCss")

                                                    <div class="@offerClass offer-overlay g-fc-st g-ps-r-md">
                                                        <div class="clearfix g-p-5">
                                                            <div class="pull-left">
                                                                <strong>@(Model.IsCompatibleSaleActive ? "SALE PRICE" : "EXCLUSIVE OFFER PRICE")</strong>
                                                            </div>
                                                            <div class="pull-right">
