            <hr />
            <div class="g-p-10">
                <div class="moreLess" data-num-items="25" data-buttclass="g-butt-100p" data-scroll-offset="80">
                    @for (int i = 0; i < Model.ModelList.Count; i++)
                    {
                        ExtdSelectListItem sli = Model.ModelList[i];
                        var addatt = HtmlHelper.AnonymousObjectToHtmlAttributes(sli.Data);
                        string ctype = addatt.First(x => x.Key == "data-ctype").Value.ToString();

                        <div class="g-p-b-10 col-md-4">
                            <a class="primary" href="/model/@(sli.Text.Replace(" ", "-").Replace(".", "-" ))-@(ctype.RangeReplace())/">@sli.Text</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@section StructuredData {
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    ,
    @Html.Raw(ViewBag.ProductJson)
    @Html.Raw(ViewBag.FaqJson)
    ]
}
