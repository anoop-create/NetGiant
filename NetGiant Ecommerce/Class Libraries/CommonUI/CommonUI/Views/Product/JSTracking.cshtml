@using BusinessLogic.ViewModels;
@using CommonUI.Models;
@using System.Configuration;

@model ProductViewModel

@{
    int websiteId = int.Parse(ConfigurationManager.AppSettings["WebsiteId"].ToString());
    string facebookId = "";
    string adwordsId2 = "";
    switch (websiteId)
    {
        case 1:
            {
                facebookId = "1512021432429512";
                adwordsId2 = "1004936566";
                break;
            }
        case 2:
            {
                facebookId = "";
                adwordsId2 = "";
                break;
            }
        case 3:
            {
                facebookId = "988029194576258";
                adwordsId2 = "";               // ?? Same as TG ??
                break;
            }
    }

    <script type="text/javascript">
    // Page Specific Code

    @if (Html.Controller() == "product" && Html.Action() == "index")
    {
        // Facebook Code
       if (Convert.ToBoolean(ConfigurationManager.AppSettings["FacebookIsOn"]) && facebookId != "")
        {
            <text>
                fbq('track', 'ViewContent', {
                content_name: '@Model.Product.Description',
                content_ids: ['@Model.Product.PartNo'],
                content_type: 'product'
                });
            </text>
        }

        // Google Adwords
        if (adwordsId2 != "")
        {
            <text>
                var google_tag_params = {
		        ecomm_prodid: '@Model.Product.PartNo',
		        ecomm_pagetype: 'product'
                };

                /* <![CDATA[ */
                var google_conversion_id = @adwordsId2;
                var google_custom_params = window.google_tag_params;
                var google_remarketing_only = true;
                /* ]]> */
            </text>
        }
        }
    </script>
    @* Site audit (May 2026) item 3: this legacy Google Ads remarketing tag had no async/defer,
       making it a genuinely render-blocking third-party script on every product page (the
       site's highest-traffic template type). google_conversion_id/google_custom_params/
       google_remarketing_only are already assigned above, in the preceding <script> block,
       so by the time the parser reaches this tag those globals are already set - safe to load
       async without changing what values conversion.js reads. *@
    <script type="text/javascript" src="//www.googleadservices.com/pagead/conversion.js" async></script>
    <noscript>
        <div style="display:inline;">
            <img height="1" width="1" style="border-style:none;" alt="" src="//googleads.g.doubleclick.net/pagead/viewthroughconversion/@adwordsId2/?guid=ON&amp;script=0" inspectlet-src="/Content/Images/1pxTrans.png" />
        </div>
    </noscript>
}
