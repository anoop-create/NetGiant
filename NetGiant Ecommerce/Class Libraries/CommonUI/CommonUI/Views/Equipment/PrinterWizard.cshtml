@using System.Configuration
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework;
@using CommonUI.Models;
@using Kendo.Mvc.UI;

@model EquipmentViewModel

@{
    string ad = "WizardMarketing1";
    Dictionary<string, string> ad_dir = new Dictionary<string, string>();
    if (Model.IsCompatibleSaleActive || Model.IsOEMSaleActive)
    {
        ad_dir = Model.SaleData;
    }
    else
    {
        ad_dir = Model.EquipmentData;
    }
    ViewBag.IsSingleColumn = true;
}


@section AddTags {
    <link rel="canonical" href="@("https://" + Model.DomainNameTrunc + ViewBag.cUrl)" />
}

<section id="loadbg" class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" data-bgimg="@Html.RawFromDict(Model.EquipmentData, "FeatureBackground")">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-150-md g-fc-st">
                @if (!Model.IsMobile)
                {
                    <div class="bread-crumb hidden-xs hidden-sm">
                        @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                        {
                            <a class="second" href="/@bc.Value">@bc.Key</a>
                            <i class="fa fa-chevron-right g-fs-xs-i"></i>
                        }
                    </div>
                }
                <div class="comm-title-margin g-m-t-40">
                    <div class="pull-left">
                        <h1>
                            <span class="g-tt-c pw-manu-name">
                                @if (Model.Family != null)
                                {
                                    @Model.Family.description
                                }
                                else
                                {
                                    @(Model.Manufacturer != null ? Model.Manufacturer.manufacturerName : "")
                                }
                            </span> <span class="g-tt-c">@Model.CartridgeTypeName</span>
                        </h1>
                    </div>
                </div>
                <div class="comm-title-image g-b-1-p g-bc-s g-flex-allcenter">
                    @if (Model.Manufacturer != null)
                    {
                        <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(Model.Manufacturer.manufacturerName.Replace(' ', '-').ToLower()).jpg" alt="@Model.Manufacturer.manufacturerName" />
                    }
                    else
                    {
                        <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(Model.CartridgeTypeName.Replace(' ', '-').ToLower()).jpg" alt="@Model.CartridgeTypeName" />
                    }
                </div>
                @if (!string.IsNullOrEmpty(ad))
                {
                    <div class="pl-mktg-image1 g-cur-p g-flex-allcenter">
                        @Html.RawFromDict(ad_dir, ad, null, "hidden-xs hidden-sm")
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<div class="g-bc-p g-p-t-60 g-p-b-100">
    <div class="container body-content g-ps-r">
        <div class="row g-m-t-30">
            @{
                string priorityNote = "";
                string secondaryNote = "";
                if (Model.Manufacturer != null)
                {
                    priorityNote = Model.Manufacturer?.manufacturerNotes?.FirstOrDefault()?.priorityNote;
                    secondaryNote = Model.Manufacturer?.manufacturerNotes?.FirstOrDefault()?.secondaryNote;
                }
                else
                {
                    priorityNote = Model.WizDropDowns.PriorityNote;
                    secondaryNote = Model.WizDropDowns.SecondaryNote;
                }
            }
            @if (Model.Family == null)
            {
                <div class="col-md-12 @(string.IsNullOrEmpty(priorityNote) ? "" : "g-m-b-20")">
                    @Html.Raw(priorityNote)
                </div>
            }
        </div>
        <div class="row">
            <div class="col-md-12">
                <hr class="g-m-b-20" />
                @{
                    Html.RenderPartial("~/Views/Equipment/Wizard.cshtml", Model);
                }

                <div class="g-m-b-40">
                    @if (Model.Manufacturer == null)
                    {
                        <div id="pop-brands">
                            <hr class="g-m-t-60 g-m-b-20" />

                            <h2>Popular @Model.CartridgeTypeName.Replace(" Cartridges", "") Brands</h2>
                            <div class="g-ps-r hm-brandWizard clearfix text-center">
                                @Html.RawFromDict(Model.WizardData, @Model.CartridgeTypeName.Replace(" Cartridges", "").Replace(" ", "") + "BrandWizard")
                            </div>
                        </div>
                    }
                </div>

                <!-- Site audit (May 2026) item 23: this SEO intro text (manufacturer note /
                     cartridge-type note, both CMS-authored raw HTML - length unknown/variable)
                     used to always render in full above the product listings. Trimmed to a
                     ~90px preview with a "Read More" toggle, per the audit's recommendation,
                     so the product tiles further down aren't pushed below several paragraphs
                     of text. The toggle only appears if the content actually overflows the
                     preview height (checked via scrollHeight after render) - short content
                     just renders normally with no non-functional "Read More" link. Falls back
                     to showing full content if JS doesn't run, since the collapsed class is
                     only ever added by the script below. -->
                <style>
                    #manu-text.intro-text-collapsed {
                        max-height: 90px;
                        overflow: hidden;
                        position: relative;
                    }

                        #manu-text.intro-text-collapsed::after {
                            content: '';
                            position: absolute;
                            bottom: 0;
                            left: 0;
                            right: 0;
                            height: 36px;
                            background: linear-gradient(rgba(255,255,255,0), rgba(255,255,255,1));
                            pointer-events: none;
                        }
                </style>
                <div id="manu-text">
                    @if (Model.Manufacturer != null)
                    {
                        if (Model.Manufacturer.manufacturerNotes != null && Model.Family == null)
                        {
                            var manuNote = Model.Manufacturer.manufacturerNotes.FirstOrDefault();
                            if (manuNote != null)
                            {
                                var note = manuNote.note;

                                if (!string.IsNullOrEmpty(note))
                                {
                                    <hr class="g-m-t-60 g-m-b-20" />
                                    <h2>About our @Model.Manufacturer.manufacturerName @Model.CartridgeTypeName</h2>
                                    @Html.Raw(note)
                                }
                            }
                        }
                    }
                    else
                    {
                        <h2 class="g-tt-c">@Model.CartridgeTypeName</h2>
                        @Html.Raw(Model.WizDropDowns.CartridgeTypeNote)
                    }
                </div>
                <div class="text-center g-m-t-10" id="manu-text-toggle-wrap" style="display:none;">
                    <a href="javascript:void(0);" id="manu-text-toggle" class="second">Read More</a>
                </div>
                <script type="text/javascript">
                    (function () {
                        var el = document.getElementById('manu-text');
                        var wrap = document.getElementById('manu-text-toggle-wrap');
                        var toggle = document.getElementById('manu-text-toggle');
                        if (!el || !wrap || !toggle) { return; }
                        var collapsedHeight = 90;
                        el.classList.add('intro-text-collapsed');
                        if (el.scrollHeight > collapsedHeight + 20) {
                            wrap.style.display = 'block';
                            toggle.addEventListener('click', function () {
                                var collapsed = el.classList.toggle('intro-text-collapsed');
                                toggle.textContent = collapsed ? 'Read More' : 'Read Less';
                            });
                        } else {
                            el.classList.remove('intro-text-collapsed');
                        }
                    })();
                </script>

                <div id="printer-links">
                    @{
                        Html.RenderPartial("~/Views/Equipment/PrinterLinks.cshtml", Model.WizDropDowns, new ViewDataDictionary { { "ShowFamilyEquipment", false }, { "ShowLinks", ViewBag.ShowLinks } });
                    }
                </div>

                @if (Model.PopularRanges.Rows.Count > 0 && Model.CartridgeTypeName != "Franking Cartridges")
                {
                    <div id="pop-ranges-container">
                        <hr class="g-m-t-60 g-m-b-20" />

                        <div class="row">
                            <div class="col-md-12">
                                <h2>Popular @(Model.Manufacturer == null ? "" : Model.Manufacturer.manufacturerName) @Model.CartridgeTypeName By Range</h2>
                            </div>
                        </div>
                        <div id="pop-ranges">
                            @{
                                Html.RenderPartial("~/Views/Equipment/PopularRanges.cshtml", Model);
                            }
                        </div>
                    </div>
                }

                @if (Model.PopularCartridges.Rows.Count > 0)
                {
                    <div id="pop-cartridges-container">
                        <hr class="g-m-t-60 g-m-b-20" />

                        <div id="pop-cartridges">
                            @{
                                Html.RenderPartial("~/Views/Equipment/PopularCartridges.cshtml", Model);
                            }
                        </div>
                    </div>
                }

                @if (Model.PopularPrinters.Rows.Count > 0)
                {
                    <div id="pop-printers-container">
                        <hr class="g-m-t-60 g-m-b-20" />

                        <div class="row">
                            <div class="col-md-12">
                                <h2>Popular <span class="pw-manu-name">@(Model.Manufacturer == null ? "" : Model.Manufacturer.manufacturerName)</span> @Model.CartridgeTypeName</h2>
                            </div>
                        </div>
                        <div id="pop-printers">
                            @{                                
                                Html.RenderPartial("~/Views/Equipment/PopularPrinters.cshtml", Model);
                            }
                        </div>
                    </div>
                }
                <div id="printer-links2">
                    @if (Model.Family == null && Model.Manufacturer != null && ViewBag.ShowLinks)
                    {
                        foreach (SelectListItem family in Model.WizDropDowns.FamilyList)
                        {
                            <hr class="g-m-t-60 g-m-b-20" />

                            <div id="family@(family.Value)" class="row">
                                <div class="col-md-12">
                                    <h2>@family.Text</h2>
                                </div>
                            </div>
                            Html.RenderPartial("~/Views/Equipment/PrinterLinks.cshtml", Model.WizDropDowns, new ViewDataDictionary { { "ShowFamilyEquipment", true }, { "FamilyId", family.Value } });
                        }
                    }
                </div>

                @if (Model.Family == null)
                {
                    Html.RenderPartial("~/Views/Shared/Faq.cshtml", Model.FaqList);
                }

                @if (!string.IsNullOrEmpty(secondaryNote) && secondaryNote.Length > 5 && Model.Family == null)
                {
                    <hr class="g-m-t-60 g-m-b-20" />

                    <div id="secondaryNotes">
                        @Html.Raw(secondaryNote)
                    </div>
                }

                @{
                    Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                }
            </div>
        </div>
    </div>
</div>

@section StructuredData {
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    @Html.Raw(ViewBag.WizardFAQ)
    @Html.Raw(ViewBag.FaqJson)
    ]
}

@section AddScript
{
    @Scripts.Render("~/bundles/wizardBundle.js")
}
