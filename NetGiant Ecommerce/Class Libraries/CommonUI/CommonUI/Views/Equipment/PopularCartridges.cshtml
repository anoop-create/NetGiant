@using System.Configuration
@using BusinessLogic.ViewModels;
@using CommonUI.Models;
@using System.Data;

@model WizardViewModel

@if (Model.PopularCartridges != null)
{
    <style>
        /* Scoped to this partial's own badge rather than reusing a guessed-at "g-fc-w"/"g-p-2-6"
           utility class name that isn't confirmed to exist elsewhere in this codebase - explicit
           and self-contained is safer than a plausible-looking class that might silently do
           nothing. */
        .pop-cart-badge {
            position: absolute;
            top: 0;
            left: 0;
            z-index: 2;
            color: #fff;
            font-size: 12px;
            padding: 2px 8px;
        }

        /* Site audit (May 2026) item 21: "no Quick View option for customers to see product
           details without leaving the page". These tiles already have a fixed-height layout
           (style="height:410px;" below) with an absolutely-positioned badge in the same corner
           pattern (.pop-cart-badge above), so the button below follows that same convention -
           shown only on hover, positioned over the image area. */
        .quick-view-btn {
            display: none;
            position: absolute;
            left: 50%;
            top: 95px;
            transform: translateX(-50%);
            z-index: 3;
            background: rgba(255,255,255,0.95);
            border: 1px solid #ccc;
            border-radius: 4px;
            padding: 6px 14px;
            font-size: 12px;
            color: #333;
            cursor: pointer;
        }

        .mini-product-entry:hover .quick-view-btn {
            display: block;
        }

        .qv-content-tpl {
            display: none;
        }
    </style>
    <div class="row">
        <div class="col-md-12">
            <h2>Best Selling <span class="pw-manu-name">@(Model.Manufacturer == null ? "" : Model.Manufacturer.manufacturerName)</span> @Model.CartridgeTypeName</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="mini-product-container single-column clearfix">
                @{
                    // Site audit item 21: unique per-tile id for the hidden Quick View content
                    // template below - StockRef/PartNo can contain characters that aren't safe
                    // in a raw HTML id, so a simple counter is used instead of the data itself.
                    int qvIndex = 0;
                }
                @foreach (DataRow dr in Model.PopularCartridges.Rows)
                {
                    qvIndex++;
                    decimal mainPrice = 0;
                    decimal subPrice = 0;
                    string mainPriceVAT = "";
                    string subPriceVAT = "";
                    decimal tradePrice = Convert.ToDecimal(dr["PriceTrade"]);
                    // Site audit (May 2026) item 21: this tile only ever showed one price
                    // (ex VAT or inc VAT, whichever UseVatInclusivePrices picks) - Product/GridEntry.cshtml's
                    // equivalent tile already shows both, so mirroring that here rather than inventing a
                    // new pattern.
                    if (ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1")
                    {
                        mainPrice = Convert.ToDecimal(dr["PriceRetail"]);
                        subPrice = Decimal.Divide(Convert.ToDecimal(dr["PriceRetail"]), Model.VatMultiplier);
                        mainPriceVAT = "inc VAT";
                        subPriceVAT = "ex VAT";
                    }
                    else
                    {
                        mainPrice = Decimal.Divide(Convert.ToDecimal(dr["PriceRetail"]), Model.VatMultiplier);
                        subPrice = Convert.ToDecimal(dr["PriceRetail"]);
                        mainPriceVAT = "ex VAT";
                        subPriceVAT = "inc VAT";
                    }
                    decimal basketPrice = Convert.ToBoolean(HttpContext.Current.Session["U_IsTradeCustomer"]) ? tradePrice : mainPrice;
                    // Site audit item 21: "Compatible"/"Original" badge - dr["BrandFlag"] is the same
                    // column BusinessLogic.ViewModels.ProductViewModel.CreateProductEntry(DataRow) reads
                    // from this exact stored proc (ngmd.GetSearchResults) elsewhere, so this isn't a guess
                    // at an unconfirmed column. 1 = Original, anything else = Compatible (same mapping
                    // CreateProductEntry uses).
                    bool hasBrandFlag = dr.Table.Columns.Contains("BrandFlag");
                    bool isOriginal = hasBrandFlag && dr["BrandFlag"] != DBNull.Value && int.Parse(dr["BrandFlag"].ToString()) == 1;
                    // Site audit item 21: star rating - dr["FeeFoRating"]/dr["FeeFoCount"] are the same
                    // columns CreateProductEntry(DataRow) reads from this same proc for the product/search
                    // pages' own star-rating widget (Views/Product/ProductEntry.cshtml) - reusing that
                    // exact markup/CSS-clip technique here rather than inventing a new one. Guarded so this
                    // silently no-ops (no rating shown) rather than throwing if a given result set doesn't
                    // include these columns.
                    bool hasRating = dr.Table.Columns.Contains("FeeFoRating") && dr.Table.Columns.Contains("FeeFoCount")
                        && dr["FeeFoRating"] != DBNull.Value && dr["FeeFoCount"] != DBNull.Value;
                    decimal feefoRating = hasRating ? Convert.ToDecimal(dr["FeeFoRating"]) : 0;
                    int feefoCount = hasRating ? int.Parse(dr["FeeFoCount"].ToString()) : 0;
                    decimal feefowidth = (feefoRating * 14) + 5;
                    <div class="mini-product-entry atb-entry g-ps-r" style="height:410px;">
                        @if (hasBrandFlag)
                        {
                            <div class="pop-cart-badge g-bc-secondary">
                                @(isOriginal ? "Original" : "Compatible")
                            </div>
                        }
                        <div class="g-b-1-p g-bc-s">
                            <div class="mini-product-image">
                                <a href="@dr["ProductURL"].ToSafeString()">
                                    <img src="/Content/Images/1pxTrans.png" class="lazy" data-original="@dr["ImageURL"].ToSafeString()" alt="@dr["Description"].ToSafeString()" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                    <noscript>
                                        <img src="@dr["ImageURL"].ToString()" alt="@dr["Description"].ToSafeString()" onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';">
                                    </noscript>
                                </a>
                            </div>
                        </div>
                        <button type="button" class="quick-view-btn" data-qv-target="qv-content-@qvIndex">Quick View</button>
                        <div class="g-m-t-10 g-h-40 g-of-h">
                            <a class="primary" href="@dr["ProductURL"].ToSafeString()">
                                <strong>@dr["Description"].ToSafeString()</strong>
                            </a>
                        </div>
                        @if (hasRating)
                        {
                            <div class="clearfix g-cur-p"
                                 onclick="window.location = '@(dr["ProductURL"].ToSafeString())#reviews';"
                                 data-toggle="tooltip"
                                 data-placement="bottom"
                                 title="@feefoCount reviews, average rating: @feefoRating.ToString("0.00")">
                                <div class="pull-left g-of-h g-p-l-5 g-fs-sm" style="white-space: nowrap; width: @(feefowidth)px">
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                    <i class="fa fa-star g-fc-ff"></i>
                                </div>
                                <div class="pull-left g-p-l-5 g-fs-sm">
                                    (@feefoCount Reviews)
                                </div>
                            </div>
                        }
                        <div class="product-price-message">
                            @{
                                Html.RenderPartial("~/Views/Product/InfoMessage.cshtml", null, new ViewDataDictionary                                                            {
                                    {"Section", "MiniPrice"},
                                    {"MainPrice", mainPrice},
                                    {"TradePriceEx", tradePrice}
                                });
                            }
                        </div>
                        <div class="g-fs-n text-center">
                            &pound;@subPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@subPriceVAT</span>
                        </div>
                        <div class="g-fc-st text-center g-m-t-10 g-fs-sm g-lh-20">
                            @Html.ProductAvailability(int.Parse(dr["Availability"].ToString()), Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()), true)
                        </div>
                        <div class="g-m-t-10 g-w-100p">
                            <button class="atb-add g-butt-primary g-butt-100p"
                                    data-price="@basketPrice.ToString("N2")"
                                    data-productid="@dr["ProductReference"].ToSafeString()"
                                    data-partno="@dr["PartNo"].ToSafeString()"
                                    data-imageurl="@dr["ImageURL"].ToSafeString()"
                                    data-desc="@dr["Description"].ToSafeString()">
                                Add to Basket
                            </button>
                        </div>

                        @* Site audit item 21: hidden Quick View body for this exact tile - built
                           from the same mainPrice/subPrice/feefoRating/availability variables
                           already computed above for the visible tile, so there's no risk of the
                           popup showing different data to what's on the card itself. Populated
                           into the single shared #qv-modal (below the foreach) by the
                           .quick-view-btn click handler - no new controller action/AJAX call. *@
                        <div class="qv-content-tpl" id="qv-content-@qvIndex">
                            <div class="text-center g-m-b-10">
                                <img src="/Content/Images/1pxTrans.png" class="lazy img-responsive" data-original="@dr["ImageURL"].ToSafeString()" alt="@dr["Description"].ToSafeString()" style="max-height:220px;" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                            </div>
                            <h4>@dr["Description"].ToSafeString()</h4>
                            @if (hasBrandFlag)
                            {
                                <div class="g-m-b-10">
                                    <span class="g-bc-secondary g-fc-w g-fs-sm" style="display:inline-block; padding:2px 8px;">@(isOriginal ? "Original" : "Compatible")</span>
                                </div>
                            }
                            @if (hasRating)
                            {
                                <div class="g-m-b-10" title="@feefoCount reviews, average rating: @feefoRating.ToString("0.00")">
                                    <div class="g-of-h" style="white-space: nowrap; width: @(feefowidth)px; display:inline-block;">
                                        <i class="fa fa-star g-fc-ff"></i>
                                        <i class="fa fa-star g-fc-ff"></i>
                                        <i class="fa fa-star g-fc-ff"></i>
                                        <i class="fa fa-star g-fc-ff"></i>
                                        <i class="fa fa-star g-fc-ff"></i>
                                    </div>
                                    <span class="g-fs-sm">(@feefoCount Reviews)</span>
                                </div>
                            }
                            <div class="g-fs-n">
                                &pound;@mainPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@mainPriceVAT</span>
                                &nbsp;&middot;&nbsp;
                                &pound;@subPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@subPriceVAT</span>
                            </div>
                            <div class="g-fc-st g-fs-sm g-m-t-5 g-m-b-15">
                                @Html.ProductAvailability(int.Parse(dr["Availability"].ToString()), Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()), true)
                            </div>
                            <button class="atb-add g-butt-primary g-butt-100p"
                                    data-price="@basketPrice.ToString("N2")"
                                    data-productid="@dr["ProductReference"].ToSafeString()"
                                    data-partno="@dr["PartNo"].ToSafeString()"
                                    data-imageurl="@dr["ImageURL"].ToSafeString()"
                                    data-desc="@dr["Description"].ToSafeString()">
                                Add to Basket
                            </button>
                            <div class="text-center g-m-t-10">
                                <a href="@dr["ProductURL"].ToSafeString()" class="g-fs-sm">View Full Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* Site audit item 21: one shared Quick View modal for every tile above, populated by
       swapping in the clicked tile's own .qv-content-tpl markup - reuses the exact same modal
       markup convention as Views/Product/ImageModal.cshtml (class="modal fade custom-popup
       donotremove", the fa-times close icon with data-dismiss="modal") so it matches existing
       styling with no new CSS needed. "donotremove" protects it from launchPopup()'s
       "$('.modal, .modal-backdrop').not('.donotremove').remove();" call elsewhere on the site.
       The modal-shown lazy-load trigger already wired sitewide
       ($(document).on('shown.bs.modal', function(e){ $('.lazy', e.target).lazyload(); }); in
       site.js) picks up this modal's image automatically - no extra JS needed for that part. *@
    <div id="qv-modal" class="modal fade custom-popup donotremove" tabindex="-1" role="dialog" aria-labelledby="qvModalLabel">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="g-ps-a g-top-0 g-rt-0 g-fc-st g-m-10 g-flex-allcenter">
                    <i class="fa fa-times fa-lg g-cur-p g-fc-pt" data-dismiss="modal" aria-label="Close"></i>
                </div>
                <div class="modal-body g-p-20" id="qv-modal-body"></div>
            </div>
        </div>
    </div>

    <script>
        $(document).on('click', '.quick-view-btn', function () {
            var targetId = $(this).attr('data-qv-target');
            $('#qv-modal-body').html($('#' + targetId).html());
            $('#qv-modal').modal('show');
        });
    </script>
}