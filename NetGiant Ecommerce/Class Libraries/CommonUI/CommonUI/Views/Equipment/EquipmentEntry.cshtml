@using System.Configuration
@using BusinessLogic.ViewModels;
@using CommonUI.Models;

@model SearchViewModel

<div class="g-m-b-20 g-b-1-p pl-entry" data-att-022="#@Model.Equipment.ManufacturerId.ToString("##0")#" data-logurl="@Model.SliLoggingUrl">
    <div class="clearfix g-d-t g-bc-s prd-summ-entry">
        <div class="clearfix g-w-200 g-va-m">
            <div class="g-h-100p g-flex-allcenter g-m-t-10">
                <a href="@Model.Equipment.UrlLink">
                    <img src="/Content/Images/1pxTrans.png" class="lazy" alt="@Model.Equipment.ModelName" data-original="@Model.Equipment.ImageUrl" onerror="this.src='@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                </a>
            </div>
        </div>
        <div class="g-va-m">
            <div class="row g-h-100p">
                <div class="col-md-8">
                    <a href="@Model.Equipment.UrlLink" class="primary">
                        <div class="g-fw-b g-m-t-10 productName">@Html.HighlightKeyWords(Model.Equipment.ModelName, Model.SearchTerm, "search-highlight", true) @Model.Equipment.CartridgeType.Replace("Range", "Cartridges")</div>
                    </a>
                </div>
                <div class="col-md-4">
                    <div>
                        <a href="@Model.Equipment.UrlLink" class="btn g-butt-secondary g-butt-lg g-m-t-10 g-m-b-10 g-w-100p view-cartridge">View Cartridges<i class="fa fa-chevron-right g-m-l-10"></i></a>
                        <span class="hidden price">999999.00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


