@using BusinessLogic
@using BusinessLogic.ViewModels
@using Kendo.Mvc.UI
@using CommonUI.Models;

@model PortalViewModel

@{
    Layout = "~/Views/Shared/_Portal.cshtml";
}

<div class="g-fs-lg g-p-l-20 g-p-t-10 g-p-b-10 g-bc-s g-m-b-20 g-b-1-p">
    Back Orders
</div>

<div id="portal-grid" class="g-m-l-20 g-m-r-20">
        @(Html.Kendo().Grid<PortalViewModel.TelerikBackOrders>()
            .Name("grid")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(read => read.Action("BackOrder_Read", "Portal"))
                .Filter(f => f.Add(x => x.Status).IsEqualTo("Open"))
                .PageSize(200)
            )
            .Columns(columns =>
            {
                columns.Bound(x => x.OrderDate).Title("Order Date").HeaderHtmlAttributes(new { title = "Order Date", style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(OrderDate, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.Website).Width(70).Title("Site").HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" }).Hidden();
                columns.Bound(x => x.OrderReferenceNumber).Width(70).Title("Order Ref").HeaderHtmlAttributes(new { title = "Order Ref", style = "text-align: center;" });
                columns.Bound(x => x.SupplierOrderNumber).Width(90).Title("Supplier Ref").HeaderHtmlAttributes(new { title = "Supplier Order Ref", style = "text-align: center;" });
                columns.Bound(x => x.PurchaseOrderNumber).Width(80).Title("PO No").HeaderHtmlAttributes(new { title = "Purchase Order No", style = "text-align: center;" });
                columns.Bound(x => x.Provider).Width(90).Title("Supplier").HeaderHtmlAttributes(new { title = "Supplier", style = "text-align: center;" });
                columns.Bound(x => x.CustomerName).Width(120).Title("Name").HeaderHtmlAttributes(new { title = "Name", style = "text-align: center;" });
                columns.Bound(x => x.ItemReference).Width(80).Title("Item Ref").HeaderHtmlAttributes(new { title = "Item Ref", style = "text-align: center;" });
                columns.Bound(x => x.SupplierItemReference).Width(100).Title("Supp. Item").HeaderHtmlAttributes(new { title = "Supplier Item Ref", style = "text-align: center;" });
                columns.Bound(x => x.Description).Width(120).Title("Description").HtmlAttributes(new { title = "#:Description#" }).HeaderHtmlAttributes(new { title = "Description", style = "text-align: center;" });
                columns.Bound(x => x.QuantityOrdered).Width(60).Title("Qty").Format("{0:0.00}").HtmlAttributes(new { style = "text-align: right;" }).HeaderHtmlAttributes(new { title = "Quantity", style = "text-align: center;" });
                columns.Bound(x => x.StockReplenishmentDate).Title("Expected Date").HeaderHtmlAttributes(new { title = "Expected Date", style = "text-align: center;" }).Width(100)
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(StockReplenishmentDate, 'yyyy-MM-dd'), 'dd/MM/yyyy') #");
                columns.Bound(x => x.Status).Width(80).Title("Status").HeaderHtmlAttributes(new { title = "Status", style = "text-align: center;" });
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable
                .AllowUnsort(true))
            .Scrollable()
            .Filterable(ftb => ftb
                .Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no items to display")
            //.Events(events => events.Change("Grid_OnRowSelect"))
            //.Selectable()
            .Deferred()
        ) 
</div>
