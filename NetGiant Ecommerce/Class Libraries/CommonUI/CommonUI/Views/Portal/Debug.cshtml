@using CommonUI.Models;
@using BusinessLogic.ViewModels;

@model CommonViewModel

@{
    Layout = "~/Views/Shared/_Empty.cshtml";
}

<h1 class="text-center">@Html.RawFromDict(Model.CommonData, "SiteName") Debug Page</h1>
<div class="container-fluid">
    <div class="row">
        <ul class="nav nav-tabs g-m-t-10">
            <li class="nav active">
                <a href="#cache" data-toggle="tab">Cache</a>
            </li>
            <li class="nav">
                <a href="#session" data-toggle="tab">Session</a>
            </li>
            <li class="nav">
                <a href="#cookie" data-toggle="tab">Cookies</a>
            </li>
            <li class="nav">
                <a href="#app" data-toggle="tab">Application</a>
            </li>
            <li class="nav">
                <a href="#req" data-toggle="tab">Request</a>
            </li>
            <li class="nav">
                <a href="#tools" data-toggle="tab">Tools</a>
            </li>
            <li class="nav pull-right">
                <div class="g-fc-st g-fw-b g-p-10 g-b-1-p g-bc-tt pull-right">SERVER: @Request["LOCAL_ADDR"]</div>
                <div id="ua" class="g-fc-st g-fw-b g-p-10 g-b-1-p g-bc-neg pull-right"></div>
                @*<div id="ua1" class="g-fc-st g-fw-b g-p-10 g-b-1-p g-bc-neg pull-right"></div>*@
            </li>
        </ul>

        <!-- Tab panes -->
        <div class="tab-content g-m-b-100 g-m-t-10">
            <div class="tab-pane fade in active" id="cache">
                @{
                    Html.RenderPartial("CacheData", Model);
                }
            </div>
            <div class="tab-pane fade" id="session">
                @{
                    Html.RenderPartial("SessionData", Model);
                }
            </div>
            <div class="tab-pane fade" id="cookie">
                @{
                    Html.RenderPartial("CookieData", Model);
                }
            </div>
            <div class="tab-pane fade" id="app">
                @{
                    Html.RenderPartial("ApplicationData", Model);
                }
            </div>
            <div class="tab-pane fade" id="req">
                @{
                    Html.RenderPartial("RequestData", Model);
                }
            </div>
            <div class="tab-pane fade" id="tools">
                @{
                    Html.RenderPartial("ToolsData", Model);
                }
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">

        $(function () {
            var isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
            if (isSafari) {
                $('#ua').html('USER AGENT1: Is Safari');
            } else {
                var isIE = /MSIE|Trident/.test(navigator.userAgent);

                if (isIE) {
                    $('#ua').html('USER AGENT1: Is IE');
                } else {
                    $('#ua').html('USER AGENT1: Is Chrome / Edge');
                }
            }
            $(document).on('click',
                '#dbg-reloadcdn',
                function() {
                    $.ajax({
                        async: false,
                        cache: false,
                        type: "POST",
                        url: "/Portal/LoadCdn",
                        success: function(data) {
                            location.reload();
                        }
                    });
                });
            $(document).on('click',
                '#dbg-clearsession',
                function () {
                    $.ajax({
                        async: false,
                        cache: false,
                        type: "POST",
                        url: "/Portal/ClearSession",
                        success: function (data) {
                            location.reload();
                        }
                    });
                });
            //$(document).on('click',
            //    '#dbg-addbasketcookie',
            //    function () {
            //        $.ajax({
            //            async: false,
            //            cache: false,
            //            type: "POST",
            //            data: {
            //                basketCookie: $('#dbg-basketcookie').val()
            //            },
            //            url: "/Portal/WriteBasketCookie",
            //            success: function (data) {
            //                location.reload();
            //            }
            //        });
            //    });
        });

        function deleteLiveCacheComplete(data) {
            var x = data.responseJSON.issuccess ? 'succeeded' : 'failed';
            $.alert({
                title: 'Delete Live Cache',
                content: 'The attempt to delete the live cache ' + x
            });
        }

        function settingsComplete(data) {
            var x = data.responseJSON.saveReturn.Message;
            $.alert({
                title: 'Change Settings',
                content: x
            });
        }
    </script>
}