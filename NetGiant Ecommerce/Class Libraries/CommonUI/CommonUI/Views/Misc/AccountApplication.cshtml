@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;

@model MiscViewModel

@{
    Layout = "~/Views/Shared/_Empty.cshtml";
}

<div id="account-application" class="container-fluid g-bc-p">
    @{
        using (Ajax.BeginForm("AccountApplication",
            "Misc",
            null,
            new AjaxOptions { HttpMethod = "POST", OnBegin = "applicationBegin", OnComplete = "applicationComplete", OnFailure = "applicationError" },
            new { id = "account-application-form", autocomplete = "off" }))
        {
            @Html.AntiForgeryToken();
            Html.RenderPartial("~/Views/Misc/AccountApplicationComponents.cshtml", Model.AccountApplicationDetails, new ViewDataDictionary
            {
                TemplateInfo = new TemplateInfo()
                {
                    HtmlFieldPrefix = "AccountApplicationDetails"
                }
                //, ["ShowAddress"] = Model.AccountApplicationDetails.BillingAddress != null
            });

            <div class="row">
                <div class="pull-left">
                    @Html.GoogleCaptcha()
                </div>
                @Html.InvalidGoogleCaptchaLabel("Captcha is not valid !")
            </div>

            <div class="row g-m-t-20">
                <div id="captcha-error" class="g-p-20 g-bc-neg g-fc-st g-b-1-i g-d-ib g-d-n"></div>
            </div>

            <div class="row">
                <div id="co-submit-button" class="g-d-ib g-va-t">
                    <button type="submit" class="g-butt-primary g-butt-xl g-m-t-20">Submit Application</button>
                    <span id="submit-error" class="g-p-l-20"></span>
                </div>
                <div id="co-privacy-notice" class="g-d-ib g-d-n">
                    <p class="g-m-l-10 g-m-t-20">
                        To understand how we use your data to<br>
                        process orders view our <a href="/blog/help/policies/" target="_blank">Privacy Policy.</a>
                    </p>
                </div>
            </div>

            @Html.ValidationSummary()
        }
    }
</div>

<iframe id="iframe-height-adjust" class="g-ps-a g-top-0 g-btm-0 g-lf-0 g-h-100p g-w-0 g-b-n g-bc-transparent" data-containerid="#account-application" data-iframeid="@ViewBag.IframeId" tabindex="-1"></iframe>

@section scripts
{

    <script type="text/javascript">
        $.validator.setDefaults({ ignore: null });

        $('#account-application-form').bind("invalid-form.validate",
            function () {
                // Ensure Address is expanded
                $('#bill-manual-address').trigger('click');
            });

        function applicationBegin() {
            $('#co-submit-button > button').html('Submitting <i class="fa fa-spinner fa-spin"></i>');
            $('#co-submit-button > button').attr('disabled', true);
            $('#captcha-error').html('').addClass('g-d-n');
        }

        function applicationError(XMLHttpRequest, textStatus, errorThrown) {
            if (XMLHttpRequest.responseText.indexOf('anti-forgery') > 0) {
                $('#captcha-error').html('Anti-forgery error').removeClass('g-d-n');
                scrollToSelector('#captcha-error');
            }
        }

        function applicationComplete(data) {
            $('#co-submit-button > button').html('Submit Application');
            if (typeof $("#co-submit-button > button").attr('disabled') !== 'undefined') {
                $("#co-submit-button > button").removeAttr('disabled');
            }
            if (typeof data.responseJSON !== 'undefined') {
                if (data.responseJSON.savereturn.IsSuccess) {
                    $('#account-application').html(data.responseJSON.savereturn.Html);
                    scrollToSelector('#account-application');
                } else {
                    $('#submit-error').html(data.responseJSON.savereturn.Html);
                }
            } else {
                if ($('#captcha-error').is(':empty')) {
                    $('#captcha-error').html('Please complete the CAPTCHA').removeClass('g-d-n');
                    scrollToSelector('#captcha-error');
                }
            }
        }
    </script>
    @Scripts.Render("~/bundles/checkoutBundle.js")
}
