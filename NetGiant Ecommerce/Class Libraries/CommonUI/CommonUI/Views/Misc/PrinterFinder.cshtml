@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using CommonUI.Models;

@model MiscViewModel

@{
    ViewBag.Title = "Printer Finder";
}

@section AddTags {
    <link rel="canonical" href="https://@(Model.DomainNameTrunc + Request.Url.AbsolutePath.ToLower())/" />
}

<div class="g-bc-p">
    <section id="loadbg" class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" data-bgimg="@Html.RawFromDict(Model.CommonData, "FeatureBackground")">
        <div class="container body-content">
            <div class="row">
                <div class="col-md-12 comm-title-banner g-h-120 g-fc-st">
                    <div class="bread-crumb hidden-xs hidden-sm">
                        @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                        {
                            <a class="second" href="/@bc.Value">@bc.Key</a>
                            <i class="fa fa-chevron-right g-fs-xs-i"></i>
                        }
                    </div>

                    <div class="g-m-t-10">
                        <div class="pull-left">
                            <h1>
                                <span class="">Best 100 Printers</span>
                            </h1>
                            <div class="g-m-t-10">
                                <i class="fa fa-reply"></i>
                                <a class="second g-m-l-10 g-i" href="@Html.RawFromDict(Model.MiscData, "AllPrintersUrl")">
                                    Return to 'All Printers'
                                </a>
                            </div>
                        </div>
                        <div class="pull-right hidden-xs hidden-sm">
                            @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="container g-p-t-20 g-p-b-60">
        <div class="row g-p-t-20 g-m-b-40 body-content">
            <div class="col-md-12">
                <hr class="g-m-b-10" />
                <div class="g-fs-lg">
                    Answer the following questions to find your perfect printer...
                </div>
                <hr class="g-m-tb-10" />

                <div class="collapsable-sections">
                    <div class="collapsable-section">
                        <div class="g-flex-vcenter">
                            <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Close <i class="fa fa-chevron-up"></i></button>
                            <span class="g-fs-lg">Colour or Mono</span>
                        </div>
                        <div class="collapsable-detail">
                            <div class="row g-m-t-10">
                                <div class="col-lg-3">
                                    <img src="@ConfigurationManager.AppSettings["CDN"]/Images/pf-colour.jpg" width="280" alt="Colour or Mono"
                                         onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </div>
                                <div class="col-lg-9">
                                    <div class="g-fw-b g-m-b-10">
                                        Do you need to print in colour?
                                    </div>
                                    <div class="g-m-b-10">
                                        Sounds obvious, but do you actually need to print in colour? Because if black and white is all you really need, then one of our mono printers
                                        will do the job nicely for you. Monos are cheaper to buy and you'll save money in the long term by only buying black ink or toner cartridges
                                        instead of a full range of colours.
                                    </div>
                                    <div class="g-m-b-10 g-p-l-5">
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isColour" value="COLOUR" type="radio" name="checkboxColourOrMono">
                                            <label for="isColour">Colour</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isBlackandWhite" value="COLOUR,MONO" type="radio" name="checkboxColourOrMono">
                                            <label for="isBlackandWhite">Black &amp; White</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNoPreferenceColourOrMono" value="COLOUR,MONO" checked="checked" type="radio" name="checkboxColourOrMono">
                                            <label for="isNoPreferenceColourOrMono">No Preference</label>
                                        </div>
                                    </div>

                                    <a class="btn g-butt-primary g-butt-lg wizardNext collapsable-go-to-next" href="#" role="button">Next</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="xrow g-m-t-20 g-m-b-10" />

                    <div class="collapsable-section">
                        <div class="g-flex-vcenter">
                            <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                            <span class="g-fs-lg">Paper Size</span>
                        </div>
                        <div class="collapsable-detail g-d-n">
                            <div class="row g-m-t-10">
                                <div class="col-lg-3">
                                    <img src="@ConfigurationManager.AppSettings["CDN"]/Images/pf-paper.jpg" alt="Paper Size"
                                         onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </div>
                                <div class="col-lg-9">
                                    <div class="g-fw-b g-m-b-10">
                                        What page sizes do you want to print?
                                    </div>
                                    <div class="g-m-b-10">
                                        There are lots of different paper sizes, but the most common are definitely A4 and A3. You’ll find that most A3 printers also print A4
                                        sheets, but it doesn’t work the other way around. So it’s important to be sure you choose the right one. A3 sheets are great if you need
                                        to print out larger media such as posters, diagrams, charts etc.
                                    </div>
                                    <div class="g-m-b-10 g-p-l-5">
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isA4" value="A4,A3" type="radio" name="checkboxPaperSize">
                                            <label for="isA4">Up to A4</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isA3" value="A3" type="radio" name="checkboxPaperSize">
                                            <label for="isA3">Up to A3</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNoPreferencePaperSize" value="A4,A3" checked="checked" type="radio" name="checkboxPaperSize">
                                            <label for="isNoPreferencePaperSize">No Preference</label>
                                        </div>
                                    </div>

                                    <a class="btn g-butt-primary g-butt-lg wizardNext collapsable-go-to-next" href="#" role="button">Next</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="xrow g-m-t-20 g-m-b-10" />

                    <div class="collapsable-section">
                        <div class="g-flex-vcenter">
                            <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                            <span class="g-fs-lg">Functions</span>
                        </div>
                        <div class="collapsable-detail g-d-n">
                            <div class="row g-m-t-10">
                                <div class="col-lg-3">
                                    <img src="@ConfigurationManager.AppSettings["CDN"]/Images/pf-function.jpg" width="280" alt="Functions"
                                         onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </div>
                                <div class="col-lg-9">
                                    <div class="g-fw-b g-m-b-10">
                                        What other features does your printer need?
                                    </div>
                                    <div class="g-m-b-10">
                                        Many printers have additional functions. For example, do you need to be able to scan, photocopy or even fax? Depending on what matters
                                        to you most, we’ve got printers that can do all of these functions, a combination, and ones that just simply print. Choose the option
                                        below with the minimum function you need.
                                    </div>
                                    <div class="g-m-b-10 g-p-l-5">
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isPrint" value="SFP,3in1,4in1" type="radio" name="checkboxFunctions">
                                            <label for="isPrint">Print</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isPrintScanCopy" value="3in1,4in1" type="radio" name="checkboxFunctions">
                                            <label for="isPrintScanCopy">Print/Scan/Copy</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isPrintScanCopyFax" value="4in1" type="radio" name="checkboxFunctions">
                                            <label for="isPrintScanCopyFax">Print/Scan/Copy/Fax</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNoPreferenceFunctions" value="SFP,3in1,4in1" checked="checked" type="radio" name="checkboxFunctions">
                                            <label for="isNoPreferenceFunctions">No Preference</label>
                                        </div>
                                    </div>

                                    <a class="btn g-butt-primary g-butt-lg wizardNext collapsable-go-to-next" href="#" role="button">Next</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="xrow g-m-t-20 g-m-b-10" />

                    <div class="collapsable-section">
                        <div class="g-flex-vcenter">
                            <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                            <span class="g-fs-lg">Two-Sided Printing</span>
                        </div>
                        <div class="collapsable-detail g-d-n">
                            <div class="row g-m-t-10">
                                <div class="col-lg-3">
                                    <img src="@ConfigurationManager.AppSettings["CDN"]/Images/pf-duplex.jpg" width="280" alt="Two-Sided Printing"
                                         onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </div>
                                <div class="col-lg-9">
                                    <div class="g-fw-b g-m-b-10">
                                        Do you need to print on both sides of the page?
                                    </div>
                                    <div class="g-m-b-10">
                                        Duplex printing allows you to be able to print on both sides of a page. This helps you to save more paper, whilst being a little greener at
                                        the same time. Not all printers can do this, so make sure you consider a duplex printer if this is important to you.
                                    </div>
                                    <div class="g-m-b-10 g-p-l-5">
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isTwoSided" value="Y" type="radio" name="checkboxTwoSided">
                                            <label for="isTwoSided">Yes (Duplex)</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNotTwoSided" value="Y,N" type="radio" name="checkboxTwoSided">
                                            <label for="isNotTwoSided">No</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNoPreferenceTwoSided" value="Y,N" checked="checked" type="radio" name="checkboxTwoSided">
                                            <label for="isNoPreferenceTwoSided">No Preference</label>
                                        </div>
                                    </div>

                                    <a class="btn g-butt-primary g-butt-lg wizardNext collapsable-go-to-next" href="#" role="button">Next</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="xrow g-m-t-20 g-m-b-10" />

                    <div class="collapsable-section">
                        <div class="g-flex-vcenter">
                            <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                            <span class="g-fs-lg">Connectivity</span>
                        </div>
                        <div class="collapsable-detail g-d-n">
                            <div class="row g-m-t-10">
                                <div class="col-lg-3">
                                    <img src="@ConfigurationManager.AppSettings["CDN"]/Images/pf-connectivity.jpg" width="280" alt="Connectivity"
                                         onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noImage.jpg';" />
                                </div>
                                <div class="col-lg-9">
                                    <div class="g-fw-b g-m-b-10">
                                        How will you be connecting to the printer?
                                    </div>
                                    <div class="g-m-b-10">
                                        Most printers simply use a USB cable to connect to your computer. But if more than one person needs to use your printer, or it needs to be
                                        a bit more flexible, we also have a range of WIFI and network enabled printers too. Please select your preferred method of connecting to your printer.
                                    </div>
                                    <div class="g-m-b-10 g-p-l-5">
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isMobile" value="MOBILE" type="radio" name="checkboxConnectivity">
                                            <label for="isMobile">Mobile/Cloud</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isNetwork" value="NETWORK" type="radio" name="checkboxConnectivity">
                                            <label for="isNetwork">Network Cable</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isWifi" value="WIFI" type="radio" name="checkboxConnectivity">
                                            <label for="isWifi">Wi-Fi</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isUsbConnectivity" value="NOPREF" type="radio" checked="checked" name="checkboxConnectivity">
                                            <label for="isUsbConnectivity">USB Cable</label>
                                        </div>
                                        <div class="checkbox checkbox-success g-p-0 g-m-t-10">
                                            <input class="g-h-a" id="isnoPreferenceConnectivity" value="NOPREF" type="radio" checked="checked" name="checkboxConnectivity">
                                            <label for="isnoPreferenceConnectivity">No Preference</label>
                                        </div>
                                    </div>

                                    <a class="btn g-butt-primary g-butt-lg wizardNext showPrinters" href="#" role="button">Show Printers</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr class="xrow g-m-t-20 g-m-b-20" />
                </div>

                <section class="row">
                    <div class="col-lg-12 clearfix">
                        <div class="pull-left">
                            <button id="reset-finder" class="g-butt-second-reg g-butt-md-2 pull-left g-m-r-10" onclick="location.reload();">Reset</button>
                        </div>
                        <div class="pull-left">
                            <h2>
                                Results <span class="g-fc-s">(<span id="pl-product-count"></span>)</span>
                            </h2>
                        </div>
                        <div class="pull-right visible-lg">
                            <button class="compare g-butt-second-reg g-butt-lg-2 g-fs-sm pull-left g-m-r-10"
                                    data-toggle="modal"
                                    data-target=".custom-popup"
                                    data-url="/product/comparison/"
                                    data-container=".comparison">
                                <i class="fa fa-adjust"></i> &nbsp;Compare Products
                            </button>
                            <select class="sortResults selectpicker auto-width" data-style="g-butt-second-reg g-butt-sm-2 g-fs-sm">
                                <option value="3">Price (Low-Hi)</option>
                                <option value="4">Price (Hi-Low)</option>
                                <option value="1">Description (A-Z)</option>
                                <option value="2">Description (Z-A)</option>
                            </select>
                        </div>
                    </div>
                </section>

                <section class="row">
                    <div class="pg-products">
                        @foreach (var pe in Model.ProductViewModel.ProductList)
                        {
                            Model.ProductViewModel.Product = pe;
                            Model.ProductViewModel.Product.Attributes = new List<ProductAttribute>();

                            <div class="col-md-4 col-lg-3 pg-entry g-m-b-30">
                                @{
                                    Html.RenderPartial("~/Views/Product/GridEntry.cshtml", Model.ProductViewModel);
                                }
                            </div>
                        }
                    </div>
                </section>

                @{
                    Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                }
            </div>
        </div>
    </section>
</div>

@{
    ViewBag.StandardModalTitle = "Compare";
    Html.RenderPartial("~/Views/Shared/StandardModal.cshtml");
}

@section StructuredData {
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    ]
}

@section scripts
{
    <script type="text/javascript">
        var jsonData = $.parseJSON('@Html.Raw(Model.JsonPrinters)');
    </script>
}

@section AddScript
{
    @Scripts.Render("~/bundles/productBundle.js")
}