@using System.Configuration;
@using BusinessLogic.ViewModels;
@using System.Data;

@model WizardViewModel

<div class="row">
    @{
        int counter = 0;
        foreach (DataRow dr in Model.PopularPrinters.Rows)
        {
            if (counter == 2)
            {
                @Html.Raw("</div>")
                @Html.Raw("<div class=\"row\">")
                counter = 0;
            }
            string link = "/model/" + dr["Description"].ToString().Replace(" ", "-") + "-" + dr["CartridgeType"] + "/";
            <div class="col-sm-6">
                <div class="hm-pp-GridEntry g-p-tb-15 g-b-1-p g-flex-vcenter">
                    <div class="pull-left g-p-lr-15">
                        <a href="@link" aria-label="@dr["Description"].ToString()">
                            <img src="/Content/Images/1pxTrans.png" class="hm-pp-Image deferImage" data-original="@dr["ImageURL"].ToString()" alt="@dr["Description"].ToString()" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';">
                            <noscript>
                                <img src="@dr["ImageURL"].ToString()" class="hm-pp-Image" alt="@dr["Description"].ToString()" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';">
                            </noscript>
                        </a>
                    </div>
                    <div>
                        <a href="@link" class="primary">
                            <div class="g-of-h g-h-40 g-fw-b">
                                @(dr["Description"].ToString() + " " + dr["CartridgeTypeName"].ToString())
                            </div>
                        </a>
                        <a href="@link">
                            <div class="g-fw-b">
                                View Cartridges
                                <i class="fa fa-chevron-right g-fs-xs-i g-p-l-5"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>

            counter += 1;
        }
    }
</div>



