@using System.Configuration
@using BusinessLogic.ViewModels;
@using SharedUI.Models;

@model CommonViewModel

<div class="container body-content">
    <div class="row">
        <div class="col-md-2">
            <button id="dbg-reloadcdn" class="g-butt-primary g-butt-lg">
                Load CDN Version
            </button>
        </div>
        <div class="col-md-10">
            Current CDN: @ConfigurationManager.AppSettings["CDN"], Database Version: 
        </div>
    </div>
    <div class="row g-m-t-10">
        <div class="col-md-2">
            <button id="dbg-reloadvars" class="g-butt-primary g-butt-lg">
                Load App Variables
            </button>
        </div>
        <div class="col-md-2">
            Reload all app variables from PMS
        </div>
    </div>
    <div class="row g-m-t-10">
        <div class="col-md-2">
            <button id="dbg-clearsession" class="g-butt-primary g-butt-lg">
                Clear Session
            </button>
        </div>
        <div class="col-md-2">
            Clear all Session variables
        </div>
    </div>
</div>