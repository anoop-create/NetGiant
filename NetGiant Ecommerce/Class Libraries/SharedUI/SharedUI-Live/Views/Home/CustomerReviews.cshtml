@using BusinessLogic.ViewModels;
@using SharedUI.Models;
@using System.Data;

@model HomeViewModel

@section AddTags {
    <link rel="canonical" href="https://@(Model.DomainNameTrunc + Request.Url.PathAndQuery.ToLower())" />
}

<section data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.CommonData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-120 g-fc-st">
                <div class="bread-crumb hidden-xs hidden-sm">
                    <a class="second" href="/">Home</a>
                    <i class="fa fa-chevron-right g-fs-xs-i"></i>
                    <a class="second g-tt-c" href="/@(ViewBag.Title.ToString().ToLower())-reviews/">
                        Customer Reviews
                    </a>
                </div>

                <div class="g-m-t-a">
                    <div class="pull-left">
                        <h1><span class="">@ViewBag.Title Reviews</span></h1>
                    </div>
                    <div class="pull-right hidden-xs hidden-sm">
                        @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="comm-content g-bc-p g-p-b-60">
    <div class="container body-content g-ps-r">
        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Product</th>
                            <th>Rating</th>
                            <th>Customer Comment</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (DataRow dr in Model.FeeFo.Rows)
                        {
                            decimal feefowidth = int.Parse(dr["Rating"].ToString()) * 18;
                            <tr>
                                <td>@Convert.ToDateTime(dr["Date"]).ToShortDateString()</td>
                                <td>
                                    <a class="primary" href="/@dr["ProductURL"].ToString()">
                                        @dr["Description"].ToString()
                                    </a>
                                </td>
                                <td class="g-w-190">
                                    <div class="pull-left g-fc-ff g-of-h g-p-l-5" style="white-space: nowrap; width: @(feefowidth)px">
                                        <i class="fa fa-star"></i>
                                        <i class="fa fa-star"></i>
                                        <i class="fa fa-star"></i>
                                        <i class="fa fa-star"></i>
                                        <i class="fa fa-star"></i>
                                    </div>
                                    <div class="pull-left">(@dr["Rating"].ToString()/5)</div>
                                </td>
                                <td>
                                    <div>@dr["Comment"].ToString()</div>
                                    @if (dr["Reply"].ToString() != "")
                                    {
                                        <div class="g-m-t-10">@dr["Reply"].ToString()</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

