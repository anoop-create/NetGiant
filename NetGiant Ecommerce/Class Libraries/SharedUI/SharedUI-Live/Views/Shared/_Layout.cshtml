@using System.Configuration;
@using SharedUI.Models;
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using System.Web.Optimization

@model CommonViewModel

@{
    BasketTotals bt = new BasketTotals();

    if (Session["B_BasketTotals"] != null)
    {
        bt = (BasketTotals)Session["B_BasketTotals"];
    }

    Tuple<string, decimal> basketTotal = Utilities.SetPrice(bt.GrandTotalIncVat, bt.GrandTotalExcVat);

    string searchadd = "";
    if (ConfigurationManager.AppSettings["SearchApplication"] == "SLI")
    {
        searchadd = "data-provide=\"rac\"";
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="format-detection" content="telephone=no">
    <!--meta name="theme-color" content="#006699" /-->
    <title>@Html.RawFromDict(Model.MetaData, "Title")</title>
    <meta name="description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="msvalidate.01" content="25C06F8BDF2376F495D44F19998FAE5F">

    <meta property="og:title" content="@Html.RawFromDict(Model.MetaData, "Title")">
    <meta property="og:type" content="website">
    <meta property="og:image" content="@ConfigurationManager.AppSettings["CDN"]/images/soc-logo.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content="//@Model.DomainNameTrunc@Request.Url.PathAndQuery">
    <meta property="og:site_name" content="@Html.RawFromDict(Model.CommonData, "SiteName")">
    <meta property="og:description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="twitter:title" content="@Html.RawFromDict(Model.MetaData, "Title")">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:description" content="@Html.RawFromDict(Model.MetaData, "Description")">
    <meta name="twitter:image" content="@ConfigurationManager.AppSettings["CDN"]/images/soc-logo.jpg">
    <link rel="apple-touch-icon" href="//@Model.DomainNameTrunc/touch-icon-iphone.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="//@Model.DomainNameTrunc/touch-icon-ipad.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="//@Model.DomainNameTrunc/touch-icon-iphone-retina.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="//@Model.DomainNameTrunc/touch-icon-ipad-retina.png" />

    <link rel="manifest" href="/Content/manifest.json" />

    <link href="@Html.RawFromDict(Model.CommonData, "GooglePlusPage")" rel="publisher" />
    @Html.RawFromDict(Model.CommonData, "HtmlHeaderExtras")
    <script type="application/ld+json">
        @Html.RawFromDict(Model.CommonData, "Nap")
    </script>
    <script type="text/javascript">
        @{
            Html.RenderPartial("~/Views/Shared/JSTrackingAllHdr.cshtml", Model);
        }
    </script>

    @Styles.Render("~/Content/cssBundle.css")
    @RenderSection("AddTags", required: false)
    @Scripts.Render("~/bundles/jqueryBundle.js")

</head>

<body class="g-ps-r @(Model.IsStationerySaleActive || Model.IsOEMSaleActive || Model.IsCompatibleSaleActive ? "saleIsActive" : "")">

    @if (Model.IsFirstTime && Model.FirstTimePopup != "")
    {
        string[] firsttime = Model.FirstTimePopup.Split('~');
        <div id="firsttimepopup" class="hidden-xs hidden-sm popup"
             data-popupname="@firsttime[0]"
             data-popupwidth="md"
             data-replacements="@firsttime[2]"></div>

            <section id="firsttimemessage" class="ca-message hidden-lg hidden-md">@Html.Raw(Model.FirstTimeMessage)</section>
    }

    <section id="utility-bar" class="hdr-utility-menu g-fc-st visible-lg row-offcanvas">
        <div class="sidebar-offcanvas">
            @{
                Html.RenderPartial("~/Views/Shared/BasketSummary.cshtml");
                Html.RenderPartial("~/Views/Shared/RecentlyViewed.cshtml");
                Html.RenderPartial("~/Views/Shared/MyPrinters.cshtml", Model);
                Html.RenderPartial("~/Views/Shared/QuickReorder.cshtml", Model);
            }
        </div>
        <div class="tab-closed">
            <span class="g-fs-n"></span>
        </div>
        <div class="tab-open g-flex-allcenter" data-toggle="offcanvas-close">
            <i class="fa fa-chevron-right fa-lg"></i>
        </div>
        <div class="basketMessage g-b-1-p g-br-3 g-bc-s">
            <div class="g-bc-secondary g-fc-st g-h-30 g-p-5 g-ps-r g-br-t-3">
                Item added to basket - <span class="g-i">Click here to view</span>
                <div class="g-ps-a g-fc-s g-arrow-r" style="top: 7px; right: -14px;"></div>
            </div>
            <div id="basketItem" class="g-m-b-10"></div>
            <hr />
            <div class="text-center g-m-tb-10 g-p-lr-10">
                <a class="btn g-butt-primary g-butt-100p" href="~/checkout/" role="button">Checkout</a>
            </div>
        </div>
        <div class="printerMessage g-fs-sm g-b-1-p g-br-3 g-bc-s">
            <div class="g-bc-secondary g-fc-st g-h-30 g-p-5 g-ps-r g-br-t-3">
                My printer added - <span class="g-i">Click here to view</span>
                <div class="g-ps-a g-fc-s g-arrow-r" style="top: 9px; right: -14px;"></div>
            </div>
            <div id="printerItem" class="g-m-b-10"></div>
        </div>
    </section>

    <section class="mobileBasketMessage hidden-lg hidden-md g-d-n">
        <div class="row">
            <div id="mobileBasketItem" class="g-m-b-10 g-w-90p center-block"></div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <a class="btn g-butt-primary g-w-90p g-p-10 g-m-b-10 center-block" href="~/checkout/" role="button">View Basket</a>
                <button class="btn-continue btn g-bc-s g-w-90p g-p-10 g-m-b-10 g-b-1-p center-block">Continue Shopping</button>
            </div>
        </div>
        <div class="mobileBasketClose g-f-b g-fs-20 g-w-100p text-center g-fc-st g-cur-p">
            <span class="g-fs-n">CLOSE </span><i class="fa fa-times-circle g-va-m" aria-hidden="true"></i>
        </div>
    </section>


    @if (Model.ShowCustomerAlert && !Convert.ToBoolean(Session["SuppressCustomerAlert"] ?? false))
    {
        <section class="ca-message">
            @if (ConfigurationManager.AppSettings["AlertLevel"] == "4")
            {
                @Html.RawFromDict(Model.CommonData, "Alert4Message")
            }
            else
            {
                @Html.RawFromDict(Model.CommonData, "CustomerAlertMessage")
            }
        </section>
    }

    <section class="container" id="main-header">
        <div class="row g-m-t-10 hidden-xs hidden-sm">
            <div class="col-md-8">
                <div class="quick-links g-flex-vcenter g-lh-30">
                    @{
                        if (Authentication.IsAuthenticated())
                        {
                            <span class="g-p-r-20">
                                <a href="~/MyAccount/">
                                    <img class="msp_userDark" src="~/Content/Images/1pxTrans.png" />
                                    <span class="g-p-l-5">My Account</span>
                                </a>
                            </span>
                            <span class="logout g-p-r-20 g-cur-p">
                                <img class="msp_logOutDark" src="~/Content/Images/1pxTrans.png" />
                                <span class="g-p-l-5">Sign Out</span>
                            </span>
                        }
                        else
                        {
                            <span id="sign-in" class="g-p-r-20 g-cur-p"
                                  data-toggle="modal"
                                  data-target="#SignIn">
                                <img class="msp_logInDark" src="~/Content/Images/1pxTrans.png" />
                                <span class="g-p-l-5">Sign In</span>
                            </span>
                        }
                    }
                    <span class="g-p-r-20 open-utility g-cur-p visible-lg" data-utility="quick-order">
                        <img class="msp_quickreorderDark" src="~/Content/Images/1pxTrans.png" />
                        <span class="g-p-l-5">Quick Reorder</span>
                    </span>
                    <span class="g-p-r-20 hidden-lg">
                        <a href="/MyAccount/Index/QuickReorder/">
                            <img class="msp_quickreorderDark" src="~/Content/Images/1pxTrans.png" />
                            <span class="g-p-l-5">Quick Reorder</span>
                        </a>
                    </span>
                    <span class="g-p-r-20">
                        <a href="~/help/" target="_blank" class="g-d-ib g-p-r-20">
                            <img class="msp_helpDark" src="~/Content/Images/1pxTrans.png" />
                            <span class="g-p-l-5">Help &amp; Information</span>
                        </a>
                    </span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="hdr-right pull-right">
                    <div class="hdr-info pull-right g-flex-vcenter">
                        <div class="pull-left">
                            <i class="fa fa-phone fa-lg"></i>
                            <span class="phone g-p-r-5 g-fs-lg">
                                <strong>@Html.RawFromDict(Model.CommonData, "TelephoneNumber")</strong>
                            </span>
                        </div>
                        <div class="pull-right g-p-l-10">Mon-Thur 9 - 5:30 & Fri 10 - 5:30</div>
                    </div>
                </div>
            </div>
        </div>

        <hr class="g-m-tb-10 hidden-xs hidden-sm" />

        <div class="row g-m-b-10-md">
            <div class="col-md-8 hidden-xs hidden-sm">
                <div class="g-w-320">
                    <a href="/">
                        <img src="/Content/Images/1pxTrans.png" class="msp_siteLogo img-responsive g-m-t-10" alt="@Html.RawFromDict(Model.CommonData, "SiteName")" />
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="hdr-right pull-right">
                    <div class="hdr-basket pull-right clearfix hidden-xs hidden-sm">
                        <div class="pull-left g-p-t-10">
                            <i class="fa fa-shopping-basket g-p-r-5"></i>
                            <a class="primary" href="~/checkout/">
                                <strong>Basket (<span class="basketQuantity">@bt.Quantity</span>) - &pound;<span class="basketTotal">@((bt.GrandTotalExcVat >= bt.Delivery ? basketTotal.Item2 - bt.Delivery : basketTotal.Item2).ToString("#,###,##0.00"))</span></strong> <span class="g-fc-tt g-fs-sm">@basketTotal.Item1</span>
                            </a>
                        </div>
                        <div class="pull-right">
                            @if (HttpContext.Current.Request.RequestContext.RouteData.Values["controller"].ToString() == "Checkout")
                            {
                                <button type="button" class="checkout-button btn g-butt-primary g-butt-lg" title="Checkout">Checkout</button>
                            }
                            else
                            {
                                <a class="btn g-butt-primary g-butt-lg" href="~/checkout/" role="button">Checkout</a>
                            }
                        </div>
                    </div>
                    <div class="hdr-search g-p-t-10-md pull-right g-w-100p g-ps-r hidden-xs hidden-sm">
                        @using (Html.BeginForm("Index", "Search", FormMethod.Get))
                        {
                            <div class="input-group">
                                <input id="keyword" name="keyword" type="text" class="form-control g-fs-sm g-bc-p" autocomplete="off" placeholder="Search by Brand, Printer or Cartridge Number ..." data-token="@Model.EncryptedDate" @searchadd />
                                <input type="hidden" id="token" name="token" value="@Model.EncryptedDate" />
                                <span class="input-group-btn">
                                    <button id="apply-search" class="g-butt-secondary g-butt-sm g-fs-n" type="submit">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                        }
                        <div class="autocomplete-results g-ps-a g-w-100p g-bc-s g-b-1-p g-d-n g-m-t-5 g-p-10"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="navbar navbar-inverse">
        <div class="container">
            <div class="navbar-header">
                <button id="mobile-menu" type="button" aria-label="mobile menu" class="navbar-toggle pull-left" data-toggle="collapse" data-target=".navbar-collapse">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="/Home/">
                    <img src="/Content/Images/1pxTrans.png" class="msp_siteLogo visible-xs-inline visible-sm-inline navbar-brand g-m-t-10" alt="@Html.RawFromDict(Model.CommonData, "SiteName")" />
                </a>
                <div class="pull-right visible-xs-inline visible-sm-inline small-screen-links g-m-r-10">
                    <a href="#" class="g-m-r-20" id="opensearch-mobile" aria-label="mobile search">
                        <i class="fa fa-search fa-2x"></i>
                    </a>
                    <a href="~/checkout/">
                        <span class="basket-mobile fa-stack g-p-r-5">
                            <i class="fa fa-shopping-basket fa-stack-2x"></i>
                            <i class="basket-counter g-bc-primary g-fc-st g-fs-sm g-fw-b fa-stack-1x">@bt.Quantity</i>
                        </span>
                    </a>
                </div>
            </div>
            <div class="navbar-collapse collapse g-ps-a @(Authentication.IsAuthenticated() ? "authenticated" : "not-authenticated")">
                @Html.Raw(Model.Menu)
            </div>
        </div>
    </section>

    <section id="comm-confidence" class="container hidden-xs hidden-sm">
        <div class="row">
            <div class="col-md-12">
                @{
                    Dictionary<string, string> replacements = new Dictionary<string, string>();
                    replacements.Add("[Review-Score]", Html.RawFromDict(Model.FeeFoScore, "FiveStar").ToString());
                    replacements.Add("[Review-Count]", Html.RawFromDict(Model.FeeFoScore, "Count").ToString());
                }
                @(Html.RawFromDict(Model.CommonData, "ConfidenceBanner", replacements))
            </div>
        </div>
    </section>

    @RenderBody()

    @{
        Html.RenderPartial("~/Views/Shared/Footer.cshtml");
    }

    @if (!Authentication.IsFullyAuthenticated())
    {
        Html.RenderPartial("~/Views/MyAccount/SignIn.cshtml");
    }

    <section class="g-ps-f g-top-0 g-lf-50p text-center">
        <img src="~/Content/Images/1pxTrans.png" class="msp_goToTop g-cur-p" style="padding-left: 50%; margin-left: -20px" alt="Go to top" />
    </section>

    <section class="g-ps-f g-btm-50 hidden-xs hidden-sm">
        <div class="lhnChatButton" id="lhnChatButton1">
            <img src="~/Content/Images/1pxTrans.png" class="msp_liveChatOnline g-m-b-10" id="liveagent_button_online1" onclick="liveagent.startChat('@Html.RawFromDict(Model.CommonData, "LiveChatID")')" style="display: none; cursor: pointer;" />
            <img src="~/Content/Images/1pxTrans.png" class="" id="liveagent_button_offline1" style="display: none;" />
            @Html.Hidden("liveagent_id", Html.RawFromDict(Model.CommonData, "LiveChatID"))
        </div>
        <div id="ft_gcs"></div>
    </section>

    @Scripts.Render("~/bundles/bootstrapBundle.js")
    @Scripts.Render("~/bundles/jqueryvalBundle.js")
    @RenderSection("scripts", required: false)
    <!--script src="https://@(Html.RawFromDict(Model.CommonData, "DomainName"))data/static-files/cpy_googlereviewsbadge.js?onload=renderBadge" async defer></script-->
    <script src="https://apis.google.com/js/platform.js?onload=renderBadge" async defer></script>
    <!--script type="text/javascript" src="https://c.la2w2.salesforceliveagent.com/content/g/js/43.0/deployment.js"></script-->
    <script type="text/javascript" src="https://@(Html.RawFromDict(Model.CommonData, "DomainName"))data/static-files/cpy_sfliveagent.js"></script>
    @if (ConfigurationManager.AppSettings["SearchApplication"] == "SLI")
    {
        <!--script type="text/javascript" src="https://@(Html.RawFromDict(Model.CommonData, "DomainName"))data/static-files/cpy_sliracsearch.js" defer></script-->
        <script type="text/javascript" src="https://@(ConfigurationManager.AppSettings["SLIDomain"])/autocomplete/rac-resources-@(ConfigurationManager.AppSettings["WebsiteShortCode"])/sli-rac.config.js" defer></script>
    }
    <script type="text/javascript">
        @{
            Html.RenderPartial("~/Views/Shared/JSTrackingAll.cshtml", Model);
            Html.RenderPartial("~/Views/Shared/JSTrackingStandard.cshtml", Model);
        }
    </script>
    @{
        Html.RenderPartial("~/Views/Shared/JSGoogleAdTrackingAll.cshtml");
    }

    @RenderSection("AddScript", required: false)
    <input type="hidden" id="SearchApplication" value="@(ConfigurationManager.AppSettings["SearchApplication"] == "SLI" ? "1" : "0")" />

    <!--[if lt IE 9]> 
        <script type="text/javascript">
            alert('@ConfigurationManager.AppSettings["UnsupportedBrowser"]');
        </script>
    <![endif]-->
</body>
</html>
