        Html.RenderPartial("~/Views/Product/QandA.cshtml", Model.ProductQA);
    }

    <div class="g-m-t-60">
        @{
            Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
        }
    </div>
</div>

<!-- Right Hand Column -->
