        <hr class="g-m-tb-20"/>
        @RenderCompatiblePrinters(pe)
    </div>

    @{
        if (Model.Product.SpecLine6 == "Paper" || Model.Product.SpecLine6 == "Printer" || Model.Product.SpecLine6 == "Stationery"
            || Model.Product.SpecLine6 == "Audio Visual" || Model.Product.SpecLine6 == "")
