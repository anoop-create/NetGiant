@helper RenderBuyMore(ProductEntry pe, decimal mainPrice, decimal mainB1Price, decimal mainB2Price, decimal subB1Price, decimal subB2Price, string subPriceVAT)
{
if ((mainPrice != mainB1Price && mainPrice != mainB2Price) && (mainB1Price != 0 || mainB2Price != 0))
{
        <hr class="g-m-tb-20" />
        <div class="clearfix">
            <h2 class="pull-left">Buy More &amp; Save</h2>
        </div>
        <div class="g-bc-s g-b-1-p">
            <div class="g-p-10">
                <strong>Multibuy Discounts</strong>
            </div>
            <hr/>
            <div class="g-p-10">

                @{
                    var sBreakQty2 = (pe.BreakQty1 + 1).ToString("#0");
                    var sBreakQty3 = (pe.BreakQty2 + 1).ToString("#0") + "+";

                    if (pe.BreakQty1 + 1 < pe.BreakQty2)
                    {
                        sBreakQty2 = sBreakQty2 + "+";
                    }
                }

                <div class="row">
                    <div class="col-xs-2">@sBreakQty2</div>
                    <div class="col-xs-4">&pound;@mainB1Price.ToString("#,###,##0.00")</div>
                    <div class="col-xs-6 g-fc-tt">
                        (&pound;@subB1Price.ToString("#,###,##0.00") <span class="g-fs-sm">@subPriceVAT)</span>
                    </div>
                </div>
                <div class="row g-m-t-10">
                    <div class="col-xs-2">@sBreakQty3</div>
                    <div class="col-xs-4">&pound;@mainB2Price.ToString("#,###,##0.00")</div>
                    <div class="col-xs-6 g-fc-tt">
                        (&pound;@subB2Price.ToString("#,###,##0.00") <span class="g-fs-sm">@subPriceVAT)</span>
                    </div>
                </div>
            </div>
        </div>
    }
}

@helper RenderCompatiblePrinters(ProductEntry pe)
{
    if (pe.Type == "Toner" || pe.Type == "Ink" || pe.Type == "Franking" || pe.Type == "Solid Ink")
    {
        <div class="clearfix">
            <h2 class="pull-left">Works in these printers</h2>
        </div>
        <div class="g-bc-s g-b-1-p">
            <div class="g-p-10">
                <strong>Guaranteed to work in the following</strong>
            </div>
            <hr/>
            <div class="g-p-10">
                <div class="moreLess" data-num-items="25" data-buttclass="g-butt-100p" data-scroll-offset="80">
                    @foreach (ExtdSelectListItem sli in Model.ModelList)
                    {
                        var addatt = HtmlHelper.AnonymousObjectToHtmlAttributes(sli.Data);
                        string ctype = addatt.First(x => x.Key == "data-ctype").Value.ToString();
                        <div class="g-p-b-10">
                            <a class="primary" href="/model/@sli.Text.Replace(" ", "-")-@ctype.Replace(" ", "-")/">@sli.Text</a>
                        </div>
                    }                 
                </div>
            </div>            
        </div>
    }
}