@using BusinessLogic.ViewModels;
@using SharedUI.Models;

@model MyAccountViewModel

<section data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.CommonData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-120-sm g-fc-st">
                <div class="bread-crumb hidden-xs hidden-sm">
                    <a class="second" href="/">Home</a>
                    <i class="fa fa-chevron-right g-fs-xs-i"></i>My Account
                </div>

                <div class="g-m-t-a">
                    <div class="pull-left">
                        <h1>
                            <span class="">My Account</span>
                        </h1>
                        <div class="">
                            <i class="fa fa-reply"></i>
                            <a class="second g-fc-st" href="@Url.Action("Index", "Home")">
                                <span class="g-i">Continue Shopping</span>
                            </a>
                        </div>
                    </div>
                    <div class="pull-right hidden-xs hidden-sm">
                        @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="comm-content g-bc-p g-p-b-60">
    <div class="container body-content g-ps-r">

        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <div class="row">

                    <!-- Left Hand Column -->
                    <div class="col-md-9">
                        <hr class="g-m-b-20"/>
                        <div>
                            <h2>
                                Welcome Back, <span class="g-fc-s">@(Session["U_Name"])</span>
                            </h2>
                        </div>
                        <hr class="g-m-b-10"/>

                        <div class="collapsable-sections">
                            <div class="collapsable-section" data-url="@(Url.Action("YourDetails", "MyAccount", new {}))">
                                <div class="g-flex-vcenter">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                    <span class="g-fs-lg">Your Details</span>
                                </div>
                                <div class="collapsable-detail"></div>
                            </div>

                            <hr class="xrow g-m-t-20 g-m-b-10"/>

                            <div class="collapsable-section" data-url="@(Url.Action("BillingAddress", "MyAccount", new {}))">
                                <div class="g-flex-vcenter">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                    <span class="g-fs-lg">Billing Address</span>
                                </div>
                                <div class="collapsable-detail"></div>
                            </div>

                            <hr class="g-m-t-20 g-m-b-10"/>

                            <div class="collapsable-section clearfix" data-url="@(Url.Action("OrderHistory", "MyAccount", new {}))">
                                <div class="g-flex-vcenter">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                    <span class="g-fs-lg">Order History &amp; Invoices</span>
                                </div>
                                <div class="collapsable-detail"></div>
                            </div>

                            <hr class="g-m-t-20 g-m-b-10"/>

                            <div class="collapsable-section" data-url="@(Url.Action("QuickReorder", "MyAccount", new {}))">
                                <div class="g-flex-vcenter">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                    <span class="g-fs-lg">Quick Reorder</span>
                                </div>
                                <div class="collapsable-detail"></div>
                            </div>

                            <hr class="g-m-t-20 g-m-b-10"/>

                            <div class="collapsable-section" data-url="@(Url.Action("MyPrinters", "MyAccount", new {}))">
                                <div class="g-flex-vcenter">
                                    <button class="toggle-section btn g-butt-second-reg g-butt-md-2 g-m-r-20" role="button">Open <i class="fa fa-chevron-down"></i></button>
                                    <span class="g-fs-lg">My Printers</span>
                                </div>
                                <div class="collapsable-detail"></div>
                            </div>

                            <div class="g-m-t-60">
                                @{
                                    Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Hand Column -->
                    <div class="col-md-3 restrict-images hidden-xs hidden-sm">
                        <hr class="g-m-b-20"/>

                        @Html.RawFromDict(Model.MyAccountData, "AccountMarketing1")

                        <div class="g-m-t-20"></div>

                        @Html.RawFromDict(Model.MyAccountData, "AccountMarketing2")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(function() {
            if ('@(ViewBag.OpenSection)' != '') {
                var elem = $('[data-url="/myaccount/@(ViewBag.OpenSection)"]');
                elem.find('.toggle-section').trigger('click');
                $('html, body').animate({
                        scrollTop: $(elem).offset().top - 20
                    },
                    400);
            }
        });
    </script>
}
