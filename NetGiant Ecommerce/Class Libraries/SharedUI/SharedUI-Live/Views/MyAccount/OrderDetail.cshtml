@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using SharedUI.Models;
@using System.Configuration;
@using System.Linq;

@model MyAccountViewModel

<div class="details container-fluid g-b-b-1">
    <div class="row g-m-t-10">
        <div class="text-left col-md-6">
            <strong>Your Items <span class="g-fc-s">((@Html.Raw(Model.Order.OrderLines.Count(x => !x.IsVoucher && !x.IsDelivery)))</span></strong>
        </div>
        <div class="col-md-6">
            <div class="container-fluid">
                <div class="row">
                    <div class="text-center col-sm-3 visible-lg">
                        <strong>Price</strong>
                    </div>
                    <div class="text-center col-sm-3 visible-lg">
                        <strong>Quantity</strong>
                    </div>
                    <div class="text-center col-sm-3 visible-lg">
                        <strong>Sub-Total</strong>
                    </div>
                    <div class="text-center col-sm-3 visible-lg">
                        <i class="fa fa-info-circle"
                           data-toggle="tooltip"
                           data-placement="bottom"
                           title="Prices shown may have changed since last order.">
                        </i>
                        <strong>Reorder</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @{
        foreach (OrderLine ol in Model.Order.OrderLines)
        {
            if (!ol.IsVoucher && !ol.IsDelivery && !string.IsNullOrEmpty(ol.Description))
            {
                <div class="row g-b-b-1d g-p-tb-10">
                    <div class="col-lg-6">
                        <div class="pull-left">
                            <div class="">
                                <img class="g-b-1-p g-p-10 g-w-100" src="@ol.ImageUrl" alt="@ol.Description" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg'" />
                            </div>
                        </div>
                        <div class="pull-left g-p-l-20 g-w-190 g-w-250-sm" style="overflow-wrap: break-word">
                            <div class="g-flex-column g-h-100">
                                <div>
                                    @Html.ActionLink(ol.Description, "Index", "Product", new { productname = "", id = ol.Reference }, new { @class = "secondary" })
                                </div>
                                <div class="g-fs-sm g-m-t-10 hidden-xs">
                                    <strong>Order Code: </strong>@ol.AltRef
                                </div>
                                <div class="g-fc-st text-center g-m-t-a g-fs-sm g-lh-20">
                                    @Html.ProductAvailability(ol.Availability, Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()), true)
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="container-fluid">
                            <div class="row">
                                <div class="text-center col-sm-3 visible-lg">@ol.PriceNet.ToString("#,###,##0.00")</div>
                                <div class="text-center col-sm-3 visible-lg">@ol.Quantity.ToString("#,##0")</div>
                                <div class="text-center col-sm-3 hidden-xs">@ol.SubTotal.ToString("#,###,##0.00")</div>
                                <div class="text-center text-right-sm col-md-3 col-xs-12 atb-entry">
                                    @if (ol.IsDiscontinued)
                                    {
                                        @:Discontinued Item
                                                                }
                                    else
                                    {
                                        <button class="atb-add btn g-butt-second-reg g-butt-md-2 g-m-t-10"
                                                role="button"
                                                data-price="0"
                                                data-productid="@ol.Reference"
                                                data-partno="@ol.AltRef"
                                                data-imageurl="@ConfigurationManager.AppSettings["CDN"]/@ol.ImageUrl"
                                                data-desc="@ol.Description">
                                            Reorder
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    <div class="row">
        <div class="col-lg-4 g-m-tb-10">
            <div class="g-b-1-p">
                <div class="g-b-b-1 g-p-10">
                    <strong>Billing Address</strong>
                </div>
                <div class="g-p-10 g-h-150">
                    <div>@Model.Order.BillingAddress.Line1</div>
                    <div>@Model.Order.BillingAddress.Line2</div>
                    <div>@Model.Order.BillingAddress.Line3</div>
                    <div>@Model.Order.BillingAddress.Line4</div>
                    <div>@Model.Order.BillingAddress.Line5</div>
                    <div>@Model.Order.BillingAddress.PostCode</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 g-m-tb-10">
            <div class="g-b-1-p">
                <div class="g-b-b-1 g-p-10">
                    <strong>Delivery Address</strong>
                </div>
                <div class="g-p-10 g-h-150">
                    <div>@Model.Order.DeliveryAddress.Line1</div>
                    <div>@Model.Order.DeliveryAddress.Line2</div>
                    <div>@Model.Order.DeliveryAddress.Line3</div>
                    <div>@Model.Order.DeliveryAddress.Line4</div>
                    <div>@Model.Order.DeliveryAddress.Line5</div>
                    <div>@Model.Order.DeliveryAddress.PostCode</div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 g-m-tb-10">
            <div class="clearfix">
                <div class="pull-left">
                    <strong>Delivery</strong>
                </div>
                <div class="pull-right">&pound;@Model.Order.TotalDel.ToString("#,###,##0.00")</div>
            </div>
            @if (Model.Order.TotalVoucher != 0)
            {
                <div class="clearfix g-m-t-10">
                    <div class="pull-left">
                        <strong>Voucher</strong>
                    </div>
                    <div class="pull-right">&pound;@Model.Order.TotalVoucher.ToString("#,###,##0.00")</div>
                </div>
            }
            <div class="clearfix g-m-t-10">
                <div class="pull-left">
                    <strong>Sub-Total</strong>
                </div>
                <div class="pull-right">&pound;@Model.Order.AccTotal.ToString("#,###,##0.00")</div>
            </div>
            <div class="clearfix g-m-t-10">
                <div class="pull-left">
                    <strong>VAT</strong>
                </div>
                <div class="pull-right">&pound;@Model.Order.TotalVat.ToString("#,###,##0.00")</div>
            </div>
            <hr class="g-m-t-10" />
            <div class="clearfix g-m-t-15">
                <div class="pull-left g-lh-35">
                    <strong>Grand Total</strong>
                </div>
                <div class="pull-right g-fs-lg">
                    <strong>&pound;@Model.Order.Total.ToString("#,###,##0.00")</strong>
                </div>
            </div>
            <div class="g-m-t-15">
                @if (Model.Order.InvoiceExists)
                {
                    <a class="btn g-butt-primary g-butt-100p" href="//@ConfigurationManager.AppSettings["CDN"]/media/archive/INV@(Model.Order.OrderNumber)A.pdf" target="_blank" download>Download Invoice</a>
                }
                else
                {
                    <span>There is no invoice for this order.</span>
                }
            </div>
        </div>
    </div>
</div>