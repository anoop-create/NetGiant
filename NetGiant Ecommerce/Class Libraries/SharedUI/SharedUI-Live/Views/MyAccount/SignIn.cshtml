@using BusinessLogic.ViewModels;
@model CommonViewModel

<section class="modal fade donotremove" id="SignIn" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-md" role="document">
        <div class="modal-content">
            <section id="signin-modal">
                <div class="row">
                    <div class="col-md-4 col-sm-4 hidden-xs">
                        <div class="modal-sidebar g-bc-primary">
                            <section class="signin-sidebar g-fc-st">
                                <div class="g-fs-lg g-ta-c">New Here?</div>
                                <div class="g-fs-sm g-m-t-10 g-ta-c">
                                    Sign up today for access to all website benefits.
                                </div>
                                <input type="button" value="SIGN UP" class="signup-sidebar-btn g-butt-second-inv form-control g-m-t-20-i" />
                            </section>

                            <section class="signup-sidebar g-fc-st g-d-n">
                                <div class="g-fs-lg g-ta-c">Returning?</div>
                                <div class="g-fs-sm g-m-t-10 g-ta-c">
                                    If you already have an account, sign in here.
                                </div>
                                <input type="button" value="SIGN IN" class="signin-sidebar-btn g-butt-second-inv form-control g-m-t-20-i" />
                            </section>
                        </div>
                    </div>
                    <div class="col-md-8 col-sm-8 col-xs-12">
                        <div class="g-bc-p">
                            <div class="modal-close g-ps-a g-fs-lg g-cur-p" data-toggle="modal" data-target="#SignIn">
                                <i class="fa fa-times"></i>
                            </div>

                            <section class="signin">
                                @using (Ajax.BeginForm("SignIn", "MyAccount", null, new AjaxOptions { HttpMethod = "POST", OnBegin = "disableSubmit", OnComplete = "signinComplete", OnFailure = "logAjaxFormError" }, new { @id = "signin-form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(m => m.RedirectUrl)
                                    <div>
                                        <div class="g-fs-lg">Welcome back,</div>
                                        <div class="g-m-t-40">
                                            <div class="g-m-t-20-i">
                                                <div class="g-fs-n">EMAIL ADDRESS</div>
                                                @Html.TextBoxFor(m => m.SignIn.UserName, new { @class = "form-control", @placeholder = "Email Address", @type = "email", @id = "signin-email" })
                                            </div>
                                            <div class="g-m-t-20-i">
                                                <div class="g-fs-n">PASSWORD</div>
                                                @Html.PasswordFor(m => m.SignIn.Password, new { @class = "form-control", @placeholder = "Password", @required = "required", @id = "signin-password" })
                                            </div>
                                            <div class="g-m-t-20-i">
                                                <div class="signin-forgot-password g-cur-p g-fc-s g-u">Reset Password</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="error-message g-d-n">
                                        <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                        <p class="g-m-0 g-d-i g-p-r-10"></p>
                                    </div>
                                    <div class="g-ps-a signin-btn">
                                        <input id="btn-signin" type="submit" value="SIGN IN" class="g-butt-primary" />
                                    </div>
                                }
                            </section>

                            <section class="signup g-d-n">
                                @using (Ajax.BeginForm("SignUp", "MyAccount", null, new AjaxOptions { HttpMethod = "POST", OnBegin = "disableSubmit", OnComplete = "signupComplete", OnFailure = "logAjaxFormError" }, new { @id = "signup-form", autocomplete = "off" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <div class="signup-initial">
                                        <div>
                                            <div class="g-fs-lg">Sign up today.</div>
                                            <div class="g-m-t-40">
                                                <div class="g-m-t-20-i">
                                                    <div class="g-fs-n">EMAIL ADDRESS*</div>
                                                    @Html.TextBoxFor(m => m.SignUp.UserName, new { @class = "form-control", @placeholder = "Email Address", @type = "email", @id = "signup-email" })
                                                </div>
                                                <div class="g-m-t-20-i">
                                                    <div class="g-fs-n">SET A PASSWORD*</div>
                                                    @Html.PasswordFor(m => m.SignUp.Password, new { @class = "form-control", @placeholder = "Password", @id = "signup-password" })
                                                </div>
                                                <div class="g-m-t-40">
                                                    <div class="checkbox checkbox-success">
                                                        @Html.CheckBoxFor(m => m.SignUp.Newsletter)
                                                        <label>Receive our exclusive discounts and news.</label>
                                                    </div>
                                                    @Html.Raw(Model.CommonData["SignUpNewsletterNotice"])
                                                </div>
                                            </div>
                                        </div>

                                        <div class="g-ps-a signin-btn">
                                            <div class="g-ta-c">
                                                @Html.Raw(Model.CommonData["SignUpPrivacyNotice"])
                                            </div>
                                            <div class="error-message g-d-n g-m-b-10">
                                                <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                                <p class="g-m-0 g-d-i g-p-r-10"></p>
                                            </div>
                                            <input id="btn-signup-initial" type="button" value="CONTINUE" class="g-butt-primary" />
                                        </div>
                                    </div>

                                    <div class="signup-details g-d-n">

                                        <div class="details-back g-d-n g-ps-a g-fc-p g-fs-sm g-cur-p">
                                            <strong class="g-fs-n">&lsaquo;</strong> Back
                                        </div>

                                        <div>
                                            <div class="g-fs-lg">Sign up today.</div>
                                            <div class="g-m-t-40">
                                                <div class="g-m-t-20-i">
                                                    <div class="g-fs-n">TITLE</div>
                                                    <div class="row">
                                                        <div class="col-md-3">
                                                            @Html.DropDownListFor(m => m.SignUp.Name.Title, Model.TitleList, new { @class = "selectpicker", @id = "signup-title" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="g-m-t-20-i">
                                                    <div class="row">
                                                        <div class="col-md-6 g-p-r-15-i">
                                                            <div class="g-fs-n">FIRST NAME*</div>
                                                            @Html.TextBoxFor(m => m.SignUp.Name.Firstname, new { @class = "form-control", @placeholder = "First Name", @id = "signup-firstname" })
                                                        </div>
                                                        <div class="col-md-6 g-p-l-15-i">
                                                            <div class="g-fs-n">LAST NAME*</div>
                                                            @Html.TextBoxFor(m => m.SignUp.Name.Surname, new { @class = "form-control", @placeholder = "Last Name", @id = "signup-surname" })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="g-m-t-20-i">
                                                    <div class="g-fs-n">CONTACT NUMBER*</div>
                                                    @Html.TextBoxFor(m => m.SignUp.TelNumber, new { @class = "form-control", @placeholder = "Contact Number", @id = "signup-telno" })
                                                </div>
                                            </div>
                                        </div>
                                        <div class="error-message g-d-n">
                                            <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                            <p class="g-m-0 g-d-i g-p-r-10"></p>
                                        </div>
                                        <div class="g-ps-a signin-btn">
                                            <input id="btn-signup-details" type="button" value="CONTINUE" class="g-butt-primary" />
                                        </div>
                                    </div>

                                    <div class="signup-address g-d-n">

                                        <div class="address-back g-d-n g-ps-a g-fc-p g-fs-sm g-cur-p">
                                            <strong class="g-fs-n">&lsaquo;</strong> Back
                                        </div>

                                        <div class="address-auto">
                                            <div>
                                                <div class="g-fs-lg">Sign up today.</div>
                                                <div class="g-m-t-40">
                                                    <div class="g-m-t-20-i">
                                                        <div class="g-fs-n">FIND BILLING ADDRESS</div>
                                                        @Html.TextBoxFor(m => m.SignUp.AddressLookup, new { @class = "form-control", @placeholder = "Start typing your postcode, building or street...", @autocomplete = "false" })
                                                    </div>
                                                    <div class="g-m-t-20-i">
                                                        <div class="g-fs-n">OR</div>
                                                    </div>
                                                    <div class="g-m-t-20-i">
                                                        <div id="signup3" class="enter-address g-cur-p g-fc-s g-u">Enter Address Manually</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="error-message g-d-n">
                                                <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                                <p class="g-m-0 g-d-i g-p-r-10"></p>
                                            </div>
                                        </div>

                                        <div class="address-manual g-d-n">
                                            <div>
                                                <div class="g-fs-lg">Sign up today.</div>
                                                <div class="g-m-t-40">
                                                    <div class="g-m-t-18-i">
                                                        <div class="g-fs-n">COMPANY NAME (Optional)</div>
                                                        @Html.TextBoxFor(m => m.SignUp.Address.Line1, new { @class = "form-control", @placeholder = "Company Name", @autocomplete = "off" })
                                                    </div>
                                                    <div class="g-m-t-18-i">
                                                        <div class="g-fs-n">ADDRESS LINE 1*</div>
                                                        @Html.TextBoxFor(m => m.SignUp.Address.Line2, new { @class = "form-control", @placeholder = "Address Line 1" })
                                                    </div>
                                                    <div class="g-m-t-18-i">
                                                        <div class="row">
                                                            <div class="col-md-6 g-p-r-15-i">
                                                                <div class="g-fs-n">ADDRESS LINE 2</div>
                                                                @Html.TextBoxFor(m => m.SignUp.Address.Line3, new { @class = "form-control", @placeholder = "Address Line 2" })
                                                            </div>
                                                            <div class="col-md-6 g-p-l-15-i">
                                                                <div class="g-fs-n">TOWN OR CITY*</div>
                                                                @Html.TextBoxFor(m => m.SignUp.Address.Line4, new { @class = "form-control", @placeholder = "Town or City" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="g-m-t-18-i">
                                                        <div class="row">
                                                            <div class="col-md-6 g-p-r-15-i">
                                                                <div class="g-fs-n">COUNTY</div>
                                                                @Html.TextBoxFor(m => m.SignUp.Address.Line5, new { @class = "form-control", @placeholder = "County" })
                                                            </div>
                                                            <div class="col-md-6 g-p-l-15-i">
                                                                <div class="g-fs-n">POSTCODE*</div>
                                                                @Html.TextBoxFor(m => m.SignUp.Address.PostCode, new { @class = "form-control", @placeholder = "Postcode" })
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="error-message g-d-n">
                                                <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                                <p class="g-m-0 g-d-i g-p-r-10"></p>
                                            </div>
                                            <div class="g-ps-a signin-btn">
                                                <input id="btn-signup-address-manual" type="submit" value="SIGN UP" class="g-butt-primary" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </section>
                            <section class="signin-reset-password g-d-n"></section>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
</section>