@using System.Configuration;

@{
    int websiteId = int.Parse(ConfigurationManager.AppSettings["WebsiteId"].ToString());
    string adwordsId1 = "";
    string adwordsId2 = "";
    string adwordsId3 = "";
    string adwordsId4 = "";

    switch (websiteId)
    {
        case 1:
            {
                adwordsId1 = "1062996651";      // Tonergiant
                adwordsId2 = "1004936566";      // Tonergiant - Shopping
                adwordsId3 = "929223363";       // Tonergiant - IBC
                break;
            }
        case 2:
            {
                adwordsId1 = "1054433765";      // CartridgeMonkey
                adwordsId2 = "1007814028";      // CartridgeMonkey - Shopping
                break;
            }
        case 3:
            {
                adwordsId1 = "1003559772";      // Netgiant - Branded
                adwordsId2 = "1011141398";      // Netgiant - Unbranded
                adwordsId3 = "963271532";       // Netgiant - Shopping
                adwordsId4 = "1004178977";      // Netgiant - IBC
                break;
            }
    }

    // Google Ads Tracking
    <text>
        <!-- Adwords gtag function -->
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
        </script>
    </text>

    if (adwordsId1 != "")
    {
        @WriteGoogleTag(adwordsId1)
    }
    if (adwordsId2 != "")
    {
        @WriteGoogleTag(adwordsId2)
    }
    if (adwordsId3 != "")
    {
        @WriteGoogleTag(adwordsId3)
    }
    if (adwordsId4 != "")
    {
        @WriteGoogleTag(adwordsId4)
    }

    // Kenshoo Tracking
    @*@WriteKenshooTag()*@

}

@helper WriteGoogleTag(string Id)
{
    <text>
        <!-- Adwords Global site tag @Id -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=AW-@Id"></script>
        <script>
            gtag('js', new Date());
            gtag('config', 'AW-@Id');
        </script>
    </text>
}

@*@helper WriteKenshooTag()
{
    <text>
        <script>
            !function (a, b, c, d, e, f, g) { a.ktag || (e = function () { e.sendEvent ? e.sendEvent(arguments) : e.ktq.push(arguments) }, e.ktq = [], a.ktag = e, f = b.getElementsByTagName(d)[0], g = b.createElement(d), g.async = !0, g.src = c, f.parentNode.appendChild(g)) }(window, document, "//resources.xg4ken.com/js/v2/ktag.js?tid=KT-N2725-3F3", "script");

            ktag('setup', 'KT-N2725-3F3', '<USER_ID>');
        </script>
        <noscript>
            <img src="https://events.xg4ken.com/pixel/v2?tid=KT-N2725-3F3&noscript=1" width="1" height="1" style="display:none" />
        </noscript>
    </text>
}*@