@using BusinessLogic.ViewModels;
@using SharedUI.Models;
@using System.Configuration;
@using System.Data;

@model MyAccountViewModel

@{
    DataTable dt = new DataTable();
    if (Session["U_RecentlyOrdered"] != null)
    {
        dt = (DataTable)Session["U_RecentlyOrdered"];
    }

    bool isOrders = false;
    if (dt != null)
    {
        if (dt.Rows.Count > 0)
        {
            isOrders = true;
        }
    }

    if (isOrders)
    {
        <div class="row g-m-t-20">
            <div class="col-md-12">
                <div class="mini-product-container clearfix">
                    @foreach (DataRow dr in dt.Rows)
                    {
                        decimal mainPrice = 0;
                        string mainPriceVAT = "";
                        if (ConfigurationManager.AppSettings["UseVatInclusivePrices"] == "1")
                        {
                            mainPrice = Convert.ToDecimal(dr["PriceRetail"]);
                            mainPriceVAT = "inc VAT";
                        }
                        else
                        {
                            mainPrice = Decimal.Divide(Convert.ToDecimal(dr["PriceRetail"]), Model.VatMultiplier);
                            mainPriceVAT = "ex VAT";
                        }
                        <div class="mini-product-entry g-ps-r atb-entry">
                            <a href="@dr["ProductURL"].ToSafeString()">
                                <div class="g-bc-s g-b-1-p g-h-140 text-center">
                                    <img src="@dr["ImageURL"].ToSafeString()" alt="@dr["Description"].ToSafeString()" onerror="this.src = '@ConfigurationManager.AppSettings["CDN"]/Images/noimage.jpg';" />
                                </div>
                            </a>
                            <div class="g-m-t-10 g-h-40 g-of-h">
                                <a class="primary" href="@dr["ProductURL"].ToSafeString()">
                                    <strong>@dr["Description"].ToSafeString()</strong>
                                </a>
                            </div>
                            <div class="g-m-t-10 g-fs-lg g-h-35 g-of-h">
                                &pound;@mainPrice.ToString("#,###,##0.00") <span class="g-fc-tt g-fs-sm">@mainPriceVAT</span>
                            </div>
                            <div class="g-fc-st text-center g-m-t-10 g-fs-sm g-lh-20">
                                @Html.ProductAvailability(int.Parse(dr["Availability"].ToString()), Convert.ToBoolean(Model.CommonData["DeliveryDateIsOverridden"].ToString()), true)
                            </div>
                            <div class="pull-right g-m-t-10 g-w-100p">
                                <button class="atb-add g-butt-primary g-butt-100p"
                                        data-price="@mainPrice.ToString("N2")"
                                        data-productid="@dr["ProductReference"].ToSafeString()"
                                        data-partno="@dr["PartNo"].ToSafeString()"
                                        data-imageurl="@dr["ImageURL"].ToSafeString()"
                                        data-desc="@dr["Description"].ToSafeString()">
                                    Add to Basket
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="g-m-t-20">You have no products in your order history.</div>
        <div class="g-m-t-20">After placing an order the items you purchased will be displayed here so you can quickly reorder them again.</div>
    }
}
