@using BusinessLogic.ViewModels;
@using SharedUI.Models;

@model MyAccountViewModel

<section data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.CommonData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-150 g-fc-st">
                <div class="bread-crumb hidden-xs hidden-sm">
                    <a class="second" href="/">Home</a>
                    <i class="fa fa-chevron-right g-fs-xs-i"></i>My Account
                </div>

                <div class="g-m-t-a">
                    <div class="pull-left">
                        <h1><span class="">My Account</span></h1>
                        <div class="">
                            <a class="second" href="/">
                                <i class="fa fa-reply"></i>
                                <span class="g-i">Continue Shopping</span>
                            </a>
                        </div>
                    </div>
                    <div class="pull-right hidden-xs hidden-sm">
                        @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="comm-main g-bc-p g-p-b-60">
    <div class="container body-content g-ps-r">

        <div class="row g-m-t-20 g-m-b-40">
            <div class="col-md-12">
                <div class="row">

                    <!-- Left Hand Column -->
                    <div class="col-md-9">
                        @if (Model.ResetPassword.Sr == null)
                        {
                            if (Model.ResetPassword.OKToReset)
                            {
                                using (Html.BeginForm("ResetPassword", "MyAccount", FormMethod.Post, new { id = "reset-password"} ))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.HiddenFor(x => x.ResetGuid)

                                    <div class="clearfix g-m-t-5">
                                        <div class="g-inp-md">NEW PASSWORD*</div>
                                    </div>
                                    <div class="clearfix g-m-t-3">
                                        <div class="g-inp-md clearfix">
                                            @Html.PasswordFor(x => x.ResetPassword.NewPassword, new { placeholder = "New Password", @class = "g-b-1-p" })
                                        </div>
                                    </div>
                                    <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

                                    <div class="clearfix g-m-t-5">
                                        <div class="g-inp-md">CONFIRM PASSWORD*</div>
                                    </div>
                                    <div class="clearfix g-m-t-3">
                                        <div class="g-inp-md clearfix">
                                            @Html.PasswordFor(x => x.ResetPassword.ConfirmPassword, new { placeholder = "Confirm Password", @class = "g-b-1-p" })
                                        </div>
                                    </div>
                                    <div class="clearfix g-fc-nm g-m-t-10 g-i g-h-20 g-of-h"></div>

                                    <div class="">
                                        <button type="submit" class="g-butt-primary g-butt-xl g-m-t-20">Reset Password</button>
                                    </div>

                                    @Html.ValidationSummary()
                                }
                            }
                            else
                            {
                                <div class="error-message">
                                    <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                    <p class="g-m-0 g-d-i g-p-r-10">Invalid Token.</p>
                                </div>
                            }
                        }
                        else
                        {
                            if (Model.ResetPassword.Sr.IsSuccess)
                            {
                                <div class="g-m-t-20 clearfix">
                                    <i class="fa fa-exclamation-triangle fa-lg"></i>
                                    <span class="g-p-l-10">Your password has been successfully reset.</span>
                                </div>
                            }
                            else
                            {
                                <div class="error-message">
                                    <i class="fa fa-exclamation-triangle g-fs-20 g-p-r-10"></i>
                                    <p class="g-m-0 g-d-i">
                                        We encountered a problem resetting your password. Please try later or alternatively contact Customer Services on <strong>@Html.RawFromDict(Model.CommonData, "TelephoneNumber")</strong>
                                    </p>
                                </div>
                            }
                        }

                    </div>

                    <!-- Right Hand Column -->
                    <div class="col-md-3">

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

