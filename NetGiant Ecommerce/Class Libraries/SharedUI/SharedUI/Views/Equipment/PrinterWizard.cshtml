@using System.Configuration
@using BusinessLogic.ViewModels;
@using DataAccess.EntityFramework
@using SharedUI.Models;

@model EquipmentViewModel

@section AddTags {

   @{ 
       var manufacturer = Model.Manufacturer != null ? "/"  + Model.Manufacturer.manufacturerName.Replace(" ", "-") : "";
       manufacturer = Model.Family != null && !String.IsNullOrEmpty(manufacturer) ? manufacturer + "/" + Model.Family.description.Replace(" ", "-") : manufacturer;
   }

    <link rel="canonical" href="https://@(Model.DomainNameTrunc + "/" + Request.Url.Segments[1].Trim('/').ToLower() + manufacturer)/" />
}

<section data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.EquipmentData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            <div class="col-md-12 comm-title-banner g-h-150-md g-fc-st">
                <div class="bread-crumb hidden-xs hidden-sm">
                    @foreach (KeyValuePair<string, string> bc in Model.BreadcrumbTrail)
                    {
                        <a class="second" href="@bc.Value">@bc.Key</a>
                            <i class="fa fa-chevron-right g-fs-xs-i"></i>
                    }
                    @if (Model.Manufacturer != null)
                    {
                        @Model.Manufacturer.manufacturerName
                    }
                </div>
                <div class="comm-title-margin g-m-t-a">
                    <div class="pull-left">
                        <h1>
                            <span class="g-tt-c pw-manu-name">
                                @if (Model.Family != null)
                                {
                                    @Model.Family.description
                                }
                                else
                                {
                                    @(Model.Manufacturer != null ? Model.Manufacturer.manufacturerName : "")
                                }
                            </span> <span class="g-tt-c">@Model.CartridgeTypeName</span>
                        </h1>
                        @if (Model.Manufacturer != null)
                        {
                            if (Model.HasAlternateType)
                            {
                                <div class="g-i">
                                    <a id="pw-altcart-link" class="second g-fc-st" href="/@(Model.CartridgeTypeName.ToLower() == "toner cartridges" ? "ink-cartridges" : "toner-cartridges")/@Model.Manufacturer.manufacturerName/">
                                        Looking for <span class="g-tt-c pw-manu-name">@Model.Manufacturer.manufacturerName</span> @(Model.CartridgeTypeName.ToLower() == "toner cartridges" ? "Ink" : "Toner")?
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="g-i">
                                <a id="pw-altcart-link" class="second g-fc-st" href="/@(Model.CartridgeTypeName.ToLower() == "toner cartridges" ? "ink-cartridges" : "toner-cartridges")/">
                                    Looking for <span class="g-tt-c pw-manu-name"></span> @(Model.CartridgeTypeName.ToLower() == "toner cartridges" ? "Ink" : "Toner")?
                                </a>
                            </div>
                        }
                    </div>
                    <div class="pull-right hidden-xs hidden-sm">
                        @Html.ShowSaleInfoButton(Model.IsCompatibleSaleActive, Model.IsOEMSaleActive, Model.IsStationerySaleActive)
                    </div>
                </div>
                <div class="comm-title-image g-b-1-p g-bc-s g-flex-allcenter">
                    @if (Model.Manufacturer != null)
                    {
                        <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(Model.Manufacturer.manufacturerName.Replace(' ', '-').ToLower()).jpg" alt="@Model.Manufacturer.manufacturerName"/>
                    }
                    else
                    {
                        <img src="@ConfigurationManager.AppSettings["CDN"]/Images/BannerLogos/@(Model.CartridgeTypeName.Replace(' ', '-').ToLower()).jpg" alt="@Model.CartridgeTypeName"/>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="g-bc-p g-p-t-60 g-p-b-100">
    <div class="container body-content g-ps-r">

        <div class="row">
            <div class="col-md-9">
                <hr class="g-m-b-20"/>
                @{
                    Html.RenderPartial("~/Views/Equipment/Wizard.cshtml", Model);
                }
                
                <div class="g-m-b-40">
                    <div id="pop-brands" class="@(Model.Manufacturer != null ? "g-d-n" : "")">
                        <hr class="g-m-t-60 g-m-b-20" />

                        <h2>Popular @Model.CartridgeTypeName.Replace(" Cartridges", "") Brands</h2>
                        <div class="g-ps-r hm-brandWizard clearfix text-center">
                            @Html.RawFromDict(Model.WizardData, @Model.CartridgeTypeName.Replace(" Cartridges", "").Replace(" ", "") + "BrandWizard")
                        </div>
                    </div>
                </div>

                <div id="manu-text">
                    @if (Model.Manufacturer != null)
                    {
                        if (Model.Manufacturer.manufacturerNotes != null && Model.Family == null)
                        {
                            var manuNote = Model.Manufacturer.manufacturerNotes.FirstOrDefault();
                            if (manuNote != null)
                            {
                                var note = manuNote.note;

                                if (!string.IsNullOrEmpty(note))
                                {
                                    <hr class="g-m-t-60 g-m-b-20" />
                                    <h2>About our @Model.Manufacturer.manufacturerName @Model.CartridgeTypeName</h2>
                                    @Html.Raw(note)   
                                }
                            }
                        }
                    }
                    else
                    {
                        <h2 class="g-tt-c">@Model.CartridgeTypeName</h2>
                        @Html.Raw(Model.WizDropDowns.CartridgeTypeNote)
                    }
                </div>

                <div id="printer-links">
                    @{
                        Html.RenderPartial("~/Views/Equipment/PrinterLinks.cshtml", Model.WizDropDowns, new ViewDataDictionary { { "ShowFamilyEquipment", false }, { "ShowLinks", ViewBag.ShowLinks } });
                    }
                </div>

                @if (Model.PopularCartridges.Rows.Count > 0)
                {
                    <div id="pop-cartridges">
                        @{
                            Html.RenderPartial("~/Views/Equipment/PopularCartridges.cshtml", Model);
                        }
                    </div>

                    <hr class="g-m-t-60 g-m-b-20"/>
                }

                @if (Model.PopularPrinters.Rows.Count > 0)
                {
                    <div class="row">
                        <div class="col-md-12">
                            <h2>Popular @(Model.Manufacturer == null ? "" : Model.Manufacturer.manufacturerName) Printer Models</h2>
                        </div>
                    </div>
                    <div id="pop-printers">
                        @{
                            Html.RenderPartial("~/Views/Equipment/PopularPrinters.cshtml", Model);
                        }
                    </div>
                }
                
                @if (Model.Family == null && Model.Manufacturer != null && ViewBag.ShowLinks)
                {
                    foreach (SelectListItem family in Model.WizDropDowns.FamilyList)
                    {
                        <hr class="g-m-t-60 g-m-b-20" />
                        <div id="family@(family.Value)" class="row">
                            <div class="col-md-12">
                                <h2>@family.Text Printers</h2>
                            </div>
                        </div>
                        Html.RenderPartial("~/Views/Equipment/PrinterLinks.cshtml", Model.WizDropDowns, new ViewDataDictionary { { "ShowFamilyEquipment", true }, { "FamilyId", family.Value } });
                    }
                }

                @{
                    Html.RenderPartial("~/Views/Shared/LiveChat.cshtml", Model);
                }
            </div>
            <div class="col-md-3 restrict-images hidden-xs hidden-sm">
                <hr class="g-m-b-20"/>
                <h2>Our Services</h2>
                @if (Model.IsCompatibleSaleActive || Model.IsOEMSaleActive)
                {
                    @Html.RawFromDict(Model.SaleData, "WizardMarketing1")
                    <div class="g-m-t-20"></div>
                }
                @Html.RawFromDict(Model.EquipmentData, "WizardMarketing1")

                <div class="g-m-t-20"></div>

                @Html.RawFromDict(Model.EquipmentData, "WizardMarketing2")
            </div>
        </div>
    </div>
</div>

@section StructuredData {
    [
    @Html.Raw(ViewBag.BreadcrumbJson)
    ]
}
