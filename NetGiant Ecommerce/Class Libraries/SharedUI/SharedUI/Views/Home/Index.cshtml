@using System.Configuration
@using BusinessLogic;
@using BusinessLogic.ViewModels;
@using SharedUI.Models

@model HomeViewModel


@section AddTags {
    <link rel="canonical" href="https://@(Model.DomainNameTrunc)/" />
}

<section class="" data-stellar-background-ratio="0.5" data-stellar-ratio="1" style="background-image: url('@Html.RawFromDict(Model.WizardData, "FeatureBackground")')">
    <div class="container body-content">
        <div class="row">
            @if (int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) != 3)
            {
                // TonerGiant and CartridgeMonkey
                <div class="col-lg-6">
                    @{
                        Html.RenderPartial("~/Views/Equipment/Wizard.cshtml", Model);
                    }
                </div>
                
                if (Authentication.IsAuthenticated())
                {
                <div class="col-lg-6 visible-lg">
                    @{
                        Html.RenderPartial("~/Views/Home/CustomerSummary.cshtml", Model);
                    }
                </div>
                }
                else
                {
                <div class="col-lg-6 hm-wizmsg g-flex-allcenter hidden-xs hidden-sm hidden-md">
                    @((Model.IsCompatibleSaleActive || Model.IsOEMSaleActive || Model.IsStationerySaleActive) ? Html.RawFromDict(Model.SaleData, "WizardMessage") : Html.RawFromDict(Model.HomeData, "WizardMessage"))
                </div>
                }
            }
            else
            {
                // NetGiant.com only
                <div class="col-lg-12">
                    @{
                        Html.RenderPartial("~/Views/Equipment/Wizard.cshtml", Model);
                    }
                </div>
                <div class="col-md-12 hm-wizmsg g-flex-allcenter hidden-xs hidden-sm">
                    @((Model.IsCompatibleSaleActive || Model.IsOEMSaleActive || Model.IsStationerySaleActive) ? Html.RawFromDict(Model.SaleData, "WizardMessage") : Html.RawFromDict(Model.HomeData, "WizardMessage"))
                </div>
                }

            </div>
        </div>
    </section>

    <div class="g-bc-p g-p-b-100">
        <div class="container g-bc-p g-ps-r">
            <div class="row g-m-t-40"></div>
            <div class="row">
                @Html.RawFromDict(Model.HomeData, "SpecialOffers")
            </div>
            
            @if (int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) != 3)
            {
                <div class="row g-m-t-20">
                    <div class="col-md-12">
                        <h2>Popular @(int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) != 3 ? "Printer" : "") Brands</h2>
                        <div class="g-ps-r hm-brandWizard text-center">
                            @Html.RawFromDict(Model.HomeData, "BrandWizard")
                        </div>
                    </div>
                </div>

                <hr class="g-m-t-60 g-m-b-20"/>

                <div class="row g-m-t-20 hidden-xs hm-our-services">
                    <div class="col-md-12">
                        <h2>@Html.RawFromDict(Model.CommonData, "SiteName") Services</h2>
                        <div class="g-ps-r row">
                            @Html.RawFromDict(Model.HomeData, "ServiceMessages")
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="row hidden-xs">
                    @Html.RawFromDict(Model.HomeData, "Confidence")
                </div> 
            }

            <hr class="g-m-t-60 g-m-b-20 hidden-xs" />

            <div class="row">
                @if (int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) != 3)
                // TonerGiant and CartridgeMonkey
                {
                    <div class="col-md-12">
                        <h2>Popular Printer Models</h2>
                    </div>
                    <div class="col-md-12">
                        <div class="row">
                            <div id="pop-printers" class="col-md-8">
                                @{
                                    Html.RenderPartial("~/Views/Equipment/PopularPrinters.cshtml", Model);
                                }
                            </div>

                            <div class="col-md-4">
                                <div class="hm-pp-notes g-f-l">
                                    @Html.RawFromDict(Model.WizardData, "PopularPrintersText")
                                </div>
                                <div class="g-c-b"></div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    // NetGiant Only
                    <div class="col-md-12 main-bester-sellers">
                        @{
                            Html.RenderPartial("~/Views/Product/BestSellers.cshtml", Model);
                        }
                    </div>
                }
            </div>

            <hr class="g-m-t-60 g-m-b-20" />

            @if (Model.BlogFeed != null)
            {
                <div class="row hidden-xs">
                    <div class="col-md-12">
                        <div class="clearfix">
                            <h2 class="pull-left">Latest News</h2>
                            <div class="pull-right">
                                <a href="/blog/" class="btn g-butt-second-reg g-butt-lg-2">More News</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        @{
                            Html.RenderPartial("BlogFeed", Model);
                        }
                    </div>
                </div>

                <hr class="g-m-t-60 g-m-b-20 hidden-xs" />
             }
            
            @if (int.Parse(ConfigurationManager.AppSettings["WebsiteId"]) != 3)
            {
                <div class="row hidden-xs">
                    @Html.RawFromDict(Model.HomeData, "Confidence")
                </div>
            }

            <div class="row g-m-t-10 g-m-b-40 hidden-xs">
                <div class="col-md-12">
                    <h2 class="pull-left">Customer Feedback</h2>
                    @*<div class="pull-right">
                            <button class="g-butt-second-reg g-butt-lg-2">Leave Feedback</button>
                        </div>*@
                </div>
                @Html.RawFromDict(Model.HomeData, "Testimonials")
            </div>
        </div>
    </div>

    @section scripts
{
        <script type="text/javascript">

        $(function() {
            //$('#carousel-hacked').carousel({
            //    interval: 10000,
            //    keyboard: false
            //});

            @if (TempData["VoucherSR"] != null)
            {
                SaveReturn sr = (SaveReturn) TempData["VoucherSR"];

                @:$.confirm({ title: 'Voucher Code', content: '@Html.Raw(sr.Html)', buttons: { somethingElse: { text: 'Okay' } }, backgroundDismiss: true });
            }
        });
        </script>
    }

    @if (Convert.ToBoolean(Session["U_IsPortalUser"]) && Session["U_CSUser"] == null)
    {
        <script type="text/javascript">
            $(function () {
                launchPopup('CSAuth', 'popup-csuser', 'md', '', { backdrop: 'static', keyboard: false });

                $('.btn-csuser').click(function () {
                    if ($('#csuser-dropdown').val()) {
                        SetCSUser($('#csuser-dropdown').val());
                    }
                });
            });

            function SetCSUser(orderSource) {
                $.ajax({
                    url: "/Portal/SetCustomerServiceUser",
                    dataType: 'json',
                    taditional: true,
                    type: 'post',
                    data: {
                        orderSource: orderSource
                    },
                    async: false,
                    success: function (e) {
                        if (e.savereturn.IsSuccess)
                            window.location.reload();
                    },
                    error: function (e) {
                        logAjaxScriptError("/Portal/SetCustomerServiceUser", xhr, textStatus, thrownError);
                    }
                });
            }
        </script>
    }
   
@section StructuredData {
    [
    @Html.RawFromDict(Model.CommonData, "Nap")
    ]
}