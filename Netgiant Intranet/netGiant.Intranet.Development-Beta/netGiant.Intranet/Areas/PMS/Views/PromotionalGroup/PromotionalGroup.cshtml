@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.PromotionalGroup;
@model PromotionalGroupViewModel

@{
    ViewBag.Title = "Promotional Group";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    <a class="g-p-10 g-cur-p" data-toggle="modal" data-target="#promotionalGroupModal">Create New</a>
}

@(Html.Kendo().Grid<TelerikPromotionalGroup>()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("promoGroupGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.Name);
        columns.Bound(x => x.FilterName);
        columns.Bound(x => x.Active).Title("Active").ClientTemplate(
                "<input pid=\"#:Id#\" class=\"promotionalGroupChkBox\" type=\"checkbox\" #:Active ? \"checked=checked\" : \"\" # ></input>"
            ).HtmlAttributes(new { @class = "g-a-c" }).Width(120).Sortable(false).Filterable(false);
        columns.Bound(x => x.Id).ClientTemplate(
            "<input class=\"btn btn-default\" onclick=\"deleteConfirm(#=Id#);\" type=\"submit\" value=\"Delete\">"
            ).Width(90).Title("").Sortable(false).Filterable(false);
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
    .Sortable(sortable => sortable.AllowUnsort(true))
    .Groupable(group => group.Enabled(false))
    .Scrollable()
    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
    .ColumnMenu()
    .Resizable(resize => resize.Columns(true))
    .Reorderable(reorder => reorder.Columns(true))
    .NoRecords("There are no promotional groups to display")
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("PromotionalGroup_Read", "PromotionalGroup"))
        .Sort(s => s.Add(x => x.Name).Ascending())
        .PageSize(200)
    )
    .Events(events => events.Change("Grid_OnRowSelect").DataBound("saveGridFilters"))
    .Selectable()
 )

<!-- Modal -->
<div class="modal fade" id="promotionalGroupModal" tabindex="-1" role="dialog" aria-labelledby="promotionalGroup">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel">Create Promotional Group</h4>
            </div>
            <div class="modal-body">
                <div class="form-group row">
                    <div class="col-md-4">Promotion Group Name:</div>
                    <div class="col-md-8">
                        <input type="text" maxlength="200" class="promoName form-control" />
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-4">Filter Name:</div>
                    <div class="col-md-8">
                        <input type="text" maxlength="200" class="filterName form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary btnCreatePromo">Create</button>
                <button type="button" class="btn btn-primary btnSavePromo">Save</button> 
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    var promotionId;

    $('.btnCreatePromo').on('click', function () {
        createPromotionalGroup();
    });

    $('.btnSavePromo').on('click', function () {
        savePromotionalGroup();
    });

    $(document).on("click", ".promotionalGroupChkBox", function (e) {
        var text = this.checked ? "activate" : "deactivate";

        if (confirm("Are you sure you want to " + text + " this Promotional Group?")) {
            promotionalGroupActive($(this).attr('pid'));
        } else {
            $(this).prop("checked", !this.checked);
        }
    });

    var Grid_OnRowSelect = function (e) {
        var data = this.dataItem(this.select());
        promotionId = data.Id;
        $('.promoName').val(data.Name);
        $('.filterName').val(data.FilterName);
        $('#promotionalGroupModal').modal();
    }

    $('#promotionalGroupModal').on('show.bs.modal', function (e) {
        if (promotionId > 0) {
            $('.btnSavePromo').show();
            $('.btnCreatePromo').hide();
        } else {
            $('.btnSavePromo').hide();
            $('.btnCreatePromo').show();
        }
    });

    $('#promotionalGroupModal').on('hide.bs.modal', function (e) {       
        promotionId = 0;
        $('.promoName').val('');
        $('.filterName').val('');
    });

    function promotionalGroupActive(promoId) {
        $.ajax({
            url: '@Url.Action("SetPromotionalGroupActive", "PromotionalGroup")',
            method: 'POST',
            dataType: 'json',
            data: {
                id : promoId
            },
            success: function (e) {
                if (!e.saveReturn.IsSuccess) {
                    $.alert({
                        title: 'Error!',
                        content: e.saveReturn.Message,
                    });
                }
            },
            error: function (e) {
                $.alert({
                    title: 'Error!',
                    content: e.responseText,
                });
            }
        });
    }

    function deleteConfirm (id) {
        if (confirm("Are you sure you want to delete this Promotional Group?")) {
            deletePromotionalGroup(id);
        }
    }

    function deletePromotionalGroup(promoId) {
        $.ajax({
            url: '@Url.Action("DeletePromotionalGroup", "PromotionalGroup")',
            method: 'POST',
            dataType: 'json',
            data: {
                id : promoId
            },
            success: function (e) {
                if (e.saveReturn.IsSuccess) {
                    $("#grid").data("kendoGrid").dataSource.read();
                } else {
                    $.alert({
                        title: 'No can do!',
                        content: 'Unable to delete Promotional Group, please ensure it is not in use.',
                    });
                }
            },
            error: function (e) {
                $.alert({
                    title: 'Error!',
                    content: e.responseText,
                });
            }
        });
    }

    function createPromotionalGroup() {

        if (!$('.promoName').val() || !$('.filterName').val()) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("CreatePromotionalGroup", "PromotionalGroup")',
            method: 'POST',
            dataType: 'json',
            data: {
                name: $('.promoName').val(),
                filter: $('.filterName').val()
            },
            success: function (e) {
                if (e.saveReturn.IsSuccess) {
                    $("#grid").data("kendoGrid").dataSource.read();
                    $('#promotionalGroupModal').modal('hide');
                } else {
                    $.alert({
                        title: 'Error!',
                        content: e.saveReturn.Message,
                    });
                }
            },
            error: function (e) {
                $.alert({
                    title: 'Error!',
                    content: e.responseText,
                });
            }
        });
    }

    function savePromotionalGroup() {
        
        if (!$('.promoName').val() || !$('.filterName').val()) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("UpdatedPromotionalGroup", "PromotionalGroup")',
            method: 'POST',
            dataType: 'json',
            data: {
                id: promotionId,
                name: $('.promoName').val(),
                filter: $('.filterName').val()
            },
            success: function (e) {
                if (e.saveReturn.IsSuccess) {
                    $("#grid").data("kendoGrid").dataSource.read();
                    $('#promotionalGroupModal').modal('hide');
                } else {
                    $.alert({
                        title: 'Error!',
                        content: e.saveReturn.Message,
                    });
                }
            },
            error: function (e) {
                $.alert({
                    title: 'Error!',
                    content: e.responseText,
                });
            }
        });
    }

</script>