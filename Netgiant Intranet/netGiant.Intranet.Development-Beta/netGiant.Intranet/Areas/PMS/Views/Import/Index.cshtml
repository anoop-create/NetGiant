@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Import;
@model ImportViewModel

@{
    ViewBag.Title = "Import";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        @using (Html.BeginForm("Import", "Import", FormMethod.Post, new { @enctype = "multipart/form-data" }))
        {
            <div class="row">
                <div class="col-md-12">
                    <div class="g-m-t-20">
                        @Html.Label("Please select an import type: ")
                    </div>
                    <div class="g-m-t-10">
                        @Html.EnumDropDownListFor(x => x.Type, new { @id = "importType", @class = "g-f-l form-control g-smallCell g-m-r-10" })
                    </div>
                </div>
            </div>
            <section id="productImport" class="g-d-n">
                <div class="row">
                    <div class="col-md-12">
                        <div class="g-m-t-20">
                            @Html.Label("Please select a website: ")
                        </div>
                        <div class="g-m-t-10">
                            @Html.DropDownListFor(m => m.WebsiteFk, Model.Websites, "Select Website", new { @class = "form-control g-smallCell g-m-r-10" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="g-m-t-20">
                            @Html.Label("Please select an import key: ")
                        </div>
                        <div class="g-m-t-10">
                            @Html.DropDownListFor(x => x.ImportKey, Model.Keys, "Select Primary Key", new { @class = "form-control g-smallCell g-m-r-10" })
                        </div>
                    </div>
                </div>
            </section>
            <div class="row">
                <div class="col-md-12">
                    <div class="g-m-t-20">
                        @Html.Label("Please select a file to upload: ")
                    </div>
                    <div class="g-m-t-10">
                        <input type="file" name="file" required="required" />
                    </div>
                </div>
            </div>
            <div class="g-m-t-20">
                @Html.ValidationSummary("", new { @class = "text-danger" })
            </div>
            <div class="g-m-t-20">
                <input id="btnImport" type="submit" value="Import" class="btn btn-default" />
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    $(function(){
        $('#importType').on('change', function () {
            if ($('#importType option:selected').text() == "Product") {
                $('#productImport').show();
            } else {
                $('#productImport').hide();
            }
        });
    });
</script>