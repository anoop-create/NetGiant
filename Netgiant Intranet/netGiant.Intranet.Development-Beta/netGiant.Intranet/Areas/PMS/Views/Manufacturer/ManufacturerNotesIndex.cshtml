@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ManufacturerNotesViewModel

@{
    ViewBag.Title = "Manufacturer Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateManufacturerNotes", "Manufacturer", new { id = 0 }, new { @title = "Create new manufacturer notes", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikManufacturerNotes>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("ManufacturerNotesGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.Website).Title("Website").Width("125px");
                            columns.Bound(x => x.Manufacturer).Title("Manufacturer").Width("125px");
                            columns.Bound(x => x.CartridgeType).Title("Cartridge Type").Width("150px");
                            columns.Bound(x => x.Notes).Title("Notes")
                                .ClientTemplate("#:getTheSubstring(data.Notes, 200)#");
                            columns.Bound(x => x.PriorityNotes).Title("Priority Notes")
                                .ClientTemplate("#:getTheSubstring(data.PriorityNotes, 200)#");
                            columns.Bound(x => x.PriorityNotes).Title("Secondary Notes")
                                .ClientTemplate("#:getTheSubstring(data.SecondaryNotes, 200)#");
                            columns.Bound(x => x.MetaTitle).Title("Meta Title").Width("200px");
                            columns.Bound(x => x.MetaDescription).Title("Meta Description").Width("300px");
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"CreateManufacturerNotes/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("100px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no manufacturer notes to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("ManufacturerNotes_Read", "Manufacturer"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Manufacturer Notes',
                content: 'Are you sure you want to delete this note?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteManufacturerNotes", "Manufacturer")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>