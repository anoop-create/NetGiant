@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance
@using PagedList.Mvc;
@model ProductGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Group";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateProductGroup", "Product", new { id = 0 }, new { @title = "Create new Product Group", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikProductGroup>()
                    .HtmlAttributes(new { @class = "pointer-rows" })
                    .Name("ProductGroupGrid")
                    .Columns(columns =>
                    {
                        columns.Bound(x => x.Name).Title("Product Group Name");
                        columns.Bound(x => x.ProductGroupNo).Title("Product Group No");
                        columns.Bound(x => x.ProductType).Title("Product Type");
                        columns.Bound(x => x.DateLastUpdated).Format("{0:dd/MM/yyyy HH:mm:ss}").Title("Date Last Updated");
                        columns.Bound(x => x.Id).ClientTemplate(
                                "<a href=\"CreateProductGroup/#:Id#\">Edit</a>" +
                                "|<a href=\"##\" class=\"lnkProductGroupDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                ).Width("136px").Filterable(false).Sortable(false).Groupable(false);
                    })
                    .Pageable(pager => pager.Refresh(true))
                    .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                    .Sortable(sortable => sortable.AllowUnsort(true))
                    .Groupable()
                    .Scrollable()
                    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                    .ColumnMenu()
                    .Resizable(resize => resize.Columns(true))
                    .Reorderable(reorder => reorder.Columns(true))
                    .NoRecords("There are no product groups to display")
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Read(x => x.Action("ProductGroup_Read", "Product"))
                        .PageSize(200)
                    )
                    .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkProductGroupDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Product Group',
                content: 'Are you sure you want to delete this product group?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteProductGroup", "Product")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>