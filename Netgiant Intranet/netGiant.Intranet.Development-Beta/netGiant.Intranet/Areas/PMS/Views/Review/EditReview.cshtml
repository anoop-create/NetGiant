@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Review;
@model ReviewViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody productFieldTabs">

        <h4>Manage Review</h4>

        <div class="form-horizontal g-b-1dg g-p-10">

            @using (Html.BeginForm("SaveReview", "Review", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(x => x.OnefeefoFeedback.feefoFeedbackID)

                <fieldset class="g-b-1dg g-m-t-10">
                    <legend>Review ID @Model.OnefeefoFeedback.feefoFeedbackID.ToString()</legend>

                    <div class="col-lg-3">
                        Review/Comment:
                    </div>
                    <div class="col-lg-9">
                        <b>
                            @Model.OnefeefoFeedback.productComment
                        </b>
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        Rating:
                    </div>
                    <div class="col-lg-9">
                        <b>
                            @Model.OnefeefoFeedback.productRating
                        </b>
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        Author:
                    </div>
                    <div class="col-lg-9">
                        <b>
                            @(Model.OnefeefoFeedback.author == "" ? " - " : Model.OnefeefoFeedback.author)
                        </b>
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        Product:
                    </div>
                    <div class="col-lg-9">
                        <b>
                            @Model.OnefeefoFeedback.ProductName
                        </b>
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        Website:
                    </div>
                    <div class="col-lg-9">
                        <b>
                            @Model.OnefeefoFeedback.WebsiteName
                        </b>
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        Hide (true = hidden)
                    </div>
                    <div class="col-lg-9">
                        @Html.EditorFor(x => x.OnefeefoFeedback.isHidden, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                    </div>

                    <div class="col-lg-12">&nbsp;</div>

                    <div class="col-lg-3">
                        &nbsp;
                    </div>
                    <div class="col-lg-9">
                        <input type="submit" name="saveReview" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "Index", "Review", null, new { @class = "btn btn-default" })
                    </div>
                </fieldset>
            }

        </div>
    </div>

