@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product
@model CrossSellingLinkViewModel

@{
    ViewBag.Title = "Cross Selling Link";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
    @Html.RawFromDict(Model.IntranetData, "CrossSellingLinkFilters")

    @using (Html.BeginForm("ExportCrossSellingLinks", "CrossSellingLink", FormMethod.Post, new { @id = "ExportForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("kendoData")

        <input type="submit" class="btn btn-success g-m-t-5 download" value="Export to CSV" />
    }
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "Create", "CrossSellingLink", new { id = 0 }, new { @title = "Create new cross selling link", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikCrossSellingLink>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("CrossSellingLinkGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.PartNoA).Title("A - Part No").Width(200);
                            columns.Bound(x => x.ProductNameA).Title("A - Product Name");
                            columns.Bound(x => x.PartNoB).Title("B - Part No").Width(200);
                            columns.Bound(x => x.ProductNameB).Title("B - Product Name");
                            columns.Bound(x => x.Type).Title("Type").Width(150);
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"Create/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("120px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no cross selling links to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("Links_Read", "CrossSellingLink"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Cross Selling Link',
                content: 'Are you sure you want to delete this link?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("Delete", "CrossSellingLink")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>