@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model EquipmentNotesViewModel

@{
    ViewBag.Title = "Equipment Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateEquipmentNotes", "Equipment", new { id = 0 }, new { @title = "Create new equipment notes", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikEquipmentNotes>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("EquipmentNotesGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.Website).Title("Website").Width("150px");
                            columns.Bound(x => x.Equipment).Title("Equipment").Width("300px");
                            columns.Bound(x => x.Detail).Title("Detail").Width("80px");
                            columns.Bound(x => x.Notes).Title("Notes");
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"CreateEquipmentNotes/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("125px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no equipment notes to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("EquipmentNotes_Read", "Equipment"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Equipment Notes',
                content: 'Are you sure you want to delete this note?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteEquipmentNotes", "Equipment")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>