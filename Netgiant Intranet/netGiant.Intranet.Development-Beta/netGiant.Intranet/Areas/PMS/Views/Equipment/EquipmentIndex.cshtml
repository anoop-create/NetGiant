@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment
@using PagedList.Mvc;
@model EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Equipment";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateEquipment", "Equipment", new { id = 0 }, new { @title = "Create new equipment", @class = "g-p-10" })
}

@(Html.Kendo().Grid<EquipmentViewModel.TelerikEquipment>()
            .HtmlAttributes(new { @class = "pointer-rows" })
            .Name("equipmentGrid")
            .Columns(columns =>
            {
                columns.Bound(x => x.Equipment).Title("Equipment")
                    .HeaderHtmlAttributes(new { title = "Equipment", style = "text-align: center;" });
                columns.Bound(x => x.Manufacturer).Title("Manufacturer")
                    .HeaderHtmlAttributes(new { title = "Manufacturer", style = "text-align: center;" });
                columns.Bound(x => x.CartridgeType).Title("Cartridge Type")
                    .HeaderHtmlAttributes(new { title = "Cartridge Type", style = "text-align: center;" });
                columns.Bound(x => x.Product).Title("Product")
                    .HeaderHtmlAttributes(new { title = "Product", style = "text-align: center;" });
                columns.Bound(x => x.DateLastUpdated).Title("Date Last Updated")
                    .ClientTemplate("#= kendo.toString(kendo.parseDate(DateLastUpdated, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') #")
                    .HeaderHtmlAttributes(new { title = "Date Last Updated", style = "text-align: center;" });
                columns.Bound(x => x.Status).Title("Status")
                    .HeaderHtmlAttributes(new { title = "Status", style = "text-align: center;" });
                columns.Bound(x => x.DateInactive).Title("Date Inactive")
                    .ClientTemplate("#= DateInactive != null ? kendo.toString(kendo.parseDate(DateInactive, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') : \"N/A\" #")
                    .HeaderHtmlAttributes(new { title = "Date Inactive", style = "text-align: center;" });
                columns.Bound(x => x.Id).ClientTemplate(
                        "<a href=\"CreateEquipment/#:Id#\">Edit</a>" +
                        "|<a href=\"##\" class=\"lnkEquipmentDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>" +
                        "|<a href=\"EquipmentMemIndex/#:Id#\">Product Memberships</a>"
                        ).Title("").Filterable(false).Sortable(false).Groupable(false).Width("250px");
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable.AllowUnsort(true))
            .Groupable()
            .Scrollable()
            .Filterable(filter => filter.Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no equipment to display")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(x => x.Action("Equipment_Read", "Equipment"))
                .PageSize(200)
            )
            .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkEquipmentDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Equipment',
                content: 'Are you sure you want to delete this equipment?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteEquipment", "Equipment")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>