@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment
@using PagedList.Mvc;
@using System.Web.Optimization;
@model EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Families";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateFamily", "Equipment", new { id = 0 }, new { @title = "Create new equipment family", @class = "g-p-10" })
}

@(Html.Kendo().Grid<EquipmentViewModel.TelerikFamily>()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("familyGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.Family).Title("Family")
            .HeaderHtmlAttributes(new { title = "Family", style = "text-align: center;" });
        columns.Bound(x => x.Manufacturer).Title("Manufacturer")
            .HeaderHtmlAttributes(new { title = "Manufacturer", style = "text-align: center;" });
        columns.Bound(x => x.DateLastUpdated).Title("Date Last Updated")
            .ClientTemplate("#= kendo.toString(kendo.parseDate(DateLastUpdated, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') #")
            .HeaderHtmlAttributes(new { title = "Date Last Updated", style = "text-align: center;" });
        columns.Bound(x => x.Id).ClientTemplate(
                "<a href=\"CreateFamily/#:Id#\">Edit</a>" +
                "|<a href=\"##\" class=\"lnkFamilyDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>" +
                "|<a href=\"FamilyMemIndex/#:Id#\">Equipment</a>"
                ).Title("").Filterable(false).Sortable(false).Groupable(false).Width("250px");
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
    .Sortable(sortable => sortable.AllowUnsort(true))
    .Groupable()
    .Scrollable()
    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
    .ColumnMenu()
    .Resizable(resize => resize.Columns(true))
    .Reorderable(reorder => reorder.Columns(true))
    .NoRecords("There are no families to display")
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("Families_Read", "Equipment"))
        .PageSize(200)
    )
    .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkFamilyDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Equipment Family',
                content: 'Are you sure you want to delete this equipment family?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteFamily", "Equipment")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>