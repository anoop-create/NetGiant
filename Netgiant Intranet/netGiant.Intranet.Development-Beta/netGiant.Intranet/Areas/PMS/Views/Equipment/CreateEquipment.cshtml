@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment
@model EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Equipment";
    ViewBag.SubTitle = Model.Family != null ? "Edit" : "Create";
}

@Html.Hidden("GetProductsURL", Url.Action("GetProducts", "Equipment"))
@Html.Hidden("GetNewFamilyRowURL", Url.Action("GetNewFamilyRow", "Equipment"))
@Html.Hidden("DeleteFamilyMembershipURL", Url.Action("DeleteFamilyMembership", "Equipment"))

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @using (Html.BeginForm("SaveEquipment", "Equipment"))
        {
    <div class="form-horizontal">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(m => m.Equipment.eqEquipmentID)

        <div class="form-group">
            @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Equipment.description, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.description, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.Equipment.manufacturerFK, Model.AllEquipManufacturers, "Select...", new { @class = "form-control g-largeCell" })
                @Html.ValidationMessageFor(m => m.Equipment.manufacturerFK, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Product Type ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.Equipment.productTypeFK, Model.AllProductTypes, "Select...", new { @class = "form-control g-largeCell" })
                @Html.ValidationMessageFor(m => m.Equipment.productTypeFK, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Cartridge Type ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.Equipment.eqCartridgeTypeFK, Model.AllCartridgeTypes, "Select...", new { @class = "form-control g-largeCell" })
                @Html.ValidationMessageFor(m => m.Equipment.eqCartridgeTypeFK, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Main URL ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Equipment.mainURL, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.mainURL, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Thumbnail URL ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Equipment.thumbnailURL, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.thumbnailURL, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Product ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <select id="aProduct"></select>
                @Html.HiddenFor(m => m.Equipment.productFK, new { @class = "hiddenValue" })
                @Html.ValidationMessageFor(m => m.Equipment.productFK, "", new { @class = "text-danger g-m-l-50" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Meta Keywords ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Equipment.metaKeywords, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.metaKeywords, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Meta Title ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Equipment.metaTitle, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.metaTitle, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Meta Description ", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(m => m.Equipment.metaDescription, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                @Html.ValidationMessageFor(m => m.Equipment.metaDescription, "", new { @class = "text-danger" })
            </div>
        </div>

        @if (Model.Equipment.eqEquipmentID > 0)
        {
            <div class="form-group">
                @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(m => m.Equipment.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                </div>
            </div>

            <div class="form-group">
                @Html.Label("Date Created", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(m => m.Equipment.dateCreated, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                    @Html.HiddenFor(m => m.Equipment.dateCreated)
                </div>
            </div>
        }

        <div class="form-group">
            @Html.Label("Families", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                <div id="famContainer" class="famContainer">
                    @foreach (var famMap in Model.Equipment.eqFamilyMembership)
                    {
                        Html.RenderPartial("_CreateFamilyMapping", famMap);
                    }
                </div>

                @Html.DropDownList("newFamily", Model.AllFamilies, "Select Additional Family...", new { @class = "form-control g-largeCell g-m-t-10" })
            </div>
        </div>

        <div id="confirmRemoveDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete ?
        </div>

        <div class="form-group">
            @Html.Label("Status", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.Equipment.statusFK, Model.AllEquipStatus, "Select...", new { @class = "form-control g-largeCell" })
                @Html.ValidationMessageFor(m => m.Equipment.statusFK, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Meta Content Type", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(m => m.Equipment.metaContentTypeFK, Model.AllMetaContentTypes, "Select...", new { @class = "form-control g-largeCell" })
                @Html.ValidationMessageFor(m => m.Equipment.metaContentTypeFK, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Featured (Home Page)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10 g-p-t-5">
                @Html.CheckBoxFor(m => m.Equipment.homeFeatured, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Featured (Brand Level)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10 g-p-t-5">
                @Html.CheckBoxFor(m => m.Equipment.brandFeatured, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Featured (Global Level)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10 g-p-t-5">
                @Html.CheckBoxFor(m => m.Equipment.globallyFeatured, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
            </div>
        </div>

        <div class="form-group">
            @Html.Label("Images Not Required", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10 g-p-t-5">
                @Html.CheckBoxFor(m => m.Equipment.imageIsNotRequired, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" name="btnSaveEquipment" value="Save" class="btn btn-default" />
                @Html.ActionLink("Cancel", "EquipmentIndex", null, new { @class = "btn btn-default" })
            </div>
        </div>
    </div>
        }
        @if (Model.Equipment.product != null)
        {
            @Html.Hidden("aProductName", Model.Equipment.product.partNo + " - " + Model.Equipment.product.productName)
        }
    </div>
    
    <input type="hidden" id="activeSortType" />
    <input type="hidden" id="activeSortDir" />

</div>

@section scripts {
    <script type="text/javascript">

        var optionsArray = new Array();

        $(document).ready(function () {

            //This allows validation of hidden fields inside the form
            //$('#mainForm').validate().settings.ignore = [];

            setupComboBox($('#GetProductsURL').val());

        });

        $(document).ready(function () {
            $("#aProduct").combobox();

            $('.custom-combobox-input:first').val($('#aProductName').val());
        });

        $(document).on('change', '#newFamily', function () {
            var objArray = new Array();
            objArray[0] = this.value;
            objArray[1] = $('#Equipment_eqEquipmentID').val();

            $.ajax({
                url: $('#GetNewFamilyRowURL').val(),
                dataType: 'html',
                traditional: true,
                type: 'POST',
                cache: false,
                data:
                    {
                        optionsArray: objArray,
                        timestamp: $.now()
                    },
                async: false,
                success: function (data) {
                    $('.famContainer').append(data);
                    $('#newFamily option').removeAttr("selected");
                }
            });
        });

        $(document).on("click", ".lnkDelete", function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDelete("#confirmRemoveDialog", $("#DeleteFamilyMembershipURL").val(), $(this).attr("value"),
                "#famContainer", optionsArray);
            return false;
        });

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;
            optionsArray[1] = $("#Equipment_eqEquipmentID").val();
        }
    </script>
}
