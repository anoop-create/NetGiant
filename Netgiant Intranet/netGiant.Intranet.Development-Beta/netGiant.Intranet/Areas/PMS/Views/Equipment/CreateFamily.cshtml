@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment.EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Family";
    ViewBag.SubTitle = Model.Family != null ? "Edit" : "Create";
}
<div class="placeHolder">

    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @using (Html.BeginForm("SaveFamily", "Equipment", FormMethod.Post))
        {
            <div class="form-horizontal">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Family.eqFamilyID)

                <div class="form-group">
                    @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(m => m.Family.description, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(m => m.Family.description, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.Family.manufacturerFK, Model.AllEquipManufacturers, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(m => m.Family.manufacturerFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.Family.eqFamilyID > 0)
                {
                <div class="form-group">
                    @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(m => m.Family.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                    </div>
                </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnSaveFamily" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "FamiliesIndex", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>