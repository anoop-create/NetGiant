@using netGiant.Intranet.DataLayer.NetgiantMasterData;
@using PagedList.Mvc;
@model PagedList.IPagedList<salesAreaGroup>

@Html.Hidden("SalesAreaGroupDataURL", Url.Action("SalesAreaGroupData", "SalesAreaGroup"))
@Html.Hidden("DeleteSalesAreaGroupURL", Url.Action("Delete", "SalesAreaGroup"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "SalesAreaGroup", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="salesGroupName">Sales Area Group Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="salesGroupNo">Sales Area Group No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.salesAreaGroupName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.salesAreaGroupNo)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdate)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "SalesAreaGroup", new { id = item.salesAreaGroupID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkSalesAreaGroupDelete\" value=" + @item.salesAreaGroupID + " title=\"Delete " + @item.salesAreaGroupName + "\">Delete</a>");
                    @*@Html.ActionLink("Products", "SalesAreaGroupIndex", "SalesAreaGroup", new { id = item.salesAreaGroupID }, null)*@
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="salesAreaGroupPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="salesAreaGroupDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this sales area group?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}