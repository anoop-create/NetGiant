@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance
@using PagedList.Mvc;
@model SalesAreaGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sales Area Group";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "Create", "SalesAreaGroup", new { id = 0 }, new { @title = "Create new Sales Area Group", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikSalesAreaGroup>()
        .HtmlAttributes(new { @class = "pointer-rows" })
        .Name("SalesAreaGroupGrid")
        .Columns(columns =>
        {
            columns.Bound(x => x.Name).Title("Sales Area Group Name");
            columns.Bound(x => x.SalesAreaGroupNo).Title("Sales Area Group No");
            columns.Bound(x => x.DateLastUpdated).Format("{0:dd/MM/yyyy HH:mm:ss}").Title("Date Last Updated");
            columns.Bound(x => x.Id).Title("Action").ClientTemplate(
                    "<a href=\"Create/#:Id#\">Edit</a>" +
                    "|<a href=\"##\" class=\"lnkSalesAreaGroupDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                    ).Width("136px").Filterable(false).Sortable(false).Groupable(false);
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable.AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .NoRecords("There are no sales area groups to display")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Read(x => x.Action("SalesAreaGroup_Read", "SalesAreaGroup"))
            .PageSize(200)
        )
        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkSalesAreaGroupDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Sales Area Group',
                content: 'Are you sure you want to delete this sales area group?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("Delete", "SalesAreaGroup")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>