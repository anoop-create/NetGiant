@using System.Configuration
@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance
@model CategoryCodeViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Category Code";
    ViewBag.SubTitle = Model.catCode.categoryCodeID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "CategoryCode"))

        @using (Html.BeginForm("Save", "CategoryCode"))
        {
            <div class="form-horizontal">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.catCode.categoryCodeID)
                @Html.HiddenFor(m => m.catCode.AXISGroupID)

                <div class="form-group">
                    @Html.Label("Category Code Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.catCode.categoryCodeName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.catCode.categoryCodeName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.catCode.websiteFK, Model.AllWebsites, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.catCode.websiteFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Parent Category Code", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.catCode.parentCategoryCodeID, Model.AllCategories, "Select...", new { @class = "form-control g-largeCell", @disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.catCode.parentCategoryCodeID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("AXIS Group No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.catCode.AXISGroupNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.catCode.AXISGroupNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.catCode.categoryCodeID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.catCode.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    @Html.Label("Primary", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.catCode.isPrimary, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Google Category", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                       @Html.DropDownListFor(m => m.catCode.googleProductCategoryFK, Model.GoogleCategoryList, "Select...", new { @class = "form-control g-xxLargeCell" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sale", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.IsPartOfSale, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sitemap", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.catCode.isInSitemap, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                    </div>
                </div>
                
                <div class="form-group">
                    @Html.Label("Meta Title", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.catCode.metaTitle, new { htmlAttributes = new { @class = "form-control g-xxLargeCell" } })
                        @Html.ValidationMessageFor(model => model.catCode.metaTitle, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                <div class="form-group">
                    @Html.Label("Meta Title", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.catCode.metaDescription, new { htmlAttributes = new { @class = "form-control g-xxLargeCell" } })
                        @Html.ValidationMessageFor(model => model.catCode.metaDescription, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                <div class="form-group">
                    @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">

                        @{
                            string bootstrapCss = "";
                            string fontAwesomeCss = "";
                            string siteCss = "";

                            var machineConfig = ConfigurationManager.OpenMachineConfiguration();
                            var envir = machineConfig.AppSettings.Settings["Environment"].Value;

                            if (envir != "Live")
                            {
                                if (Model.catCode.categoryCodeID > 0)
                                {
                                    switch (Model.catCode.websiteFK)
                                    {
                                        case 1:
                                            bootstrapCss = "http://beta.tonergiant.co.uk/Content/bootstrap.css";
                                            fontAwesomeCss = "http://beta.tonergiant.co.uk/Content/font-awesome.css";
                                            siteCss = "http://beta.tonergiant.co.uk/Content/site.less";
                                            break;
                                        case 2:
                                            bootstrapCss = "http://beta.cartridgemonkey.com/Content/bootstrap.css";
                                            fontAwesomeCss = "http://beta.cartridgemonkey.com/Content/font-awesome.css";
                                            siteCss = "http://beta.cartridgemonkey.com/Content/site.less";
                                            break;
                                        case 3:
                                            bootstrapCss = "http://beta.netgiant.com/Content/bootstrap.css";
                                            fontAwesomeCss = "http://beta.netgiant.com/Content/font-awesome.css";
                                            siteCss = "http://beta.netgiant.com/Content/site.less";
                                            break;
                                    }
                                }
                                else
                                {
                                    bootstrapCss = "http://beta.tonergiant.co.uk/Content/bootstrap.css";
                                    fontAwesomeCss = "http://beta.tonergiant.co.uk/Content/font-awesome.css";
                                    siteCss = "http://beta.tonergiant.co.uk/Content/site.less";
                                }
                            }
                            else
                            {
                                if (Model.catCode.categoryCodeID > 0)
                                {
                                    switch (Model.catCode.websiteFK)
                                    {
                                        case 1:
                                            bootstrapCss = "http://www.tonergiant.co.uk/Content/bootstrap.css";
                                            fontAwesomeCss = "http://www.tonergiant.co.uk/Content/font-awesome.css";
                                            siteCss = "http://www.tonergiant.co.uk/Content/site.less";
                                            break;
                                        case 2:
                                            bootstrapCss = "http://www.cartridgemonkey.com/Content/bootstrap.css";
                                            fontAwesomeCss = "http://www.cartridgemonkey.com/Content/font-awesome.css";
                                            siteCss = "http://www.cartridgemonkey.com/Content/site.less";
                                            break;
                                        case 3:
                                            bootstrapCss = "http://www.netgiant.com/Content/bootstrap.css";
                                            fontAwesomeCss = "http://www.netgiant.com/Content/font-awesome.css";
                                            siteCss = "http://www.netgiant.com/Content/site.less";
                                            break;
                                    }
                                }
                                else
                                {
                                    bootstrapCss = "http://www.tonergiant.co.uk/Content/bootstrap.css";
                                    fontAwesomeCss = "http://www.tonergiant.co.uk/Content/font-awesome.css";
                                    siteCss = "http://www.tonergiant.co.uk/Content/site.less";
                                }
                            }
                        }

                        @(Html.Kendo().Editor()
                              .Name("content")
                              .HtmlAttributes(new { style = "height:440px;", @class = "kendoEditor" })
                              .Resizable(resizable => resizable.Content(true).Toolbar(true))
                              .Encode(false)
                              .Serialization(s => s
                                  .Semantic(false)
                                  .Scripts(true)
                                  .Custom("formatHtml"))
                              .Tools(tool => tool
                                  .FontColor()
                                  .BackColor()
                                  .FontSize()
                                  .ViewHtml()
                              )
                              .Value(Model.catCode.description)
                              .StyleSheets(css => css
                                  .Add(Url.Content(bootstrapCss))
                                  .Add(Url.Content(fontAwesomeCss))
                                  .Add(Url.Content(siteCss))
                              )
                        )

                        @Html.TextArea("content", Model.catCode.description, new { style = "height: 440px;", @class = "textArea" })

                    </div>

                    @Html.ValidationMessageFor(model => model.catCode.description, "", new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnCategoryCodeSave" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@section scripts {

    <script type="text/javascript">

        if (parseInt($('#catCode_websiteFK').val()) > 0) {
            var origId = $('#catCode_parentCategoryCodeID').val();

            if ($('#catCode_websiteFK').val().length > 0) {
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + parseInt($('#catCode_websiteFK').val()), '#catCode_parentCategoryCodeID', 'category', origId);
            } else {
                $("#axisGroup_categoryCodeFK").empty();
                $("#axisGroup_categoryCodeFK").html('<option value="" selected="true">Search by category</option>');
                $("#axisGroup_categoryCodeFK").attr('disabled', 'disabled');
            }

            $('#catCode_parentCategoryCodeID').prop('disabled', false);
        }

        $(document).on("change", "#catCode_websiteFK", function (event) {

            if ($(this).val().length > 0) {
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#catCode_parentCategoryCodeID', 'category');
            } else {
                $("#axisGroup_categoryCodeFK").empty();
                $("#axisGroup_categoryCodeFK").html('<option value="" selected="true">Search by category</option>');
                $("#axisGroup_categoryCodeFK").attr('disabled', 'disabled');
            }

        });
    </script>

    <script type="text/javascript" src="~/Scripts/html5-tidy.js"></script>
    <script>

        var showBodyOnly = true;
        @if (Model.catCode.description != null && Model.catCode.description.Contains("<!DOCTYPE"))
            {
                @:showBodyOnly = false;
            }

        options = {
            "indent": "auto",
            "indent-spaces": 4,
            "wrap": 200,
            "output-xml": false,
            "quote-nbsp": false,
            "show-body-only": showBodyOnly,
            "quote-ampersand": false,
            "uppercase-tags": false,
            "uppercase-attributes": false,
            "drop-font-tags": false,
            "tidy-mark": false,
            "drop-empty-paras": false,
            "drop-empty-elements": false
        }

        $(function() {

            var showHtmlEditor = true;
            @*if (Model.catCode.categoryCodeID == 0 || Model.catCode.description.Length < 6 || !Model.catCode.description.TrimStart().Substring(0, 6).Contains("<style"))
            {
                @:showHtmlEditor = true;
            }
            else
            {
                @:showHtmlEditor = false;
            }*@

            if (showHtmlEditor) {
                $('.kendoEditor').data("kendoEditor").wrapper.show();
                $('.kendoEditor').removeAttr('disabled');
                $('.textArea').hide();
                $('.textArea').attr('disabled', 'disabled');
            } else {
                $('.kendoEditor').data("kendoEditor").wrapper.hide();
                $('.kendoEditor').attr('disabled', 'disabled');
                $('.textArea').show();
                $('.textArea').removeAttr('disabled');
            }
        });

        function formatHtml(html) {
            @if (Model.catCode.description != null && (Model.catCode.description.Length < 6 || !Model.catCode.description.TrimStart().Substring(0, 6).Contains("<style")))
            {
                @:return tidy_html5(html, options);
            }
        }
    </script>
}