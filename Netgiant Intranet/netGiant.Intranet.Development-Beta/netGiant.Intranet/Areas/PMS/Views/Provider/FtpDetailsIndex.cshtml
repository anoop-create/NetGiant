@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider;
@model ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ftp Details";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateFtpDetails", "Provider", new { id = 0 }, new { @title = "Create new ftp details", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikFtpDetails>()
                            .HtmlAttributes(new { @class = "pointer-rows" })
                            .Name("FtpDetailsGrid")
                            .Columns(columns =>
                            {
                                columns.Bound(x => x.ProviderType).Title("Provider Type");
                                columns.Bound(x => x.Provider).Title("Provider");
                                columns.Bound(x => x.Host).Title("Host");
                                columns.Bound(x => x.User).Title("User");
                                columns.Bound(x => x.Password).Title("Password");
                                columns.Bound(x => x.Directory).Title("Directory");
                                columns.Bound(x => x.Filename).Title("Filename");
                                columns.Bound(x => x.ZipFilename).Title("Zip Filename");
                                columns.Bound(x => x.DateLastFeedFile).Title("Feed File Date Stamp")
                                    .HeaderHtmlAttributes(new { title = "Feed File Date Stamp", style = "text-align: center;" })
                                    .ClientTemplate("#= DateLastFeedFile != null ? " + "kendo.toString(kendo.parseDate(DateLastFeedFile),'dd/MM/yyyy HH:mm:ss') :" + "'' #");
                                columns.Bound(x => x.Id).ClientTemplate(
                                        "<a href=\"CreateFtpDetails/#:Id#\">Edit</a>" +
                                        "| <a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>" +
                                        "| <a href=\"FtpConnection/#:Id#\">Test Connection</a>"
                                        ).Width("200px").Filterable(false).Sortable(false).Groupable(false).Title("");
                            })
                            .Pageable(pager => pager.Refresh(true))
                            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                            .Sortable(sortable => sortable.AllowUnsort(true))
                            .Groupable()
                            .Scrollable()
                            .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                            .ColumnMenu()
                            .Resizable(resize => resize.Columns(true))
                            .Reorderable(reorder => reorder.Columns(true))
                            .NoRecords("There are no ftp details to display")
                            .DataSource(dataSource => dataSource
                                .Ajax()
                                .Read(x => x.Action("FtpDetails_Read", "Provider"))
                                .PageSize(200)
                                .Sort(x =>
                                {
                                    x.Add(y => y.ProviderType).Ascending();
                                    x.Add(y => y.Provider).Ascending();
                                })
                            )
                            .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Ftp Details',
                content: 'Are you sure you want to delete this ftp detail entry?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteFtpDetails", "Provider")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}