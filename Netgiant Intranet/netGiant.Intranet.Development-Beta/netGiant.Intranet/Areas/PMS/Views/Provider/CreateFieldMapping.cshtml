@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider.ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Field Mapping";
    ViewBag.SubTitle = Model.FieldMapping.fieldMappingID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("SaveFieldMapping", "Provider", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.FieldMapping.fieldMappingID)
                @Html.HiddenFor(m => m.selectedProviderID)
                @Html.HiddenFor(m => m.selectedFtpDetailID)

                <div class="form-group">
                    @Html.Label("Provider", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.FieldMapping.providerFK, Model.allProviders, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.FieldMapping.providerFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("PMS Field", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.FieldMapping.fieldMappingTo, Model.allPMSMappingFields, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.FieldMapping.fieldMappingTo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Provider's Field", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.hasColumnHeaders)
                        {
                            @Html.EditorFor(model => model.FieldMapping.fieldMappingWith, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        }
                        else
                        {
                            @Html.EditorFor(model => model.FieldMapping.fieldMappingWith, new { htmlAttributes = new { @class = "form-control g-largeCell", onkeydown = "return ValidateNumber(event);", @autocomplete="off" } })
                            <span><b>Note:</b>Please provide only column index (Numbers only).</span><br />
                        }
                        @Html.ValidationMessageFor(model => model.FieldMapping.fieldMappingWith, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                if (Model.FieldMapping.fieldMappingID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.FieldMapping.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveFieldMapping" value="Save" class="btn btn-default" title="Save" />
                        @if (Model.selectedProviderID > 0)
                        {
                            @Html.ActionLink("Cancel", "CreateFtpDetails", "Provider", new { id = Model.selectedFtpDetailID }, new { @class = "btn btn-default" })
                        }
                        else
                        {
                            @Html.ActionLink("Cancel", "FieldMapping", "Provider", null, new { @class = "btn btn-default" })
                        }
                    </div>
                </div>
            }

        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        function ValidateNumber(e) {
            var evt = (e) ? e : window.event;
            var charCode = (evt.keyCode) ? evt.keyCode : evt.which;
            if (charCode > 31 && (charCode < 48 || charCode > 57)) {
                return false;
            }
            return true;
        };

    </script>
 }