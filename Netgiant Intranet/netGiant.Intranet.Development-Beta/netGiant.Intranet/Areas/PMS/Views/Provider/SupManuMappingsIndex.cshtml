@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel

@{
    ViewBag.Title = "Supplier Manufacturer Mappings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateSupManuMapping", "Provider", new { id = 0 }, new { @title = "Create new supplier manufacturer mapping", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikSupplierManufacturerMapping>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("SupplierManufacturerMappingGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.Provider).Title("Provider");
                            columns.Bound(x => x.Reference).Title("Reference");
                            columns.Bound(x => x.Manufacturer).Title("Manufacturer");
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"CreateSupManuMapping/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("136px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no supplier manufacturer mappings to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("SupplierManufacturerMapping_Read", "Provider"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Supplier Manufacturer Mapping',
                content: 'Are you sure you want to delete this mapping?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteSupManuMapping", "Provider")/', { id: rowid })
                    },
                    No: function () { }
                }
            });
        });
    });
</script>