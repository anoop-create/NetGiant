@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider;
@using netGiant.Intranet.BusinessLayer.Models;
@using Kendo.Mvc.UI
@model ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>Provider Details</h4>

        <button class="btn btn-danger" onclick="clearFilter()">Clear Filters</button>

        <br />
        <br />

        @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
        {
            @Html.ActionLink("Create New", "CreateProvider", "Provider", new { id = 0 }, new { @title = "New" })
        }
        else
        {
            @Html.Raw("&nbsp");
        }

        <div id="providerData">
            @(Html.Kendo().Grid<ProviderViewModel.TelerikProvider>()
                .HtmlAttributes(new { @class = "pointer-rows" })
                .Name("ProviderGrid")
                .Columns(columns =>
                {
                    columns
                        .Bound(x => x.ID).Title("ID").HeaderHtmlAttributes(new { title = "ID", style = "text-align: center;" });
                    columns
                        .Bound(x => x.Name).Title("Provider Name").HeaderHtmlAttributes(new { title = "Provider Name", style = "text-align: center;" });
                    columns
                        .Bound(x => x.Description).Title("Description").HeaderHtmlAttributes(new { title = "Description", style = "text-align: center;" });
                    columns
                        .Bound(x => x.Type).Title("Provider Type").HeaderHtmlAttributes(new { title = "Provider Type", style = "text-align: center;" });
                    columns
                        .Bound(x => x.ShortName).Title("Short Name").HeaderHtmlAttributes(new { title = "Short Name", style = "text-align: center;" });
                    //columns.Bound(x => x.FeedFileDateTime).Title("Feed File Date Stamp")
                    //    .HeaderHtmlAttributes(new { title = "Feed File Date Stamp", style = "text-align: center;" })
                    //    .ClientTemplate("#= FeedFileDateTime != null ? " +
                    //         "kendo.toString(kendo.parseDate(FeedFileDateTime),'dd/MM/yyyy HH:mm:ss') :" +
                    //         "'' #");
                    columns
                        .Bound(x => x.AxisSupplierReference).Title("Axis Ref").HeaderHtmlAttributes(new { title = "Axis Ref", style = "text-align: center;" });
                    columns
                        .Bound(x => x.ReviewTotal).Title("Review Total").HeaderHtmlAttributes(new { title = "Review Total", style = "text-align: center;" });
                    columns
                        .Bound(x => x.ReviewRating).Title("Review Rating").HeaderHtmlAttributes(new { title = "Review Rating", style = "text-align: center;" });
                    columns
                        .Bound(x => x.Active).Title("Active").HeaderHtmlAttributes(new { title = "Active", style = "text-align: center;" })
                        .ClientTemplate("<input type='checkbox' disabled='disabled' #=Active ? checked='checked' : '' # />");
                    columns
                        .Bound(x => x.ID).Title("Actions").HeaderHtmlAttributes(new { title = "Actions", style = "text-align: center;" })
                        .ClientTemplate(
                        "<a href=\"CreateProvider/#:ID#\">Edit</a>" +
                        " | <a href=\"\\\\#\" class=\"lnkProviderDelete\" value=\"#:ID#\" title=\"Delete\">Delete</a>" +
                        " | <a href=\"ProviderDetails/#:ID#\">Other Details</a>");
                }
                )
                .Pageable(pager => pager.Refresh(true))
                .Pageable(pager => pager.PageSizes(new List<int>
                    { 150, 100, 50, 20 }))
                    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                    .ColumnMenu()
                    .Sortable(sortable => sortable.AllowUnsort(true))
                    .Resizable(resize => resize.Columns(true))
                    .Reorderable(reorder => reorder.Columns(true))
                    .NoRecords("There are no products to display")
                    .DataSource(dataSource => dataSource
                    .Ajax()
                    .Read(x => x.Action("ProviderDataAjax", "Provider"))
                    .PageSize(50)
                    )
                .Events(e => e.DataBound("saveGridFilters"))
            )
        </div>
    </div>
</div>

@Html.Hidden("DeleteProviderURL", Url.Action("DeleteProvider", "Provider"))

<div id="providerDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this provider?
</div>

@section Scripts {
    <script type="text/javascript">

        $(document).on("click", ".lnkProviderDelete", function () {
            optionsArray = new Array();
            optionsArray[0] = $(this).attr("value")
            ajaxDeleteTelerikRow(optionsArray, $('#DeleteProviderURL').val(), '#providerDeleteDialog')
            return false;
        });

        function clearFilter() {
            $("form.k-filter-menu button[type='reset']").trigger("click");
        }

    </script>
}