@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel

@{
    ViewBag.Title = "Sku Mappings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateSkuMapping", "Provider", new { id = 0 }, new { @title = "Create new sku mapping", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikSkuMapping>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("SkuMappingGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.Provider).Title("Provider");
                            columns.Bound(x => x.ProviderPartNo).Title("Provider Part No").Width("200px");
                            columns.Bound(x => x.OurPartNo).Title("Our Part No");
                            columns.Bound(x => x.AxisSupplierNo).Title("Axis Supplier No");
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"CreateSkuMapping/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("136px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no sku mappings to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("SkuMappings_Read", "Provider"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Sku Mapping',
                content: 'Are you sure you want to delete this mapping?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteSkuMapping", "Provider")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>