@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product
@model WebsiteInventoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Website Inventory";
    ViewBag.Subtitle = Model.WebInventory.websiteInventoryID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h3>@ViewBag.SubTitle @ViewBag.Title</h3>

        <div class="form-horizontal">

            @using (Html.BeginForm("Save", "WebsiteInventory", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.WebInventory.websiteInventoryID)

                <div class="form-group">
                    @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.WebInventory.websiteFK, Model.allWebsites, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.WebInventory.websiteFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Product", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.WebInventory.productFK, Model.allProducts, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.WebInventory.productFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Category Code", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.WebInventory.categoryCodeFK, Model.allCategoryCodes, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.WebInventory.categoryCodeFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Promotional Group", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.WebInventory.promotionalGroupFK, Model.allPromotionalGroups, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.WebInventory.promotionalGroupFK, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                if (Model.WebInventory.websiteInventoryID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.WebInventory.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveWebsiteInvetory" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "WebsiteInventory", "WebsiteInventory", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }

        </div>
    </div>
</div>