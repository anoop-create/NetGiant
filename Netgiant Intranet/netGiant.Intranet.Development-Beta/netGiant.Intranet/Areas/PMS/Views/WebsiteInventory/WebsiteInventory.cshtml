@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product
@model WebsiteInventoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Website Inventory";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "Create", "WebsiteInventory", new { id = 0 }, new { @title = "Create new website inventory", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikWebsiteInventory>()
                    .HtmlAttributes(new { @class = "pointer-rows" })
                    .Name("WebsiteInventoryGrid")
                    .Columns(columns =>
                    {
                        columns.Bound(x => x.Category).Title("Category");
                        columns.Bound(x => x.PartNo).Title("Part No").Width("200px");
                        columns.Bound(x => x.Website).Title("Website");
                        columns.Bound(x => x.Promotion).Title("Promotional Group");
                        columns.Bound(x => x.LastUpdated).Title("Date Last Updated").Format("{0:dd/MM/yyyy HH:mm:ss}");
                        columns.Bound(x => x.Id).ClientTemplate(
                                "<a href=\"Create/#:Id#\">Edit</a>" +
                                "|<a href=\"##\" class=\"lnkWebsiteInventoryDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                ).Width("136px").Filterable(false).Sortable(false).Groupable(false).Title("");
                    })
                    .Pageable(pager => pager.Refresh(true))
                    .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                    .Sortable(sortable => sortable.AllowUnsort(true))
                    .Groupable()
                    .Scrollable()
                    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                    .ColumnMenu()
                    .Resizable(resize => resize.Columns(true))
                    .Reorderable(reorder => reorder.Columns(true))
                    .NoRecords("There are no website inventories to display")
                    .DataSource(dataSource => dataSource
                        .Ajax()
                        .Read(x => x.Action("WebsiteInventory_Read", "WebsiteInventory"))
                        .PageSize(200)
                    )
                    .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkWebsiteInventoryDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Website Inventory',
                content: 'Are you sure you want to delete this website inventory?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("Delete", "WebsiteInventory")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>