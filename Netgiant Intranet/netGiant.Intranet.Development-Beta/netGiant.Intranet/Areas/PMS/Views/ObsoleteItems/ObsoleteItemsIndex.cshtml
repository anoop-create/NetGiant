@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ObsoleteItemsViewModel

@{
    ViewBag.Title = "Obsolete Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateObsoleteItem", "ObsoleteItems", new { id = 0 }, new { @title = "Create new Obsolete Item", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikObsoleteItem>()
                .HtmlAttributes(new { @class = "pointer-rows" })
                .Name("ObsoleteItemGrid")
                .Columns(columns =>
                {
                    columns.Bound(x => x.Website).Title("Website").Width("200px");
                    columns.Bound(x => x.StockRef).Title("Stock Reference").Width("200px");
                    columns.Bound(x => x.Equipment).Title("Equipment Name");
                    columns.Bound(x => x.URL).Title("URL");
                    columns.Bound(x => x.Id).ClientTemplate(
                            "<a href=\"CreateObsoleteItem/#:Id#\">Edit</a>" +
                            "|<a href=\"##\" class=\"lnkObsoleteItemDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                            ).Width("136px").Filterable(false).Sortable(false).Groupable(false);
                })
                .Pageable(pager => pager.Refresh(true))
                .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                .Sortable(sortable => sortable.AllowUnsort(true))
                .Groupable()
                .Scrollable()
                .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                .ColumnMenu()
                .Resizable(resize => resize.Columns(true))
                .Reorderable(reorder => reorder.Columns(true))
                .NoRecords("There are no obsolete items to display")
                .DataSource(dataSource => dataSource
                    .Ajax()
                    .Read(x => x.Action("ObsoleteItem_Read", "ObsoleteItems"))
                    .PageSize(200)
                )
                .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkObsoleteItemDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Obsolete Items',
                content: 'Are you sure you want to delete this obsolete item?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteObsoleteItem", "ObsoleteItems")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>