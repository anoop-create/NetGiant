@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model AxisValueLookupViewModel

@{
    ViewBag.Title = "Axis Value Lookup";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateAxisValueLookup", "Axis", new { id = 0 }, new { @title = "Create new axis value lookup", @class = "g-p-10" })
}

@(Html.Kendo().Grid<TelerikAxisValueLookup>()
                        .HtmlAttributes(new { @class = "pointer-rows" })
                        .Name("AxisValueLookupGrid")
                        .Columns(columns =>
                        {
                            columns.Bound(x => x.Id).Title("Axis Value Lookup Id");
                            columns.Bound(x => x.AxisTypeName).Title("Axis Type Name");
                            columns.Bound(x => x.AttributeName).Title("Attribute Name");
                            columns.Bound(x => x.AttributeValueId).Title("Attribute Value Id");
                            columns.Bound(x => x.AttributeValue).Title("Attribute Value");
                            columns.Bound(x => x.Id).ClientTemplate(
                                    "<a href=\"CreateAxisValueLookup/#:Id#\">Edit</a>" +
                                    "|<a href=\"##\" class=\"lnkAxisValueLookupDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                                    ).Width("136px").Filterable(false).Sortable(false).Groupable(false).Title("");
                        })
                        .Pageable(pager => pager.Refresh(true))
                        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
                        .Sortable(sortable => sortable.AllowUnsort(true))
                        .Groupable()
                        .Scrollable()
                        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
                        .ColumnMenu()
                        .Resizable(resize => resize.Columns(true))
                        .Reorderable(reorder => reorder.Columns(true))
                        .NoRecords("There are no axis value lookups to display")
                        .DataSource(dataSource => dataSource
                            .Ajax()
                            .Read(x => x.Action("AxisValueLookup_Read", "Axis"))
                            .PageSize(200)
                        )
                        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkAxisValueLookupDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Axis Value Lookup',
                content: 'Are you sure you want to delete this axis value lookup?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteAxisValueLookup", "Axis")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>