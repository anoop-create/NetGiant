@using netGiant.Intranet.BusinessLayer.ViewModels.OMS;
@model AccViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.SubTitle = Model.Address.AddressId > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle Address</h4>

        <div class="form-horizontal">
            @using (Html.BeginForm("SaveAddress", "Acc", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(x => x.Address.AddressId)
                @Html.HiddenFor(x => x.Address.AccountFk)

                <div class="AddressTabs" style="background:none;">
                    <ul>
                        <li>
                            <a href="#AddressDetails">Address Details</a>
                        </li>
                    </ul>
                </div>

                <div id="AddressDetails">
                    <fieldset class="g-m-t-20">
                        <legend>Address Details</legend>

                        <div class="form-group">
                            @Html.Label("Address Type", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.DropDownListFor(
                                    model => model.Address.AddressTypeFk,
                                    Model.AddressTypeList,
                                    "Select...",
                                    new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                )
                                @Html.ValidationMessageFor(model => model.Contact.ContactStatusFk, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Line 1", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Line1, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Line1, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Line 2", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Line2, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Line2, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Line 3", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Line3, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Line3, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Line 4", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Line4, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Line4, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Line 5", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Line5, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Line5, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label("Postcode", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.Address.Postcode, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.Address.Postcode, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </fieldset>
                </div>



                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="SaveAddress" value="Save" class="btn btn-default" title="Save" />

                        <a href="@(Url.Action("EditAccount/" + Model.Address.AccountFk.ToString(), "Acc"))#AccountAddressesTab" class="btn btn-default">
                            Cancel
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $(".AddressTabs").tabs();
    });

</script>