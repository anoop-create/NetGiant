@using netGiant.Intranet.BusinessLayer.ViewModels.OMS;
@model AccViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.SubTitle = Model.Account.AccountId > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle Account</h4>

        <div class="form-horizontal">
            @using (Html.BeginForm("SaveAccount", "Acc", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(x => x.Account.AccountId)

                <div class="AccountTabs" style="background:none;">
                    <ul>
                        <li>
                            <a href="#ContactDetailsTab">Contact Details</a>
                        </li>
                        <li>
                            <a href="#AccountFinancialTab">Financial</a>
                        </li>
                        <li>
                            <a href="#AccountNotesTab">Notes</a>
                        </li>
                    </ul>

                    <div id="ContactDetailsTab">
                        <fieldset class="g-m-t-20">
                            <legend>Contact Details</legend>

                            <div class="form-group">
                                @Html.Label("Short Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Account.ShortName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.Account.ShortName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Account Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Account.Name, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.Account.Name, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div id="AccountFinancialTab">
                        <fieldset class="g-m-t-20">
                            <legend>Financial</legend>

                            <div class="form-group">
                                @Html.Label("VAT Number", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Account.VatNumber, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.Account.VatNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Sage Nominal Account", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Account.SageNominalAccount, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.Account.SageNominalAccount, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Credit Limit", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.Account.CreditLimit, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.Account.CreditLimit, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Account Type", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                     model => model.Account.AccountTypeFk,
                     Model.AccountTypeList,
                     "Select...",
                     new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                     )
                                    @Html.ValidationMessageFor(model => model.Account.AccountTypeFk, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Credit Status", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                                         model => model.Account.CreditStatusFk,
                                         Model.CreditStatusList,
                                         "Select...",
                                         new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                     )
                                    @Html.ValidationMessageFor(model => model.Account.CreditStatusFk, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Account Status", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                                         model => model.Account.AccountStatusFk,
                                         Model.AccountStatusList,
                                         "Select...",
                                         new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                         )
                                    @Html.ValidationMessageFor(model => model.Account.AccountStatusFk, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Payment Method", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                                         model => model.Account.PaymentMethodFk,
                                         Model.PaymentMethodList,
                                         "Select...",
                                         new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                         )
                                    @Html.ValidationMessageFor(model => model.Account.PaymentMethodFk, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                                         model => model.Account.WebsiteFk,
                                         Model.WebsiteList,
                                         "Select...",
                                         new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                         )
                                    @Html.ValidationMessageFor(model => model.Account.WebsiteFk, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Customer Group", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(
                                         model => model.Account.CustomerGroupFk,
                                         Model.CustomerGroupList,
                                         "Select...",
                                         new { @class = "g-f-l form-control g-smallCell g-m-r-10" }
                                         )
                                    @Html.ValidationMessageFor(model => model.Account.CustomerGroupFk, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div id="AccountNotesTab">
                        <fieldset class="g-m-t-20">
                            <legend>Notes</legend>

                            <div class="form-group">
                                @Html.Label("Customer Notes", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.TextAreaFor(model => model.Account.CustomerNotes, new { htmlAttributes = new { @class = "form-control" }, style = "max-width:500px; height:100px;" })
                                    @Html.ValidationMessageFor(model => model.Account.CustomerNotes, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </fieldset>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="SaveAccount" value="Save" class="btn btn-default" title="Save" />

                        @Html.ActionLink(
                     linkText: "Cancel",
                     actionName: "ViewAccount",
                     controllerName: "Acc",
                     routeValues: new { id = Model.Account.AccountId },
                     htmlAttributes: new { @class = "btn btn-default" }
                     )
                    </div>
                </div>
            }









            <div class="AccountTabs2" style="background:none;">
                <ul>
                    <li>
                        <a href="#AccountContactsTab">Contacts</a>
                    </li>
                    <li>
                        <a href="#AccountAddressesTab">Addresses</a>
                    </li>
                </ul>

                <div id="AccountContactsTab">
                    <fieldset class="g-m-t-20">
                        <legend>Contacts</legend>

                        <table class="table g-bc-w">
                            <tr>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Tel No.</th>
                                <th>Date Joined</th>

                                <th></th>
                            </tr>
                            @foreach (var cl in Model.ContactList)
                            {
                                <tr>
                                    <td>@cl.FirstName.ToString() @cl.LastName.ToString()</td>
                                    <td>@cl.Email.ToString()</td>
                                    <td>@cl.TelephoneNumber.ToString()</td>
                                    <td>@(cl.DateJoined.HasValue ? cl.DateJoined.Value.ToString("dd/MM/yyyy") : " - ")</td>
                                    <td>
                                        <a href="../ViewContact/@cl.ContactId.ToString()">View</a>
                                        |
                                        <a href="../EditContact/@cl.ContactId.ToString()">Edit</a>
                                    </td>
                                </tr>
                            }
                        </table>
                    </fieldset>
                </div>

                <div id="AccountAddressesTab">
                    <fieldset class="g-m-t-20">
                        <legend>Adresses</legend>
                        <table class="table g-bc-w">
                            <tr>
                                <th>Type</th>
                                <th>Line 1</th>
                                <th>Line 2</th>
                                <th>Line 3</th>
                                <th>Line 4</th>
                                <th>Line 5</th>
                                <th>Postcode</th>
                                <th></th>
                            </tr>
                            @foreach (var al in Model.AddressList)
                            {
                                <tr>
                                    <td>@al.AddressType.ToString()</td>
                                    <td>@al.Line1.ToString()</td>
                                    <td>@al.Line2.ToString()</td>
                                    <td>@al.Line3.ToString()</td>
                                    <td>@al.Line4.ToString()</td>
                                    <td>@al.Line5.ToString()</td>
                                    <td>@al.Postcode.ToString()</td>
                                    <td>
                                        <a href="../ViewAddress/@al.AddressId.ToString()">View</a>
                                        |
                                        <a href="../EditAddress/@al.AddressId.ToString()">Edit</a>
                                    </td>
                                </tr>
                            }
                        </table>
                    </fieldset>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $(".AccountTabs").tabs();
        $(".AccountTabs2").tabs();
    });

</script>