@using netGiant.Intranet.BusinessLayer.ViewModels.OMS;
@model PurchaseOrderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.SubTitle = Model.PurchaseOrderLine.PurchaseOrderLineId > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle PurchaseOrderLine</h4>

        <div class="form-horizontal">
            @using (Html.BeginForm("SavePurchaseOrderLine", "PurchaseOrder", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                @Html.HiddenFor(x => x.PurchaseOrderLine.PurchaseOrderLineId)

                <div class="PurchaseOrderLineTabs" style="background:none;">
                    <ul>
                        <li>
                            <a href="#PurchaseOrderLineDetails">PurchaseOrderLine Details</a>
                        </li>
                    </ul>
                </div>

                <div id="PurchaseOrderLineDetails">
                    <fieldset class="g-m-t-20">
                        <legend>PurchaseOrder Line Details</legend>

                        <div class="form-group">
                            @Html.Label("Description", htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.PurchaseOrderLine.Description, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                @Html.ValidationMessageFor(model => model.PurchaseOrderLine.Description, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </fieldset>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            <input type="submit" name="SavePurchaseOrderLine" value="Save" class="btn btn-default" title="Save" />

                            @Html.ActionLink(
                            linkText: "Cancel",
                            actionName: "ViewPurchaseOrderLine",
                            controllerName: "PurchaseOrder",
                            routeValues: new { id = Model.PurchaseOrderLine.PurchaseOrderLineId },
                            htmlAttributes: new { @class = "btn btn-default" }
                            )
                        </div>
                    </div>
                </div>
             }
        </div>
    </div>
</div>

<script>

    $(document).ready(function () {
        $(".PurchaseOrderLineTabs").tabs();
    });

</script>
