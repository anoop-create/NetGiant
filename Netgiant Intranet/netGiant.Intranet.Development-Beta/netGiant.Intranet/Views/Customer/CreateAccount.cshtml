@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $("#AccountEntry_DateOfApplication").datepicker({ dateFormat: 'dd/mm/yy' });
        });

        $(function () {
            $.validator.addMethod('date',
                function (value, element) {
                    if (this.optional(element)) {
                        return true;
                    }
                    var ok = true;
                    try {
                        $.datepicker.parseDate('dd/mm/yy', value);
                    }
                    catch (err) {
                        ok = false;
                    }
                    return ok;
                });
            $('#CustomerEntry_AccountStatusId').val($('#AccountEntry_StatusId').val());
            $('#AccountEntry_CustomerTypeId').val($('#CustomerEntry_CustomerTypeId').val());
            $(document).on("change",
                "#AccountEntry_StatusId",
                function () {
                    $('#CustomerEntry_AccountStatusId').val($('#AccountEntry_StatusId').val());
                });
            $(document).on("change",
                "#CustomerEntry_CustomerTypeId",
                function () {
                    $('#AccountEntry_CustomerTypeId').val($('#CustomerEntry_CustomerTypeId').val());
                });
        });
    </script>
}
