    <!-- Add the checkout buttons, set up the order and approve the order -->
    <script>
        paypal.Buttons({
            fundingSource: paypal.FUNDING.PAYPAL,
            style: {
                layout: 'vertical'
                , shape: 'rect'
                , label: 'checkout'
            },
            createOrder: function (data, actions) {
                return actions.order.create({
                    intent: "AUTHORIZE",
                    purchase_units: [{
                        amount: {
                            value: '0.01'
                        }
                    }],
                    payment_initiator: 'CUSTOMER'
                });
            },
            onApprove: function (data, actions) {
                return actions.order.authorize().then(function (details) {
                    var detailsJson = JSON.stringify(details);
                    $.ajax({
                        url: '/Test/PayPalCapture',
                        method: 'POST',
                        dataType: 'json',
                        async: false,
                        cache: false,
                        data: {
                            trans: detailsJson
                        },
                        success: function (data) {
                            if (data.IsSuccess) {
                                alert('Success.');
                            } else {
                                alert('Not Success');
                            }
                        },
                        error: function (xhr, textStatus, thrownError) {
                            alert('Application eror');
                        }
                    });
                });
            },
            onCancel: function (data) {
                alert('You decided to cancel the operation.');
            },
            onError: function (err) {
                alert('Paypal eror');
            }
        }).render('#paypal-button-container1');





