@using netGiant.Intranet.BusinessLayer.ViewModels.Reports;

@foreach (var code in Model)
{
    <tr>
        <td class="g-w-15p">
            @{ string codeName = (code.AXISGroupNo != null ? code.AXISGroupNo + " - " : "") + code.categoryCodeName; }

            @Html.ActionLink(codeName, "Create", "CategoryCode", new { area = "PMS", id = code.categoryCodeID }, null)

            @if (code.ProductCount > 0)
            {
                string codeCount = "(" + code.ProductCount + ")";
                @Html.ActionLink(codeCount, "ProductList", "CategoryCodeStructure", new { id = code.categoryCodeID }, new { @class = "showProducts", value = code.categoryCodeID })
            }
        </td>
    </tr>
