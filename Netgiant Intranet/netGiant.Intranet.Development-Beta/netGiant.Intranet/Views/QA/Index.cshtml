@using netGiant.Intranet.BusinessLayer.ViewModels.QA;
@model QAViewModel

@{
    ViewBag.Title = "Questions & Answers";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@Html.Hidden("DeleteEntryURL", Url.Action("DeleteEntry", "QA"))

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "Create", "QA", new { id = 0 }, new { @title = "Create new question", @class = "g-p-10" })
}

@(Html.Kendo().Grid<QAViewModel.TelerikQA>
    ()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("qaEntryGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.Question).Title("Question").Width("700px");
        columns.Bound(x => x.Id).Title("Part No")
            .HtmlAttributes(new { style = "text-align: center" })
            .ClientTemplate("<a target=\"_blank\" href=\"#:ProductUrl#\" title=\"\">#:ProductID#</a>")
            .Width("90px");
        columns.Bound(x => x.EquipmentName).Title("Equipment")
            .ClientTemplate("<a target=\"_blank\" href=\"#:EquipmentURL#\" title=\"\">#:EquipmentName#</a>")
            .Width("220px");
        columns.Bound(x => x.Id).Title("Asked Date").ClientTemplate("#= kendo.toString(kendo.parseDate(AskedDate, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') #").Width("100px");
        columns.Bound(x => x.Id).Title("Replied Date").ClientTemplate("#= kendo.toString(kendo.parseDate(RepliedDate, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') #").Width("100px");
        columns.Bound(x => x.RepliedBy).Title("Replied By");
        columns.Bound(x => x.Granularity).Title("Granularity");
        columns.Bound(x => x.Id).Title("Source Website")
            .HtmlAttributes(new { style = "text-align: center" })
            .ClientTemplate("<img src=\"#:WebsiteLogoUrl#\" alt=\"#:WebsiteName#\" title=\"#:WebsiteName#\" class=\"qa_WebsiteImage\" />")
            .Width("90px");

        columns.Bound(x => x.Id).ClientTemplate(
        "<a href=\"Create/#:Id#\">Edit</a>" +
        "|<a href=\"##\" class=\"lnkEntryDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
        ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int>
        { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable.AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .NoRecords("There are no questions to display")
        .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("QAEntry_Read", "QA"))
        .PageSize(200)
        .Sort(sort => sort
        .Add(x => x.AskedDate).Descending())
        )
        .Events(e => e.DataBound("saveGridFilters"))
        )

        <div id="qaEntryDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this entry?
        </div>

        <script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkEntryDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Q&A Entries',
                content: 'Are you sure you want to delete this entry?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("Delete", "QA")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
        </script>
