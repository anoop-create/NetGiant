@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CMSViewModel

@{
    ViewBag.Title = "CMS Section";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateSection", "CMS", new { id = 0 }, new { @title = "Create new CMS section", @class = "g-p-10" })
}

@(Html.Kendo().Grid<CMSViewModel.TelerikEntry>()
        .HtmlAttributes(new { @class = "pointer-rows" })
        .Name("cmsSectionGrid")
        .Columns(columns =>
        {
            columns.Bound(x => x.Website).Title("Website").Width("200px")
                .HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
            columns.Bound(x => x.Name).Title("Section Name")
                .HeaderHtmlAttributes(new { title = "Section Name", style = "text-align: center;" });
            columns.Bound(x => x.Id).ClientTemplate(
                    "<a href=\"CreateSection/#:Id#\">Edit</a>" +
                    "|<a href=\"##\" class=\"lnkSectionDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                    ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable.AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .NoRecords("There are no products to display")
        .DataSource(dataSource => dataSource
            .Ajax()
            .Read(x => x.Action("CMSSection_Read", "CMS"))
            .PageSize(200)
        )
        .Events(e => e.DataBound("saveGridFilters"))
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkSectionDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'CMS Sections',
                content: 'Are you sure you want to delete this section?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteSection", "CMS")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>