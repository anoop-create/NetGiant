@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CMSViewModel

@{
    ViewBag.Title = "CMS Entries";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
    @Html.RawFromDict(Model.IntranetData, "CMSEntriesFilters")
</div>

@Html.Hidden("DeleteEntryURL", Url.Action("DeleteEntry", "CMS"))

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateEntry", "CMS", new { id = 0 }, new { @title = "Create new CMS entry", @class = "g-p-10" })
}

@(Html.Kendo().Grid<CMSViewModel.TelerikEntry>()
            .HtmlAttributes(new { @class = "pointer-rows" })
            .Name("cmsEntryGrid")
            .Columns(columns =>
            {
                columns.Bound(x => x.Website).Title("Website").Width("150px")
                    .HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
                columns.Bound(x => x.Group).Title("Group Name").Width("150px")
                    .HeaderHtmlAttributes(new { title = "Group Name", style = "text-align: center;" });
                columns.Bound(x => x.Section).Title("Section Name")
                    .HeaderHtmlAttributes(new { title = "Section Name", style = "text-align: center;" });
                columns.Bound(x => x.Name).Title("Entry Name")
                    .HeaderHtmlAttributes(new { title = "Entry Name", style = "text-align: center;" });
                columns.Bound(x => x.Content).Title("Content")
                    .HeaderHtmlAttributes(new { title = "Content", style = "text-align: center;" });
                columns.Bound(x => x.Notes).Title("Notes")
                    .HeaderHtmlAttributes(new { title = "Notes", style = "text-align: center;" });
                columns.Bound(x => x.Id).ClientTemplate(
                        "<a href=\"CreateEntry/#:Id#\">Edit</a>" +
                        "|<a href=\"##\" class=\"lnkEntryDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                        ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable.AllowUnsort(true))
            .Groupable()
            .Scrollable()
            .Filterable(filter => filter.Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no CMS entries to display")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(x => x.Action("CMSEntry_Read", "CMS"))
                .PageSize(200)
            )
            .Events(e => e.DataBound("saveGridFilters"))
)

<div id="cmsEntryDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this entry?
</div>

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkEntryDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'CMS Entries',
                content: 'Are you sure you want to delete this entry?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteEntry", "CMS")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>