
@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CMSViewModel

@{
    ViewBag.Title = "Event Maintenance";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section AddTags
{
    <link href="~/Content/font-awesome.min.css" rel="stylesheet">
}

<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
    @Html.RawFromDict(Model.IntranetData, "EventMappingFilters")
</div>

@Html.Hidden("DeleteEntryURL", Url.Action("DeleteEntry", "CMS"))

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    <div class="g-m-l-10">
        <a class="lnk g-cur-p" data-url="@Url.Action("CreateEvent", "CMS")/0">Create New Event</a>
    </div>
}

@(Html.Kendo().Grid<CMSViewModel.TelerikEventData>()
    .HtmlAttributes(new {@class = "pointer-rows g-m-t-10"})
    .Name("EventMappingGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.Website).Hidden(true);
        columns.Bound(x => x.Event).Title("Event").Hidden(true)
            .ClientGroupHeaderTemplate(
                "Event: #= fixEvent(data, 0) # <a class=\"lnk g-cur-p\" data-url=\"" + Url.Action("CreateEvent", "CMS") +
                "/" + "#= fixEvent(data, 1) #\">[Edit Event]</a>"
            );
        columns.Bound(x => x.DefaultCmsSection).Title("Default CMS Section").Width("200px");
        columns.Bound(x => x.DefaultCmsEntry).Title("Default CMS Entry");
        columns.Bound(x => x.MappedCmsEntry).Title("Mapped CMS Entry").ClientTemplate(
            "<a href=\"" + Url.Action("CreateEntry", "CMS") + "/#:MappedCmsEntryId#\">#:MappedCmsEntry#</a>");
        columns.Bound(x => x.DateActivate).Title("Date Active").Format("{0:dd/MM/yyyy HH:mm:ss}").Width(140);
        columns.Bound(x => x.DateInactive).Title("Date In-Active").Format("{0:dd/MM/yyyy HH:mm:ss}").Width(140);
        columns.Bound(x => x.IsActive).Title("Currently Active").Width(140);
        columns.Bound(x => x.Id).ClientTemplate(
            "<a class=\"lnk g-cur-p\" data-url=\"" + Url.Action("CreateEventMapping", "CMS") + "/#:Id#?cmsEntryId=#:CmsEntryId#\">Edit</a>" +
            "|<a href=\"##\" class=\"lnkDelete g-cur-p\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
            ).Width("136px").Filterable(false).Sortable(false).Groupable(false).Title("Actions");
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int>
    {400, 600, 800}))
    .Sortable(sortable => sortable.AllowUnsort(true))
    .Scrollable()
    .Groupable()
    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
    .ColumnMenu()
    .Resizable(resize => resize.Columns(true))
    .Reorderable(reorder => reorder.Columns(true))
    .NoRecords("There is no data to display")
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("EventData_Read", "CMS"))
        .Sort(sort =>
        {
            sort.Add(x => x.Website).Descending();
            sort.Add(x => x.Event).Ascending();
            sort.Add(x => x.DefaultCmsEntry).Ascending();
        })
        .PageSize(400)
        .Group(group =>
        {
            group.Add(x => x.Website);
            group.Add(x => x.Event);
        })
    )
    .Events(e => e.DataBound("onDataBind"))
)

<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document" style="width: 1000px;">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel"></h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button id="close-modal" type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Delete Event Mapping',
                content: 'Are you sure you want to delete this Event Mapping?',
                type: 'orange',
                icon: 'fa fa-warning',
                animation: 'zoom',
                animateFromElement: false,
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteEventMapping", "CMS")/', { id: rowid });
                    },
                    No: function () { }
                }
            });

            $('#myModal').on('hidden.bs.modal', function (e) {
                $('#myModal').find('.modal-body').empty();
                $('.k-grid').data('kendoGrid').dataSource.read();
                //$('.k-grid').data('kendoGrid').refresh();
            });
        });

        $(document).on("click", ".lnk", function () {
            var url = $(this).attr('data-url');
            $('#myModal').find('.modal-body').empty();
            $.ajax({
                url: url
            }).done(function (data) {
                $('#myModal').find('.modal-body').html(data);
                addDatePicker();
            });
            $('#myModal').modal();
        });
    });

    function addDatePicker() {
        // create DateTimePicker
        $("#Event_DateActive, #Event_DateInactive").kendoDateTimePicker({
            format: "yyyy/MM/dd hh:mm tt",
            change: function () {
                if ($(this)[0].element.context.id = 'Event_DateActive') {
                    var startPicker = $("#Event_DateActive").data("kendoDateTimePicker");
                    var endPicker = $("#Event_DateInactive").data("kendoDateTimePicker");
                    var startDate = startPicker.value();
                    if (startDate) {
                        var newEndDate = new Date(startDate);
                        newEndDate.setDate(newEndDate.getDate() + 1);
                        endPicker.min(newEndDate);
                        endPicker.value(newEndDate);
                    }
                }
            }
        });
    }   

    function fixEvent(e, i) {
        return e.value.split("|")[i];
    }

    function onDataBind() {
        saveGridFilters();
        var grid = this;
        $(".k-grouping-row").each(function (e) {
            if ($(this).html().indexOf('colspan="8"') > 0) { // <== Depends on No. on columns in the Grid
                grid.collapseGroup(this);
            }
        });
    }

    function ajaxReturn(data) {
        var response = data.responseJSON;
        $.confirm({
            title: response.type,
            content: response.savereturn.Message,
            type: response.savereturn.IsSuccess ? 'green' : 'red',
            icon: response.savereturn.IsSuccess ? 'fa fa-check' : 'fa fa-warning',
            animation: 'zoom',
            animateFromElement: false,
            buttons: {
                OK: function () {
                    if (response.savereturn.IsSuccess) {
                        $('#close-modal').click();
                    }
                }
            }
        });
        return false;
    }  
</script>

