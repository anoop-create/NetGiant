@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.Orders;
@model BackOrderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Back Orders";
}

<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
    @Html.RawFromDict(Model.IntranetData, "BackOrderFilters")

    @using (Html.BeginForm("ExportBackOrder", "BackOrder", FormMethod.Post, new { @id = "ExportForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("kendoData")
    }

    <input type="submit" class="btn btn-success g-m-t-5 download" value="Export to CSV" />
</div>

@(Html.Kendo().Grid<TelerikBackOrder>
    ()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("BackOrderGrid")
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("BackOrder_Read", "BackOrder"))
        .PageSize(200)
        .Filter(f => f.Add(x => x.Status).IsEqualTo("Open"))
        .Sort(sort => sort.Add(x => x.OrderDate).Ascending())
        .Aggregates(agg => {
            agg.Add(f => f.CostValue).Sum();
            agg.Add(f => f.SellValue).Sum();
        })
    )
    .Columns(columns =>
    {
        columns.Bound(x => x.Id).Title("Id").Hidden().Width(80);
        columns.Bound(x => x.OrderReference).Title("Order Reference").Width(100).HeaderHtmlAttributes(new { title = "Order Reference", style = "text-align: center;" })
            .HeaderHtmlAttributes(new { title = "Order Reference", style = "text-align: center;" });
        columns.Bound(x => x.PurchaseOrderNumber).Title("PO Number").Width(100)
            .HeaderHtmlAttributes(new { title = "PO Number", style = "text-align: center;" });
        columns.Bound(x => x.Provider).Title("Provider").Width(130)
            .HeaderHtmlAttributes(new { title = "Provider", style = "text-align: center;" })
            .ClientGroupHeaderTemplate("Provider: #=kendo.toString(value)# | Total Cost: #=kendo.toString(aggregates.CostValue.sum, 'N2')# | Total Nett: #=kendo.toString(aggregates.SellValue.sum, 'N2')#");
        columns.Bound(x => x.SupplierOrderNumber).Title("Supplier Order Number").Width(120)
            .HeaderHtmlAttributes(new { title = "Supplier Order Number", style = "text-align: center;" });
        columns.Bound(x => x.OrderDate).Title("Order Date").Format("{0:dd/MM/yyyy}").Width(100)
            .HeaderHtmlAttributes(new { title = "Order Date", style = "text-align: center;" });
        columns.Bound(x => x.CustomerName).Title("Customer Name").Width(150)
            .HeaderHtmlAttributes(new { title = "Customer Name", style = "text-align: center;" })
            .ClientGroupFooterTemplate("<div class=\"g-a-r\">Sub Totals:</div>")
            .ClientFooterTemplate("<div class=\"g-a-r\">Totals:</div>");
        columns.Bound(x => x.CostValue).Title("Cost Value").Width(80)
            .Format("{0:N2}")
            .HtmlAttributes(new { style = "text-align: right;" })
            .HeaderHtmlAttributes(new { title = "Total Cost Value", style = "text-align: center;" })
            .FooterHtmlAttributes(new { style = "text-align: right;" })
            .ClientGroupFooterTemplate("#=kendo.toString(sum, 'N2')#")
            .ClientFooterTemplate("#=kendo.toString(sum, 'N2')#");
        columns.Bound(x => x.SellValue).Title("Nett Value").Width(80)
            .Format("{0:N2}")
            .HtmlAttributes(new { style = "text-align: right;" })
            .HeaderHtmlAttributes(new { title = "Total Retail Value (ex VAT)", style = "text-align: center;" })
            .FooterHtmlAttributes(new { style = "text-align: right;" })
            .ClientGroupFooterTemplate("#=kendo.toString(sum, 'N2')#")
            .ClientFooterTemplate("#=kendo.toString(sum, 'N2')#");
        columns.Bound(x => x.Status).Title("Status").Width(90)
            .HeaderHtmlAttributes(new { title = "Status", style = "text-align: center;" });
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int>
        { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable
        .AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(ftb => ftb
        .Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .Excel(excel => excel
        .AllPages(true)
        .FileName("Grid Export")
        .Filterable(true)
        .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
        .NoRecords("There are no back orders")
        .Events(events => events.Change("Grid_OnRowSelect"))
        .Events(events => events.DataBound("Grid_OnDataBound"))
        .Selectable()
        )
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document" style="width: 1500px;">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel"></h4>
            </div>
            <div class="modal-body">
                @Html.HiddenFor(m => m.BackOrderEntry.BackOrderId, new { id = "modal-backorder-id" })
                <iframe src="" width="100%" height="600" scrolling="no"></iframe>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts
    {
    <script type="text/javascript">

        $(function () {
            $('#myModal').on('shown.bs.modal', function (event) {
                $('iframe').attr('src', 'BackOrderItem/' + $('#modal-backorder-id').val());
            });
        });

        $('#log-grid').on('click', function () {
            $('iframe').attr('src', 'BackOrderItem/' + $('#modal-backorder-id').val());
        });

        var Grid_OnRowSelect = function (e) {
            var data = this.dataItem(this.select());
            $('#modal-backorder-id').val(data.Id);
            $('#myModal').modal();
        }

        function Grid_OnDataBound() {
            $("#BackOrderGrid tr.k-alt").removeClass("k-alt");

            var grid = this;
            var currentRecords = grid.dataSource.view();
            for (var i = 0; i < currentRecords.length; i++) {
                //currentRecords[i] is the current dataItem
                if (currentRecords[i].HasError) {
                    grid.tbody.find("tr[data-uid='" + currentRecords[i].uid + "']").removeClass("k-alt").addClass("g-bc-r").addClass("g-fc-w");
                }
            }
            saveGridFilters();
        }

        $(document).on('click', '.switchStatus', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Back Orders',
                content: 'Are you sure you want to switch the status of this back order?',
                buttons: {
                    Yes: function () {
                        switchStatus('@Url.Action("SwitchStatus", "BackOrder")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });

        function switchStatus(url, data) {
            $('body').append('<div id="updatingContainer"></div>');

            $.ajax({
                type: "POST",
                url: url,
                data: data,
                success: function (data) {
                    if (data.saveReturn.IsSuccess) {
                        $('.k-grid').data('kendoGrid').dataSource.read();
                        $('.k-grid').data('kendoGrid').refresh();
                    } else {
                        $.alert({
                            title: 'Error!',
                            content: data.saveReturn.Message
                        });
                    }
                },
                error: function (e) {
                    $.alert({
                        title: 'Error!',
                        content: e.responseText
                    });
                }
            });

            $('#updatingContainer').remove();
        }

        $(document).on('click', '.download', function (e) {
            var view = $("#BackOrderGrid").data("kendoGrid").dataSource.view();
            $('#kendoData').val(encodeURIComponent(JSON.stringify(view)));
            $('#ExportForm').submit();
        });
    </script>
}





