@using netGiant.Intranet.BusinessLayer.ViewModels.Reports;
@using System.Globalization;
@using System.Data;
@model ReportsViewModel

@{
    int websiteFK = ViewBag.website;
    var siteName = "";
    decimal grossProfitPercentage = 0;
    decimal grossProfit = 0;
    decimal orders = 0;
    decimal sales = 0;
    decimal totalGrossProfit = 0;
    decimal totalRevenue = 0;
    decimal graphActual = 0;
    var stretchTarget = Convert.ToDecimal(Session["StretchTarget"].ToString() != "" ? Session["StretchTarget"] : 0);
    var baseTarget = Convert.ToDecimal(Session["BaseTarget"].ToString() != "" ? Session["BaseTarget"] : 0);
    decimal dStretchHeight = 17;
    string stretchHeight = dStretchHeight.ToString() + "%";
    string baseHeight = (100 - dStretchHeight).ToString() + "%";


    string showSales = "initial";
    string showIT = "none";

    switch (websiteFK)
    {
        case 1:
            siteName = "TONERGIANT";
            grossProfitPercentage = Model.TonergiantGrossProfitPercentage;
            grossProfit = Model.TonergiantGrossProfit;
            orders = Model.TonergiantOrders;
            sales = Model.TonergiantSales;
            showSales = "initial";
            showIT = "none";
            break;
        case 2:
            siteName = "CARTRIDGE MONKEY";
            grossProfitPercentage = Model.CartridgeMonkeyGrossProfitPercentage;
            grossProfit = Model.CartridgeMonkeyGrossProfit;
            orders = Model.CartridgeMonkeyOrders;
            sales = Model.CartridgeMonkeySales;
            showSales = "initial";
            showIT = "none";
            break;
        case 3:
            siteName = "TOTALS";
            grossProfitPercentage = Model.TotalGrossProfitPercentage;
            grossProfit = Model.TotalGrossProfit;
            orders = Model.TotalOrders;
            sales = Model.TotalRevenue;
            showSales = "initial";
            showIT = "none";
            break;
        case 4:
            showSales = "none";
            showIT = "initial";
            break;
    }

    totalGrossProfit = Math.Floor(Model.TotalGrossProfit);
    totalRevenue = Math.Floor(Model.TotalRevenue);

    decimal percentage, basePercentage, stretchPercentage, overflowPercentage;
    string[] graphLabels;
    if (Convert.ToBoolean(ViewBag.targetsAreRevenue))
    {
        percentage = baseTarget > 0 ? totalRevenue / baseTarget * 100 : totalRevenue / 1 * 100;
        basePercentage = Math.Min(totalRevenue, baseTarget) / baseTarget * (100 - dStretchHeight);
        stretchPercentage = Math.Min(Math.Max(totalRevenue - baseTarget, 0), stretchTarget - baseTarget) / (stretchTarget - baseTarget) * (dStretchHeight);
        overflowPercentage = Math.Max(totalRevenue - stretchTarget, 0) / baseTarget * (100 - dStretchHeight);
        graphLabels = new string[] { "SALES", "SALES TARGET", "SALES TODAY" };
        graphActual = totalRevenue;
    }
    else
    {
        percentage = baseTarget > 0 ? totalGrossProfit / baseTarget * 100 : totalGrossProfit / 1 * 100;
        basePercentage = Math.Min(totalGrossProfit, baseTarget) / baseTarget * (100 - dStretchHeight);
        stretchPercentage = Math.Min(Math.Max(totalGrossProfit - baseTarget, 0), stretchTarget - baseTarget) / (stretchTarget - baseTarget) * (dStretchHeight);
        overflowPercentage = Math.Max(totalGrossProfit - stretchTarget, 0) / baseTarget * (100 - dStretchHeight);
        graphLabels = new string[] { "GROSS PROFIT", "GP TARGET", "GP TODAY" };
        graphActual = totalGrossProfit;
    }
    var chartPercentage = basePercentage + stretchPercentage + overflowPercentage;

    string targetHeight = "100%";
    string targetTop = "0px";
    if (chartPercentage > 100)
    {
        targetHeight = (200 - chartPercentage).ToString() + "%";
        targetTop = (chartPercentage - 100).ToString() + "%";
    }

    string backgroundCss = "wb_barColour1";
    if (percentage >= 50 && percentage <= 79)
    {
        backgroundCss = "wb_barColour5";
    }

    if (percentage > 79 && percentage <= 100)
    {
        backgroundCss = "wb_barColour6";
    }

    if (graphActual >= baseTarget)
    {
        backgroundCss = "wb_barColour2";
    }

    if (graphActual >= stretchTarget)
    {
        backgroundCss = "wb_barColour4";
    }
}

@Html.Hidden("targetsURL", Url.Action("WallBoardTargets", "Reports"))

@Html.ValidationSummary("", new { @class = "text-danger g-fs-2em" })

<div id="wallBoardDynamicData">
    <div class="wb_dynamicContainer" style="display:@showSales">
        <div class="g-f-l wb_leftContainer">
            <div class="wb_SiteNameHeader">@siteName</div>
            <div class="wb_dataContainer">
                <div class="wb_dataText g-fc-bl g-a-c g-f-l">ORDERS</div>
                <div class="wb_data g-f-l"><div class="g-fc-bl">@orders</div></div>
                <div class="wb_arrow"></div>
            </div>
            <div class="wb_dataContainer">
                <div class="wb_dataText g-a-c g-fc-bl g-f-l">SALES</div>
                <div class="wb_data g-f-l"><div class="g-fc-bl">£@string.Format("{0:N0}", sales)</div></div>
                <div class="wb_arrow"></div>
            </div>
            <div class="wb_dataContainer">
                <div class="wb_dataText g-f-l g-fc-bl">GP</div>
                <div class="wb_data g-f-l"><div class="g-fc-bl">£@string.Format("{0:N0}", Math.Floor(grossProfit))</div></div>
                <div class="wb_arrow"></div>
            </div>
            <div class="wb_dataContainer">
                <div class="wb_dataText g-f-l g-fc-bl">GP %</div>
                <div class="wb_data g-f-l"><div class="g-fc-bl">@grossProfitPercentage%</div></div>
                <div class="wb_arrow"></div>
            </div>
        </div>

        <div class="wb_rightContainer g-f-r">
            <div class="wb_graphHeader">
                @graphLabels[0]
                <div class="wb_arrow2"></div>
            </div>
            <div class="wb-spacer"></div>
            <div class="wb_graphContainer">
                <div class="wb_graphLeftContainer g-f-l g-ps-r" style="height: @targetHeight; top: @targetTop;">
                    <div class="wb_barChartStretchTargetContainer" style="height: @stretchHeight">
                        <div class="wb_stretchTargetText">STRETCH</div>
                        <div class="wb_stretchTargetData">£@string.Format("{0:N0}", stretchTarget)</div>
                    </div>
                    <div class="wb_barChartTargetContainer" style="height: @baseHeight">
                        <div class="wb_baseTargetText">BASE</div>
                        <div class="wb_baseTargetData">£@string.Format("{0:N0}", baseTarget)</div>
                        <div class="wb_gpText">@graphLabels[1]</div>
                    </div>
                </div>
                <div class="wb_graphRightContainer g-f-l">
                    <div class="wb_barChartGPContainer">
                        <div class="wb_gpBar @backgroundCss" style="height: @string.Format("{0:N0}", chartPercentage)%;">
                            <div class="wb_gpText">@graphLabels[2]</div>
                            <div class="wb_gpTodayData">£@string.Format("{0:N0}", graphActual)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="wb_graphFooter"></div>
        </div>
    </div>

    <div class="wb_dynamicContainer" style="display:@showIT">
        <div>
            <div class="wb_SiteNameHeader" style="position:absolute;">IT</div>
            <div class="wb_ITdataContainer">
                <div class="wallboardIT_row" style="margin-bottom: -10px;">
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell wallboardIT_left">
                        ORDERS
                    </div>
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell wallboardIT_slim">
                        HOUR
                    </div>
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell wallboardIT_slim">
                        DAY
                    </div>
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell wallboardIT_wide">
                        WEEK
                    </div>
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell wallboardIT_wide">
                        MONTH
                    </div>
                </div>

                <div class="wallboardIT_row">
                    <div class="wallboardIT_cell wallboardIT_whitecell wallboardIT_left">
                        SAGE
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "SAGEPAY").hour
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "SAGEPAY").day
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "SAGEPAY").week
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "SAGEPAY").month
                    </div>
                </div>

                <div class="wallboardIT_row">
                    <div class="wallboardIT_cell wallboardIT_whitecell wallboardIT_left">
                        PAYPAL
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "PAYPAL").hour
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "PAYPAL").day
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "PAYPAL").week
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "PAYPAL").month
                    </div>
                </div>

                <div class="wallboardIT_row">
                    <div class="wallboardIT_cell wallboardIT_whitecell wallboardIT_left">
                        AMAZON
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "AMAZON").hour
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_slim">
                        @Model.itTableList.Find(x => x.rowname == "AMAZON").day
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "AMAZON").week
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_wide">
                        @Model.itTableList.Find(x => x.rowname == "AMAZON").month
                    </div>
                </div>

                <div class="wallboardIT_row" style="margin-bottom: -10px;">
                    <div class="wallboardIT_cell wallboardIT_nobackgroundcell">
                        ECOMMERCE / BATCH ERRORS
                    </div>
                </div>

                <div class="wallboardIT_row">
                    <div class="wallboardIT_cell wallboardIT_whitecell wallboardIT_left" style="background-color:mediumpurple; color:white;">
                        WEB
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_slim" style="@Model.itTableList.Find(x => x.rowname == "WebError").hour">
                        @Model.itTableList.Find(x => x.rowname == "ECOM").hour
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_slim" style="@Model.itTableList.Find(x => x.rowname == "WebError").day">
                        @Model.itTableList.Find(x => x.rowname == "ECOM").day
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_wide" style="@Model.itTableList.Find(x => x.rowname == "WebError").week">
                        @Model.itTableList.Find(x => x.rowname == "ECOM").week
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_wide" style="@Model.itTableList.Find(x => x.rowname == "WebError").month">
                        @Model.itTableList.Find(x => x.rowname == "ECOM").month
                    </div>
                </div>

                <div class="wallboardIT_row">
                    <div class="wallboardIT_cell wallboardIT_whitecell wallboardIT_left" style="background-color:mediumpurple; color:white;">
                        BATCH
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_slim" style="@Model.itTableList.Find(x => x.rowname == "BatchError").hour">
                        @Model.itTableList.Find(x => x.rowname == "BATCH").hour
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_slim" style="@Model.itTableList.Find(x => x.rowname == "BatchError").day">
                        @Model.itTableList.Find(x => x.rowname == "BATCH").day
                    </div>
                    <div class="wallboardIT_cell wallboardIT_darkcell wallboardIT_wide" style="@Model.itTableList.Find(x => x.rowname == "BatchError").week">
                        @Model.itTableList.Find(x => x.rowname == "BATCH").week
                    </div>
                    <div class="wallboardIT_cell wallboardIT_lightcell wallboardIT_wide" style="@Model.itTableList.Find(x => x.rowname == "BatchError").month">
                        @Model.itTableList.Find(x => x.rowname == "BATCH").month
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>


    <script type="text/javascript">

        if ($(".wb_gpBar").height() <= 120) {
            $(".wb_gpTodayData").css("margin-top", "-120px");
        }

    </script>
