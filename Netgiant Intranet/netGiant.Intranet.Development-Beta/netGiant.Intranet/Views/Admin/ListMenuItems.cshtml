@using netGiant.Intranet.BusinessLayer.ViewModels.Admin;

@model MenuViewModel

@*@Html.Hidden("MenuDeleteURL", Url.Action("DeleteMenuItem", "Admin"))*@

@{
    ViewBag.Title = "Menu Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@Html.Hidden("DeleteEntryURL", Url.Action("DeleteMenuItem", "Admin"))

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateMenuItem", "Admin", new { id = 0 }, new { @title = "Create new menu item", @class = "g-p-10" })
}

@(Html.Kendo().Grid<MenuViewModel.Telerik>
    ()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("qaEntryGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.TopParent).Title("Top Parent").Width("100px")
            .HeaderHtmlAttributes(new { title = "Top Parent", style = "text-align: center;" });
        columns.Bound(x => x.Parent).Title("Parent").Width("100px")
            .HeaderHtmlAttributes(new { title = "Parent", style = "text-align: center;" });
        columns.Bound(x => x.LinkTitle).Title("Link Title").Width("100px")
            .HeaderHtmlAttributes(new { title = "Link Title", style = "text-align: center;" });
        columns.Bound(x => x.LinkLevel).Title("Link Level").Width("60px")
            .HeaderHtmlAttributes(new { title = "Link Level", style = "text-align: center;" });
        columns.Bound(x => x.LinkUrl).Title("Link URL").Width("80px")
            .HeaderHtmlAttributes(new { title = "Link URL", style = "text-align: center;" });
        columns.Bound(x => x.ActionName).Title("Action Name").Width("100px")
            .HeaderHtmlAttributes(new { title = "Action Name", style = "text-align: center;" });
        columns.Bound(x => x.ControllerName).Title("Controller Name").Width("100px")
            .HeaderHtmlAttributes(new { title = "Controller Name", style = "text-align: center;" });
        columns.Bound(x => x.Area).Title("Area").Width("100px")
            .HeaderHtmlAttributes(new { title = "Area", style = "text-align: center;" });
        columns.Bound(x => x.Roles).Title("Roles").Width("200px")
            .HeaderHtmlAttributes(new { title = "Roles", style = "text-align: center;" });
        columns.Bound(x => x.Active).Title("Active").Width("60px")
            .HeaderHtmlAttributes(new { title = "Active", style = "text-align: center;" });

        columns.Bound(x => x.Id).ClientTemplate(
        "<a href=\"UpdateMenuItem/#:Id#\">Edit</a>" +
        "|<a href=\"##\" class=\"lnkEntryDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
        ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int>
        { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable.AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .NoRecords("There are no menus to display")
        .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("MenuEntry_Read", "Admin"))
        .PageSize(200)
        .Sort(sort => sort.Add(x => x.TopParent).Ascending())
        )
    .Events(e => e.DataBound("saveGridFilters"))
)

<div id="mEntryDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this menu item?
</div>

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkEntryDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Menu Entries',
                content: 'Are you sure you want to delete this entry?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteMenuItem", "Admin")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>
