@using netGiant.Intranet.BusinessLayer.ViewModels.Shared;
@model CommonViewModel
@{
    ViewBag.Title = "Debug Page";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

<div class="container-fluid">
    <div class="row">
        <ul class="nav nav-tabs g-m-t-10">
            <li class="nav active">
                <a href="#cache" data-toggle="tab">Cache</a>
            </li>
            <li class="nav">
                <a href="#session" data-toggle="tab">Session</a>
            </li>
            <li class="nav">
                <a href="#cookie" data-toggle="tab">Cookies</a>
            </li>
            <li class="nav">
                <a href="#app" data-toggle="tab">Application</a>
            </li>
            <li class="nav">
                <a href="#req" data-toggle="tab">Request</a>
            </li>
            <li class="nav">
                <a href="#tools" data-toggle="tab">Tools</a>
            </li>
            <li class="nav pull-right g-bc-tt">
                <a class="g-fc-pt g-fw-b" data-toggle="tab">SERVER: @Request["LOCAL_ADDR"]</a>
            </li>
        </ul>
        <div class="tab-content g-p-t-10 g-bc-w">
            <div class="tab-pane fade in active" id="cache">
                @{Html.RenderPartial("_Cache", Model);}
            </div>
            <div class="tab-pane fade" id="session">
                @{Html.RenderPartial("_Session", Model);}
            </div>
            <div class="tab-pane fade" id="cookie">
                @{Html.RenderPartial("_Cookie", Model);}
            </div>
            <div class="tab-pane fade" id="app">
                @{Html.RenderPartial("_Application", Model);}
            </div>
            <div class="tab-pane fade" id="req">
                @{Html.RenderPartial("_Request", Model);}
            </div>
            <div class="tab-pane fade" id="tools">
                @{Html.RenderPartial("_Tools", Model);}
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(function() {
            $(document).on('click',
                '#dbg-clearsession',
                function () {
                    $.ajax({
                        async: false,
                        cache: false,
                        type: "POST",
                        url: "/Admin/ClearSession",
                        success: function (data) {
                            location.reload();
                        }
                    });
                });
        });
    </script>
}