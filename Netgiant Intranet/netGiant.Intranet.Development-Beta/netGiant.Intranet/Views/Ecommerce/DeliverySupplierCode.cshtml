@using netGiant.Intranet.BusinessLayer.ViewModels.Ecommerce;
@model DeliveryConfigurationViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Delivery Supplier Codes";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "NewEditDeliverySupplierCode/0", "Ecommerce", null, new { @title = "Create new delivery supplier code", @class = "g-p-10" })
}

@(Html.Kendo().Grid<DeliveryConfigurationViewModel.TelerikDeliverySupplierCode>()
      .HtmlAttributes(new { @class = "pointer-rows" })
      .Name("deliverySupplierCodeGrid")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Read(read => read.Action("DeliverySupplierCode_Read", "Ecommerce"))
          .PageSize(200)
          .Sort(sort => sort
              .Add(y => y.ProviderName).Ascending())
      )
      .Columns(columns =>
      {
          columns.Bound(x => x.DeliverySupplierCodeId)
            .Title("ID")
            .HeaderHtmlAttributes(new { title = "ID", style = "text-align: center;" })
            .Width("80px");

          columns.Bound(x => x.Website)
            .Title("Website")
            .HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" })
            .Width("130px");

          columns.Bound(x => x.DeliveryServiceName)
            .Title("Service")
            .HeaderHtmlAttributes(new { title = "Service", style = "text-align: center;" });

          columns.Bound(x => x.ProviderName)
            .Title("Provider")
            .HeaderHtmlAttributes(new { title = "Provider", style = "text-align: center;" });

          columns.Bound(x => x.ProviderItemCode)
            .Title("Provider Code")
            .HeaderHtmlAttributes(new { title = "Provider Code", style = "text-align: center;" });

          columns.Bound(x => x.Price)
            .Title("Price")
            .HeaderHtmlAttributes(new { title = "Price", style = "text-align: center;" });
          columns.Command(command => command.Custom("Delete").Click("deleteSupplierCode"));
      })
      .Pageable(pager => pager.Refresh(true))
      .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
      .Sortable(sortable => sortable
          .AllowUnsort(true))
      .Groupable()
      .Scrollable()
      .Filterable(ftb => ftb
          .Mode(GridFilterMode.Menu)
          .Extra(false))
      .ColumnMenu()
      .Resizable(resize => resize.Columns(true))
      .Reorderable(reorder => reorder.Columns(true))
      .Excel(excel => excel
          .AllPages(true)
          .FileName("Grid Export")
          .Filterable(true))
      .NoRecords("There are no items to display")
      .Events(events => events.Change("Grid_OnRowSelect").DataBound("saveGridFilters"))
      .Selectable()
      )

@section scripts
{
    <script type="text/javascript">

        $(function () {
            setGridHeaderTitleTags();
        });

        function WebsiteFilter(element) {
            element.kendoDropDownList({
                dataSource: {
                    transport: {
                        read: "@Url.Action("GetWebsites", "SelectLists")"
                    }
                },
                optionLabel: "--Select Value--"
            });
        }

        var Grid_OnRowSelect = function(e) {
            var data = this.dataItem(this.select());
            window.location.href = '@Url.Action("NewEditDeliverySupplierCode")/' + data.DeliverySupplierCodeId;
        }

        function deleteSupplierCode(e) {
            var data = this.dataItem($(e.currentTarget).closest("tr"));

            $.confirm({
                title: 'Delete Delivery Supplier Code',
                content: 'Are you sure you want to delete this delivery supplier code?',
                buttons: {
                    Yes: function () {
                        $.ajax({
                            url: '@Url.Action("DeleteDeliverySupplierCode", "Ecommerce")',
                            method: 'POST',
                            data: { id: data.DeliverySupplierCodeId }
                        }).done(function (data) {
                            if (data.IsSuccess) {
                                $("#deliverySupplierCodeGrid").data("kendoGrid").dataSource.read();
                            } else {
                                $.alert('Failed to delete. Error: ' + data.Message);
                            }
                        });
                    },
                    No: function () { }
                }
            });

            return false;
        }

        function setGridHeaderTitleTags() {
            $("#grid th").each(function (index, val) {
                var link = $(this).find('.k-link');
                link.attr('title', link.text());
            });
        }

    </script>
}