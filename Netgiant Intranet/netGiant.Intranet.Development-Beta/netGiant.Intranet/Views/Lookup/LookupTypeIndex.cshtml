@using netGiant.Intranet.BusinessLayer.ViewModels.CrMS;
@{
    ViewBag.Title = "Lookup Type Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b-10">
    <h4 class="text-center">Lookup Type Details</h4>
</div>
@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateLookupType", "Lookup", null, new { @title = "Create new lookup", @class = "g-p-10" })
}

@(Html.Kendo().Grid<LookupViewModel.TelerikLT>()
            .HtmlAttributes(new { @class = "pointer-rows" })
            .Name("lookupTypeGrid")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Sort(x =>
                {
                    x.Add(y => y.LookupScope).Ascending();
                    x.Add(y => y.TypeName).Ascending();
                })
            .Read(read => read.Action("LookupType_Read", "Lookup"))
            .PageSize(200)
            )
        .Columns(columns =>
        {
            columns.Bound(x => x.LookupScope).Title("Scope")
                .HeaderHtmlAttributes(new { title = "Scope", style = "text-align: center;" });
            columns.Bound(x => x.TypeName).Title("Lookup Type")
                .HeaderHtmlAttributes(new { title = "Lookup Type", style = "text-align: center;" });
            columns.Bound(x => x.LookupTypeId).ClientTemplate(
                "<a href=\"UpdateLookupType?id=#:LookupTypeId#&scope=#:LookupScope#\">Edit</a>" +
                "|<a href=\"##\" class=\"lnkEntryDelete\" value=\"#:LookupTypeId#\" data-scope=\"#:LookupScope#\" title=\"Delete\">Delete</a>"
                ).Width("125px").Title("").Filterable(false).Sortable(false).Groupable(false);
        })
        .Pageable(pager => pager.Refresh(true))
        .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable
            .AllowUnsort(true))
        .Groupable()
        .Scrollable()
        .Filterable(ftb => ftb
            .Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .Excel(excel => excel
            .AllPages(true)
            .FileName("Grid Export")
            .Filterable(true)
            .ProxyURL(Url.Action("Excel_Export_Save", "Reports")))
        .NoRecords("There are no items to display")
        .Events(events => events.DataBound("saveGridFilters"))
        .Selectable()
)

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkEntryDelete', function (e) {
            var rowid = $(this).attr('value');
            var scope = $(this).attr('data-scope');
            e.preventDefault();
            $.confirm({
                title: 'Lookup Types',
                content: 'Are you sure you want to delete this entry?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteLookupType", "Lookup")/', { id: rowid, scope: scope });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>



