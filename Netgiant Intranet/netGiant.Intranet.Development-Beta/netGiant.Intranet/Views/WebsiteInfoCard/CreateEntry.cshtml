@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model WebsiteInfoCardViewModel

@{
    ViewBag.Title = "Create Website Info Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">
            @using (Html.BeginForm("SaveEntry", "WebsiteInfoCard"))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })
                @Html.HiddenFor(x => x.InfoCard.WebsiteInfoCardId)

                <div class="form-group">
                    @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.InfoCard.WebsiteInfoCardId > 0)
                        {
                            @Html.DropDownListFor(m => m.InfoCard.WebsiteId, Model.WebsiteNameList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10", disabled = "disabled" })
                            @Html.HiddenFor(m => m.InfoCard.WebsiteId)
                            <span class="help-block">Website can't be changed once a card is created.</span>
                        }
                        else
                        {
                            @Html.DropDownListFor(m => m.InfoCard.WebsiteId, Model.WebsiteNameList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
                        }
                        @Html.ValidationMessageFor(model => model.InfoCard.WebsiteId, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Category", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.InfoCard.WebsiteInfoCardId > 0)
                        {
                            @Html.DropDownListFor(m => m.InfoCard.Category, Model.CategoryList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10", disabled = "disabled" })
                            @Html.HiddenFor(m => m.InfoCard.Category)
                            <span class="help-block">'Banner' only uses Image URL / Link URL below. The other categories (Delivery, Trust, TradePricing, Payment) use Icon/Title/Body/Find Out More. Category can't be changed once a card is created.</span>
                        }
                        else
                        {
                            @Html.DropDownListFor(m => m.InfoCard.Category, Model.CategoryList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
                            <span class="help-block">'Banner' only uses Image URL / Link URL below. The other categories (Delivery, Trust, TradePricing, Payment) use Icon/Title/Body/Find Out More.</span>
                        }
                        @Html.ValidationMessageFor(model => model.InfoCard.Category, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Icon (Font Awesome class)", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.InfoCard.WebsiteInfoCardId > 0)
                        {
                            @Html.EditorFor(model => model.InfoCard.IconClass, new { htmlAttributes = new { @class = "form-control g-largeCell", placeholder = "e.g. fa fa-truck", @readonly = "readonly" } })
                            <span class="help-block">Icon can't be changed once a card is created.</span>
                        }
                        else
                        {
                            @Html.EditorFor(model => model.InfoCard.IconClass, new { htmlAttributes = new { @class = "form-control g-largeCell", placeholder = "e.g. fa fa-truck" } })
                        }
                        @Html.ValidationMessageFor(model => model.InfoCard.IconClass, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Title", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.InfoCard.Title, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.InfoCard.Title, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Body Text", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.InfoCard.BodyText, new { @class = "form-control g-largeCell", rows = 3 })
                        @Html.ValidationMessageFor(model => model.InfoCard.BodyText, "", new { @class = "text-danger" })
                        <span class="help-block">The short teaser shown on the card before "Find Out More" is clicked. Basic HTML (e.g. &lt;strong&gt;) is allowed.</span>
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Find Out More Content", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.InfoCard.FindOutMoreContent, new { @class = "form-control g-largeCell", rows = 6 })
                        @Html.ValidationMessageFor(model => model.InfoCard.FindOutMoreContent, "", new { @class = "text-danger" })
                        <span class="help-block">The expanded HTML content shown when the customer clicks "Find Out More". Wrap paragraphs in &lt;p&gt; tags.</span>
                    </div>
                </div>

                @* Image URL / Link URL only apply to the 'Banner' category - shown/hidden by the
                   script below based on the Category selection. Hidden via a CSS class (not the
                   "disabled" attribute), so the values still post normally even while hidden. *@
                <div id="bannerFields" class="g-d-n">
                    <div class="form-group">
                        @Html.Label("Image URL", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.InfoCard.ImageUrl, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                            @Html.ValidationMessageFor(model => model.InfoCard.ImageUrl, "", new { @class = "text-danger" })
                            <span class="help-block">Used for the 'Banner' category.</span>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Link URL", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.InfoCard.LinkUrl, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                            @Html.ValidationMessageFor(model => model.InfoCard.LinkUrl, "", new { @class = "text-danger" })
                            <span class="help-block">Optional click-through, e.g. banner -> sale landing page.</span>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Display Order", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.InfoCard.DisplayOrder, new { htmlAttributes = new { @class = "form-control g-smallCell" } })
                        @Html.ValidationMessageFor(model => model.InfoCard.DisplayOrder, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Active", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.InfoCard.IsActive)
                        @Html.ValidationMessageFor(model => model.InfoCard.IsActive, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveInfoCardItem" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "Index", "WebsiteInfoCard", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        function toggleBannerFields() {
            var selectedText = $('select[name="InfoCard.Category"] option:selected').text();

            if (selectedText === 'Banner') {
                $('#bannerFields').removeClass('g-d-n');
            } else {
                $('#bannerFields').addClass('g-d-n');
            }
        }

        toggleBannerFields();

        // Only fires in Create mode (the Category select is disabled in Edit mode), which is
        // fine - the load-time call above already accounts for Edit's fixed Category value.
        $('select[name="InfoCard.Category"]').on('change', toggleBannerFields);
    });
</script>
