@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model WebsiteInfoCardViewModel

@{
    ViewBag.Title = "Website Info Cards";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
</div>

@Html.Hidden("DeleteInfoCardURL", Url.Action("DeleteEntry", "WebsiteInfoCard"))

@* FIX (2026-08-25): "Create New" hidden here per explicit request, for now - existing cards
   are still fully editable/deletable via the grid's Edit/Delete links below (both use this
   same CreateEntry view/action, just with a real id), and CreateEntry/0 still works if
   navigated to directly. Only this entry point into it is hidden. To re-enable, uncomment
   the block below.
@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreateEntry", "WebsiteInfoCard", new { id = 0 }, new { @title = "Create new info card", @class = "g-p-10" })
}
*@

@(Html.Kendo().Grid<WebsiteInfoCardViewModel.TelerikInfoCard>()
            .HtmlAttributes(new { @class = "pointer-rows" })
            .Name("infoCardGrid")
            .Columns(columns =>
            {
                columns.Bound(x => x.Website).Title("Website").Width("120px")
                    .HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
                columns.Bound(x => x.Category).Title("Category").Width("120px")
                    .HeaderHtmlAttributes(new { title = "Category", style = "text-align: center;" });
                columns.Bound(x => x.Title).Title("Title")
                    .HeaderHtmlAttributes(new { title = "Title", style = "text-align: center;" });
                columns.Bound(x => x.BodyText).Title("Body Text")
                    .HeaderHtmlAttributes(new { title = "Body Text", style = "text-align: center;" });
                columns.Bound(x => x.DisplayOrder).Title("Order").Width("80px")
                    .HeaderHtmlAttributes(new { title = "Order", style = "text-align: center;" });
                columns.Bound(x => x.IsActive).Title("Active").Width("80px")
                    .HeaderHtmlAttributes(new { title = "Active", style = "text-align: center;" });
                columns.Bound(x => x.Id).ClientTemplate(
                        "<a href=\"CreateEntry/#:Id#\">Edit</a>" +
                        "|<a href=\"##\" class=\"lnkInfoCardDelete\" value=\"#:Id#\" title=\"Delete\">Delete</a>"
                        ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
            })
            .Pageable(pager => pager.Refresh(true))
            .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
            .Sortable(sortable => sortable.AllowUnsort(true))
            .Groupable()
            .Scrollable()
            .Filterable(filter => filter.Mode(GridFilterMode.Menu))
            .ColumnMenu()
            .Resizable(resize => resize.Columns(true))
            .Reorderable(reorder => reorder.Columns(true))
            .NoRecords("There are no info cards to display")
            .DataSource(dataSource => dataSource
                .Ajax()
                .Read(x => x.Action("InfoCard_Read", "WebsiteInfoCard"))
                .PageSize(200)
            )
)

<div id="infoCardDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this info card?
</div>

<script type="text/javascript">
    $(function () {
        $(document).on('click', '.lnkInfoCardDelete', function (e) {
            var rowid = $(this).attr('value');
            e.preventDefault();
            $.confirm({
                title: 'Website Info Cards',
                content: 'Are you sure you want to delete this info card?',
                buttons: {
                    Yes: function () {
                        deleteGridRow('@Url.Action("DeleteEntry", "WebsiteInfoCard")/', { id: rowid });
                    },
                    No: function () { }
                }
            });
        });
    });
</script>
