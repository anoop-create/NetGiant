@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.Orders;
@using System.Globalization;
@model OpayoViewModel

@{
    ViewBag.Title = "Opayo Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="placeHolder">
    <h4 class="text-center">@ViewBag.Title</h4>
    @Html.RawFromDict(Model.IntranetData, "OpayoTransactionsFilters")

    @using (Html.BeginForm("ExportTransactions", "Opayo", FormMethod.Post, new { @id = "ExportForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("kendoData")
    }

    <input type="submit" class="btn btn-success g-m-t-5 download" value="Export to CSV" />
</div>

@(Html.Kendo().Grid<OpayoViewModel.TelerikOpayoTransaction>
    ()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("opayoTransactionGrid")
    .Columns(columns =>
    {
        columns.Bound(x => x.Id).Title("Id").Hidden().Width(80);
        columns.Bound(x => x.OrderNumber).Title("Order Number").Width("100px").HeaderHtmlAttributes(new { title = "Order Number", style = "text-align: center;" });
        columns.Bound(x => x.Website).Title("Website").Width("150px").HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
        columns.Bound(x => x.Name).Title("Name").Width("200px").HeaderHtmlAttributes(new { title = "Name", style = "text-align: center;" });
        columns.Bound(x => x.Amount).HtmlAttributes(new { style = "text-align: right" }).Title("Amount").Width("100px").HeaderHtmlAttributes(new { title = "Amount", style = "text-align: center;" });
        columns.Bound(x => x.DateTime).Title("DateTime").ClientTemplate("#= kendo.toString(kendo.parseDate(DateTime, 'yyyy-MM-dd'), 'dd/MM/yyyy HH:mm:ss') #").Width("150px").HeaderHtmlAttributes(new { title = "Date/Time", style = "text-align: center;" });
        columns.Bound(x => x.MerchantSessionKey).Title("Merchandise Session Key").Width("350px").HeaderHtmlAttributes(new { title = "Merchandise Session Key", style = "text-align: center;" });
        columns.Template(@<text> </text>).Title("");
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int>
        { 150, 100, 50, 20 }))
        .Sortable(sortable => sortable.AllowUnsort(true))
        .Scrollable()
        .Filterable(filter => filter.Mode(GridFilterMode.Menu))
        .ColumnMenu()
        .Resizable(resize => resize.Columns(true))
        .Reorderable(reorder => reorder.Columns(true))
        .NoRecords("There are no Opayo transactions to display")
        .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("OpayoTransaction_Read", "Opayo"))
        .Sort(s => s.Add(x => x.DateTime).Descending())
        .PageSize(200)
        )
        .Events(events => events.Change("Grid_OnRowSelect"))
        .Events(events => events.DataBound("Grid_OnDataBound"))
        .Selectable()
)
<!-- Modal -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document" style="width: 1500px;">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title" id="myModalLabel"></h4>
            </div>
            <div class="modal-body"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    var Grid_OnRowSelect = function (e) {
        var griddata = this.dataItem(this.select());
        $('#myModal').find('.modal-body').html('');
        $.ajax({
            url: '@Url.Action("GetOpayoTransaction", "Opayo")',
            //data: { id: griddata.Id, merchantSessionKey: '' }
            data: { id: griddata.Id, merchantSessionKey: griddata.MerchantSessionKey }
        }).done(function (data) {
            $('#myModal').find('.modal-body').html(data);
        });
        $('#myModal').modal();
    }

    $(document).on('click', '.download', function (e) {
        var view = $("#opayoTransactionGrid").data("kendoGrid").dataSource.view();
        $('#kendoData').val(encodeURIComponent(JSON.stringify(view)));
        $('#ExportForm').submit();
    });

    function Grid_OnDataBound() {
        $("#opayoTransactionGrid tr.k-alt").removeClass("k-alt");

        var grid = this;
        var currentRecords = grid.dataSource.view();
        for (var i = 0; i < currentRecords.length; i++) {
            if (currentRecords[i].OrderIsPlaced == 'No') {
                grid.tbody.find("tr[data-uid='" + currentRecords[i].uid + "']").removeClass("k-alt").addClass("g-bc-r").addClass("g-fc-w");
            }
            //if (currentRecords[i].Reg_IsPortal) {
            //    grid.tbody.find("tr[data-uid='" + currentRecords[i].uid + "']").removeClass("k-alt").addClass("g-bc-g");
            //}
        }
        saveGridFilters();
    }

</script>


