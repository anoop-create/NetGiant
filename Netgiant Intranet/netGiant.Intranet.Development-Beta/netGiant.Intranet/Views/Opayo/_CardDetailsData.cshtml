@using netGiant.Intranet.DataLayer.NetgiantMasterData;
@model SagePayTokens


<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="string">Card type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="response">Last 4 digits</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="response">Expiry Date</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
    </tr>
    <tr>
        <td>
            @Html.Raw(Model.card_type)
        </td>
        <td>
            @Html.Raw(Model.last_4_digits)
        </td>
        <td>
            @if (Model.expiry_date != "")
            {
                @Html.Raw(Model.expiry_date.Insert(2, "/"))
            }
        </td>
    </tr>
</table>

