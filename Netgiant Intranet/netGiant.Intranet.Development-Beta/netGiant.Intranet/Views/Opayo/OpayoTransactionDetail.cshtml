@using netGiant.Intranet.BusinessLayer.Models;
@using netGiant.Intranet.BusinessLayer.ViewModels.Orders;
@using netGiant.Intranet.DataLayer.NetgiantMasterData;
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;

@model OpayoViewModel

@{
    Layout = "~/Views/Shared/_LayoutEmpty.cshtml";
}

<div class="container-fluid">
    <div class="row g-fw-b g-p-10" style="background-color: #c9cb43;">
        <div class="col-lg-6">Request</div>
        <div class="col-lg-6">Response(s)</div>
    </div>
</div>
<div class="container-fluid">
    <div class="row g-p-5">
        <div class="col-lg-6">
            <div class="">@Model.TransactionShortList[0].Lookup.LookupName</div>
            <div class="json"><pre><code>@Html.Raw(JValue.Parse(Model.TransactionShortList[0].Json).ToString(Formatting.Indented))</code></pre></div>
        </div>
        <div class="col-lg-6">
            @foreach (OpayoLog ol in Model.TransactionShortList.Where(x => x.Lookup.LookupName != "Create Transaction"))
            {
                <div class="">@ol.Lookup.LookupName</div>
                <div class="json"><pre><code>@Html.Raw(JValue.Parse(ol.Json).ToString(Formatting.Indented))</code></pre></div>
            }
        </div>
    </div>
</div>

