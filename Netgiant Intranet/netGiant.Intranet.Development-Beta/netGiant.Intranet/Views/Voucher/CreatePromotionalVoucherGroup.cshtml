@using netGiant.Intranet.BusinessLayer.ViewModels.Ecommerce.PromoVoucher
@model PromotionalVoucherGroupsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Promotional Voucher Group";
    ViewBag.SubTitle = Model.pvouchgrp.VoucherPromoGroupId > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title - @Model.pvouchgrp.GroupName</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("SavePromotionalVoucherGroup", "Voucher", FormMethod.Post, new { @id = "mainForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.pvouchgrp.VoucherPromoGroupId)

                <fieldset class="g-m-t-20">
                    <legend>Promotional Voucher Group Details</legend>
                    <div class="form-group">
                        @Html.Label("Promotional Voucher Group Name", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => Model.pvouchgrp.GroupName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                            @Html.ValidationMessageFor(model => Model.pvouchgrp.GroupName, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.DropDownListFor(m => m.pvouchgrp.WebsiteFk, Model.AllWebsites, "Select...", new { @class = "form-control g-largeCell" })
                            @Html.ValidationMessageFor(m => m.pvouchgrp.WebsiteFk, "", new { @class = "text-danger" })
                        </div>
                    </div>

                </fieldset>

                <div class="form-group">
                    <div class="col-md-10 g-m-t-10">
                        <input type="submit" name="savePromotionalVoucherGroup" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "PromotionalVoucherGroupsIndex", "Voucher", null, new { @class = "btn btn-default" })
                        @Html.ActionLink("Read Only", "DetailPromotionalVoucherGroup", "Voucher", new { id = Model.pvouchgrp.VoucherPromoGroupId }, new { @class = "btn btn-default" })
                    </div>
                </div>

            }
        </div>
    </div>
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}

@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {

            //This allows validation of hidden fields inside the form
            $('#mainForm').validate().settings.ignore = [];

            $.validator.methods.date = function (value, element) {
                if ($.browser.webkit) {
                    var d = new Date();
                    return this.optional(element) || !/Invalid|NaN/.test(new Date(d.toLocaleDateString(value)));
                }
                else {
                    return this.optional(element) || !/Invalid|NaN/.test(new Date(value));
                }
            };

        });

        $(document).tooltip({
            items: '*:not(.ui-dialog-titlebar-close)'
        });

    </script>
}
