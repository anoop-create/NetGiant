@using netGiant.Intranet.BusinessLayer.ViewModels.Ecommerce.PromoVoucher
@model PromotionalVoucherGroupsViewModel

@{
    ViewBag.Title = "PromotionalVoucherGroups";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder g-m-b--20">
    <h4 class="text-center">Promotional Voucher Groups</h4>
</div>

@Html.Hidden("DeletePromotionalVoucherGroupURL", Url.Action("DeletePromotionalVoucherGroup", "Voucher"))

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "CreatePromotionalVoucherGroup", "Voucher", new { id = 0 }, new { @title = "Create new promotional voucher group", @class = "g-p-10" })
}

@(Html.Kendo().Grid<PromotionalVoucherGroupsViewModel.TelerikPromotionalVoucherGroups>
    ()
    .HtmlAttributes(new { @class = "pointer-rows" })
    .Name("promoVoucherGroupsGrid")
    .Columns(columns =>
    {
    columns.Bound(x => x.PromotionalVoucherGroupWebsite).Title("Website").HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" }).Width("100px")
        .HeaderHtmlAttributes(new { title = "Website", style = "text-align: center;" });
    columns.Bound(x => x.PromotionalVoucherGroupName).Title("Promotional Voucher Group").HeaderHtmlAttributes(new { title = "Promotional Voucher Group", style = "text-align: center;" }).Width("200px")
        .HeaderHtmlAttributes(new { title = "Promotional Voucher Group", style = "text-align: center;" });
    columns.Bound(x => x.PromotionalVoucherGroupId).ClientTemplate(
    "<a href=\"DetailPromotionalVoucherGroup/#:PromotionalVoucherGroupId#\">Details</a>" +
    "|<a href=\"CreatePromotionalVoucherGroup/#:PromotionalVoucherGroupId#\">Edit</a>" +
    "|<a href=\"##\" class=\"lnkPromotionalVoucherGroupDelete\" value=\"#:PromotionalVoucherGroupId#\" title=\"Delete\">Delete</a>" +
    "|<a href=\"CreatePromoGroupMapping/#:PromotionalVoucherGroupId#\">Edit Mappings</a>"
    ).Width("136px").Title("").Filterable(false).Sortable(false).Groupable(false);
    })
    .Pageable(pager => pager.Refresh(true))
    .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
    .Sortable(sortable => sortable.AllowUnsort(true))
    .Groupable()
    .Scrollable()
    .Filterable(filter => filter.Mode(GridFilterMode.Menu))
    .ColumnMenu()
    .Resizable(resize => resize.Columns(true))
    .Reorderable(reorder => reorder.Columns(true))
    .NoRecords("There are no promotional voucher groups to display")
    .DataSource(dataSource => dataSource
        .Ajax()
        .Read(x => x.Action("ReadPromotionalVoucherGroups", "Voucher"))
        .Sort(s => s.Add(x => x.PromotionalVoucherGroupName).Ascending())
        .PageSize(200)
    )
    .Events(e => e.DataBound("saveGridFilters"))
    )

<div id="promotionalVoucherGroupsDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this promotional voucher group?
</div>

<script type="text/javascript">
    var optionsArray;

    $(document).on("click", ".lnkPromotionalVoucherGroupDelete", function () {
        setupOptionsArrayDelete($(this));
   
        ajaxDeleteTelerikRow(optionsArray, $('#DeletePromotionalVoucherGroupURL').val(), '#promotionalVoucherGroupsDeleteDialog');
        return false;
    });

    function setupOptionsArrayDelete(lnkDelete) {
        optionsArray = new Array();
        optionsArray[0] = lnkDelete.attr("value"); //ValueTypeID
        optionsArray[1] = 'telerik'; // obsolete
        optionsArray[2] = ''; // obsolete
        optionsArray[3] = ''; // obsolete
        optionsArray[4] = 0; // obsolete
        optionsArray[5] = 0; // obsolete
        optionsArray[6] = 0; // obsolete
        optionsArray[7] = 0; // obsolete
    }
</script>


