    <EntitySet Name="PriceCompView" EntityType="Self.PriceCompView" store:Type="Views" store:Schema="ngmd">
      <DefiningQuery>SELECT 
    [PriceCompView].[rn] AS [rn], 
    [PriceCompView].[partNo] AS [partNo], 
    [PriceCompView].[price] AS [price], 
    [PriceCompView].[productName] AS [productName], 
    [PriceCompView].[categoryCodeID] AS [categoryCodeID], 
    [PriceCompView].[categoryCodeName] AS [categoryCodeName], 
    [PriceCompView].[supplierStock] AS [supplierStock], 
    [PriceCompView].[manufacturerName] AS [manufacturerName], 
    [PriceCompView].[manufacturerID] AS [manufacturerID], 
    [PriceCompView].[tradePrice] AS [tradePrice], 
    [PriceCompView].[retailPrice] AS [retailPrice], 
    [PriceCompView].[diff] AS [diff], 
    [PriceCompView].[cheapestCostPrice] AS [cheapestCostPrice], 
    [PriceCompView].[costFinalDiff] AS [costFinalDiff], 
    [PriceCompView].[grossMargin] AS [grossMargin], 
    [PriceCompView].[productID] AS [productID]
    FROM [ngmd].[PriceCompView] AS [PriceCompView]</DefiningQuery>
    </EntitySet>
