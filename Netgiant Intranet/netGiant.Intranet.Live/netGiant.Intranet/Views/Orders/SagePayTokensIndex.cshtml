@using netGiant.Intranet.BusinessLayer.ViewModels.Orders;
@using System.Globalization;
@model SagePayViewModel

@{
    ViewBag.Title = "Sage Pay Tokens";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("SagePayTokensDataURL", Url.Action("TokensIndexData", "SagePay"))
        @Html.Hidden("CardDetailsLinkURL", Url.Action("CardDetailsData", "SagePay"))
        @Html.Hidden("TokensList", Model.TokensList.Count)

        @Html.DropDownListFor(m => m.Token.websiteID, Model.WebsiteList, "Search by Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })

        <select id="SagePayTokensSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
            <option selected="selected" value="account">Search by Account</option>
            <option value="email">Search by Email</option>
            <option value="uid">Search by Uid</option>
            <option value="token">Search by Token</option>
        </select>

        <div class="g-f-l">
            @Html.TextBox("SearchSagePayTokens", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
            <a id="lnkSearchSagePayTokens" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
            <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slConfigurationSetting" />
        </div>

        @Html.ActionLink("Reset", "TokensIndex", "SagePay", null, new { @class = "btn btn-default" })

        @Html.CheckBox("ShowDeleted", false, new { @class = "g-m-lr-10-i", @value = "false" }) @Html.Label("Show Deleted")

        <div class="g-c-b"></div>

        <div class="g-m-t-10">
            @Html.Label("From", new { @class = "g-f-l g-p-t-5" })
            @Html.TextBox("DateFrom", DateTime.Now.ToShortDateString(), new { @class = "searchBox form-control g-smallCell g-f-l text-box single-line g-m-lr-10" })

            @Html.Label("To", new { @class = "g-f-l g-p-t-5" })
            @Html.TextBox("DateTo", DateTime.Now.Date.ToShortDateString(), new { @class = "searchBox form-control g-smallCell g-f-l text-box single-line g-m-lr-10" })
        </div>

        <div class="g-c-b"></div>
        
        <span class="g-f-r"><span id="settingCount" class="g-fw-b">@Model.TokensListCount </span><span>Tokens Found</span></span>

        <div class="g-c-b" id="SagePayTokensPartialView">
            <table class="table" id="tableSetting">
                <tr>
                    <th>
                        <a href="#" class="tableHeaderSort" value="account">Account</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="email">Email</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="uid">Uid</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="website">Website</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="token">Token</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="cardDetails">Card Details</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="time">Time</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                </tr>
                @{Html.RenderAction("SagePayTokensList", "SagePay", new { Model = Model.TokensList });}
            </table>
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />

        <div id="CardDetailsDialogue" class="g-d-n" title="Protx String/response"></div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        if ($('#TokensList').val() < 50) {
        noMoreData = true;
    }

    var optionsArray;

    $(document).on("click", "#lnkSearchSagePayTokens", function (event) {
        blockNumber = 1;
        GetConfigurationSettings(true);
        return false;
    });

    $("#SearchSagePayTokens").keypress(function (event) {
        if (event.which == 13) {
            blockNumber = 1;
            GetConfigurationSettings(true);
        }
    });

    $(document).on("change", "#Token_websiteID", function (event) {
        setupOptionsArray();
        blockNumber = 1;
        GetConfigurationSettings(true);
    });

    $(document).on("change", "#DateFrom, #DateTo", function (event) {
        setupOptionsArray();
        blockNumber = 1;
        GetConfigurationSettings(true);
    });

    $(document).on("click", ".tableHeaderSort", function (event) {
        setupSort($(this));
        blockNumber = 1;
        GetConfigurationSettings(true);
        return false;
    });

    $(document).on('click', '#ShowDeleted', function () {
        setupOptionsArray();
        blockNumber = 1;
        GetConfigurationSettings(true);
    });


    $(window).scroll(function () {
        if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
            && !noMoreData && !inProgress) {
            GetConfigurationSettings(false);
        }
        return false;
    });

    $(document).on("click", ".cardDetails", function () {
        getCardDetailsData($("#CardDetailsLinkURL").val(), "#CardDetailsDialogue", $(this).attr("value"))
        $("#CardDetailsDialogue").dialog({
            modal: true,
            width: 800
        });
        return false;
    });

    $("#DateFrom, #DateTo").datepicker({ dateFormat: 'dd/mm/yy' });

    function getCardDetailsData(url, divPartialView, id) {

        $.ajax({
            url: url,
            dataType: 'html',
            traditional: true,
            type: 'POST',
            data: { id: id },
            async: false,
            cache: false,
            success: function (data) {
                $('' + divPartialView + '').empty();
                $('' + divPartialView + '').html(data);
            }
        });

    }

    function GetConfigurationSettings(clearTable) {
        setupOptionsArray();
        InfiniteScroll($('#SagePayTokensDataURL').val(),
            optionsArray,
            clearTable,
            '#tableSetting tr:gt(0)',
            '#settingCount',
            '#tableSetting tbody',
            $("#activeSortType"),
            $("#activeSortDir"));
    }

    function setupOptionsArray() {
        optionsArray = new Array();

        var sortType = $("#activeSortType").val();
        var sortDir = $("#activeSortDir").val();

        if (sortType.length > 0) {
            optionsArray[0] = sortType + sortDir;
        } else {
            optionsArray[0] = '';
        }

        optionsArray[1] = $("#Token_websiteID").val() || 0; //Search by Website
        optionsArray[2] = $("#SearchSagePayTokens").val(); //SearchTerm
        optionsArray[3] = $("#SagePayTokensSearchBy").val(); //SearchBy
        optionsArray[4] = $("#ShowDeleted").is(":checked"); //ShowDeleted
        optionsArray[5] = $("#DateFrom").val(); //DateFrom Search
        optionsArray[6] = $("#DateTo").val(); //DateTo Search
    }
    </script>
}

