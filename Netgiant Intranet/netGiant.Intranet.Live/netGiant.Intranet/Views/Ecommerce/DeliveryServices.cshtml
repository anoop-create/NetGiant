@using netGiant.Intranet.BusinessLayer.ViewModels.Ecommerce;
@model DeliveryConfigurationViewModel

@{
    ViewBag.Title = "Delivery Services";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
{
    @Html.ActionLink("Create New", "NewDeliveryService", "Ecommerce", null, new { @title = "Create new delivery service" })
}

@(Html.Kendo().Grid<DeliveryConfigurationViewModel.TelerikDeliveryService>()
      .HtmlAttributes(new { @class = "pointer-rows" })
      .Name("grid")
      .DataSource(dataSource => dataSource
          .Ajax()
          .Read(read => read.Action("DeliveryServices_Read", "Ecommerce"))
          .PageSize(200)
          .Sort(sort => sort
              .Add(x => x.ServiceName).Descending())
      )
      .Columns(columns =>
      {
          columns.Bound(product => product.WebsiteName).Width(50).Title("Website").Filterable(fl => fl.UI("WebsiteFilter"));
          columns.Bound(product => product.ServiceName).Title("Service Name").Width(150);
          columns.Bound(product => product.StockRef).Title("Stock Ref").Width(50);
          columns.Bound(product => product.Price).Title("Price").Width(50);
          columns.Bound(product => product.InfoMessage).Title("Info Message").Width(200);
          columns.Bound(product => product.IsCompatibleInkOnly).Title("Is Compatible Ink").Width(50);
          columns.Bound(product => product.IsSaturdayOnly).Title("Is Saturday").Width(50);
          columns.Bound(product => product.IsBulky).Title("Is Bulky").Width(50);
          columns.Bound(product => product.DeliveryMethod).Title("Delivery Method").Width(50);
          columns.Bound(product => product.ThresholdStart).Title("Threshold Start").Width(50);
          columns.Bound(product => product.ThresholdEnd).Title("Threshold End").Width(50);
          columns.Command(command => command.Custom("Delete").Click("deleteService")).Width(50);
      })
      .Pageable(pager => pager.Refresh(true))
      .Pageable(pager => pager.PageSizes(new List<int> { 150, 100, 50, 20 }))
      .Sortable(sortable => sortable
          .AllowUnsort(true))
      .Groupable()
      .Scrollable()
      .Filterable(ftb => ftb
          .Mode(GridFilterMode.Menu)
          .Extra(false))
      .ColumnMenu()
      .Resizable(resize => resize.Columns(true))
      .Reorderable(reorder => reorder.Columns(true))
      .Excel(excel => excel
          .AllPages(true)
          .FileName("Grid Export")
          .Filterable(true))
      .NoRecords("There are no items to display")
      .Events(events => events.Change("Grid_OnRowSelect"))
      .Selectable()
      )

@section scripts
{
    <script type="text/javascript">

        $(function () {
            setGridHeaderTitleTags();
            resizeGrid();
        });

        function WebsiteFilter(element) {
            element.kendoDropDownList({
                dataSource: {
                    transport: {
                        read: "@Url.Action("GetWebsites", "SelectLists")"
                    }
                },
                optionLabel: "--Select Value--"
            });
        }

        var Grid_OnRowSelect = function(e) {
            var data = this.dataItem(this.select());
            window.location.href = '@Url.Action("EditDeliveryService")/' + data.DeliveryServiceId;
        }

        function deleteService(e) {
            var data = this.dataItem($(e.currentTarget).closest("tr"));

            $.confirm({
                title: 'Delete Delivery Service',
                content: 'Are you sure you want to delete this delivery service?',
                confirm: function () {
                    $.ajax({
                        url: '@Url.Action("DeleteDeliveryService", "Ecommerce")',
                        method: 'POST',
                        data: { id: data.DeliveryServiceId }
                    }).done(function (data) {
                        if (data.IsSuccess) {
                            $("#grid").data("kendoGrid").dataSource.read();
                        } else {
                            $.alert('Failed to delete. Error: ' + data.Message);
                        }
                    });
                },
                cancel: function () {
                    
                }
            });

            return false;
        }

        function setGridHeaderTitleTags() {
            $("#grid th").each(function (index, val) {
                var link = $(this).find('.k-link');
                link.attr('title', link.text());
            });
        }

    </script>
}


