@model netGiant.Intranet.BusinessLayer.ViewModels.Ecommerce.DeliveryConfigurationViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Edit Delivery Configuration";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@Model.DeliveryService.Website.FriendlyName Delivery Service: @Model.DeliveryService.ServiceName</h4>

        @using (Html.BeginForm("SaveDeliveryService", "Ecommerce", FormMethod.Post, new { id = "mainForm" }))
        {
            <div class="form-horizontal g-m-t-50">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(x => x.DeliveryService.WebsiteFK)
                @Html.HiddenFor(x => x.DeliveryService.DeliveryServiceId)

                <div class="form-group">
                    @Html.Label("Service Name", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.ServiceName, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.ServiceName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Stock Ref", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.StockRef, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.StockRef, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Price", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.Price, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.Price, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Info Message", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.InfoMessage, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.InfoMessage, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Saturday Only", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DeliveryService.IsSaturdayOnly, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.IsSaturdayOnly, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Compatible Ink Only", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DeliveryService.IsCompatibleInkOnly, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.IsCompatibleInkOnly, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Bulky", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DeliveryService.IsBulky, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.IsBulky, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Use Thresholds", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.DeliveryService.UsesThresholds, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.UsesThresholds, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Threshold Start", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.ThresholdStart, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.ThresholdStart, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Threshold End", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.ThresholdEnd, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.ThresholdEnd, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Delivery Method", new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(model => model.DeliveryService.DeliveryMethod, new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.DeliveryService.DeliveryMethod, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10 g-m-t-50">
                        <input type="submit" name="btnSaveDeliveryService" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "DeliveryServices", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>

