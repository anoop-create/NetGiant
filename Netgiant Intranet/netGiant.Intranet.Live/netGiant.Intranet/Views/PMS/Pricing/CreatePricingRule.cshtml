@section Scripts
{
    <script type="text/javascript">

        $(document).ready(function () {
            //This allows validation of hidden fields inside the form
            $('#mainForm').validate().settings.ignore = [];
            setupComboBox($('#GetProductsURL').val());

            $("#ddlProduct").combobox();

            if ($('#priceRuleSingle_productFK').val() > 0) {
                $('.custom-combobox-input').val($('#aProductName').val());
            }

            if ($('#priceRuleSingle_priceRuleID').val() == 0) {
                enableDisableInputs('disable');
            }
            
            setPageState(parseInt($('#priceRuleSingle_ruleType').val()) || 0, true);
        });

        $(document).on("change", "#priceRuleSingle_costUpliftIsPercent", function () {
            var costUplift = $("#priceRuleSingle_costUplift");
            var costUpliftSymbol = $("#costUpliftSymbol");

            if ($(this).is(":checked")) {
                costUplift.val(Number(costUplift.val()).toFixed(2));
                costUpliftSymbol.html('%');
                setCostUpliftBands_Percentage(true);
            } else {
                costUplift.val(Number(costUplift.val()).toFixed(2));
                costUpliftSymbol.html('£');
                setCostUpliftBands_Percentage(false);
            }
        });

        $(document).on("change", "#priceRuleSingle_useBanding", function () {
            if ($(this).is(":checked")) {
                getNewBand();
                validateRuleType();
                $('#containerPriceRuleBands').slideDown();
            } else {
                $('#containerPriceRuleBands').hide();
                $('#priceRuleBandsSubContainer div').remove();
            }
        });

        $(document).on('click', '.lnkAddPriceBand', function () {
            getNewBand();
            return false;
        });

        $(document).on("change", "#selectedWebsiteFK", function (event) {
            if ($(this).val().length > 0) {
                jsonPopulateDropDownPriceRule($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#priceRuleSingle_categoryCodeFK', 'category');
            } else {
                $("#priceRuleSingle_categoryCodeFK").empty();
                $("#priceRuleSingle_categoryCodeFK").html('<option value="" selected="true">Search by category</option>');
                $("#priceRuleSingle_categoryCodeFK").attr('disabled', 'disabled');
            }
        });

        $(document).on('click', '.lnkRemoveBand', function () {
            $(this).parentsUntil('div').parent().remove();
            return false;
        });

        $(document).on("blur", ".c", function () {
            $(this).val(Number($(this).val()).toFixed(2));
        });

        $(document).on("blur", ".valInput, .percentInput", function () {
            $(this).val(Number($(this).val()).toFixed(2));
        });

        $(document).on("blur", ".bandsCostUplift, #priceRuleSingle_costUplift", function () {
            $(this).val(Number($(this).val()).toFixed(2));
        });

        $(document).on("change", "#priceRuleSingle_ruleType", function () {
            selectedVal = parseInt($(this).val()) || 0;
            setPageState(selectedVal, false);
        });

        $(document).on('change', '#priceRuleSingle_manufacturerFK', function () {
            validateRuleType();
        });

        $(document).on('change', '#priceRuleSingle_minMargin, ' +
            '#priceRuleSingle_desiredMargin, ' +
            '#priceRuleSingle_maxMargin', function () {
            validateMargins();
        });

        function setPageState(selectedVal, pageLoad) {
            switch (selectedVal) {
                case 0:
                    enableDisableInputs('disable');
                    $('#priceRuleSingle_manufacturerFK').prop('disabled', true).removeClass('g-v-h');
                    $('.selectProduct').removeClass('g-v-h');

                    if (pageLoad == false) {
                        $('#priceRuleSingle_productFK').val(0);
                        $('.custom-combobox-input').val('Start Typing...');
                    }
                    
                    $('#priceRuleBandsSubContainer').empty();
                    $('#containerPriceRuleBands').slideUp();
                    $('#priceRuleSingle_useBanding').prop('checked', false);
                    $('#priceRuleSingle_productGroupFK').prop('disabled', true).removeClass('g-v-h');
                    $('#priceRuleSingle_compatDiscount').prop('disabled', true).removeClass('g-v-h');
                    $('#priceRuleSingle_compatOverrideValue').prop('disabled', true).removeClass('g-v-h');
                    $('#priceRuleSingle_compatOverrideMargin').prop('disabled', true).removeClass('g-v-h');
                    $('#priceRuleSingle_maxMargin, #priceRuleSingle_maxMargin').prop('disabled', true).removeClass('g-v-h');
                    break;
                case 1:
                    enableDisableInputs('enable');
                    $('#priceRuleSingle_manufacturerFK').prop('disabled', true).addClass('g-v-h');
                    $('.selectProduct').addClass('g-v-h');

                    if (pageLoad == false) {
                        $('#priceRuleSingle_productFK').val(0);
                    }

                    validateRuleType();
                    break;
                case 2:
                    enableDisableInputs('enable');
                    $('#priceRuleSingle_manufacturerFK').prop('disabled', false).removeClass('g-v-h');
                    $('.selectProduct').addClass('g-v-h');

                    if (pageLoad == false) {
                        $('#priceRuleSingle_productFK').val(0);
                    }

                    validateRuleType();
                    break;
                case 3:
                    enableDisableInputs('enable');
                    $('#priceRuleSingle_manufacturerFK').prop('disabled', false).removeClass('g-v-h');
                    $('.selectProduct').removeClass('g-v-h');

                    if (pageLoad == false) {
                        $('#priceRuleSingle_productFK').val(0);
                        $('.custom-combobox-input').val('Start Typing...');
                    }

                    validateRuleType();
                    break;
            }
        }

        function getNewBand() {
            $.ajax({
                url: $('#GetNewPriceRuleBandRow').val(),
                dataType: 'html',
                traditional: true,
                type: 'POST',
                cache: false,
                data:
                    {
                        priceRuleBandId: 0,
                        timestamp: $.now()
                    },
                async: false,
                success: function (data) {
                    $('#priceRuleBandsSubContainer').append(data);
                    validateRuleType();
                }
            });
        }

        function setCostUpliftBands_Percentage(chked) {
            $(".bandsCostUplift").each(function () {
                $(this).val(Number($(this).val()).toFixed(2));
            });
        }

        function jsonPopulateDropDownPriceRule(url, dropDownId, name) {

            $.getJSON(url, function (data) {
                $(dropDownId).empty();
                var optionsList = '<option value="" selected="true">Search by ' + name + '</option>';

                $.each(data, function (index) {
                    var optVal = data[index].Value;
                    var optText = data[index].Text;
                    var optNoFallback = data[index].NoCategoryFallback;
                    var optProductCount = data[index].ProductCount;
                    var cssName = '';

                    if (optNoFallback == true) {
                        cssName = 'selectListOptionBold';
                    }

                    optionsList += '<option class="' + cssName + '" value="' + optVal + '">' + optText + " (" + optProductCount + ")" + '</option>';
                });

                $(dropDownId).removeAttr('disabled');
                $(dropDownId).html(optionsList);
            });

        }

        function enableDisableInputs(enableDisable) {

            if (enableDisable == 'disable') {
                $('.allowDisable').prop('disabled', true);
                $('.custom-combobox-input').prop('disabled', true);
                $('.custom-combobox-input').next().addClass('g-d-n');
            } else {
                $('.allowDisable').prop('disabled', false);
                $('.custom-combobox-input').prop('disabled', false);
                $('.custom-combobox-input').next().removeClass('g-d-n');
            }

        }

        function validateRuleType() {

            if (($('#priceRuleSingle_ruleType').val() == 2 || $('#priceRuleSingle_ruleType').val() == 3) &&
                $('#priceRuleSingle_manufacturerFK').val() == 278) {

                $('#priceRuleSingle_compatDiscount, #priceRuleSingle_compatOverrideValue, ' +
                '#priceRuleSingle_compatOverrideMargin').prop('disabled', false).removeClass('g-v-h');
                $('.compatInput').prop('disabled', false).removeClass('g-v-h');
                $('.oemInput').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_nudge').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_competitorsToBeat').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_costUplift, #priceRuleSingle_costUpliftIsPercent').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_desiredMargin').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_maxMarginValue, #priceRuleSingle_minMarginValue').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_productGroupFK').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_fixedPriceOverride').prop('disabled', true).addClass('g-v-h');
                $('.bandFixedPrice').prop('disabled', true).addClass('g-v-h');
            } else if ($('#priceRuleSingle_ruleType').val() == 3) {
                $('#priceRuleSingle_fixedPriceOverride').prop('disabled', false).removeClass('g-v-h');
                $('.bandFixedPrice').prop('disabled', false).removeClass('g-v-h');
                $('.oemInput').prop('disabled', false).removeClass('g-v-h');
            } else {
                $('#priceRuleSingle_compatDiscount, #priceRuleSingle_compatOverrideValue, ' +
                    '#priceRuleSingle_compatOverrideMargin').prop('disabled', true).addClass('g-v-h');
                $('.compatInput').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_nudge').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_competitorsToBeat').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_costUplift, #priceRuleSingle_costUpliftIsPercent').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_desiredMargin').prop('disabled', false).removeClass('g-v-h');
                $('#priceRuleSingle_maxMarginValue, #priceRuleSingle_minMarginValue').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_productGroupFK').prop('disabled', true).addClass('g-v-h');
                $('#priceRuleSingle_fixedPriceOverride').prop('disabled', true).addClass('g-v-h');
                $('.bandFixedPrice').prop('disabled', true).addClass('g-v-h');
                $('.oemInput').prop('disabled', false).removeClass('g-v-h');
            }

        }

        function validateMargins() {

            if (($('#priceRuleSingle_ruleType').val() == 2 || $('#priceRuleSingle_ruleType').val() == 3) &&
                $('#priceRuleSingle_manufacturerFK').val() == 278) {
            } else {

                var minMargin = Number($('#priceRuleSingle_minMargin').val());
                var desiredMargin = Number($('#priceRuleSingle_desiredMargin').val());
                var maxMargin = Number($('#priceRuleSingle_maxMargin').val());

                if (minMargin > desiredMargin || minMargin > maxMargin || desiredMargin < minMargin || desiredMargin > maxMargin) {
                    $('#errorContainer').text('Invalid Margin Values').removeClass('g-d-n');
                    $('#btnSave').prop('disabled', true);
                } else {
                    $('#errorContainer').text('Invalid Margin Values').addClass('g-d-n');
                    $('#btnSave').prop('disabled', false);
                }
            }

        }

    </script>
}