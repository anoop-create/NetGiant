        @Html.EditorFor(m => Model.bandStart, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.bandEnd, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.costUplift, null, String.Format("{0}[{1}]", "Bands", newGuid))
