    <td>
        @Html.EditorFor(x => Model.desiredMargin, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.minMargin, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.maxMargin, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.competitorsToBeat, null, String.Format("{0}[{1}]", "Bands", newGuid))
    </td>
    <td>
        @Html.EditorFor(x => Model.nudge, null, String.Format("{0}[{1}]", "Bands", newGuid))
