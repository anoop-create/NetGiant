@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<eqEquipment>

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("EquipmentDataURL", Url.Action("EquipmentIndexData", "Equipment"))
@Html.Hidden("EquipmentDeleteURL", Url.Action("DeleteEquipment", "Equipment"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateEquipment", "Equipment", new { id = 0 }, null)
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
    @Html.Hidden("PageCount", Model.PageCount)
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="equipment">Equipment</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="cartridge">Cartridge Type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="product">Product</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="status">Status</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-a-c">
            <a href="#" class="tableHeaderSort" value="dateInactive">Date Inactive</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.description)</td>
            <td>@Html.DisplayFor(m => item.manufacturer.manufacturerName)</td>
            <td>@Html.DisplayFor(m => item.eqCartridgeType.eqCartridgeTypeName)</td>
            <td>@Html.DisplayFor(m => item.product.productName)</td>
            <td>@Html.DisplayFor(m => item.dateLastUpdate)</td>
            <td>@Html.DisplayFor(m => item.equipmentStatus.Status)</td>
            @if (item.dateInactive == null)
            {
                <td class="g-a-c"> @Html.Raw("N/A")</td>
            }
            else
            {
               <td class="g-a-c">@Html.DisplayFor(m => item.dateInactive)</td> 

            }        
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateEquipment", "Equipment", new { id = item.eqEquipmentID }, null);
                    @Html.Raw(" | <a class=\"lnkDeleteEquipment\" href=\"#\" value=" + @item.eqEquipmentID + ">Delete</a> | "); 
                }
                @Html.ActionLink("Product Memberships", "EquipmentMemIndex", "Equipment", new { id = item.eqEquipmentID }, null)
            </td>
        </tr>
    }

</table>

<br />
<div id="eqEquipmentPaging" style="text-align:center;">
    @Html.PagedListPager(Model, m => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}