@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment
@using PagedList.Mvc;
@model EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Equipment";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.equipment.manufacturerFK, Model.AllEquipManufacturers, "Search by Manufacturer", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.equipment.statusFK, Model.AllEquipStatus, "Search by Status", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="eqEquipmentSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="name">Search by Equipment</option>
            </select>
            <div>
                @Html.TextBox("SearchEqEquipment", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchEqEquipment" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div id="equipmentDataPartialView">
            @{Html.RenderPartial("~/Views/PMS/Equipment/EquipmentData.cshtml", Model.equipmentList);}
        </div>

        <div id="eqEquipmentDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchEqEquipment, #eqEquipmentPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchEqEquipment").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkDeleteEquipment", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#eqEquipmentDialog", $("#EquipmentDeleteURL").val(), $(this).attr("value"),
                                "#equipmentDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("change", "#equipment_manufacturerFK", function (event) {
            applyStandardPaging(event, 0);
        });

        $(document).on("change", "#equipment_statusFK", function (event) {
            applyStandardPaging(event, 0);
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#equipmentDataPartialView').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#eqEquipmentPaging", $("#EquipmentDataURL").val(),
                                    "#equipmentDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchEqEquipment").val(); //SearchTerm
            optionsArray[1] = $("#equipment_manufacturerFK").val() || 0; //Manufacturer
            optionsArray[2] = $("#equipment_statusFK").val() || 0; //Status

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }
        
        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //FamilyID
            optionsArray[1] = $("#SearchEqEquipment").val(); //SearchTerm
            optionsArray[2] = $("#equipment_manufacturerFK").val() || 0; //Manufacturer

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}
