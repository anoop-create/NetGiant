@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<eqFamilyMembership>

@{
    int eqFamilyID = ViewBag.FamilyID;
}

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("FamilyMemDataURL", Url.Action("FamilyMemIndexData", "Equipment"))
@Html.Hidden("FamilyMemDeleteURL", Url.Action("DeleteFamilyMembership", "Equipment"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateFamilyMembership", "Equipment", new { id = eqFamilyID }, null)
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
    @Html.Hidden("PageCount", Model.PageCount)
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="equipment">Equipment</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>Manufacturer</th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(m => item.eqEquipment.description)</td>
            <td>@Html.DisplayFor(m => item.eqEquipment.manufacturer.manufacturerName)</td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.Raw("<a class=\"lnkDeleteFamilyMapping\" href=\"#\" value=" + @item.eqFamilyMembershipID + ">Delete</a> | ");
                }
                @Html.ActionLink("Product Memberships", "EquipmentMemIndex", "Equipment", new { id = item.eqEquipmentID }, null)
            </td>
        </tr>
    }

</table>

<br />
<div id="eqFamilyMappingPaging" style="text-align:center;">
    @Html.PagedListPager(Model, m => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}