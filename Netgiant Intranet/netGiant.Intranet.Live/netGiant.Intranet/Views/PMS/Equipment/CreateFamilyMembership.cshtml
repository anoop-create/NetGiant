@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Equipment;
@model EquipmentViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Family Membership for: ";
    ViewBag.SubTitle = "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title@ViewBag.FamilyName</h4>
        <br/>

        @using (Html.BeginForm("SaveFamilyMembership", "Equipment", new { id = ViewBag.eqEquipmentID }))
        {
            <div class="form-horizontal">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.familyID)

                <div class="form-group">
                    @Html.Label("Select Equipment", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.equipID, Model.AllEquips, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.equipID, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnSaveEquipment" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "FamilyMemIndex", new { id = Model.familyID }, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }
    </div>
</div>