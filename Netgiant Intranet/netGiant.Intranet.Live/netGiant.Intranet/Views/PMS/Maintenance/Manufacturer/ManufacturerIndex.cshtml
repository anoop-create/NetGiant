@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<manufacturer>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manufacturer";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="manufacturerSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchManufacturer", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchManufacturer" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slManufacturer" />
            </div>
        </div>
        <br />

        <div id="manufacturerPartialView">
            @{Html.RenderPartial("~/Views/PMS/Maintenance/Manufacturer/ManufacturerData.cshtml", Model);}
        </div>

        <!--Delete Dialog-->
        <div id="manufacturerDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchManufacturer, #manufacturerPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchManufacturer").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkManufacturerDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#manufacturerDialog", $("#ManufacturerDeleteURL").val(), $(this).attr("value"),
                                "#manufacturerPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#manufacturerPartialView').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#manufacturerPaging", $("#ManufacturerDataURL").val(),
                                    "#manufacturerPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchManufacturer").val(); //SearchTerm
            optionsArray[1] = $("#manufacturerSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //ManufacturerID
            optionsArray[1] = $("#manufacturerSearchBy").val(); //SearchBy
            optionsArray[2] = $("#SearchManufacturer").val(); //SearchTerm

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}