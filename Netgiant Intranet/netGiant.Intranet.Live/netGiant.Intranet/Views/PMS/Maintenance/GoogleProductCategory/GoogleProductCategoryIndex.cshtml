@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance
@model GoogleProductCategoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Google Product Categories";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("GoogleProductCategoryDataURL", Url.Action("GoogleProductCategoryData", "GoogleProductCategory"))
        @Html.Hidden("GoogleProductCategoryURL", Url.Action("Delete", "GoogleProductCategory"))
        @Html.Hidden("GoogleProductCategoryList", Model.GoogleProductCategoryList.Count)

        <div class="g-m-b-5">
            <select id="GoogleProductCategorySearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="number">Search by Number</option>
                <option value="description">Search by Description</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchGoogleProductCategory", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchGoogleProductCategory" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slGoogleProductCategory" />
            </div>

            @Html.ActionLink("Reset", "GoogleProductCategoryIndex", "GoogleProductCategory", null, new { @class = "btn btn-default" })
        </div>

        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                @Html.ActionLink("Create New", "Create", "GoogleProductCategory", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="GoogleProductCategoryCount" class="g-fw-b">@Model.GoogleProductCategoryListCount </span><span>Google Product Categories Found</span></span>
        </div>

        <table class="table" id="tblGoogleProductCategory">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="no">Google Product Code Number</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="description">Google Product Code Description</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th></th>
            </tr>
            @{Html.RenderAction("GoogleProductCategoryList", "GoogleProductCategory", new { Model = Model.GoogleProductCategoryList });}
        </table>

        <div id="GoogleProductCategoryDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this Google Product Category?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        if ($('#GoogleProductCategoryList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetGoogleProductCategorySettings(true);
            return false;
        });

        $(document).on("click", "#lnkSearchGoogleProductCategory", function (event) {
            blockNumber = 1;
            GetGoogleProductCategorySettings(true);
            return false;
        });

        $("#SearchGoogleProductCategory").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetGoogleProductCategorySettings(true);
            }
        });

        $(document).on("change", "#GoogleProductCategorySearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetGoogleProductCategorySettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetGoogleProductCategorySettings(false);
            }
            return false;
        });

        $(document).on('click', '.lnkDeleteGoogleProductCategory', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#GoogleProductCategoryDeleteDialog', $('#GoogleProductCategoryURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tblGoogleProductCategory tr:gt(0)', '#GoogleProductCategoryCount', '#tblGoogleProductCategory tbody');
            return false;
        });

        function GetGoogleProductCategorySettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#GoogleProductCategoryDataURL').val(),
                optionsArray,
                clearTable,
                '#tblGoogleProductCategory tr:gt(0)',
                '#GoogleProductCategoryCount',
                '#tblGoogleProductCategory tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchGoogleProductCategory").val(); //SearchTerm
            optionsArray[2] = $("#GoogleProductCategorySearchBy").val(); //SearchBy
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchGoogleProductCategory").val(); //SearchTerm
            optionsArray[2] = $("#GoogleProductCategorySearchBy").val(); //SearchBy
        }
    </script>
}
