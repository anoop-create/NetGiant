@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model GoogleProductCategoryViewModel

@{
    ViewBag.Title = "Create Google Product Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">
            @using (Html.BeginForm("Save", "GoogleProductCategory"))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.GoogleProductCategory.googleProductCategoryID)

                <div class="form-group">
                    @Html.Label("Google Product Code Number", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.GoogleProductCategory.googleProductCategoryNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.GoogleProductCategory.googleProductCategoryNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Google Product Code Description", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(model => model.GoogleProductCategory.googleProductCategoryDescription, new { @class = "form-control g-largeCell-textArea", rows = 2 })
                        @Html.ValidationMessageFor(model => model.GoogleProductCategory.googleProductCategoryDescription, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveGoogleProductCategory" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "GoogleProductCategoryIndex", "GoogleProductCategory", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
