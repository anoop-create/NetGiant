@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model WebsiteViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Website";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="websiteSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="name">Search by name</option>
                <option value="url">Search by url</option>
                <option value="friendlyName">Search by friendly name</option>
            </select>
            <div>
                @Html.TextBox("SearchWebsite", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchWebsite" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div id="websiteData">
            @{ Html.RenderPartial("~/Views/PMS/Maintenance/Websites/WebsiteData.cshtml", Model.websites);}
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchWebsite, #websitePaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchWebsite").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkWebsiteDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#websiteDeleteDialog', $('#DeleteWebsiteURL').val(), $(this).attr('value'),
                '#websiteData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#websiteData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#websitePaging", $('#WebsiteDataURL').val(),
                                    "#websiteData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchWebsite").val(); //SearchTerm
            optionsArray[1] = $("#websiteSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //WebsiteID
            optionsArray[1] = $("#SearchWebsite").val(); //SearchTerm
            optionsArray[2] = $("#websiteSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}