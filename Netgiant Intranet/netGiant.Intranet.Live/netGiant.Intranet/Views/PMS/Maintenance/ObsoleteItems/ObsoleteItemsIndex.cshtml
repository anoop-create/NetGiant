@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ObsoleteItemsViewModel

@{
    ViewBag.Title = "Obsolete Items";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("ObsoleteItemsDataURL", Url.Action("ObsoleteItemsData", "ObsoleteItems"))
        @Html.Hidden("DeleteObsoleteItemsURL", Url.Action("Delete", "ObsoleteItems"))
        @Html.Hidden("ObsoleteItemsList", Model.ObsoleteItemsList.Count)

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.ObsoleteItem.websiteFK, Model.WebsiteNameList, "Search by Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })

            <div class="g-f-l">
                <select id="ObsoleteItemsSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                    <option value="stockref">Search by Stock Reference</option>
                    <option value="equip">Search by Equipment Name</option>
                    <option value="url">Search by URL</option>
                </select>
                @Html.TextBox("SearchObsoleteItems", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchObsoleteItems" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
                @Html.ActionLink("Reset", "ObsoleteItemsIndex", "ObsoleteItems", null, new { @class = "btn btn-default g-m-r-10" })
            </div>
        </div>
        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin") || User.IsInRole("SEO"))
            {
                @Html.ActionLink("Create New", "Create", "ObsoleteItems", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="ObsoleteItemsCount" class="g-fw-b">@Model.ObsoleteItemsListCount </span><span>Obsolete Items Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="website">Website</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="stockref">Stock Reference</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="equip">Equipment Name</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="url">URL</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("ObsoleteItemsList", "ObsoleteItems", new { Model = Model.ObsoleteItemsList });}
        </table>

        <div id="ObsoleteItemsDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this Obsolete Item Record?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        //var ownBrand = 0;

        if ($('#ObsoleteItemsList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchObsoleteItems", function (event) {
            blockNumber = 1;
            GetObsoleteItemsSettings(true);
            return false;
        });

        $("#SearchObsoleteItems").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetObsoleteItemsSettings(true);
            }
        });

        $(document).on("change", "#ObsoleteItem_websiteFK", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetObsoleteItemsSettings(true);
        });

        $(document).on("change", "#ObsoleteItemsSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetObsoleteItemsSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetObsoleteItemsSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetObsoleteItemsSettings(true);
            return false;
        });

        $(document).on('click', '.lnkDeleteObsoleteItem', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#ObsoleteItemsDeleteDialog', $('#DeleteObsoleteItemsURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#ObsoleteItemsCount', '#tableSetting tbody');
            return false;
        });

        function GetObsoleteItemsSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#ObsoleteItemsDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#ObsoleteItemsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchObsoleteItems").val(); //SearchTerm
            optionsArray[2] = $("#ObsoleteItemsSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ObsoleteItem_websiteFK").val() || 0; //Search by Website
            //optionsArray[4] = $("#ObsoleteItems_productTypeFK").val() || 0; //Search by Product Type
            //optionsArray[5] = $('#OwnBrandSearchBy').val();
            //optionsArray[6] = $('#AssemblySearchBy').val();
            //if ($("#isMaintenance").is(":checked")) {
            //    optionsArray[7] = true;
            //} else {
            //    optionsArray[7] = false;
            //}
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchObsoleteItems").val(); //SearchTerm
            optionsArray[2] = $("#ObsoleteItemsSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ObsoleteItem_websiteFK").val() || 0; //Search by Website
            //optionsArray[4] = $("#ObsoleteItems_productTypeFK").val() || 0; //Search by Product Type
            //optionsArray[5] = $('#OwnBrandSearchBy').val();
            //optionsArray[6] = $('#AssemblySearchBy').val();
            //if ($("#isMaintenance").is(":checked")) {
            //    optionsArray[7] = true;
            //} else {
            //    optionsArray[7] = false;
            //}
        }
    </script>
}

