@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model PriorityProviderViewModel

@{
    ViewBag.Title = "Priority Provider";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("PriorityProviderDataURL", Url.Action("PriorityProviderData", "PriorityProvider"))
        @Html.Hidden("PriorityProviderList", Model.PriorityProviderList.Count)

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.PriorityProvider.providerFK, Model.ProviderNameList, "Search by Provider", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.PriorityProvider.manufacturerFK, Model.ManufacturerNameList, "Search by Manufacturer", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="PriorityProviderSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="id">Search by ID</option>
                <option value="provider">Search by Provider Name</option>
                <option value="manufacturer">Search by Manufacturer Name</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchPriorityProvider", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchPriorityProvider" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
            </div>
            @Html.ActionLink("Reset", "PriorityProviderIndex", "PriorityProvider", null, new { @class = "btn btn-default" })
        </div>

        <div class="g-c-b">
            <span class="g-f-r"><span id="PriorityProviderCount" class="g-fw-b">@Model.PriorityProviderListCount </span><span>Priority Providers Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="id">ID</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="provider">Provider FK</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer FK</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
            </tr>
            @{Html.RenderAction("PriorityProviderList", "PriorityProvider", new { Model = Model.PriorityProviderList });}
        </table>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>


@section Scripts {
    <script type="text/javascript">

        if ($('#PriorityProviderList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchPriorityProvider", function (event) {
            blockNumber = 1;
            GetPriorityProviderSettings(true);
            return false;
        });

        $("#SearchPriorityProvider").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetPriorityProviderSettings(true);
            }
        });

        $(document).on("change", "#PriorityProvider_providerFK, #PriorityProvider_manufacturerFK", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetPriorityProviderSettings(true);
        });

        $(document).on("change", "#PriorityProviderSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetPriorityProviderSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetPriorityProviderSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetPriorityProviderSettings(true);
            return false;
        });

        function GetPriorityProviderSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#PriorityProviderDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#PriorityProviderCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchPriorityProvider").val(); //SearchTerm
            optionsArray[2] = $("#PriorityProviderSearchBy").val(); //SearchBy
            optionsArray[3] = $("#PriorityProvider_providerFK").val() || 0; //Search by Provider
            optionsArray[4] = $("#PriorityProvider_manufacturerFK").val() || 0; //Search by Manufacturer
        }

    </script>
}

