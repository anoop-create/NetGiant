@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<productGroup>

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("ProductGroupDataURL", Url.Action("IndexData", "ProductGroup"))
@Html.Hidden("ProductGroupDeleteURL", Url.Action("Delete", "ProductGroup"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", new { id = 0 }, null)
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="productGroupName">Product Group Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="productGroupNo">Product Group No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="productType">Product Type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.productGroupName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.productGroupNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.productType.productTypeName)
            </td>
            <td>
                @Html.DisplayFor(m => item.productType.dateLastUpdate)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", new { id = item.productGroupID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkProductGroupDelete\" value=" + @item.productGroupID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>
<br />
<div id="productGroupPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}