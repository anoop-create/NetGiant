@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance
@using PagedList.Mvc;
@model ProductGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Group";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.productGroupSingle.productTypeFK, Model.AllProductTypes, "Search by product group", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="productGroupSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchProductGroup", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchProductGroup" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slProductGroup" />
            </div>
        </div>
        <br />

        <div id="productGroupPartialView">
            @{Html.RenderPartial("~/Views/PMS/Maintenance/ProductGroup/ProductGroupData.cshtml", Model.productGroupList);}
        </div>

        <div id="productGroupDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchProductGroup, #productGroupPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchProductGroup").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkProductGroupDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#productGroupDialog", $("#ProductGroupDeleteURL").val(), $(this).attr("value"),
                                "#productGroupPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        $(document).on("change", "#productGroupSingle_productTypeFK", function (event) {
            applyStandardPaging(event, 0);
        });

        if ($("#historyPage").val() != '') {
            $('#productGroupPartialView').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#productGroupPaging", $("#ProductGroupDataURL").val(),
                                    "#productGroupPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchProductGroup").val(); //SearchTerm
            optionsArray[1] = $("#productGroupSearchBy").val(); //SearchBy
            optionsArray[2] = $('#productGroupSingle_productTypeFK').val() || 0; //Product Group

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //OverrideTypeID
            optionsArray[1] = $("#overrideTypeSearchBy").val(); //SearchBy
            optionsArray[2] = $("#SearchProductGroup").val(); //SearchTerm
            optionsArray[3] = $('#productGroupSingle_productTypeFK').val() || 0; //Product Group

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[4] = sortType + sortDir;
            } else {
                optionsArray[4] = '';
            }
        }

    </script>
}