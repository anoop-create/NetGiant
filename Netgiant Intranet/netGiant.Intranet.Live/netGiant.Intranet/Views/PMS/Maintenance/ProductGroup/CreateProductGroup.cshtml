@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.ProductGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product Group";
    ViewBag.SubTitle = Model.productGroupSingle.productGroupID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @using (Html.BeginForm("Save", "ProductGroup"))
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.productGroupSingle.productGroupID)

                <div class="form-group">
                    @Html.Label("Product Group Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.productGroupSingle.productGroupName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.productGroupSingle.productGroupName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Product Group No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.productGroupSingle.productGroupNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.productGroupSingle.productGroupNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Product Type", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.productGroupSingle.productTypeFK, Model.AllProductTypes, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.productGroupSingle.productTypeFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.productGroupSingle.productGroupID > 0)
                {
                <div class="form-group">
                    @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.productGroupSingle.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                    </div>
                </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnProductGroupSave" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }

    </div>
</div>