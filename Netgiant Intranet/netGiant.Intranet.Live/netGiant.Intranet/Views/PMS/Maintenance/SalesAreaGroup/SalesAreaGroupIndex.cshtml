@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model SalesAreaGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sales Area Group";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="salesAreaGroupSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchSalesAreaGroup", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchSalesAreaGroup" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>

        <br />

        <div id="salesAreaGroupData">
            @{ Html.RenderPartial("~/Views/PMS/Maintenance/SalesAreaGroup/SalesAreaGroupData.cshtml", Model.salesAreaGroups); }
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchSalesAreaGroup, #salesAreaGroupPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchSalesAreaGroup").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkSalesAreaGroupDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#salesAreaGroupDialog', $('#DeleteSalesAreaGroupURL').val(), $(this).attr('value'),
                '#salesAreaGroupData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#salesAreaGroupData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#salesAreaGroupPaging", $('#SalesAreaGroupDataURL').val(),
                                    "#salesAreaGroupData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchSalesAreaGroup").val(); //SearchTerm
            optionsArray[1] = $("#salesAreaGroupSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //ProviderID
            optionsArray[1] = $("#SearchSalesAreaGroup").val(); //SearchTerm
            optionsArray[2] = $("#salesAreaGroupSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}