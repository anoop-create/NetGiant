@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.SalesAreaGroupViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Sales Area Group";
    ViewBag.SubTitle = Model._salesAreaGroup.salesAreaGroupID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("Save", "SalesAreaGroup", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m._salesAreaGroup.salesAreaGroupID)

                <div class="form-group">
                    @Html.Label("Sales Area Group Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model._salesAreaGroup.salesAreaGroupName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model._salesAreaGroup.salesAreaGroupName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sales Area Group No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model._salesAreaGroup.salesAreaGroupNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model._salesAreaGroup.salesAreaGroupNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                if (Model._salesAreaGroup.salesAreaGroupID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model._salesAreaGroup.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveSalesAreaGroup" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "SalesAreaGroupIndex", "SalesAreaGroup", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>