@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ManufacturerNotesViewModel

@{
    ViewBag.Title = "Manufacturer Notes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("ManufacturerNotesDataURL", Url.Action("ManufacturerNotesData", "ManufacturerNotes"))
        @Html.Hidden("DeleteManufacturerNotesURL", Url.Action("Delete", "ManufacturerNotes"))
        @Html.Hidden("ManufacturerNotesList", Model.ManufacturerNotesList.Count)

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.ManufacturerNotes.websiteFK, Model.WebsiteNameList, "Search by Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.ManufacturerNotes.manufacturerFK, Model.ManufacturerNameList, "Search by Manufacturer", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.ManufacturerNotes.eqCartridgeTypeFK, Model.CartridgeTypeNameList, "Search by Cartridge Type", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="ManufacturerNotesSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="website">Search by Website</option>
                <option value="manufacturer">Search by Manufacturer</option>
                <option value="cartridge">Search by Cartridge Type</option>
                <option value="note">Search by Note</option>
                <option value="title">Search by Meta Title</option>
                <option value="description">Search by Meta Description</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchManufacturerNotes", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchManufacturerNotes" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
            </div>
            @Html.ActionLink("Reset", "ManufacturerNotesIndex", "ManufacturerNotes", null, new { @class = "btn btn-default" })
        </div>

        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin") || User.IsInRole("SEO"))
            {
                @Html.ActionLink("Create New", "Create", "ManufacturerNotes", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="ManufacturerNotesCount" class="g-fw-b">@Model.ManufacturerNotesListCount </span><span>Manufacturer Notes Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="website">Website</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="cartridge">Cartridge Type</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="note">Note</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="title">Meta Title</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="description">Meta Description</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("ManufacturerNotesList", "ManufacturerNotes", new { Model = Model.ManufacturerNotesList });}
        </table>

        <div id="ManufacturerNotesDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this Manufacturer Note?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        if ($('#ManufacturerNotesList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchManufacturerNotes", function (event) {
            blockNumber = 1;
            GetManufacturerNoteSettings(true);
            return false;
        });

        $("#SearchManufacturerNotes").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetManufacturerNoteSettings(true);
            }
        });

        $(document).on("change", "#ManufacturerNotes_websiteFK, #ManufacturerNotes_manufacturerFK, #ManufacturerNotes_eqCartridgeTypeFK", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetManufacturerNoteSettings(true);
        });

        $(document).on("change", "#ManufacturerNotesSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetManufacturerNoteSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetManufacturerNoteSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetManufacturerNoteSettings(true);
            return false;
        });

        $(document).on('click', '.lnkDeleteManufacturerNotes', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#ManufacturerNotesDeleteDialog', $('#DeleteManufacturerNotesURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#ManufacturerNotesCount', '#tableSetting tbody');
            return false;
        });

        function GetManufacturerNoteSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#ManufacturerNotesDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#ManufacturerNotesCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchManufacturerNotes").val(); //SearchTerm
            optionsArray[2] = $("#ManufacturerNotesSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ManufacturerNotes_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#ManufacturerNotes_manufacturerFK").val() || 0; //Search by Manufacturer
            optionsArray[5] = $("#ManufacturerNotes_eqCartridgeTypeFK").val() || 0; //Search by CartridgeType
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchManufacturerNotes").val(); //SearchTerm
            optionsArray[2] = $("#ManufacturerNotesSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ManufacturerNotes_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#ManufacturerNotes_manufacturerFK").val() || 0; //Search by Manufacturer
            optionsArray[5] = $("#ManufacturerNotes_eqCartridgeTypeFK").val() || 0; //Search by CartridgeType
        }
    </script>
}