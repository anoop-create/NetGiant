@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CartridgeTypeViewModel

@{
    ViewBag.Title = "Create Cartridge Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">
            @using (Html.BeginForm("Save", "Cartridgetype"))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.CartridgeType.ID)

                <div class="form-group">
                    @Html.Label("CartridgeType ID", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @if (Model.CartridgeType.ID > 0)
                        {
                            <div class="g-m-t-10">@Html.DisplayFor(model => model.CartridgeType.eqCartridgeTypeID, new { htmlAttributes = new { @class = "form-control g-largeCell" } })</div>
                            @Html.HiddenFor(x => x.CartridgeType.eqCartridgeTypeID)
                        }
                        else
                        {
                            @Html.EditorFor(model => model.CartridgeType.eqCartridgeTypeID, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        }
                        @Html.ValidationMessageFor(model => model.CartridgeType.eqCartridgeTypeID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("CartridgeType Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.CartridgeType.eqCartridgeTypeName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.CartridgeType.eqCartridgeTypeName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveCartridgetype" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "CartridgetypeIndex", "CartridgeType", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

