@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CartridgeTypeViewModel

@{
    ViewBag.Title = "Cartridge Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("CartridgeTypeDataURL", Url.Action("CartridgeTypeData", "CartridgeType"))
        @Html.Hidden("DeleteCartridgeTypeURL", Url.Action("Delete", "CartridgeType"))
        @Html.Hidden("CartridgetypeList", Model.CartridgeTypeList.Count)

        <div class="g-m-b-5">
            <select id="CartridgeTypeSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="id">Search by ID</option>
                <option value="name">Search by Name</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchCartridgeTypes", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchCartridgeTypes" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slConfigurationSetting" />
            </div>

            @Html.ActionLink("Reset", "CartridgetypeIndex", "Cartridgetype", null, new { @class = "btn btn-default" })
        </div>

        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                @Html.ActionLink("Create New", "Create", "CartridgeType", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="CartridgeTypeCount" class="g-fw-b">@Model.CartridgeTypeListCount </span><span>Cartridge Types Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="id">CartridgeType ID</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="name">CartridgeType Name</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("CartridgeTypeList", "Cartridgetype", new { Model = Model.CartridgeTypeList });}
        </table>

        <div id="CartridgeTypeDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this Cartridge Type?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        if ($('#CartridgetypeList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchCartridgeTypes", function (event) {
            blockNumber = 1;
            GetCartridgeTypeSettings(true);
            return false;
        });

        $("#SearchCartridgeTypes").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetCartridgeTypeSettings(true);
            }
        });

        $(document).on("change", "#CartridgeTypeSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetCartridgeTypeSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetCartridgeTypeSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetCartridgeTypeSettings(true);
            return false;
        });

        $(document).on('click', '.lnkDeleteCartridgeType', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#CartridgeTypeDeleteDialog', $('#DeleteCartridgeTypeURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#CartridgeTypeCount', '#tableSetting tbody');
            return false;
        });

        function GetCartridgeTypeSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#CartridgeTypeDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#CartridgeTypeCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchCartridgeTypes").val(); //SearchTerm
            optionsArray[2] = $("#CartridgeTypeSearchBy").val(); //SearchBy
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchCartridgeTypes").val(); //SearchTerm
            optionsArray[2] = $("#CartridgeTypeSearchBy").val(); //SearchBy
        }
    </script>
}

