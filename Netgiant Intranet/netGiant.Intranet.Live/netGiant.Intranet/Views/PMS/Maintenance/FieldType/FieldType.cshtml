@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.FieldTypeViewModel

@{
    ViewBag.Title = "Field Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="fieldTypeSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchFieldType", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchFieldType" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>

        <br />

        <div id="fieldTypeData">
            @{ Html.RenderPartial("~/Views/PMS/Maintenance/FieldType/FieldTypeData.cshtml", Model.fieldTypes);}
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchFieldType, #fieldTypePaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchFieldType").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkFieldTypeDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#fieldTypeDeleteDialog', $('#DeleteFieldTypeURL').val(), $(this).attr('value'),
                '#fieldTypeData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#fieldTypeData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#fieldTypePaging", $('#FieldTypeDataURL').val(),
                                    "#fieldTypeData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchFieldType").val(); //SearchTerm
            optionsArray[1] = $("#fieldTypeSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //ProductTypeID
            optionsArray[1] = $("#SearchFieldType").val(); //SearchTerm
            optionsArray[2] = $("#fieldTypeSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}

