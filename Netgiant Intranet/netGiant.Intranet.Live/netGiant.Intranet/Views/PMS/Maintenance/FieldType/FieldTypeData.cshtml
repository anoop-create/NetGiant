@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<fieldType>

@Html.Hidden("FieldTypeDataURL", Url.Action("FieldTypeData", "FieldType"))
@Html.Hidden("DeleteFieldTypeURL", Url.Action("Delete", "FieldType"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "FieldType", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldTypeName">Field Type Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.fieldTypeName)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdated)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "FieldType", new { id = item.fieldTypeID }, new { @title = "Edit" });
                    @Html.Raw(" | <a href=\"#\" class=\"lnkFieldTypeDelete\" value=" + @item.fieldTypeID + " title=\"Delete" + @item.fieldTypeName + ">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="fieldTypePaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="fieldTypeDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this field type?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}

