@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<AXISGroups>

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("AxisGroupDataURL", Url.Action("IndexData", "AXISGroups"))
@Html.Hidden("AxisGroupDeleteURL", Url.Action("Delete", "AXISGroups"))
@Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "SelectLists"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "AXISGroups", new { id = 0 }, null)
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="axisGroupName">AXIS Group Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="axisGroupNo">AXIS Group No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        @*<th>
            <a href="#" class="tableHeaderSort" value="pEbusiness">P-eBusiness Group</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="sEbusiness">S-eBusiness Group</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>*@
        <th>
            <a href="#" class="tableHeaderSort" value="categoryCodeName">Category Code</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="website">Website</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(m => item.AXISGroupName)
            </td>
            <td>
                @Html.DisplayFor(m => item.AXISGroupNo)
            </td>
            @*<td>
                @Html.DisplayFor(modelItem => item.p_eBusinessGroup)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.s_eBusinessGroup)
            </td>*@
            <td>
                @Html.DisplayFor(modelItem => item.categoryCode.categoryCodeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Website.WebsiteName)
            </td>
            <td>       
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "AXISGroups", new { id = item.AXISGroupsID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkAxisGroupDelete\" value=" + @item.AXISGroupsID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>
<br />
<div id="axGroupPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}