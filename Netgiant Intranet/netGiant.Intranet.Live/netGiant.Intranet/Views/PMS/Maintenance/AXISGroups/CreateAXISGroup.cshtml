@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.AXISGroupsViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "AXIS Groups";
    ViewBag.SubTitle = Model.axisGroup.AXISGroupsID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "SelectLists"))

        @using (Html.BeginForm("Save", "AXISGroups"))
        {
            <div class="form-horizontal">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.axisGroup.AXISGroupsID)

                <div class="form-group">
                    @Html.Label("AXIS Group Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.axisGroup.AXISGroupName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.axisGroup.AXISGroupName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("AXIS Group No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.axisGroup.AXISGroupNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.axisGroup.AXISGroupNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                @*<div class="form-group">
                    @Html.Label("Primary eBusiness Group", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.axisGroup.p_eBusinessGroup, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.axisGroup.p_eBusinessGroup, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Secondary eBusiness Group", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.axisGroup.s_eBusinessGroup, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.axisGroup.s_eBusinessGroup, "", new { @class = "text-danger" })
                    </div>
                </div>*@

                <div class="form-group">
                    @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.axisGroup.websiteFK, Model.AllWebsites, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.axisGroup.websiteFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Category Code", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.axisGroup.categoryCodeFK, Model.AllCategories, "Select...", new { @class = "form-control g-largeCell", @disabled = "disabled" })
                        @Html.ValidationMessageFor(model => model.axisGroup.categoryCodeFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.axisGroup.AXISGroupsID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.axisGroup.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnAXISGroupSave" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>

        }

    </div>
</div>

@section scripts {

    <script type="text/javascript">

        if ($('#axisGroup_AXISGroupsID').val() > 0) {
            $('#axisGroup_categoryCodeFK').removeAttr('disabled');
        }

        $(document).on("change", "#axisGroup_websiteFK", function (event) {

            if ($(this).val().length > 0) {
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#axisGroup_categoryCodeFK', 'category');
            } else {
                $("#axisGroup_categoryCodeFK").empty();
                $("#axisGroup_categoryCodeFK").html('<option value="" selected="true">Search by category</option>');
                $("#axisGroup_categoryCodeFK").attr('disabled', 'disabled');
            }

        });
    </script>
}