@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@using System.Globalization;
@model AxisEBusinessViewModel

@{
    ViewBag.Title = "Axis eBusiness Groups";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>
        
        @Html.Hidden("AxisEbusinessDataURL", Url.Action("eBusinessIndexData", "AxisEbusiness"))
        @Html.Hidden("DeleteEBusinessGroupURL", Url.Action("Delete", "AxisEbusiness"))
        @Html.Hidden("EBusinessGroupList", Model.EbusinessGroupList.Count)

        <div class="g-m-b-5">
            <select id="EBusinessGroupsSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="ref">Search by Ref</option>
                <option value="code">Search by Code</option>
                <option value="description">Search by Description</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchEBusinessGroups", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchEBusinessGroups" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slConfigurationSetting" />
            </div>

            @Html.ActionLink("Reset", "eBusinessIndex", "AxisEBusiness", null, new { @class = "btn btn-default" })
        </div>

        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                @Html.ActionLink("Create New", "Create", "AxisEBusiness", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="eBusinessGroupsCount" class="g-fw-b">@Model.EbusinessGroupListCount </span><span>eBusiness Groups Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="ref">eBusinessRef</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="code">eBusinessCode</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="code">Affiliate Commission Group</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="description">Description</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("eBusinessList", "AxisEbusiness", new { Model = Model.EbusinessGroupList });}
        </table>


        <div id="AxisEBusinessDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this E-Business Group?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>


@section Scripts {
    <script type="text/javascript">

        if ($('#EBusinessGroupList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchEBusinessGroups", function (event) {
            blockNumber = 1;
            GetAxisEbusinessSettings(true);
            return false;
        });

        $("#SearchEBusinessGroups").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetAxisEbusinessSettings(true);
            }
        });

        $(document).on("change", "#EBusinessGroupsSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetAxisEbusinessSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetAxisEbusinessSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetAxisEbusinessSettings(true);
            return false;
        });

        $(document).on('click', '.lnkDeleteGroup', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#AxisEBusinessDeleteDialog', $('#DeleteEBusinessGroupURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#eBusinessGroupsCount', '#tableSetting tbody');
            return false;
        });

        function GetAxisEbusinessSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#AxisEbusinessDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#eBusinessGroupsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchEBusinessGroups").val(); //SearchTerm
            optionsArray[2] = $("#EBusinessGroupsSearchBy").val(); //SearchBy
        }

        function setupOptionsArrayDelete(eBusinessId) {
            optionsArray = new Array();
            optionsArray[0] = eBusinessId;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchEBusinessGroups").val(); //SearchTerm
            optionsArray[2] = $("#EBusinessGroupsSearchBy").val(); //SearchBy
        }
    </script>

}