@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<overrideType>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Override Type";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="overrideTypeSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="overridetype">Search by override type</option>
            </select>
            <div>
                @Html.TextBox("SearchOverrideType", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchOverrideType" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slOverrideType" />
            </div>
        </div>
        <br />

        <div id="overrideTypePartialView">
            @{Html.RenderPartial("~/Views/PMS/Maintenance/OverrideType/OverrideTypeData.cshtml", Model);}
        </div>

        <div id="overrideTypeDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchOverrideType, #overrideTypePaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchOverrideType").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkOverrideTypeDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#overrideTypeDialog", $("#OverrideTypeDeleteURL").val(), $(this).attr("value"),
                                "#overrideTypePartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#overrideTypePartialView').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#overrideTypePaging", $("#OverrideTypeDataURL").val(),
                                    "#overrideTypePartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchOverrideType").val(); //SearchTerm
            optionsArray[1] = $("#overrideTypeSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //OverrideTypeID
            optionsArray[1] = $("#overrideTypeSearchBy").val(); //SearchBy
            optionsArray[2] = $("#SearchOverrideType").val(); //SearchTerm

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}