@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.OverrideTypeViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Override Type";
    ViewBag.SubTitle = Model.overrideTypeSingle.overrideTypeID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        @Html.Hidden("SaveOverrideTypeURL", Url.Action("Save", "OverrideType"))

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @using (Html.BeginForm("Save", "OverrideType"))
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.overrideTypeSingle.overrideTypeID)

                <div class="form-group">
                    @Html.Label("Override Type Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.overrideTypeSingle.overrideTypeName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.overrideTypeSingle.overrideTypeName, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.overrideTypeSingle.overrideTypeID > 0)
                {
                <div class="form-group">
                    @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.overrideTypeSingle.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                    </div>
                </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnOverrideTypeSave" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>

        }
    </div>
</div>