@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<categoryAttribute>

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("CategoryAttsDataURL", Url.Action("CategoryAttributesData", "CategoryCode"))
@Html.Hidden("CategoryAttsDeleteURL", Url.Action("Delete", "Category"))

<div>
    @Html.ActionLink("Create New", "CreateCategoryAttributes", "CategoryCode", new { id = @ViewBag.CategoryCodeID }, null)
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="attributeName">Attribute Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(m => item.filterableAttribute.attributeName)
            </td>

            <td>
                <a href="#" class="lnkDeleteCategoryAtt" value="@item.categoryAttributeID" title="Remove">Delete</a>
            </td>
        </tr>
    }

</table>
<br />
<div id="categoryAttributesPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}