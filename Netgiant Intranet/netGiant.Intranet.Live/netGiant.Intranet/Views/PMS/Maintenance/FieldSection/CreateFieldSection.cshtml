@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.FieldSectionViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Field Section";
    ViewBag.SubTitle = Model.fs.fieldSectionID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("Save", "FieldSection", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.fs.fieldSectionID)

                <div class="form-group">
                    @Html.Label("Field Section Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fs.fieldSectionName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fs.fieldSectionName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sequence No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fs.sequenceNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fs.sequenceNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                if (Model.fs.fieldSectionID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.fs.dateLastUpdated, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveFieldSection" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "FieldSection", "FieldSection", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>