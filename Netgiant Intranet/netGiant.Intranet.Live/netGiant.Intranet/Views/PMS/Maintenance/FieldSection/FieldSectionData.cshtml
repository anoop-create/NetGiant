@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<fieldSection>

@Html.Hidden("FieldSectionDataURL", Url.Action("FieldSectionData", "FieldSection"))
@Html.Hidden("DeleteFieldSectionURL", Url.Action("Delete", "FieldSection"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "FieldSection", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldSectionName">Field Section Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="sequenceNo">Sequence No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.ActionLink(item.fieldSectionName, "RelatedSubSections", "FieldSection", new { id = item.fieldSectionID }, new { @class = "gl_RemoveAnchorStyle" })
            </td>
            <td>
                @Html.DisplayFor(m => item.sequenceNo)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdated)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                   @Html.ActionLink("Edit", "Create", "FieldSection", new { id = item.fieldSectionID }, null);
                   @Html.Raw(" | <a href=\"#\" class=\"lnkFieldSectionDelete\" value=" + @item.fieldSectionID + " title=\"Delete" + @item.fieldSectionName + ">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="fieldSectionPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="fieldSectionDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this field section?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}
