@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model CMSViewModel

@{
    ViewBag.Title = "CMS Section";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("CmsSectionDataURL", Url.Action("SectionData", "CMS"))
        @Html.Hidden("DeleteCmsSectionURL", Url.Action("DeleteSection", "CMS"))
        @Html.Hidden("CmsSectionList", Model.CmsSectionList.Count)

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.CmsSection.websiteFK, Model.WebsiteNameList, "Search by Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })

            <div class="g-f-l">
                <select id="CmsSectionSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                    <option value="sectionname">Search by Section Name</option>
                </select>
                @Html.TextBox("SearchCmsSection", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchCmsSection" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
                @Html.ActionLink("Reset", "SectionIndex", "CMS", null, new { @class = "btn btn-default g-m-r-10" })
            </div>
        </div>
        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin") || User.IsInRole("SEO"))
            {
                @Html.ActionLink("Create New", "CreateSection", "CMS", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="CmsSectionCount" class="g-fw-b">@Model.CmsSectionListCount </span><span>CMS Section Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="website">Website</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="stockref">Section Name</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="stockref">Title</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("SectionList", "CMS", new { Model = Model.CmsSectionList });}
        </table>

        <div id="CmsSectionDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this CMS Section?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        //var ownBrand = 0;

        if ($('#CmsSectionList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchCmsSection", function (event) {
            blockNumber = 1;
            GetCmsSectionSettings(true);
            return false;
        });

        $("#SearchCmsSection").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetCmsSectionSettings(true);
            }
        });

        $(document).on("change", "#CmsSection_websiteFK", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetCmsSectionSettings(true);
        });

        $(document).on("change", "#CmsSectionSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetCmsSectionSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetCmsSectionSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetCmsSectionSettings(true);
            return false;
        });

        $(document).on('click', '.lnkDeleteCmsSection', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#CmsSectionDeleteDialog', $('#DeleteCmsSectionURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#CmsSectionCount', '#tableSetting tbody');
            return false;
        });

        function GetCmsSectionSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#CmsSectionDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#CmsSectionCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchCmsSection").val(); //SearchTerm
            optionsArray[2] = $("#CmsSectionSearchBy").val(); //SearchBy
            optionsArray[3] = $("#CmsSection_websiteFK").val() || 0; //Search by Website
            //if ($("#isMaintenance").is(":checked")) {
            //    optionsArray[7] = true;
            //} else {
            //    optionsArray[7] = false;
            //}
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchCmsSection").val(); //SearchTerm
            optionsArray[2] = $("#CmsSectionSearchBy").val(); //SearchBy
            optionsArray[3] = $("#CmsSection_websiteFK").val() || 0; //Search by Website
            //optionsArray[4] = $("#CmsSection_productTypeFK").val() || 0; //Search by Product Type
            //optionsArray[5] = $('#OwnBrandSearchBy').val();
            //optionsArray[6] = $('#AssemblySearchBy').val();
            //if ($("#isMaintenance").is(":checked")) {
            //    optionsArray[7] = true;
            //} else {
            //    optionsArray[7] = false;
            //}
        }
    </script>
}





