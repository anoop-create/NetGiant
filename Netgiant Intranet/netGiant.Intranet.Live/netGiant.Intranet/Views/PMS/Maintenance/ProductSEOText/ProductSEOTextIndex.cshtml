@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ProductSEOTextViewModel

@{
    ViewBag.Title = "Product SEO Text";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("ProductSEOTextDataURL", Url.Action("ProductSEOTextData", "ProductSEOText"))
        @Html.Hidden("DeleteProductSEOTextURL", Url.Action("Delete", "ProductSEOText"))
        @Html.Hidden("ProductSEOTextList", Model.ProductSEOTextList.Count)

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.ProductSEOText.websiteFK, Model.WebsiteNameList, "Search by Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.ProductSEOText.productTypeFK, Model.ProductTypeNameList, "Search by Product Type", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="AssemblySearchBy" class="g-f-l searchBy form-control g-smallCell g-m-r-10">
                <option selected="selected" value="2">Search by Item Type</option>
                <option value="1">Search by Assembly</option>
                <option value="0">Search by Stock</option>
                <option value="">Search by Both</option>
            </select>
            <select id="OwnBrandSearchBy" class="g-f-l searchBy form-control g-smallCell g-m-r-10">
                <option selected="selected" value="2">Search OwnBrand</option>
                <option value="1">Search by True</option>
                <option value="0">Search by False</option>
                <option value="">Search by Both</option>
            </select>
            <div class="g-f-l">
                <select id="ProductSEOTextSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                    <option selected="selected" value="pnumber">Search by Paragraph Number</option>
                    <option value="enumber">Search by Entry Number</option>
                    <option value="ptext">Search by Paragraph Text</option>
                </select>
                @Html.TextBox("SearchProductSEOText", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchProductSEOText" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
                @Html.ActionLink("Reset", "ProductSEOTextIndex", "ProductSEOText", null, new { @class = "btn btn-default g-m-r-10" })
                <div class="g-f-r">
                    <div class="g-m-l-10 g-f-l g-m-r-5" style="height: 35px; line-height: 35px;"><input type="checkbox" id="isMaintenance" /></div>
                    <div class="g-f-r" style="height: 30px; line-height: 30px;"><label style="color: green; padding-right: 10px;">Maintenance</label></div>
                </div>
            </div>
        </div>
        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin") || User.IsInRole("SEO"))
            {
                @Html.ActionLink("Create New", "Create", "ProductSEOText", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="ProductSEOTextCount" class="g-fw-b">@Model.ProductSEOTextListCount </span><span>SEO Text Records Found</span></span>
        </div>

        <table class="table" id="tableSetting">
            <tr>
                <th>
                    <a href="#" class="tableHeaderSort" value="number">Paragraph No</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="entry">Entry No (1-6)</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="website">Website</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="type">Product Type</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th class="g-a-c">
                    <a href="#" class="tableHeaderSort" value="ownbrand">Own Brand</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th class="g-a-c">
                    <a href="#" class="tableHeaderSort" value="assembly">Item Type</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th class="g-a-c">
                    <a href="#" class="tableHeaderSort" value="maintenance">Maintenance</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                    <a href="#" class="tableHeaderSort" value="text">Paragraph Text</a>
                    <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                </th>
                <th>
                </th>
            </tr>
            @{Html.RenderAction("ProductSEOTextList", "ProductSEOText", new { Model = Model.ProductSEOTextList });}
        </table>

        <div id="ProductSEOTextDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this Product SEO Text Record?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var ownBrand = 0;

        if ($('#ProductSEOTextList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("change", "#OwnBrandSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetProductSEOTextSettings(true);
        });

        $(document).on("change", "#AssemblySearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetProductSEOTextSettings(true);
        });

        $(document).on("click", "#lnkSearchProductSEOText", function (event) {
            blockNumber = 1;
            GetProductSEOTextSettings(true);
            return false;
        });

        $("#SearchProductSEOText").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetProductSEOTextSettings(true);
            }
        });

        $(document).on("change", "#ProductSEOText_websiteFK, #ProductSEOText_productTypeFK", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetProductSEOTextSettings(true);
        });

        $(document).on("change", "#ProductSEOTextSearchBy", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetProductSEOTextSettings(true);
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetProductSEOTextSettings(false);
            }
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetProductSEOTextSettings(true);
            return false;
        });

        $(document).on("click", "#isMaintenance", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetProductSEOTextSettings(true);
        });

        $(document).on('click', '.lnkDeleteProductSEOText', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#ProductSEOTextDeleteDialog', $('#DeleteProductSEOTextURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#ProductSEOTextCount', '#tableSetting tbody');
            return false;
        });

        function GetProductSEOTextSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#ProductSEOTextDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#ProductSEOTextCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchProductSEOText").val(); //SearchTerm
            optionsArray[2] = $("#ProductSEOTextSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ProductSEOText_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#ProductSEOText_productTypeFK").val() || 0; //Search by Product Type
            optionsArray[5] = $('#OwnBrandSearchBy').val();
            optionsArray[6] = $('#AssemblySearchBy').val();
            if ($("#isMaintenance").is(":checked")) {
                optionsArray[7] = true;
            } else {
                optionsArray[7] = false;
            }
        }

        function setupOptionsArrayDelete(id) {
            optionsArray = new Array();
            optionsArray[0] = id;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchProductSEOText").val(); //SearchTerm
            optionsArray[2] = $("#ProductSEOTextSearchBy").val(); //SearchBy
            optionsArray[3] = $("#ProductSEOText_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#ProductSEOText_productTypeFK").val() || 0; //Search by Product Type
            optionsArray[5] = $('#OwnBrandSearchBy').val();
            optionsArray[6] = $('#AssemblySearchBy').val();
            if ($("#isMaintenance").is(":checked")) {
                optionsArray[7] = true;
            } else {
                optionsArray[7] = false;
            }
        }
    </script>
}