@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.DataSupplierViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Data Supplier";
    ViewBag.SubTitle = Model.dataSupplier.dataSupplierID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @using (Html.BeginForm("Save", "DataSupplier"))
        {
            @Html.AntiForgeryToken()
            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.dataSupplier.dataSupplierID)

                <div class="form-group">
                    @Html.Label("Data Supplier Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.dataSupplier.dataSupplierName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.dataSupplier.dataSupplierName, "", new { @class = "text-danger" })
                    </div>
                </div>

                @if (Model.dataSupplier.dataSupplierID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.dataSupplier.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnDataSupplierSave" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            </div>
        }

    </div>
</div>