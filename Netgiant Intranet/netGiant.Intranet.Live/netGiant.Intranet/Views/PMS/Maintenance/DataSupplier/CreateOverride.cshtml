@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model DataSupplierViewModel

@{
    ViewBag.Title = "Create Override";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">

            @using (Html.BeginForm("SaveOverride", "DataSupplier"))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.DataSupplierOverride.overrideType, new { Value = 1 })
                @Html.HiddenFor(x => x.DataSupplierOverride.dataSupplierFk, new { Value = 1 })

                <div class="form-group">
                    @Html.Label("Attribute Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextBoxFor(x => x.DataSupplierOverride.attributeName, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveCmsEntry" value="Save" class="btn btn-default" title="Save" />
                    </div>
                </div>
            }

        </div>
    </div>
</div>
