@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<dataSupplier>

@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("DataSupplierDataURL", Url.Action("IndexData", "DataSupplier"))
@Html.Hidden("DataSupplierDeleteURL", Url.Action("Delete", "DataSupplier"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "DataSupplier", new { id = 0 }, null)
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="dataSupplierName">Data Supplier Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdate">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.dataSupplierName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.dateLastUpdate)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "DataSupplier", new { id = item.dataSupplierID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkDataSupplierDelete\" value=" + @item.dataSupplierID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>
<br />
<div id="dataSupplierPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}