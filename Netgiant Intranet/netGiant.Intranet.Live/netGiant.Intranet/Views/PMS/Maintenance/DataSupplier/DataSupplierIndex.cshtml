@using netGiant.Intranet.DataLayer
@using PagedList.Mvc;
@model PagedList.IPagedList<dataSupplier>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Data Supplier";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <div id="dataSupplierToggler" class="toggler">
            <div id="effect" class="ui-widget-content ui-corner-all">
                <h3 class="ui-widget-header ui-corner-all"></h3>
            </div>
        </div>

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="dataSupplierSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px;" >
                <option selected="selected" value="dataSupplier">Search by data supplier</option>
            </select>
            <div>
                @Html.TextBox("SearchDataSupplier", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchDataSupplier" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slDataSupplier" />
            </div>
        </div>
        <br />

        <div id="dataSupplierPartialView">
            @{Html.RenderPartial("~/Views/PMS/Maintenance/DataSupplier/DataSupplierData.cshtml", Model);}
        </div>

        <div id="dataSupplierDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchDataSupplier, #dataSupplierPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchDataSupplier").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkDataSupplierDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#dataSupplierDialog", $("#DataSupplierDeleteURL").val(), $(this).attr("value"),
                                "#dataSupplierPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#dataSupplierPartialView').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#dataSupplierPaging", $("#DataSupplierDataURL").val(),
                                    "#dataSupplierPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchDataSupplier").val(); //SearchTerm
            optionsArray[1] = $("#dataSupplierSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //DataSupplierID
            optionsArray[1] = $("#dataSupplierSearchBy").val(); //SearchBy
            optionsArray[2] = $("#SearchCategoryCode").val(); //SearchTerm

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}