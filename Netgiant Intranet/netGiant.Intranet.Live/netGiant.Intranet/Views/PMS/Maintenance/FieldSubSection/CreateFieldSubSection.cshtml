@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.FieldSubSectionViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Field Sub Section";
    ViewBag.SubTitle = Model.fss.fieldSubSectionID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("Save", "FieldSubSection", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.fss.fieldSubSectionID)

                <div class="form-group">
                    @Html.Label("Field Sub Section Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fss.fieldSubSectionName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fss.fieldSubSectionName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sequence No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fss.sequenceNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fss.sequenceNo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Field Section", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.fss.fieldSectionFK, Model.allFieldSections, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.fss.fieldSectionFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                if (Model.fss.fieldSubSectionID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.fss.dateLastUpdated, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveFieldSubSection" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "FieldSubSection", "FieldSubSection", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>