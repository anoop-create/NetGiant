@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model ProductItemTypeViewModel

@{
    ViewBag.Title = "Create Product Item Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">
            @using (Html.BeginForm("Save", "ProductItemType"))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.ProductItemType.productItemTypeID)

                <div class="form-group">
                    @if (Model.ProductItemType.productItemTypeID > 0)
                    {
                        @Html.Label("ProductItemType ID", htmlAttributes: new { @class = "control-label col-md-2" })
                    }
                    <div class="col-md-10">
                        @if (Model.ProductItemType.productItemTypeID > 0)
                        {
                            <div class="g-m-t-10">@Html.DisplayFor(model => model.ProductItemType.productItemTypeID, new { htmlAttributes = new { @class = "form-control g-largeCell" } })</div>
                            @Html.HiddenFor(x => x.ProductItemType.productItemTypeID)
                        }
                        @*else
                        {
                            @Html.EditorFor(model => model.ProductItemType.productItemTypeID, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        }*@
                        @Html.ValidationMessageFor(model => model.ProductItemType.productItemTypeID, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("ProductItemType Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.ProductItemType.productItemTypeName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.ProductItemType.productItemTypeName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveCartridgetype" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "ProductItemTypeIndex", "ProductItemType", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>

