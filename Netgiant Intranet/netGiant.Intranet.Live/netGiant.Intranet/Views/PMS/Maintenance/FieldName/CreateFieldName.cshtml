@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.FieldNameViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Field Name";
    ViewBag.SubTitle = Model.fn.fieldNameID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("Save", "FieldName", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.fn.fieldNameID)

                <div class="form-group">
                    @Html.Label("Field Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fn.fieldName1, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fn.fieldName1, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("AXIS Table Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fn.AXISTableName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fn.AXISTableName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("AXIS Field Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fn.AXISFieldName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fn.AXISFieldName, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Sequence No", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fn.sequenceNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.fn.sequenceNo, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                @*<div class="form-group">
                    @Html.Label("Field Section", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownList("ddFieldSections", Model.allFieldSections, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.DropDownListFor(m => m.fn.fieldSubSection.fieldSectionFK, Model.allFieldSections, "Select...", new { @class = "form-control g-largeCell" })
                    </div>
                </div>*@

                <div class="form-group">
                    @Html.Label("Field Sub Section", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.fn.fieldSubSectionFK, Model.allFieldSubSections, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.fn.fieldSubSectionFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Field Type", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.fn.fieldTypeFK, Model.allFieldTypes, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.fn.fieldTypeFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Is Website Specific", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.fn.websiteSpecific, new { htmlAttributes = new { @class = "" } })
                        @Html.ValidationMessageFor(model => model.fn.websiteSpecific, "", new { @class = "text-danger" })
                    </div>
                </div>

                if (Model.fn.fieldNameID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.fn.dateLastUpdated, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveFieldName" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "FieldName", "FieldName", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>