@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<fieldName>

@Html.Hidden("FieldNameDataURL", Url.Action("FieldNameData", "FieldName"))
@Html.Hidden("DeleteFieldNameURL", Url.Action("Delete", "FieldName"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "FieldName", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldName">Field Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="AXISTableName">AXIS Table Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="AXISFieldName">AXIS Field Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="sequenceNo">Sequence No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldSubSection">Field Sub Section</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldType">Field Type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.fieldName1)
            </td>
            <td>
                @Html.DisplayFor(m => item.AXISTableName)
            </td>
            <td>
                @Html.DisplayFor(m => item.AXISFieldName)
            </td>
            <td>
                @Html.DisplayFor(m => item.sequenceNo)
            </td>
            <td>
                @Html.DisplayFor(m => item.fieldSubSection.fieldSubSectionName)
            </td>
            <td>
                @Html.DisplayFor(m => item.fieldType.fieldTypeName)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdated)
            </td>
            <td> 
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "FieldName", new { id = item.fieldNameID }, new { @title = "Edit" });
                    @Html.Raw(" | <a href=\"#\" class=\"lnkFieldNameDelete\" value=" + @item.fieldNameID + " title=\"Delete" + @item.fieldName1 + ">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="fieldNamePaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="fieldNameDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete this field name?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}