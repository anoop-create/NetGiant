@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance;
@model EquipmentNotesViewModel

@{
    ViewBag.Title = "Create Equipment Note";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h4>@ViewBag.Title</h4>
        <div class="form-horizontal">
            @using (Html.BeginForm("Save", "EquipmentNotes"))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new { @class = "text-danger" })
                @Html.HiddenFor(x => x.EquipmentNotes.equipmentNotesID)

                <div class="form-group">
                    @Html.Label("Website", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.EquipmentNotes.websiteFK, Model.WebsiteNameList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
                        @Html.ValidationMessageFor(model => model.EquipmentNotes.Website.WebsiteName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Equipment", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.EquipmentNotes.eqEquipmentFK, Model.EquipmentNameList, "Select...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
                        @Html.ValidationMessageFor(model => model.EquipmentNotes.eqEquipment.description, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Detail", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.CheckBoxFor(model => model.EquipmentNotes.isDetail, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label("Note", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.TextAreaFor(x => x.EquipmentNotes.note, new { @class = "form-control g-largeCell-textArea", rows = 5 }) 
                        @Html.ValidationMessageFor(model => model.EquipmentNotes.note, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveEquipmentNotes" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "EquipmentNotesIndex", "EquipmentNotes", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
