@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Maintenance.FilterableAttributeViewModel

@{
    ViewBag.Title = "Filterable Attributes";
    ViewBag.SubTitle = Model.filterableAttribute.filterableAttributeID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        @Html.Hidden("SaveFilterableAttributeURL", Url.Action("Save", "FilterableAttribute"))

        <div class="form-horizontal">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(m => m.filterableAttribute.filterableAttributeID)

            <div class="form-group">
                @Html.Label("Attribute Name", htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.EditorFor(model => model.filterableAttribute.attributeName, new { htmlAttributes = new { @class = "form-control gl_LargeCell" } })
                    @Html.ValidationMessageFor(model => model.filterableAttribute.attributeName, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-offset-2 col-md-10">
                    <a id="lnkFilterableAttributeSave" href="#" class="btn btn-default">Save</a>
                    <a id="lnkFilterableAttributeCancel" href="#" class="btn btn-default">Cancel</a>
                </div>
            </div>

        </div>
    </div>
</div>