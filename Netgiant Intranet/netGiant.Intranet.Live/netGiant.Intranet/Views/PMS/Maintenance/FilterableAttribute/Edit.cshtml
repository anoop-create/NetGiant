@model netGiant.Intranet.DataLayer.filterableAttribute

@{
    ViewBag.Title = "Filterable Attributes";
    ViewBag.SubTitle = "Edit";
}

<div class="qa_placeHolderHeading gl_textType2b">Product Management System &raquo; @ViewBag.Title &raquo; @ViewBag.SubTitle<hr /></div>
<div class="qa_placeHolderBody">

    <h3>@(string.Format("{0} {1}", ViewBag.SubTitle, ViewBag.Title))</h3>

    @Html.Hidden("SaveFilterableAttributeURL", Url.Action("Save", "FilterableAttribute"))
    @Html.Hidden("FilterableAttributeDetailsURL", Url.Action("Index", "FilterableAttribute"))

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.filterableAttributeID)

        <div class="form-group">
            @Html.Label("Attribute Name", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.attributeName, new { htmlAttributes = new { @class = "form-control gl_LargeCell" } })
                @Html.ValidationMessageFor(model => model.attributeName, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <a id="lnkFilterableAttributeSave" href="#" class="btn btn-default">Save</a>
                <a id="lnkFilterableAttributeCancel" href="#" class="btn btn-default">Cancel</a>
            </div>
        </div>
    </div>

</div>