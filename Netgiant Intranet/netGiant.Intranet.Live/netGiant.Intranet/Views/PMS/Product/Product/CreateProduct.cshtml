                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Stock Notes", new { @class = "g-f-l" })
                                            <textarea id="prod.AxisFields.AxisFieldsAdditional@(loopCount).stockNoteDesc"
                                                      name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].stockNoteDesc">@afa.stockNoteDesc</textarea>
                                            </div>
                                            <div class="g-f-l prdCrt_leftContainer">
                                                @Html.Label("Meta Keywords", new { @class = "g-f-l" })
                                                <textarea id="prod.AxisFields.AxisFieldsAdditional@(loopCount).metaKeywords"
                                                    name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].metaKeywords">@afa.metaKeywords</textarea>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <div class="g-f-l prdCrt_leftContainer">
                                                    @Html.Label("Meta Title", new { @class = "g-f-l" })
                                                    <textarea id="prod.AxisFields.AxisFieldsAdditional@(loopCount).metaTitle"
                                                              name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].metaTitle">@afa.metaTitle</textarea>
                                                    </div>
                                                    <div class="g-f-l prdCrt_leftContainer">
                                                        @Html.Label("Meta Description", new { @class = "g-f-l" })
                                                        <textarea id="prod.AxisFields.AxisFieldsAdditional@(loopCount).metaDesc"
                                                                  name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].metaDesc">@afa.metaDesc</textarea>
                                                        </div>
                                                    </div>

                                                </fieldset>
                                loopCount++;
                            }
                        }
                    </div>
                    <div id="tabs-4">
                        <table class="g-m-t-20 g-w-100p">
                            <tr>
                                <td class="g-w-50p g-a-t">
                                    <fieldset>
                                        <legend>eBusiness Group(s)</legend>
                                        <table id="tblEbusiness" width="500">
                                            @foreach (var grp in Model.prod.AxisEbusinessMapping.OrderBy(x => x.eBusinessRef))
                                            {
                                                Html.RenderPartial("~/Views/PMS/Product/Product/EbusinessGroups.cshtml",
                                                     grp);
                                            }
                                        </table>
                                        @Html.DropDownList("ddlEbusiness", Model.AllEbusinessGroups, "Add to eBusiness Group...", new { @class = "form-control g-largeCell" })
                                    </fieldset>
                                </td>
                                <td class="g-w-50p g-a-t">
                                    <fieldset>
                                        <legend>Secondary Category Code(s)</legend>
                                        @foreach (var wi in Model.prod.websiteInventory)
                                        {
                                            Model.AllCategoryCodes = SelectListViewModel.AllCategoryCodes(wi.websiteFK);
                                            <fieldset>
                                                <legend>@Html.Raw(wi.Website.FriendlyName)</legend>
                                                <table id=@Html.Raw("\"tblCatCode-" + wi.websiteFK + "\"") width="500">
                                                    <tr>
                                                        <td class="g-fw-b">
                                                            @Html.Raw(wi.categoryCode != null ? "<span class=\"lblDesc\">" + wi.categoryCodeFK + " - " + wi.categoryCode.categoryCodeName + "</span>" : "Not Set")
                                                        </td>
                                                        <td class="g-fw-b" colspan="2">Primary</td>
                                                    </tr>

                                                    @{ ViewBag.guid = Guid.NewGuid().ToString(); }

                                                    @Html.Hidden("guid" + wi.websiteFK, (string)ViewBag.guid, new { @class = "guid" })

                                                    @foreach (var scc in wi.secondaryCategoryLookup.OrderBy(x => x.categoryCodeFK))
                                                    {
                                                        Html.RenderPartial("~/Views/PMS/Product/Product/CategoryCodes.cshtml", scc);
                                                    }
                                                </table>
                                                @Html.DropDownList("ddlCategoryCodes-" + wi.websiteFK, Model.AllCategoryCodes, "Add to Category Code...", new { @class = "form-control g-largeCell" })
                                                @Html.Hidden("prod.websiteInventory[" + (string)ViewBag.guid + "].websiteFK", wi.websiteFK)
                                                @Html.Hidden("prod.websiteInventory[" + (string)ViewBag.guid + "].websiteInventoryID", wi.websiteInventoryID, new { @class = "wi-id" + wi.websiteFK })
                                                @Html.Hidden("prod.websiteInventory[" + (string)ViewBag.guid + "].productFK", Model.prod.productID)

                                                <input type="hidden" value="@ViewBag.guid" autocomplete="off"
                                                       name="prod.websiteInventory.index">

                                            </fieldset>
                                        }
                                    </fieldset>
                                </td>
                            </tr>
                        </table>
                    </div>

                    @if (Model.prod.productItemTypeFK == 2)
                    {
                        <div id="tabs-5">
                            <fieldset class="g-m-t-20">
                                <legend>Components</legend>
                                <table id="tblComponents" width="800">
                                    @foreach (var com in Model.prod.assemblyComponent.OrderBy(x => x.product1.partNo))
                                    {
                                        Html.RenderPartial("~/Views/PMS/Product/Product/AssemblyComponent.cshtml",
                                            com);
                                    }
                                </table>
                                <select id="aProduct"></select>
                                @Html.Hidden("hiddenComponent", "0", new { @class = "hiddenValue" })
                            </fieldset>
                        </div>
                    }

                    @if(Model.prod.productID != 0)
                    {
                        <div id="tabs-6">
                            <br />

                            <input id="hiddenProductID" value="@Model.prod.productID" type="hidden" />

                            <div id="membershipDataPartialView">
                                @{Html.RenderPartial("~/Views/PMS/Product/ProductDetail/EquipMemberships.cshtml", Model.ProductMembership);}
                            </div>

                            <div id="eqMembershipDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
                                Are you sure ?
                            </div>

                            <input type="hidden" id="activeSortType" />
                            <input type="hidden" id="activeSortDir" />
                            <input type="hidden" id="historyPage" />
                        </div>
                    }

                </div>

                <div class="form-group">
                    <div class="col-md-10 g-m-t-10">
                        <input type="submit" name="saveProduct" value="Save" class="btn btn-default" title="Save" id="btnSaveProduct" />
                        @Html.ActionLink("Cancel", "ProductIndex", "Product", null, new { @class = "btn btn-default" })
                        @Html.ActionLink("Read Only", "Detail", "Product", new { id = Model.prod.productID }, new { @class = "btn btn-default" })
                    </div>
                </div>

            }
        </div>

        @Html.Hidden("GetProductsURL", Url.Action("GetAvailableComponents", "Product"))
        <div id="eanSearchDialogue" title="EAN Search" class="g-d-n" style="overflow: hidden;"></div>

    </div>
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}

@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {

            //This allows validation of hidden fields inside the form
            $('#mainForm').validate().settings.ignore = [];

            setupComboBox($('#GetProductsURL').val());

            $.validator.methods.date = function (value, element) {
                if ($.browser.webkit) {
                    var d = new Date();
                    return this.optional(element) || !/Invalid|NaN/.test(new Date(d.toLocaleDateString(value)));
                }
                else {
                    return this.optional(element) || !/Invalid|NaN/.test(new Date(value));
                }
            };

        });

        $(document).ready(function () {
            $("#aProduct, #bProduct").combobox();
        });

        $(document).on('change', '.hiddenValue', function () {
            var objArray = new Array();
            objArray[0] = $('#prod_productID').val();
            objArray[1] = $(this).val();

            $.ajax({
                url: $('#GetNewComponentURL').val(),
                dataType: 'html',
                traditional: true,
                type: 'POST',
                cache: false,
                data:
                    {
                        parms: objArray,
                        timestamp: $.now()
                    },
                async: false,
                success: function (data) {
                    $('#tblComponents').append(data);
                    $('.custom-combobox-input').val('').blur();
                }
            });
        });

        $(document).on('change', '.chkBoxWebsite', function () {
            var catCodeSelect = $(this).parent().find('.catCodeSelect');

            if ($(this).is(':checked')) {
                catCodeSelect.removeAttr('disabled');
            } else {
                catCodeSelect.attr('disabled', 'disabled');
                catCodeSelect.prop('selectedIndex', 0);
            }
        });

        $(document).on('click', 'input[type=submit]', function () {
            var returnState = true;

            $('.chkBoxWebsite').each(function () {
                if ($(this).is(':checked')) {
                    var catCodeSelect = $(this).parent().find('.catCodeSelect');
                    if (catCodeSelect.prop('selectedIndex') == 0) {
                        returnState = false;
                        alert('Please select a catgory code');
                    }
                }
            });

            return returnState;
        });

        $(document).on('change', '.catCodeSelect', function () {
            $('#ChangedWebsiteInv').val(true);
            $('input[type=submit]').trigger('click');
            $('#ChangedWebsiteInv').val(false);
        });

        $(document).on('click', '.chkBoxWebsite', function () {
            if (!$(this).is(':checked')) {
                $('#ChangedWebsiteInv').val(true);
                $('input[type=submit]').trigger('click');
                $('#ChangedWebsiteInv').val(false);
            }
        });

        $(document).on('change', '#prod_productItemTypeFK', function () {
            $('#ChangedWebsiteInv').val(true);
            $('input[type=submit]').trigger('click');
            $('#ChangedWebsiteInv').val(false);
        });

        $(document).on('click', '.chkPrimary', function () {
            $(this).removeClass('chkPrimary');

            $('.chkPrimary').each(function () {
                $(this).prop('checked', false);
            });

            $(this).addClass('chkPrimary');
        });

        $(document).on('click', '.lnkDelete', function () {
            $(this).parent().parent().remove();
            return false;
        });

        $(document).on('change', '#ddlEbusiness', function () {
            var objArray = new Array();
            objArray[0] = this.value;
            objArray[1] = $('#prod_productID').val();

            $.ajax({
                url: $('#GetNewEbusRowURL').val(),
                dataType: 'html',
                traditional: true,
                type: 'POST',
                cache: false,
                data:
                    {
                        parms: objArray,
                        timestamp: $.now()
                    },
                async: false,
                success: function (data) {
                    $('#tblEbusiness').append(data);
                }
            });
        });

        $(document).on('change', '[id^=ddlCategoryCodes]', function () {
            var websiteId = $(this).attr('id').split('-')[1];
            var objArray = new Array();
            objArray[0] = this.value;
            objArray[1] = $('.wi-id' + (websiteId)).val();
            objArray[2] = $(this).parent().find('.guid').val();

            $.ajax({
                url: $('#GetNewCatCodeRowURL').val(),
                dataType: 'html',
                traditional: true,
                type: 'POST',
                cache: false,
                data:
                    {
                        parms: objArray,
                        timestamp: $.now()
                    },
                async: false,
                success: function (data) {
                    $('#tblCatCode-' + websiteId).append(data);
                }
            });
        });

        $(document).ready(function () {
            $(".createProductTabs").tabs();
        });

        $(document).on('click', '#btnSaveProduct', function () {
            if ($('#mainForm').valid()) {
                $('body').append('<div id="updatingContainer"></div>');
            }
        });

        $(document).on('click', '#checkBarcode', function () {
            $('body').append('<div id="updatingContainer" style="z-index: 102;"></div>');
            $('#eanSearchDialogue').html('<div class="g-ps-r g-of-h eanB_popup"><iframe id="eanIframe" src="https://www.barcodelookup.com/' + $('#prod_barcode').val() + '" class="g-ps-a" frameborder="0"></iframe></div>');
            $('#eanIframe').load(function () { $('#updatingContainer').remove(); });
            $("#eanSearchDialogue").dialog({
                modal: true,
                width: 1000,
                height: 620
            });

            return false;
        });

        $(document).tooltip({
            items: '*:not(.ui-dialog-titlebar-close)'
        });

        $(document).on('change', '.product-status', function () {
            if ($(this).val() == 3) {
                $('.chkBoxWebsite').attr('checked', false);
                $('.catCodeSelect option:selected').attr('selected', false);
                $('.catCodeSelect').attr('disabled', 'disabled');
            }
        });

        $(document).on('click', '.deleteProductRelationship', function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#eqMembershipDialog", $("#ProductMemDeleteURL").val(), $(this).attr("value"),
                "#membershipDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        $(document).on("click", "#eqMembershipPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#eqMembershipPaging", $("#ProductMemDataURL").val(),
                "#membershipDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#hiddenProductID").val();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value");
            optionsArray[1] = $("#hiddenProductID").val();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

    </script>
}
