@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product
@using netGiant.Intranet.BusinessLayer.ViewModels.Shared
@using netGiant.Intranet.DataLayer
@model ProductViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Product";
    ViewBag.SubTitle = Model.prod.productID > 0 ? "Edit" : "Create";
    ViewBag.Action = "CreateProduct";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title - @Model.prod.partNo, @Model.prod.productName</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("SaveProduct", "Product", FormMethod.Post, new { @id = "mainForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.prod.productID)
                @Html.HiddenFor(m => m.ChangedWebsiteInv)
                @Html.Hidden("GetNewEbusRowURL", Url.Action("GetNewEbusinessRow", "Product"))
                @Html.Hidden("GetNewCatCodeRowURL", Url.Action("GetNewCatCodeRow", "Product"))
                @Html.Hidden("GetNewComponentURL", Url.Action("GetNewComponentRow", "Product"))

                <div class="createProductTabs">
                    <ul>
                        <li><a href="#tabs-1">Product Info</a></li>
                        <li><a href="#tabs-2">Axis Fields</a></li>
                        <li><a href="#tabs-3">Site Specific</a></li>
                        <li><a href="#tabs-4">Categorisation</a></li>

                        @if (Model.prod.productItemTypeFK == 2)
                        {
                            <li><a href="#tabs-5">Components</a></li>
                        }

                        @if (Model.prod.productID != 0)
                        {
                            <li><a href="#tabs-6">Equipment</a></li>
                        }
                    </ul>

                    <div id="tabs-1">
                        <fieldset class="g-m-t-20">
                            <legend>Product Details</legend>
                            <div class="form-group">
                                @Html.Label("Product Name", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.prod.productName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.prod.productName, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Part No", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.EditorFor(model => model.prod.partNo, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                                    @Html.ValidationMessageFor(model => model.prod.partNo, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            
                            <div class="form-group">
                                @Html.Label("Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(m => m.prod.manufacturerFK, Model.AllManufacturers, "Select...", new { @class = "form-control g-largeCell" })
                                    @Html.ValidationMessageFor(model => model.prod.manufacturerFK, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Product Status", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(m => m.prod.productStatusFK, Model.AllProductStatuses, "Select...", new { @class = "product-status form-control g-largeCell" })
                                    @Html.ValidationMessageFor(model => model.prod.productStatusFK, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.Label("Product Group", htmlAttributes: new { @class = "control-label col-md-2" })
                                <div class="col-md-10">
                                    @Html.DropDownListFor(m => m.prod.productGroupFK, Model.AllProductGroups, "Select...", new { @class = "form-control g-largeCell" })
                                    @Html.ValidationMessageFor(model => model.prod.productGroupFK, "", new { @class = "text-danger" })
                                </div>
