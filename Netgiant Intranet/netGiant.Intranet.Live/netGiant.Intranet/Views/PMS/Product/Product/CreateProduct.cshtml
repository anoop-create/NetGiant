                            }
                        </fieldset>

                        <fieldset class="g-m-t-20">
                            <legend>Website Inventory Main Category Code</legend>
                            <div class="form-group">
                                <div class="col-md-10">
                                    @*@Html.CheckBoxListFor(m => m.SelectedWebsiteIDs, m => m.AllWebsites, x => x.WebsiteID, x => x.FriendlyName, m => m.selectedWebsites,
                                        new MvcCheckBoxList.Model.HtmlListInfo(MvcCheckBoxList.Model.HtmlTag.vertical_columns, 2,
                                            new { @class = "styled_checkbox" }, MvcCheckBoxList.Model.TextLayout.RightToLeft))*@

                                    <div>
                                        @{int currentIndex = 0;}
                                        @foreach (Website ws in Model.AllWebsites)
                                        {
                                            string currentID = "SelectedWebsiteIDs" + currentIndex;
                                            bool isSelected = Model.SelectedWebsites.Contains(ws);
                                            websiteInventory wiDetail = Model.prod.websiteInventory.Where(x => x.websiteFK == ws.WebsiteID).FirstOrDefault();

                                            <div class="createProductInventoryRow">
                                                @Html.Label(ws.FriendlyName)
                                                @Html.CheckBoxFor(m => isSelected, new { id = @currentID, Value = ws.WebsiteID, Name = "SelectedWebsiteIDs", @class = "chkBoxWebsite" })
                                                @Html.DropDownList("selectedCatId" + currentIndex, new SelectList(SelectListViewModel.AllCategoryCodes(ws.WebsiteID),
                                            "Value", "Text", wiDetail != null ? wiDetail.categoryCodeFK : 0), "Select...",
                                             isSelected == true ? (object)new { @class = "form-control g-smallCell g-d-i catCodeSelect", Name = "selectedCatCodeIDs" } :
                                             (object)new { @disabled = "disabled", @class = "form-control g-smallCell g-d-i catCodeSelect", Name = "selectedCatCodeIDs" })
                                            </div>

                                            currentIndex += 1;
                                        }
                                    </div>

                                </div>
                            </div>
                        </fieldset>
                    </div>
