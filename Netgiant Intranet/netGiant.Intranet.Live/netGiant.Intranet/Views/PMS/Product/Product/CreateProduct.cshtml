                    <div id="tabs-3">
                        @if (Model.prod.AxisFields != null)
                        {
                            int loopCount = 0;
                            foreach (AxisFieldsAdditional afa in Model.prod.AxisFields.AxisFieldsAdditional.OrderBy(x => x.websiteFK))
                            {
                                <fieldset class="g-m-t-20">
                                    <legend>@Html.Raw(Model.AllWebsites.Where(x => x.WebsiteID == afa.websiteFK).First().FriendlyName)</legend>
                                    <input type="hidden" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).axisFieldsAdditionalID"
                                           value="@afa.axisFieldsAdditionalID" name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].axisFieldsAdditionalID">
                                    <input type="hidden" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).productFK"
                                           value="@afa.productFK" name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].productFK">
                                    <input type="hidden" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).websiteFK"
                                           value="@afa.websiteFK" name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].websiteFK">

                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Google Feed Site", new { @class = "g-f-l" })
                                            <input value="@afa.googleFeedSite" type="text" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).googleFeedSite"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].googleFeedSite"
                                                   class="form-control g-largeCell" />
                                        </div>
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Google Feed Include", new { @class = "g-f-l" })
                                            @Html.CheckBox("prod.AxisFields.AxisFieldsAdditional[" + loopCount + "].googleFeedInclude",
                                        afa.googleFeedInclude != null ? afa.googleFeedInclude == true ? true : false : false)

                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Google Feed Category", new { @class = "g-f-l" })
