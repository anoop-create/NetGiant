                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Bespoke Custom Ship Cost", new { @class = "g-f-l" })
                                            <input value="@afa.bespokeFeedUseCustomShipCost" type="text" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).bespokeFeedUseCustomShipCost"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].bespokeFeedUseCustomShipCost"
                                                   class="form-control g-largeCell" />
