                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].bespokeFeedAvailability"
                                                   class="form-control g-largeCell" />
                                        </div>
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Bespoke Feed Condition", new { @class = "g-f-l" })
                                            <input value="@afa.bespokeFeedCondition" type="text" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).bespokeFeedCondition"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].bespokeFeedCondition"
                                                   class="form-control g-largeCell" />
                                        </div>
