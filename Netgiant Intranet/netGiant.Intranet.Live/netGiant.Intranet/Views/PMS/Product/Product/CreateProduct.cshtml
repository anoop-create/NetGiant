                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Break Quantity 1", new { @class = "g-f-l" })
                                            <input value="@afa.breakQuantity1" type="number" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).breakQuantity1"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].breakQuantity1"
                                                   class="form-control g-largeCell" />
                                        </div>
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Break Quantity 2", new { @class = "g-f-l" })
                                            <input value="@afa.breakQuantity2" type="number" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).breakQuantity2"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].breakQuantity2"
                                                   class="form-control g-largeCell" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <div class="g-f-l prdCrt_leftContainer">
                                            @Html.Label("Break Quantity 3", new { @class = "g-f-l" })
                                            <input value="@afa.breakQuantity3" type="number" id="prod.AxisFields.AxisFieldsAdditional@(loopCount).breakQuantity3"
                                                   name="prod.AxisFields.AxisFieldsAdditional[@(loopCount)].breakQuantity3"
                                                   class="form-control g-largeCell" />
                                        </div>
