                                    @Html.ValidationMessageFor(model => model.prod.supplierStock, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            @if (Model.prod.productID > 0)
                            {
                                <div class="form-group">
                                    @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.prod.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                                    </div>
                                </div>
                                <div class="form-group">
                                    @Html.Label("Supplier Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                                    <div class="col-md-10">
                                        @Html.EditorFor(model => model.prod.supplierLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                                    </div>
                                </div>
                                @Html.HiddenFor(model => model.prod.supplierLastUpdate)
