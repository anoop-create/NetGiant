@using netGiant.Intranet.DataLayer
@model AxisEbusinessMapping

<tr>
    <td class="g-w-80p">
        @Html.Raw("<span class=\"lblDesc\">" + Model.eBusinessRef + " - " + Model.AxisEbusiness.description + "</span>")
    </td>
    <td class="g-w-10p">
    @using (Html.BeginCollectionItem("prod.AxisEbusinessMapping"))
    {

        @Html.CheckBoxFor(m => m.eBusinessPrimary, new { @class = "chkPrimary" })
        @Html.HiddenFor(m => m.eBusinessRef)
        @Html.HiddenFor(m => m.productFK)
        @Html.HiddenFor(m => m.eBusinessMappingID)
    }
    </td>
    <td class="g-w-10p">
        <a href="#" class="lnkDelete">Delete</a>
    </td>
</tr>
