@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product;
@model ProductViewModel

@{
    ViewBag.Title = "Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        @Html.Hidden("DeleteProductURL", Url.Action("DeleteProduct", "Product"))
        @Html.Hidden("ProductIndexDataURL", Url.Action("ProductIndexData", "Product"))
        @Html.Hidden("ProductPricesDataURL", Url.Action("ProductPrices", "Product"))

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.SelectedManufacturerID, Model.AllManufacturers, "Search By Manufacturer", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            @Html.DropDownListFor(m => m.SelectedProductGroupID, Model.AllProductGroups, "Search By Product Group", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            @Html.DropDownListFor(m => m.SelectedProductStatusID, Model.AllProductStatuses, "Search By Product Status", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            @Html.DropDownListFor(m => m.SelectedSalesAreaGroupID, Model.AllSalesAreaGroups, "Search By Sales Group", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            @Html.ActionLink("Reset", "ProductIndex", "Product", null, new { @class = "btn btn-default" })
        </div>
        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.SelectedProductItemTypeID, Model.AllProductItemType, "Search By Item Type", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            <select id="productSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="partNo">Search by part no</option>
                <option value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchProduct", null, new { @class = "form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkProductSearch" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div>
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                @Html.ActionLink("Create New", "CreateProduct", "Product", new { id = 0 }, new { @title = "Create new product" })
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="productCount" class="g-fw-b">@Model.ProductsCount </span><span>Products Found</span></span>
        </div>

        <div id="productDataPartialView">
            <table id="tblProduct" class="table">
                <tr>
                    <th class="g-mediumCell">
                        <a href="#" class="tableHeaderSort" value="productName">Product Name</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="partNo">Part No</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="productStatus">Product Status</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="productGroup">Product Group</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="salesGroup">Sales Area Group</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="stock">Stock</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="priceTG">TG Price</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="priceCM">CM Price</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="priceNG">NG Price</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="dataSupplier">Data Supplier</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="supplierLastUpdate">Supplier Last Update</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th></th>
                </tr>
                @{Html.RenderAction("ProductList", "Product", new { Model = Model.Products });}
            </table>
        </div>

        <div id="productDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this product?
        </div>

        <div id="productDetailsDialog" title="Product Details" style="display:none;"></div>
        <div id="productPricesContainer" title="Price History"></div>
        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on('click', '#lnkProductSearch', function (event) {
            blockNumber = 1;
            GetProducts(true);
            return false;
        });

        $("#SearchProduct").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetProducts(true);
            }
        });

        $(document).on("click", ".lnkProductDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDeleteInfiniteScroll('#productDeleteDialog', $('#DeleteProductURL').val(), $(this).attr('value'),
                '#productDataPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tblProduct tr:gt(0)', '#productCount', '#tblProduct tbody');
            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetProducts(true);
            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#productDataPartialView').html($("#historyPage").val());
        }

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetProducts(false);
            }
            return false;
        });

        function GetProducts(clearTable) {
            setupOptionsArrayPaging();
            InfiniteScroll('@Url.Action("ProductData", "Product")',
                optionsArray,
                clearTable,
                '#tblProduct tr:gt(0)',
                '#productCount',
                '#tblProduct tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

    $(document).on('change', '#SelectedManufacturerID, #SelectedProductGroupID, ' +
        '#SelectedProductStatusID, #SelectedSalesAreaGroupID, #SelectedProductItemTypeID',
        function (event) {
            blockNumber = 1;
            GetProducts(true);
            return false;
    });

    $(document).on("click", ".lnkPriceHistory", function () {
        var objParams = { productFK: $(this).attr("value") };

        ajaxGet($("#ProductPricesDataURL").val(), "#productPricesContainer", objParams)
        $("#productPricesContainer").dialog({
            modal: true,
            width: 1000,
            title: "Price History - " + $(this).attr("p") + ", " + $(this).attr("d")
        });

        return false;
    });

    function setupOptionsArrayPaging() {
        optionsArray = new Array();
        optionsArray[0] = $("#SearchProduct").val(); //SearchTerm
        optionsArray[1] = $("#productSearchBy").val(); //SearchBy

        var sortType = $("#activeSortType").val();
        var sortDir = $("#activeSortDir").val();

        if (sortType.length > 0) {
            optionsArray[2] = sortType + sortDir;
        } else {
            optionsArray[2] = '';
        }

        optionsArray[3] = $("#SelectedManufacturerID option:selected").val().length > 0 ? $("#SelectedManufacturerID option:selected").val() : 0;
        optionsArray[4] = $("#SelectedProductGroupID option:selected").val().length > 0 ? $("#SelectedProductGroupID option:selected").val() : 0;
        optionsArray[5] = $("#SelectedProductStatusID option:selected").val().length > 0 ? $("#SelectedProductStatusID option:selected").val() : 0;
        optionsArray[6] = $("#SelectedSalesAreaGroupID option:selected").val().length > 0 ? $("#SelectedSalesAreaGroupID option:selected").val() : 0;
        optionsArray[7] = $("#SelectedProductItemTypeID option:selected").val().length > 0 ? $("#SelectedProductItemTypeID option:selected").val() : 0;
    }

    function setupOptionsArrayDelete(lnkDelete) {
        optionsArray = new Array();
        optionsArray[0] = lnkDelete.attr("value"); //ProductID
        optionsArray[1] = $("#SearchProduct").val(); //SearchTerm
        optionsArray[2] = $("#productSearchBy").val(); //SearchBy

        var sortType = $("#activeSortType").val();
        var sortDir = $("#activeSortDir").val();

        if (sortType.length > 0) {
            optionsArray[3] = sortType + sortDir;
        } else {
            optionsArray[3] = '';
        }

        optionsArray[4] = $("#SelectedManufacturerID option:selected").val().length > 0 ? $("#SelectedManufacturerID option:selected").val() : 0;
        optionsArray[5] = $("#SelectedProductGroupID option:selected").val().length > 0 ? $("#SelectedProductGroupID option:selected").val() : 0;
        optionsArray[6] = $("#SelectedProductStatusID option:selected").val().length > 0 ? $("#SelectedProductStatusID option:selected").val() : 0;
        optionsArray[7] = $("#SelectedSalesAreaGroupID option:selected").val().length > 0 ? $("#SelectedSalesAreaGroupID option:selected").val() : 0;
    }

    </script>
}