@using netGiant.Intranet.DataLayer
@using PagedList.Mvc

@model PagedList.IPagedList<websiteInventory>

@Html.Hidden("WebsiteInventoryDataURL", Url.Action("WebsiteInventoryData", "WebsiteInventory"))
@Html.Hidden("DeleteWebsiteInventoryURL", Url.Action("Delete", "WebsiteInventory"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)
@Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "SelectLists"))

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "Create", "WebsiteInventory", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th class="g-mediumCell">
            <a href="#" class="tableHeaderSort" value="categoryCodeName">Category Code Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-smallCell">
            <a href="#" class="tableHeaderSort" value="partNo">Product (PartNo)</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-smallCell">
            <a href="#" class="tableHeaderSort" value="website">Website</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-smallCell">
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-smallCell"></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.categoryCode.categoryCodeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.product.partNo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Website.WebsiteName)
            </td>
            <td>
                @Html.DisplayFor(m => item.Website.dateLastUpdate)
            </td>
            <td class="g-a-c">
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "Create", "WebsiteInventory", new { id = item.websiteInventoryID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkWebInventoryDelete\" value=" + @item.websiteInventoryID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>
<br />

<div id="websiteInventoryPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}