@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product
@model WebsiteInventoryViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Website Inventory";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.webInventory.websiteFK, Model.allWebsites, "Search by website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            <select id="ddlCategorySearch" class="searchBy g-f-l form-control g-smallCell g-m-r-10" disabled="disabled">
                <option selected="selected">Search by category</option>
            </select>
            <select id="websiteInventorySearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option value="product">Search by product's part no</option>
            </select>
            <div>
                @Html.TextBox("SearchWebsiteInventory", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchWebsiteInventory" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        
        <br />

        <div id="websiteInventoryData">
            @{ Html.RenderPartial("~/Views/PMS/Product/WebsiteInventory/WebsiteInventoryData.cshtml", Model.webInventories);}
        </div>

        <div id="webInventoryDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete the website inventory?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchWebsiteInventory, #websiteInventoryPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchWebsiteInventory").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkWebInventoryDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#webInventoryDeleteDialog', $('#DeleteWebsiteInventoryURL').val(), $(this).attr('value'),
                '#websiteInventoryData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#websiteInventoryData').html($("#historyPage").val());
        }

        $(document).on("change", "#webInventory_websiteFK", function (event) {

            if ($(this).val().length > 0) {
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#ddlCategorySearch', 'category');
            } else {
                $("#ddlCategorySearch").empty();
                $("#ddlCategorySearch").html('<option value="" selected="true">Search by category</option>');
                $("#ddlCategorySearch").attr('disabled', 'disabled');
            }

            applyStandardPaging(event, 0);
        });

        $(document).on("change", "#ddlCategorySearch", function (event) {
            applyStandardPaging(event, 0);
        });

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#websiteInventoryPaging", $('#WebsiteInventoryDataURL').val(),
                                    "#websiteInventoryData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchWebsiteInventory").val(); //SearchTerm
            optionsArray[1] = $("#websiteInventorySearchBy").val(); //SearchBy
            optionsArray[2] = parseInt($('#webInventory_websiteFK').val()) || 0; //Website DropDown
            optionsArray[3] = parseInt($('#ddlCategorySearch').val()) || 0; //Category DropDown

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[4] = sortType + sortDir;
            } else {
                optionsArray[4] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //ProductID
            optionsArray[1] = $("#SearchWebsiteInventory").val(); //SearchTerm
            optionsArray[2] = $("#websiteInventorySearchBy").val(); //SearchBy
            optionsArray[3] = parseInt($('#webInventory_websiteFK').val()) || 0; //Website DropDown
            optionsArray[4] = parseInt($('#ddlCategorySearch').val()) || 0; //Category DropDown

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[5] = sortType + sortDir;
            } else {
                optionsArray[5] = '';
            }
        }

    </script>
}