@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product;
@model CategoryCodeAssignmentViewModel

@{
    ViewBag.Title = "Category Code Assignment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">
        <h3>@ViewBag.Title</h3>

        @Html.Hidden("CategoryCodeAssignmentDataURL", Url.Action("CategoryCodeAssignmentData", "CategoryCodeAssignment"))
        @Html.Hidden("CategoryCodeAssignmentList", Model.CategoryCodeAssignmentList.Count)
        @Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "SelectLists"))

        <div class="g-m-b-5">
            @Html.DropDownListFor(m => m.WebsiteInventory.websiteFK, Model.WebsiteNameList, "Search By Website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownList("WebsiteInventory_categoryCodeFK1", Model.CategoryCodeList, "Search By Category", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.Product.manufacturerFK, Model.ManufacturerNameList, "Search By Manufacturer", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.Product.productStatusFK, Model.ProductStatusList, "Search By Product Status", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })

            <select id="CategoryCodeAssignmentSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="productgroup">Search by Product Group</option>
                <option value="salesareagroup">Search by Sales Area Group</option>
                <option value="datasupplier">Search by Data Supplier</option>
            </select>

            <div class=" g-c-b g-f-l"><b>(Website is a Required Field)</b></div>

            <div class="g-c-b g-f-l g-m-t-5">
                <div class="g-f-l g-c-b">
                    @Html.TextBox("SearchCategoryCodeAssignment", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                    <a id="lnkSearchCategoryCodeAssignment" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                    <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slAxisValueLookup" />
                    @Html.ActionLink("Reset", "CategoryCodeAssignmentIndex", "CategoryCodeAssignment", null, new { @class = "btn btn-default" })
                </div>            
            </div>
        </div>

        <div class="g-c-b g-m-b-20">
            <span class="g-f-r"><span id="ProductsCount" class="g-fw-b">@Model.CategoryCodeAssignmentListCount </span><span>Products Found</span></span>
        </div>

        @using (Html.BeginForm("Save", "CategoryCodeAssignment"))
        {
            @Html.AntiForgeryToken()

            <table class="table" id="tableSetting">
                <tr>
                    <th>
                        <a href="#" class="tableHeaderSort g-f-l" value="name">Product Name</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                        <div class="g-c-b g-m-t-5 g-f-l">@Html.CheckBox("SecondaryCategoryDefault", false, new { @class = "g-m-lr-10-i", @value = "false" })</div>
                        <div class="g-f-l" style="height: 25px; line-height: 25px;">Secondary Category Only</div>
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="category">Category</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="partno">Part No</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="website">Website</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="status">Product Status</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="productgroup">Product Group</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="salesarea">Sales Area Group</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="datasupplier">Data Supplier</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a>Primary</a>
                        <div class="g-c-b g-m-t-5 g-m-l-10">@Html.CheckBox("PrimaryCategory", false, new { @class = "g-m-lr-10-i", @value = "false" })</div>
                    </th>
                    <th>
                        <a>Secondary</a>
                        <div class="g-c-b g-m-t-5 g-m-l-10">@Html.CheckBox("SecondaryCategory", false, new { @class = "g-m-lr-10-i", @value = "false" })</div> 
                    </th>
                </tr>
                @{Html.RenderAction("CategoryCodeAssignmentList", "CategoryCodeAssignment", new { Model = Model.CategoryCodeAssignmentList });}
            </table>

        <div class="g-w-100p" style="height: 50px;">
            <div class="g-f-l" style="margin-left: 550px; height: 30px; line-height: 30px;">
                @Html.Label("Assignment")
            </div>
            <div id="CategoryCodeDynamicList" class="g-f-l g-m-l-50">
                @Html.DropDownListFor(m => m.SelectedCategory, Model.CategoryCodeList, "Assign to...", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            </div>
            <div class="g-f-l g-m-l-50">
                <input type="submit" name="saveCategoryCodeAssignment" value="Save" class="btn btn-default" title="Save" />
            </div>
        </div>
        }

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var useMax = false;

        if ($('#CategoryCodeAssignmentList').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchCategoryCodeAssignment", function (event) {
            if ($("#WebsiteInventory_websiteFK").val() >= 0) {
                useMax = false;
            }
            setupOptionsArray();
            blockNumber = 1;
            GetCategoryCodeAssignmentSettings(true);
            if ($('#SecondaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
            else if ($('#PrimaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('checked', false)
            }
            else if ($('#SecondaryCategoryDefault').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
            return false;
        });

        $("#SearchCategoryCodeAssignment").keypress(function (event) {
            if (event.which == 13) {
                if ($("#WebsiteInventory_websiteFK").val() >= 0) {
                    useMax = false;
                }
                setupOptionsArray();
                blockNumber = 1;
                GetCategoryCodeAssignmentSettings(true);
                if ($('#SecondaryCategory').prop('checked')) {
                    $('#PrimaryCategory').prop('disabled', false)
                    $('#SecondaryCategory').prop('checked', false)
                    $('#SecondaryCategory').prop('disabled', true)
                    $('#SecondaryCategoryDefault').prop('checked', false)
                }
                else if ($('#PrimaryCategory').prop('checked')) {
                    $('#PrimaryCategory').prop('checked', false)
                }
                else if ($('#SecondaryCategoryDefault').prop('checked')) {
                    $('#PrimaryCategory').prop('disabled', false)
                    $('#SecondaryCategory').prop('checked', false)
                    $('#SecondaryCategory').prop('disabled', true)
                    $('#SecondaryCategoryDefault').prop('checked', false)
                }
            }
        });

        $(document).on("click", "#WebsiteInventory_websiteFK", function (event) {
            $('.SecondaryCategoryProduct').prop('disabled', true);
        });

        if ($('#WebsiteInventory_websiteFK').val() == "") {
            $("#SelectedCategory").empty();
            $("#SelectedCategory").html('<option value="" selected="true">Search by category</option>');
            $("#SelectedCategory").attr('disabled', 'disabled');
            $("#WebsiteInventory_categoryCodeFK1").empty();
            $("#WebsiteInventory_categoryCodeFK1").html('<option value="" selected="true">Search by category</option>');
            $("#WebsiteInventory_categoryCodeFK1").attr('disabled', 'disabled');
        }

        $(document).on("change", "#WebsiteInventory_websiteFK", function (event) {
            $('#WebsiteInventory_categoryCodeFK1').empty();

            if ($(this).val().length > 0) {
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#SelectedCategory', 'category');
                jsonPopulateDropDown($("#GetCategoryCodesURL").val() + '/' + $(this).val(), '#WebsiteInventory_categoryCodeFK1', 'category');
            } else {
                $("#SelectedCategory").empty();
                $("#SelectedCategory").html('<option value="" selected="true">Search by category</option>');
                $("#SelectedCategory").attr('disabled', 'disabled');
                $("#WebsiteInventory_categoryCodeFK1").empty();
                $("#WebsiteInventory_categoryCodeFK1").html('<option value="" selected="true">Search by category</option>');
                $("#WebsiteInventory_categoryCodeFK1").attr('disabled', 'disabled');
            }

            if ($("#WebsiteInventory_websiteFK").val() >= 0) {
                useMax = false;
            }
            setupOptionsArray();
            blockNumber = 1;
            GetCategoryCodeAssignmentSettings(true);
            if ($('#SecondaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
            else if ($('#PrimaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('checked', false)
            }
            else if ($('#SecondaryCategoryDefault').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
        });

        $(document).on("change", "#Product_manufacturerFK, #Product_productStatusFK, #CategoryCodeAssignmentSearchBy, #WebsiteInventory_categoryCodeFK1", function (event) {
            if ($("#WebsiteInventory_websiteFK").val() >= 0) {
                useMax = false;
            }
            setupOptionsArray();
            blockNumber = 1;
            GetCategoryCodeAssignmentSettings(true);
            if ($('#SecondaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
            else if ($('#PrimaryCategory').prop('checked')) {
                $('#PrimaryCategory').prop('checked', false)
            }
            else if ($('#SecondaryCategoryDefault').prop('checked')) {
                $('#PrimaryCategory').prop('disabled', false)
                $('#SecondaryCategory').prop('checked', false)
                $('#SecondaryCategory').prop('disabled', true)
                $('#SecondaryCategoryDefault').prop('checked', false)
            }
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetCategoryCodeAssignmentSettings(true);
            return false;
        });

        $(document).ready(function () {
            $('#SecondaryCategory').prop('disabled', true)
            $('.SecondaryCategoryProduct').prop('disabled', true)
        });

        $(document).on("click", "#PrimaryCategory", function (event) {
            if ($('#PrimaryCategory').is(':checked') && $("#WebsiteInventory_websiteFK").val() > 0) {
                useMax = true;
                var primaryCategory = true;
                $('.PrimaryCategoryProduct').prop('checked', true);
            }
            else
            {
                $('.PrimaryCategoryProduct').prop('checked', false);
                useMax = false;
            }
            setupOptionsArray();
            AjaxGetProducts($('#CategoryCodeAssignmentDataURL').val(),
                optionsArray,
                true,
                '#tableSetting tr:gt(0)',
                '#ProductsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"),
                primaryCategory);
        });

        $(document).on("click", "#SecondaryCategory", function (event) {
            if ($('#SecondaryCategory').is(':checked') && $("#WebsiteInventory_websiteFK").val() > 0) {
                useMax = true;
                var primaryCategory = false;
                $('.SecondaryCategoryProduct').prop('checked', true);

            }
            else {
                $('.SecondaryCategoryProduct').prop('checked', false);
                useMax = false;
                var primaryCategory = "Secondary";
            }
            setupOptionsArray();
            AjaxGetProducts($('#CategoryCodeAssignmentDataURL').val(),
                optionsArray,
                true,
                '#tableSetting tr:gt(0)',
                '#ProductsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"),
                primaryCategory);
        });

        $(document).on("click", "#SecondaryCategoryDefault", function (event) {
            if ($('#SecondaryCategoryDefault').is(':checked')) {
                useMax = false;
                var primaryCategory = "Secondary";
                $('#PrimaryCategory').prop('checked', false)
                $('#PrimaryCategory').prop('disabled', true)
                $('.PrimaryCategoryProduct').prop('checked', false)
                $('.PrimaryCategoryProduct').prop('disabled', true)
                $('#SecondaryCategory').prop('disabled', false)
                $('.SecondaryCategoryProduct').prop('disabled', false);
            }
            else
            {
                useMax = false;
                var primaryCategory = "Primary";
                $('#PrimaryCategory').prop('disabled', false)
                $('.PrimaryCategoryProduct').prop('disabled', false);
                $('#SecondaryCategory').prop('checked', false)
                $('.SecondaryCategoryProduct').prop('checked', false);
                $('#SecondaryCategory').prop('disabled', true)
                $('.SecondaryCategoryProduct').prop('disabled', true);
            }
            setupOptionsArray();
            AjaxGetProducts($('#CategoryCodeAssignmentDataURL').val(),
                optionsArray,
                true,
                '#tableSetting tr:gt(0)',
                '#ProductsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"),
                primaryCategory);
        });

        $(document).on("click", "#Product_manufacturerFK, #Product_productStatusFK, #CategoryCodeAssignmentSearchBy, #SearchCategoryCodeAssignment, #lnkSearchCategoryCodeAssignment, #SecondaryCategoryDefault, #PrimaryCategory, #PrimaryCategoryProduct", function (event) {
            if ($('#WebsiteInventory_websiteFK').val() <= 0) {
                alert("You Must Select a Website First");
                $('#PrimaryCategory').prop('checked', false)
                $('.PrimaryCategoryProduct').prop('checked', false);
                $('#SecondaryCategoryDefault').prop('checked', false);
                $('#PrimaryCategory').prop('disabled', false)
                $('.PrimaryCategoryProduct').prop('disabled', false);
                $('#SecondaryCategory').prop('disabled', true)
                $('.SecondaryCategoryProduct').prop('disabled', true);
            }
        });

        function AjaxGetProducts(url, optionsArray, clearData,
    clearElement, countElement, appendElement, sortType, sortDir, primaryCategory) {

            $("body").append('<div id="updatingContainer"></div>');
            optionsArray.push(blockNumber);

            $.ajax({
                type: 'POST',
                url: url,
                traditional: true,
                data:
                {
                    optionsArray: optionsArray,
                },
                success: function (data) {
                    $(clearElement).remove();
                    $(appendElement).append(data.HTMLString);
                    $('#updatingContainer').remove();

                    if (primaryCategory == true) {
                        $('.PrimaryCategoryProduct').prop('checked', true);
                    }
                    else if (primaryCategory == false) {
                        $('.SecondaryCategoryProduct').prop('checked', true);
                        $('.SecondaryCategoryProduct').prop('disabled', false);
                        $('.PrimaryCategoryProduct').prop('disabled', true);
                    }
                    else if (primaryCategory == "Primary") {
                        $('.PrimaryCategoryProduct').prop('disabled', false);
                        $('.SecondaryCategoryProduct').prop('disabled', true);
                    }
                    else if (primaryCategory == "Secondary") {
                        $('.PrimaryCategoryProduct').prop('disabled', true);
                        $('.SecondaryCategoryProduct').prop('disabled', false);
                    }

                    if (sortType != undefined) {
                        if (sortType.length > 0) {
                            var sortImgClass = '';
                            var sortImgTitle = '';
                            if (sortDir.val() == "Asc") {
                                sortImgClass = 'msp_sortArrowAsc';
                                sortImgTitle = 'Ascending';
                            } else {
                                sortImgClass = 'msp_sortArrowDesc';
                                sortImgTitle = 'Descending';
                            }

                            $('.tableHeaderSort').next().removeClass('msp_sortArrowAsc msp_sortArrowDesc');
                            $('.tableHeaderSort[value="' + sortType.val() + '"]').next().addClass(sortImgClass);
                            $('.tableHeaderSort[value="' + sortType.val() + '"]').next().attr("title", sortImgTitle);
                        }
                    }
                }
            });

        }

        function GetCategoryCodeAssignmentSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#CategoryCodeAssignmentDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#ProductsCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchCategoryCodeAssignment").val(); //SearchTerm
            optionsArray[2] = $("#CategoryCodeAssignmentSearchBy").val(); //SearchBy
            optionsArray[3] = $("#WebsiteInventory_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#Product_manufacturerFK").val() || 0; //Search by Manufacturer
            optionsArray[5] = $("#Product_productStatusFK").val() || 0; //Search by ProductStatus
            optionsArray[6] = $("#WebsiteInventory_categoryCodeFK1").val() || 0; //Search by Category
            optionsArray[7] = useMax;
        }
    </script>
}