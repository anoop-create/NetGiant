@using netGiant.Intranet.DataLayer
@using PagedList.Mvc

@model PagedList.IPagedList<productOverride>

@Html.Hidden("productOverrideDataURL", Url.Action("ProductOverrideData", "ProductOverride"))
@Html.Hidden("DeleteProductOverrideURL", Url.Action("Delete", "ProductOverride"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @Html.ActionLink("Create New", "Create", "ProductOverride", new { id = 0 }, new { @title = "New" })
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="originalVal">Original Value</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="overrideVal">Override Value</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="overrideRule">Override Rule</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="overrideType">Override Type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="product">Product</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.originalValue)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overrideValue)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overrideRule)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.overrideType.overrideTypeName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.product.productName)
            </td>
            <td>
                @Html.ActionLink("Edit", "Create", "ProductOverride", new { id = item.productOverrideID }, null) |
                <a href="#" class="lnkProductOverrideDelete" value="@item.productOverrideID" title="Delete @item.overrideValue">Delete</a>
            </td>
        </tr>
    }

</table>

<br />

<div id="productOverridePaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="productOverrideDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete the product override?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}