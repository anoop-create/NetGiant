@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Product;
@using netGiant.Intranet.DataLayer;
@model ProductFieldViewModel

<div class="productFieldTabs">
    <ul>
        @foreach (var item in Model.fieldSections)
        {
            <li><a href="#@item.fieldSectionID" value="@item.fieldSectionID">@item.fieldSectionName</a></li>
        }
    </ul>

    @using (Html.BeginForm("SaveProductFieldData", "ProductField", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.SelectedProductID)
        @Html.HiddenFor(m => m.SelectedWebsiteID)
        @Html.HiddenFor(m => m.SelectedFieldSectionID)
        @Html.HiddenFor(m => m.SelectedFieldSectionIndex)

        foreach (var sec in Model.fieldSections.Where(x => x.fieldSectionID == Model.SelectedFieldSectionID).OrderBy(x => x.sequenceNo))
        {
            <div id="@sec.fieldSectionID" class="divSection">
                @foreach (var subSec in sec.fieldSubSection.OrderBy(x => x.sequenceNo))
                {
                    <div class="divSubSection">
                        <fieldset>
                            <legend>@subSec.fieldSubSectionName</legend>
                            @for (int i = 0; i < Model.EditfieldValues.Count(); i++)
                            {
                                if (Model.EditfieldValues[i].fieldName.fieldSubSectionFK == subSec.fieldSubSectionID)
                                {
                                    <div class="div-table">
                                        @Html.HiddenFor(m => Model.EditfieldValues[i].fieldValueID)
                                        @Html.HiddenFor(m => Model.EditfieldValues[i].fieldNameFK)
                                        @Html.HiddenFor(m => Model.EditfieldValues[i].productFK)
                                        @Html.HiddenFor(m => Model.EditfieldValues[i].websiteFK)

                                        <div class="div-table-row">
                                            <div class="div-table-col-th">@Model.EditfieldValues[i].fieldName.fieldName1</div>
                                            <div class="div-table-col-td">
                                                @switch (@Model.EditfieldValues[i].fieldName.fieldType.fieldTypeName)
                                                {
                                                    case "Text":
                                                        if (Model.EditfieldValues[i].fieldName.fieldName1.Equals("Note Description"))
                                                        {
                                                            @Html.TextAreaFor(m => Model.EditfieldValues[i].fieldValueText, new { @class = "form-control" })
                                                        }
                                                        else
                                                        {
                                                            @Html.EditorFor(m => Model.EditfieldValues[i].fieldValueText, new { htmlAttributes = new { @class = "form-control" } })
                                                        }
                                                        
                                                        break;
                                                    case "Boolean":
                                                    @Html.EditorFor(m => Model.EditfieldValues[i].fieldValueBool, new { htmlAttributes = new { @class = "form-control" } })
                                                        break;
                                                    case "Double":
                                                    @Html.EditorFor(m => Model.EditfieldValues[i].fieldValueDouble, new { htmlAttributes = new { @class = "form-control" } })
                                                        break;
                                                    default:
                                                        break;
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </fieldset>
                    </div>
                }
            </div>
        }

        <div class="actionButtons">
            <input type="submit" name="saveProductField" value="Save" class="btn btn-default" title="Save" />
            @Html.ActionLink("Cancel", "ProductFields", "ProductField", new { id = Model.SelectedProductID }, new { @class = "btn btn-default" })
        </div>
    }

</div>