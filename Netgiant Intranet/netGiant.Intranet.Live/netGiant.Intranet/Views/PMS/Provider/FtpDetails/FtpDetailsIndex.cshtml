@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider;
@model ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Ftp Details";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        <div style="padding-bottom: 20px">
            <div>
                <select id="ftpSearchBy" class="searchBy g-f-l form-control g-smallCell"  style="margin-right:10px">
                    <option selected="selected" value="host">Search by host</option>
                    <option value="user">Search by User</option>
                    <option value="filename">Search by Filename</option>
                </select>
                @Html.TextBox("SearchFtpDetails", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchFtpDetails" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>

        <br />

        <div id="ftpDetailsData">
            @{ Html.RenderPartial("~/Views/PMS/Provider/FtpDetails/FtpDetailsData.cshtml", Model.listFTPDetails); }
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchFtpDetails, #ftpDetailsPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchFtpDetails").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkFtpDetailsDel", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#ftpDetailsDeleteDialog', $('#DeleteFtpDetailsURL').val(), $(this).attr('value'),
                '#ftpDetailsData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#ftpDetailsData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#ftpDetailsPaging", $('#FtpDetailsDataURL').val(),
                                    "#ftpDetailsData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchFtpDetails").val(); //SearchTerm
            optionsArray[1] = $("#ftpSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //FtpDetailsID
            optionsArray[1] = $("#SearchFtpDetails").val(); //SearchTerm
            optionsArray[2] = $("#ftpSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}