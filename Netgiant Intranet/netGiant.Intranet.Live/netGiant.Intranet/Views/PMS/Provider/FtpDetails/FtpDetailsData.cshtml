@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<ftpDetails>

@Html.Hidden("FtpDetailsDataURL", Url.Action("FtpDetailsData", "Provider"))
@Html.Hidden("DeleteFtpDetailsURL", Url.Action("DeleteFtpDetails", "Provider"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateFtpDetails", "Provider", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="ftpHost">Ftp Host</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="ftpUser">Ftp User</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="ftpPassword">Ftp Password</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="ftpFolder">Ftp Folder</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="filename">Filename</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="zipFilename">Zip Filename</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="provider">Provider</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ftpHost)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ftpUser)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ftpPassword)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ftpFolder)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ftpFilename)
            </td>
            <td>
                @Html.DisplayFor(m => item.ftpZipFilename)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.provider.providerName)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateFtpDetails", "Provider", new { id = item.ftpDetailID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkFtpDetailsDel\" value=" + @item.ftpDetailID + " title=\"Delete\">Delete</a> | ");
                    @Html.ActionLink("Test Connection", "FtpConnection", "Provider", new { id = item.ftpDetailID }, null);
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="ftpDetailsPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="ftpDetailsDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete these ftp details?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}