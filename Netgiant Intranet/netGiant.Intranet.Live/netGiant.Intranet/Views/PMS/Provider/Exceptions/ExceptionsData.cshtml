@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider;
@using PagedList.Mvc;
@model ProviderExceptionsViewModel

@Html.Hidden("ExceptionsDataURL", Url.Action("ExceptionsData", "Provider"))
@Html.Hidden("SetUntrustedURL", Url.Action("SetUntrustedProviderException", "Provider"))
@Html.Hidden("GetCategoryCodesURL", Url.Action("GetCategoryCodes", "SelectLists"))
@Html.Hidden("PageCount", Model.ProviderInventoryExcList.PageCount)
@Html.Hidden("PageNumber", Model.ProviderInventoryExcList.PageNumber)
@Html.Hidden("PageSize", Model.ProviderInventoryExcList.PageSize)

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="partNo">Part No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="providerPartNo">Provider Part No</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="provider">Provider</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="productName">Product Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="stock">Stock</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="latestPrice">Latest Price</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="previousPrice">Previous Price</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="priceChange">Change</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="priceChangePercent">Change %</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="reason">Reason</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="date">Date Change</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th class="g-a-c">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                <a href="#" class="tableHeaderSort" value="untrusted">Untrusted</a>
                <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
            }
        </th>
    </tr>

    @{var loopCount = 0;}
    @foreach (var item in Model.ProviderInventoryExcList)
    {
        if (item.PreviousPrice != null)
        {
            <tr>
                <td>
                    @Html.ActionLink(item.PartNo, "Detail/" + item.ProductFK, "Product")

                </td>
                <td>
                    @Html.DisplayFor(m => item.ProviderPartNo)
                </td>
                <td>
                    @Html.DisplayFor(m => item.Provider)
                </td>
                <td>
                    @Html.DisplayFor(m => item.ProductName)
                </td>
                <td>
                    @Html.DisplayFor(m => item.Manufacturer)
                </td>
                <td>
                    @Html.DisplayFor(m => item.Stock)
                </td>
                <td>
                    @Html.Raw("£" + string.Format("{0:N2}", item.LatestPrice))
                </td>
                <td>
                    @Html.Raw("£" + string.Format("{0:N2}", item.PreviousPrice))
                </td>
                <td>
                    @Html.Raw("£" + string.Format("{0:N2}", item.Change))
                </td>
                <td>
                    @Html.Raw(string.Format("{0:P2}", item.ChangePercentage))
                </td>
                <td>
                    @Html.Raw(item.Reason)
                </td>
                <td>
                    @Html.DisplayFor(m => item.Date)
                </td>
                <td class="g-a-c">
                    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                    {
                        @Html.CheckBox("untrsuted" + loopCount, item.Untrusted == true ? true : false,
                             new { @class = "chkBoxUntrusted", @value = item.ProviderInventoryFK })
                    }                     
                </td>
            </tr>
        }

        loopCount++;
    }
</table>

<!--Paging-->
<div id="providerExceptionsPaging" style="text-align:center;">
    @Html.PagedListPager(Model.ProviderInventoryExcList, p => "#")
</div>