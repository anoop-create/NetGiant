
@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<mfpnExtensions>

@Html.Hidden("MfpnExtensionsDataURL", Url.Action("MfpnExtensionsData", "Provider"))
@Html.Hidden("DeleteMfpnExtensionURL", Url.Action("DeleteMfpnExtension", "Provider"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateMfpnExtension", "Provider", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="manufacturer">Manufacturer</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="extension">Extension</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(m => item.manufacturer.manufacturerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.extension)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateMfpnExtension", "Provider", new { id = item.mfpnExtensionID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkMfpnExtensionDelete\" value=" + @item.mfpnExtensionID + " title=\"Delete Mapping\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="mfpnExtensionsPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}