@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel

@{
    ViewBag.Title = "MFPN Extensions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.manufacturerFK, Model.allManufacturers, "Search By Manufacturer", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            <select id="mfpnExtensionsSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="extension">Search by extension</option>
            </select>
            <div>
                @Html.TextBox("mfpnExtensionsSearchBox", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkMfpnExtenstions" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div id="mfpnExtensionsData">
            @{ Html.RenderPartial("~/Views/PMS/Provider/mfpnExtensions/mfpnExtensionsData.cshtml", Model.mfpnExtensionsList); }
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

        <!--Delete Dialog-->
        <div id="mfpnExtensionsDeleteDialogue" class="confirmDialog g-d-n" title="Confirm Delete">
            Are you sure you want to delete this MFPN extensions Entry ?
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#mfpnExtensionsPaging a", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event, $(this));

            return false;
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            setupOptionsArrayPaging();
            applyStandardPaging(event);

            return false;
        });

        $("#mfpnExtensionsSearchBox").keypress(function (event) {
            if (event.which == 13) {
                setupOptionsArrayPaging();
                applyStandardPaging(event);
            }
        });

        $(document).on("click", "#lnkMfpnExtenstions", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event);
        });

        $(document).on("change", "#manufacturerFK", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event);
        });

        $(document).on("click", ".lnkMfpnExtensionDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#mfpnExtensionsDeleteDialogue', $('#DeleteMfpnExtensionURL').val(), $(this).attr('value'),
                '#mfpnExtensionsData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        function applyStandardPaging(event, id) {
            standardPaging(event, id, "#mfpnExtensionsPaging", $('#MfpnExtensionsDataURL').val(),
                                    "#mfpnExtensionsData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#manufacturerFK").val() || 0; //Manufacturer
            optionsArray[1] = $("#mfpnExtensionsSearchBox").val(); //Search Box
            optionsArray[2] = $("#mfpnExtensionsSearchBy").val() || 0; //Search By
            
            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = $("#manufacturerFK").val() || 0; //Manufacturer
            optionsArray[1] = $("#mfpnExtensionsSearchBox").val(); //Search Box
            optionsArray[2] = $("#mfpnExtensionsSearchBy").val() || 0; //Search By
            
            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }

            optionsArray[4] = lnkDelete.attr("value");
        }

    </script>
}

