@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel

@{
    ViewBag.Title = "Supplier Manufacturer Mappings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        <div style="padding-bottom: 20px">
            @Html.DropDownListFor(m => m.selectedProviderID, Model.allSuppliers, "Search By Provider", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            @Html.DropDownListFor(m => m.manufacturerFK, Model.allManufacturers, "Search By Manufacturer", new { @class = "form-control g-smallCell g-f-l g-m-r-10" })
            <select id="supManuMappingSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px">
                <option selected="selected" value="supManuRef">Search by ref</option>
            </select>
            <div>
                @Html.TextBox("supManuMappingSearchBox", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchSupManuMapping" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div id="supManuMappingData">
            @{ Html.RenderPartial("~/Views/PMS/Provider/SupManuMappings/SupManuMappingsData.cshtml", Model.supManuMappingsList); }
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

        <!--Delete Dialog-->
        <div id="supManuMappingsDeleteDialogue" class="confirmDialog g-d-n" title="Confirm Delete">
            Are you sure you want to delete this Supplier Manufacturer Mapping Entry ?
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#supManuMappingsPaging a", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event, $(this));

            return false;
        });

        $(document).on("change", "#selectedProviderID", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event);
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            setupOptionsArrayPaging();
            applyStandardPaging(event);

            return false;
        });

        $("#supManuMappingSearchBox").keypress(function (event) {
            if (event.which == 13) {
                setupOptionsArrayPaging();
                applyStandardPaging(event);
            }
        });

        $(document).on("click", "#lnkSearchSupManuMapping", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event);
        });

        $(document).on("click", "#manufacturerFK", function (event) {
            setupOptionsArrayPaging();
            applyStandardPaging(event);
        });

        $(document).on("click", ".lnkSupManuMappingDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#supManuMappingsDeleteDialogue', $('#DeleteSupManuMappingURL').val(), $(this).attr('value'),
                '#supManuMappingData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        function applyStandardPaging(event, id) {
            standardPaging(event, id, "#supManuMappingsPaging", $('#SupManuMappingsDataURL').val(),
                                    "#supManuMappingData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#selectedProviderID").val() || 0; //ProviderID
            optionsArray[1] = $("#supManuMappingSearchBox").val(); //Search Box
            optionsArray[2] = $("#supManuMappingSearchBy").val() || 0; //Search By
            optionsArray[3] = $("#manufacturerFK").val() || 0; //Manufacturer

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[4] = sortType + sortDir;
            } else {
                optionsArray[4] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = $("#selectedProviderID").val() || 0; //ProviderID
            optionsArray[1] = $("#supManuMappingSearchBox").val(); //Search Box
            optionsArray[2] = $("#supManuMappingSearchBy").val() || 0; //Search By
            optionsArray[3] = $("#manufacturerFK").val() || 0; //Manufacturer

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[4] = sortType + sortDir;
            } else {
                optionsArray[4] = '';
            }

            optionsArray[5] = lnkDelete.attr("value");
        }

    </script>
}

