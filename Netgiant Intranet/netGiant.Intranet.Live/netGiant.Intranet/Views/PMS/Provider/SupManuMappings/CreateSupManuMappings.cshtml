@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel
@{
    ViewBag.Title = "Supplier Manufacturer Mapping";
    ViewBag.SubTitle = Model.supManuMap.providerFK > 0 ? "Edit" : "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("SaveSupManuMapping", "Provider", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.supManuMap.supplierManuMappingID)

                <div class="form-group">
                    @Html.Label("Provider", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.supManuMap.providerFK, Model.allSuppliers, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.supManuMap.providerFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Supplier Manu Ref", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.supManuMap.supplierManuRef, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.supManuMap.supplierManuRef, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label("Manufacturer", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(m => m.supManuMap.manufacturerFK, Model.allManufacturers, "Select...", new { @class = "form-control g-largeCell" })
                        @Html.ValidationMessageFor(model => model.supManuMap.manufacturerFK, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveProviderType" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "SupManuMappings", "Provider", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>

