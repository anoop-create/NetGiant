@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider;
@model ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Field Mapping";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="fieldMappingSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="provider">Search by provider</option>
            </select>
            <div>
                @Html.TextBox("SearchFieldMapping", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchFieldMapping" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

        <div id="fieldMappingData">
            @{ Html.RenderPartial("~/Views/PMS/Provider/FieldMapping/FieldMappingData.cshtml", Model.fieldMappings); }
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchFieldMapping, #fieldMappingPaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchFieldMapping").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkFieldMappingDelete", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#fieldMappingDeleteDialog', $('#DeleteFieldMappingURL').val(), $(this).attr('value'),
                '#fieldMappingData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#fieldMappingData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#fieldMappingPaging", $('#FieldMappingDataURL').val(),
                                    "#fieldMappingData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchFieldMapping").val(); //SearchTerm
            optionsArray[1] = $("#fieldMappingSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //FieldMappingID
            optionsArray[1] = $("#SearchFieldMapping").val(); //SearchTerm
            optionsArray[2] = $("#fieldMappingSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}