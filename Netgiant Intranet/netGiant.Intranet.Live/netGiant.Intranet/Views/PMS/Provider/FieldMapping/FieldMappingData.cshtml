@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<fieldMapping>

@Html.Hidden("FieldMappingDataURL", Url.Action("FieldMappingData", "Provider"))
@Html.Hidden("DeleteFieldMappingURL", Url.Action("DeleteFieldMapping", "Provider"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateFieldMapping", "Provider", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldMappingTo">Field Mapping To (PMS)</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="fieldMappingFrom">Field Mapping From (Provider)</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="provider">Provider</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.fieldMappingTo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.fieldMappingWith)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.provider.providerName)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdate)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateFieldMapping", "Provider", new { id = item.fieldMappingID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkFieldMappingDelete\" value=" + @item.fieldMappingID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="fieldMappingPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="fieldMappingDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
    Are you sure you want to delete the field mappings?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}