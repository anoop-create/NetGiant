@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<providerType>

@Html.Hidden("ProviderTypeDataURL", Url.Action("ProviderTypeData", "Provider"))
@Html.Hidden("DeleteProviderTypeURL", Url.Action("DeleteProviderType", "Provider"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateProviderType", "Provider", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="providerTypeName">Provider Type Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="dateLastUpdated">Date Last Updated</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.providerTypeName)
            </td>
            <td>
                @Html.DisplayFor(m => item.dateLastUpdate)
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateProviderType", "Provider", new { id = item.providerTypeID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkProviderTypeDel\" value=" + @item.providerTypeID + " title=\"Delete\">Delete</a>");
                }
            </td>
        </tr>
    }

</table>

<br />

<div id="providerTypePaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<div id="productTypeDelDialog" class="confirmDialog g-d-n" title="Confirm Delete">
    Are you sure you want to delete this provider type?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}