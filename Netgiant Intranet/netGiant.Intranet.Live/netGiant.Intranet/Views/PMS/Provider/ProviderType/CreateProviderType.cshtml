@model netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider.ProviderViewModel

@{
    ViewBag.Title = "Provider Type";
    ViewBag.SubTitle = Model.provType.providerTypeID > 0 ? "Edit" : "Create";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.SubTitle @ViewBag.Title</h4>

        <div class="form-horizontal">

            @using (Html.BeginForm("SaveProviderType", "Provider", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.provType.providerTypeID)

                <div class="form-group">
                    @Html.Label("Provider Type", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.provType.providerTypeName, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.provType.providerTypeName, "", new { @class = "text-danger" })
                    </div>
                </div>
                
                if (Model.provType.providerTypeID > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.provType.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="saveProviderType" value="Save" class="btn btn-default" title="Save" />
                        @Html.ActionLink("Cancel", "ProviderTypeIndex", "Provider", null, new { @class = "btn btn-default" })
                    </div>
                </div>
            }
        </div>

    </div>
</div>