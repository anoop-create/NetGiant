@using netGiant.Intranet.BusinessLayer.ViewModels.PMS.Provider
@model ProviderViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Provider Type";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title Details</h4>

        <div style="padding-bottom: 20px">
            <select id="providerTypeSearchBy" class="searchBy g-f-l form-control g-smallCell" style="margin-right:10px" >
                <option selected="selected" value="name">Search by name</option>
            </select>
            <div>
                @Html.TextBox("SearchProviderType", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10", @type = "text" })
                <a id="lnkSearchProviderType" href="#" class="btn btn-default g-f-l" title="Empty search returns all records">Search</a>
            </div>
        </div>
        <br />

       <div id="ProviderTypeData">
           @{ Html.RenderPartial("~/Views/PMS/Provider/ProviderType/ProviderTypeData.cshtml", Model.ProviderTypes); }
       </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        $(document).on("click", "#lnkSearchProviderType, #providerTypePaging a", function (event) {
            applyStandardPaging(event, $(this));
            return false;
        });

        $("#SearchProviderType").keypress(function (event) {
            if (event.which == 13) {
                applyStandardPaging(event);
            }
        });

        $(document).on("click", ".lnkProviderTypeDel", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete('#productTypeDelDialog', $('#DeleteProviderTypeURL').val(), $(this).attr('value'),
                '#ProviderTypeData', optionsArray, $("#activeSortType"), $("#activeSortDir"));
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            applyStandardPaging(event, 0);

            return false;
        });

        if ($("#historyPage").val() != '') {
            $('#ProviderTypeData').html($("#historyPage").val());
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#providerTypePaging", $('#ProviderTypeDataURL').val(),
                                    "#ProviderTypeData", optionsArray, $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArrayPaging() {
            optionsArray = new Array();
            optionsArray[0] = $("#SearchProviderType").val(); //SearchTerm
            optionsArray[1] = $("#providerTypeSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[2] = sortType + sortDir;
            } else {
                optionsArray[2] = '';
            }
        }

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //ProductID
            optionsArray[1] = $("#SearchProviderType").val(); //SearchTerm
            optionsArray[2] = $("#providerTypeSearchBy").val(); //SearchBy

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[3] = sortType + sortDir;
            } else {
                optionsArray[3] = '';
            }
        }

    </script>
}