@using netGiant.Intranet.DataLayer;
@using PagedList.Mvc;
@model PagedList.IPagedList<provider>

@Html.Hidden("ProviderDataURL", Url.Action("ProviderData", "Provider"))
@Html.Hidden("DeleteProviderURL", Url.Action("DeleteProvider", "Provider"))
@Html.Hidden("ProviderOtherDetailsURL", Url.Action("ShowOtherDetails", "Provider"))
@Html.Hidden("EnableDisableURL", Url.Action("EnableDisableProvider", "Provider"))
@Html.Hidden("PageCount", Model.PageCount)
@Html.Hidden("PageNumber", Model.PageNumber)
@Html.Hidden("PageSize", Model.PageSize)

<div>
    @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
    {
        @Html.ActionLink("Create New", "CreateProvider", "Provider", new { id = 0 }, new { @title = "New" })
    }
    else
    {
        @Html.Raw("&nbsp");
    }
    <span class="g-f-r">Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount</span>
</div>

<table class="table">
    <tr>
        <th>
            <a href="#" class="tableHeaderSort" value="providerID">ID</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="providerName">Provider Name</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="description">Description</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="providerType">Provider Type</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="feedFileDateStamp">Feed File Date Stamp</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="axisSupplierRef">Axis Ref</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="reviewTotal">Review Total</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="reviewRating">Review Rating</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th>
            <a href="#" class="tableHeaderSort" value="active">Active</a>
            <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
        </th>
        <th></th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(m => item.providerID)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.providerName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.providerDesc)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.providerType.providerTypeName)
            </td>
            <td>
                @Html.DisplayFor(m => item.feedFileDateTime)
            </td>
            <td>
                @Html.DisplayFor(m => item.axisSupplierRef)
            </td>
            <td>
                @String.Format("{0:n0}", item.reviewTotal)
            </td>
            <td>
                @Html.DisplayFor(m => item.reviewRating)
            </td>
            <td>
                @Html.CheckBoxFor(m => item.active, new { @class = "providerActive", data_id = item.providerID })
            </td>
            <td>
                @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
                {
                    @Html.ActionLink("Edit", "CreateProvider", "Provider", new { id = item.providerID }, null);
                    @Html.Raw(" | <a href=\"#\" class=\"lnkProviderDelete\" value=\"" + item.providerID + "\" title=\"Delete" + item.providerName + "\">Delete</a> | ");
                    @Html.ActionLink("Other Details", "ProviderDetails", "Provider", new { id = item.providerID }, null);
                }
            </td>
        </tr>
    }
</table>
<br />

<!--Paging-->
<div id="providerPaging" style="text-align:center;">
    @Html.PagedListPager(Model, p => "#")
</div>

<!--Delete Dialog-->
<div id="providerDeleteDialog" class="confirmDialog g-d-n" title="Confirm Delete">
    Are you sure you want to delete this provider?
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}