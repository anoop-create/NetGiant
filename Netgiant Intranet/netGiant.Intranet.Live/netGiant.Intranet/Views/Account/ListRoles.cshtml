@using netGiant.Intranet.Models;
@using Microsoft.AspNet.Identity.EntityFramework;

@model List<IdentityRole>

@Html.Hidden("RoleDeleteURL", Url.Action("DeleteRole", "Account"))

@{
    ViewBag.Title = "Roles List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h2>@ViewBag.Title</h2>
        <h4>List all the available roles on the intranet</h4>

        <div>
            @Html.ActionLink("Create New", "CreateRole", "Account", null, null)
        </div>        

        <div id="roDataPartialView">
            @{Html.RenderPartial("~/Views/Account/ListRoleData.cshtml", Model);}
        </div>

        <div id="roRoleDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure ?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var optionsArray;

        $(document).on("click", ".lnkDeleteRole", function () {
            setupOptionsArrayDelete($(this));
            ajaxDelete("#roRoleDialog", $("#RoleDeleteURL").val(), $(this).attr("value"),
                "#roDataPartialView", optionsArray, $("#activeSortType"), $("#activeSortDir"));
            return false;
        });

        function setupOptionsArrayDelete(lnkDelete) {
            optionsArray = new Array();
            optionsArray[0] = lnkDelete.attr("value"); //Role Name
        }

    </script>
}