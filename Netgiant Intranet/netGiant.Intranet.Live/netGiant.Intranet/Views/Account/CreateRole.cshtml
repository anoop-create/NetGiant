@using Microsoft.AspNet.Identity.EntityFramework;

@model IdentityRole

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Role";
}
<div class="placeHolder">

    <div class="placeHolderBody">

        <h2>@ViewBag.Title</h2>
        <h4>Create a new role</h4>

        @using (Html.BeginForm("CreateRole", "Account"))
        {
            <div class="form-horizontal">
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)

                <div class="form-group">
                    @Html.Label("Role Name", htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.EditorFor(model => model.Name, new { htmlAttributes = new { @class = "form-control g-largeCell" } })
                        @Html.ValidationMessageFor(model => model.Name, "", new { @class = "text-danger" })
                    </div>
                </div>

                @*@if (Model.Id > 0)
                {
                    <div class="form-group">
                        @Html.Label("Date Last Updated", htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.family.dateLastUpdate, new { htmlAttributes = new { @class = "form-control g-largeCell", @disabled = "disabled" } })
                        </div>
                    </div>
                }*@

                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" name="btnSaveRole" value="Save" class="btn btn-default" />
                        @Html.ActionLink("Cancel", "ListUserRoles", "Account", new { @class = "btn btn-default" }, null)
                    </div>
                </div>
            </div>
        }
    </div>
</div>