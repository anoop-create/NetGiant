@using netGiant.Intranet.BusinessLayer.ViewModels.Admin
@model ConfigurationSettingViewModel

@{
    ViewBag.Title = "Configuration Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="placeHolder">
    <div class="placeHolderBody">

        <h4>@ViewBag.Title</h4>

        @Html.Hidden("ConfigurationSettingDataURL", Url.Action("IndexData", "ConfigurationSetting"))
        @Html.Hidden("DeleteSettingURL", Url.Action("Delete", "ConfigurationSetting"))
        @Html.Hidden("SettingListCount", Model.SettingList.Count)

        <div class="g-p-b-10">

            @Html.DropDownListFor(m => m.Setting.sectionName, Model.SectionList, "Search by section", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })
            @Html.DropDownListFor(m => m.Setting.websiteFK, Model.WebsiteList, "Search by website", new { @class = "g-f-l form-control g-smallCell g-m-r-10" })

            <select id="configurationSettingSearchBy" class="searchBy g-f-l form-control g-smallCell g-m-r-10">
                <option selected="selected" value="name">Search by name</option>
                <option value="value">Search by Value</option>
                <option value="description">Search by description</option>
            </select>

            <div class="g-f-l">
                @Html.TextBox("SearchConfigurationSetting", null, new { @class = "searchBox form-control g-mediumCell g-f-l text-box single-line g-m-r-10" })
                <a id="lnkSearchConfigurationSetting" href="#" class="btn btn-default g-m-r-10" title="Empty search returns all records">Search</a>
                <img src="~/Content/images/loader/ajax-loader-whiteBG.gif" alt="" class="g-d-n" id="slConfigurationSetting" />
            </div>

            @Html.ActionLink("Reset", "Index", "ConfigurationSetting", null, new { @class = "btn btn-default" })

        </div>

        <div class="g-c-b">
            @if (User.IsInRole("IntranetAdmin") || User.IsInRole("PMSAdmin"))
            {
                @Html.ActionLink("Create New", "Create", "ConfigurationSetting", new { id = 0 }, null)
            }
            else
            {
                @Html.Raw("&nbsp");
            }
            <span class="g-f-r"><span id="settingCount" class="g-fw-b">@Model.ConfigurationSettingsCount </span><span>Settings Found</span></span>
        </div>

        <div id="configurationSettingPartialView">
            <table class="table" id="tableSetting">
                <tr>
                    <th>
                        <a href="#" class="tableHeaderSort" value="section">Section</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="name">Name</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="value">Value</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="description">Description</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="website">Website</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th>
                        <a href="#" class="tableHeaderSort" value="dateLastUpdate">Date Last Update</a>
                        <img src="~/Content/Images/1pxTrans.png" alt="Sort" />
                    </th>
                    <th></th>
                </tr>
                @{Html.RenderAction("ConfigurationSettingList", "ConfigurationSetting", new { Model = Model.SettingList });}
            </table>
        </div>


        <div id="configurationSettingDeleteDialog" class="confirmDialog" title="Confirm Delete" style="display:none;">
            Are you sure you want to delete this configuration setting?
        </div>

        <input type="hidden" id="activeSortType" />
        <input type="hidden" id="activeSortDir" />
        <input type="hidden" id="historyPage" />

    </div>
</div>

@{
    string infoBoxText = Convert.ToString(@TempData["InformationBoxFlag"]);
    if (infoBoxText != string.Empty)
    {
        <div id="infoBoxFlag" class="g-d-n">@TempData["InformationBoxFlag"]</div>
    }
}

@section Scripts {
    <script type="text/javascript">

        var optionsArray;

        if ($('#SettingListCount').val() < 50) {
            noMoreData = true;
        }

        $(document).on("click", "#lnkSearchConfigurationSetting", function (event) {
            blockNumber = 1;
            GetConfigurationSettings(true);
            return false;
        });

        $("#SearchConfigurationSetting").keypress(function (event) {
            if (event.which == 13) {
                blockNumber = 1;
                GetConfigurationSettings(true);
            }
        });

        $(document).on("change", "#Setting_websiteFK, #Setting_sectionName", function (event) {
            setupOptionsArray();
            blockNumber = 1;
            GetConfigurationSettings(true);
        });

        $(document).on("click", ".tableHeaderSort", function (event) {
            setupSort($(this));
            blockNumber = 1;
            GetConfigurationSettings(true);
            return false;
        });

        $(window).scroll(function () {
            if ($(window).scrollTop() + $(window).height() > $('#scrollBottomContainer').offset().top
                && !noMoreData && !inProgress) {
                GetConfigurationSettings(false);
            }
            return false;
        });

        $(document).on('click', '.lnkDeleteSetting', function () {
            setupOptionsArrayDelete($(this).attr('value'));
            ajaxDeleteInfiniteScroll('#configurationSettingDeleteDialog', $('#DeleteSettingURL').val(), $(this).attr('value'),
                '#configurationSettingPartialView', optionsArray, $("#activeSortType"), $("#activeSortDir"),
                true, '#tableSetting tr:gt(0)', '#settingCount', '#tableSetting tbody');
            return false;
        });

        function GetConfigurationSettings(clearTable) {
            setupOptionsArray();
            InfiniteScroll($('#ConfigurationSettingDataURL').val(),
                optionsArray,
                clearTable,
                '#tableSetting tr:gt(0)',
                '#settingCount',
                '#tableSetting tbody',
                $("#activeSortType"),
                $("#activeSortDir"));
        }

        function applyStandardPaging(event, id) {
            setupOptionsArrayPaging();
            standardPaging(event, id, "#configurationSettingPaging", $("#CategoryCodeDataURL").val(),
                                    "#configurationSettingPartialView", optionsArray,
                                    $("#activeSortType"), $("#activeSortDir"));
        }

        function setupOptionsArray() {
            optionsArray = new Array();

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[0] = sortType + sortDir;
            } else {
                optionsArray[0] = '';
            }

            optionsArray[1] = $("#SearchConfigurationSetting").val(); //SearchTerm
            optionsArray[2] = $("#configurationSettingSearchBy").val(); //SearchBy
            optionsArray[3] = $("#Setting_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#Setting_sectionName").val(); //Search by Section
        }

        function setupOptionsArrayDelete(configId) {
            optionsArray = new Array();
            optionsArray[0] = configId;

            var sortType = $("#activeSortType").val();
            var sortDir = $("#activeSortDir").val();

            if (sortType.length > 0) {
                optionsArray[1] = sortType + sortDir;
            } else {
                optionsArray[1] = '';
            }

            optionsArray[1] = $("#SearchConfigurationSetting").val(); //SearchTerm
            optionsArray[2] = $("#configurationSettingSearchBy").val(); //SearchBy
            optionsArray[3] = $("#Setting_websiteFK").val() || 0; //Search by Website
            optionsArray[4] = $("#Setting_sectionName").val(); //Search by Section
        }

    </script>
}